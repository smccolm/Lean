@[simp] theorem fordGapAffineSource0_coeff_56 :
    fordGapAffineSource0.coeff 56 =
      fordGapAffineCoeff0 56 := by
  unfold fordGapAffineSource0
  rw [coeff_comp_affine,
    hasseDeriv_eval_eq_sum_range 88 56 fordNumericalGapExplicit (0 : ℚ)
      fordNumericalGapExplicit_natDegree_le]
  norm_num [Finset.sum_range_succ, Nat.choose,
    fordGapAffineCoeff0]

