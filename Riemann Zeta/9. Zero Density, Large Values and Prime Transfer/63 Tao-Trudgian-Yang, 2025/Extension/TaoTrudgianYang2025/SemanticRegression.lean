      W.card ≤ 2 * (2 * (2 * ⌈H⌉₊ + 1)) * (Nat.clog 2 M) * U.card ∧
      (∀ v ∈ U, S / Nat.clog 2 M ≤
        ‖dirichletPoly (2 ^ j) (normalizedTypeIReflectedCoeff sigma M) v‖) :=
