      ∑ n ∈ Finset.Icc (a : ℤ) (b : ℤ), (𝐞 (T*F ((n : ℝ)/N)) : ℂ) :=
  @exponentialSumAt_eq_int_sum F T N a b

example
    {F : ℝ → ℝ} {σ δ N : ℝ} {P : ℕ}
    (hF : IsApproximateModelPhaseFunction F σ P δ) (hN : 0 < N)
    {a b : ℕ} (ha : N < (a : ℝ)) (hab : a ≤ b) (hb : (b : ℝ) < 2*N) :
