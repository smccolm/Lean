    modelPhaseWeightedSchwartz hχ hs hF hN T x =
      modelPhaseWeightedKernel χ F T N x :=
  @modelPhaseWeightedSchwartz_apply χ F σ δ N P hχ hs hF hN T x

example
    {χ F : ℝ → ℝ} {σ δ N : ℝ} {P : ℕ}
    (hχ : ContDiff ℝ ∞ χ) (hs : tsupport χ ⊆ Ioo (1 : ℝ) 2)
