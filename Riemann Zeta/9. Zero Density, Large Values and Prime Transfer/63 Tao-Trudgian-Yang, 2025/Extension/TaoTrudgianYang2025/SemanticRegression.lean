  @norm_modelPhaseStationaryCharacter F T N r

example (F : ℝ → ℝ) (T N : ℝ) (a L : ℕ) :
    exponentialSumAt F T N a (a+L) =
      ∑ i ∈ Finset.range (L+1), (𝐞 (T*F (((a : ℝ)+i)/N)) : ℂ) :=
  @exponentialSumAt_eq_range F T N a L

example (F : ℝ → ℝ) (T N : ℝ)
    (a L j : ℕ) (hj : j ≤ L) :
