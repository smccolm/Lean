      δ ≤ ζ ∧ 0 < K ∧ 0 < G ∧ 1 ≤ H ∧ 2 ≤ N₀ ∧
      ∀ (P : LargeValuePattern) (L : ℝ), P.ordinates.Nonempty →
        C ≤ P.N → N₀ ≤ P.N → L = P.T/P.N^χ →
