      (∀ x : ℝ, 0 ≤ χ x ∧ χ x ≤ 1) ∧
      ∀ n : ℤ, χ ((n : ℝ)/N) = if n ∈ Finset.Icc a b then 1 else 0 :=
  @exists_modelPhase_integer_cutoff N hN a b ha hab hb

example (F : ℝ → ℝ) (T N : ℝ) (a b : ℕ) :
