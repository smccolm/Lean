  @modelPhase_weighted_poisson χ F σ δ N P hχ hs hF hN T

example {N : ℝ} (hN : 0 < N)
    {a b : ℤ} (ha : N < (a : ℝ)) (hab : a ≤ b) (hb : (b : ℝ) < 2*N) :
