example {H : ℝ} (hH : 0 < H) :
    ∃ u ∈ Ioc (-H) H, (0 : ℝ) ≤ 2*H*(0 : ℝ) := by
  simpa using bourgainBandOccupancy_weighted_common_shift
    (∅ : Finset ℕ) (fun _ => (0 : ℝ)) (fun _ => (∅ : Finset ℤ))
