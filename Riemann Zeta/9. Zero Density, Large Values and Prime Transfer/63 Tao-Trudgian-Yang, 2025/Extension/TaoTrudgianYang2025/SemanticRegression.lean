example (a : ℕ → ℂ) (t : ℝ) :
    (∑ n ∈ (∅ : Finset ℕ), a n * dirichletPhase n t) = 0 := by simp
example (W : Finset ℝ) :
    bourgainZetaDifferenceMoment W 0 = 0 := by
  simp [bourgainZetaDifferenceMoment, bourgainLocalZetaSquare]

