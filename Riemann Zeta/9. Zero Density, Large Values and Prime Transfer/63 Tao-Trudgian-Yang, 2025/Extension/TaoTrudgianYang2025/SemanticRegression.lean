example
    {χ F : ℝ → ℝ} {σ A w T N r : ℝ}
    (hA : 0 < A) (hw : 0 < w) (hT : T ≠ 0) (hN : N ≠ 0)
    (hv : 0 < r*N/T) (hχ : χ (r*N/T) = 1) :
