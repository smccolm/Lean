example
    {χ F : ℝ → ℝ} {N : ℝ}
    (hs : tsupport χ ⊆ Ioo (1 : ℝ) 2) (hN : 0 < N) (T : ℝ) :
    HasCompactSupport (modelPhaseWeightedKernel χ F T N) :=
  @modelPhaseWeightedKernel_hasCompactSupport χ F N hs hN T

example
    {χ F : ℝ → ℝ} {σ δ N : ℝ} {P : ℕ}
