    (∑ p ∈ W ×ˢ W, ∫ u in -H..H, f (p.1-p.2+u)) ≤
      ∑ ℓ ∈ bourgainDifferenceSupport W, (bourgainDifferenceCount W ℓ : ℝ) *
        ∫ u in -(H+1)..H+1, f ((ℓ : ℝ)+u) :=
  @bourgain_difference_window_integral_le W f hf hf0 H hH

