  obtain ⟨hi,hk⟩ := (hmem j).mp (Finset.mem_filter.mp hj).1
  have hh := abs_le.mp ((hinfo j.1 hi).2.2.1 j.2 hk)
  have hg := ((hinfo j.1 hi).1 j.2).mp hk
