  have hrp i : rp i ≠ 0 := (mul_ne_zero_iff.mp (hxr i).1.ne').1
  have hxref i : xref i∈Ioo (1/2:ℝ) (W i-1/2) := (hxr i).2.1
  have href i : iteratedDeriv 2 (f i) (xref i)/2=(ep i:ℝ)/rp i := (hxr i).2.2.1
  let p : ℕ → ℤ × ℤ := fun j =>
