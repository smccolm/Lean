    rw [Int.cast_sub]
    exact (pow_le_pow_left₀ (abs_nonneg _) hb 2).trans (hbudget i)
  have hseedSq i : |(round (x₀ i):ℝ)-(ar i:ℝ)|^2 ≤ M*R := by
    have hh := rounded_displacement_bound (x₀ i) (xref i)
    have hb : |(round (x₀ i):ℝ)-(ar i:ℝ)| ≤ H+|x₀ i-xref i|+1 := by
