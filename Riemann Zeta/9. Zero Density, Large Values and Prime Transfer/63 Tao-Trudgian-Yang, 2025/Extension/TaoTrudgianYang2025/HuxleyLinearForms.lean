  let S := ((HuxleyLinearForm.fareySector K (-w) (-l)).image
      (fun p : ℤ × ℤ => (-p.1,p.2)))
  let y₀ := (p₀.1:ℝ)/p₀.2
  let f := fun i => heathBrownPhysicalPhase (F i) T M (A i) 1
  let a := fun i => round (x₀ i)
  let b := fun y i => round (x₁ y i)
  let n := fun y i => b y i-a i
