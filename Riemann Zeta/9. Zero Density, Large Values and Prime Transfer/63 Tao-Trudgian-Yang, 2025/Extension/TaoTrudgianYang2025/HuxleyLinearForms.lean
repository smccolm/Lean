        (U:ℝ) ≤ R^2 ∧ B*(U:ℝ)*Q ≤ (N:ℝ) ∧
        B^2*(U:ℝ)^3*R^2 ≤ (N:ℝ)^2 ∧
      let f := fun y w => T*(F (w/M)-F (w/M+η*y))/(σ*η)
