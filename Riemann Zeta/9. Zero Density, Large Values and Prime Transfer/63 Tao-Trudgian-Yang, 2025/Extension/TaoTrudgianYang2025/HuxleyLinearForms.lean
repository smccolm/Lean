  exact negative_fareySector_integer_labels_enlarged_rectangle_all_slopes hw hlw hB hη hcard hlarge
    (fun q hq => ⟨H q,hlin q hq⟩) p₀ hp0 hpu hpt.le hptK H₀ hpnear'


