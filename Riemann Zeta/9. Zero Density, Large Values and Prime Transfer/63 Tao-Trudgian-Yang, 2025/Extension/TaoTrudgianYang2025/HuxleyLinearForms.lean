            (q ij.1.1:ℤ) ∣ (r ij.2.1).num-(r ij.1.1).num) := by
  classical
  obtain ⟨C,hC,hentry⟩ := positive_difference_tagged_gap_dyadic_source_fourier hσ hc hJ
  refine ⟨C,hC,?_⟩
  intro ι Y F N s H η T M R U y x₁ x₂ hN hH hη hηmax hy hT hM hR hU
