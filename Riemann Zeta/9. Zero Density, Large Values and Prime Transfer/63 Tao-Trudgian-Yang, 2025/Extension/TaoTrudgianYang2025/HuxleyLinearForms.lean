theorem physicalModelPhase_actual_fourier_negative_selected_cell_family_count
    (S : Finset ℕ) (hS : 4944 ≤ S.card) (jref : ℕ) (hjref : jref∈S)
    (Q K₀ : ℕ) [NeZero K₀]
