    · exact ⟨fun _ => 0,fun h => False.elim (hp h)⟩
  choose cnew hcnew using hlabels
  have hδ0 : 0 ≤ δ := (abs_nonneg _).trans
    (approximateModelPhase_iteratedDeriv_error (hF 0)
