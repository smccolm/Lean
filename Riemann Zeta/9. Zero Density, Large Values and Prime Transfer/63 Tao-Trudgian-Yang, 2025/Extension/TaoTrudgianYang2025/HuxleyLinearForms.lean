      _ ≤ _ := by gcongr
  have hbudget := sector_no_wrap_scalar_budget htR hμ hd
    (hqpos p hp 0) (hqpos p hp 1) hvar (hVsmall 0) (hVsmall 1)
  exact physicalModelPhase_sector_second_condition_consumer
