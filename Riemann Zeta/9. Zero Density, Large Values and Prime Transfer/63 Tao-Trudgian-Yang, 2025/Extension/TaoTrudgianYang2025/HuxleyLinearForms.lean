    fin_cases i <;> dsimp only [ap,ep,vp] <;> push_cast <;> ring
  have hpoints (p) (hp : p∈S) (i) :
      xp p i∈Ioo (1/2:ℝ) (W i-1/2) ∧
      iteratedDeriv 2 (f i) (xp p i)/2=ap p i/qp p i ∧
