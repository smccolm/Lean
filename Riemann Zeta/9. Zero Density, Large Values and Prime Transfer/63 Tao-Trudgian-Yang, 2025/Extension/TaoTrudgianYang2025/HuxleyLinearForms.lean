    let νr := fun i => iteratedDeriv 4 (f i) (ar i)/24
    let dr := fun i => deriv (f i) (ar i)
    let δr := fun i => iteratedDeriv 2 (f i) (ar i)/2-(ep i:ℝ)/rp i
