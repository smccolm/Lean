  let ν := fun i => iteratedDeriv 4 (f i) (a i)/24
  let d := fun y i => (r i:ℝ)*y+s i
  let q := fun (p : ℤ × ℤ) i => (r i:ℝ)*p.1+s i*p.2
  let d₀ := fun i => iteratedDeriv 1 (f i) (a i)
  let δ₀ := fun i => iteratedDeriv 2 (f i) (a i)/2-(e i:ℝ)/r i
