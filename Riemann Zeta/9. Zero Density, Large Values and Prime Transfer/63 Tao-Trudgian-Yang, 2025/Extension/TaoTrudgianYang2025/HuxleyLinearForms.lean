      let a := e*p.1+v*p.2
      let d := r*p.1+s*p.2
      let x₁ := ξ ((p.1:ℝ)/p.2)
      let anew : Fin 2 → ℤ := ![a,Mat 0*a+Mat 1*d]
      let qnew : Fin 2 → ℤ := ![d,Mat 2*a+Mat 3*d]
