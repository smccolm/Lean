    (hlambda : 0 < lambda) (hUband : 0 ≤ Uband)
    (hθ : 0 < θ) (hθmax : θ ≤ 1/24)
    (hcurv : ∀ j∈S, ∀ i, lambda ≤ |(rat j i:ℝ)| ∧ |(rat j i:ℝ)| ≤ Uband)
