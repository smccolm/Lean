/-- The actual source scale relation and bounded reference labels give
a polynomial rectangle for original seed coordinates. The scale T is
not an independent asymptotic variable. -/
theorem source_reference_seed_height_polynomial
    {σ J Jv T M N R Q U V e r v s : ℝ}
    (hσ : 0 < σ) (hJ : 0 ≤ J) (hJv : 0 ≤ Jv)
    (hT : 0 < T) (hM : 0 < M) (hR : 1 ≤ R)
    (hRQ : R ≤ Q) (hQN : Q ≤ N) (hNM : N^2 ≤ M)
    (hU : 1 ≤ U) (hscale : T*N*R^2=M^3)
    (hV₀ : 0 ≤ V) (hV : V ≤ Jv*T/(2*M^2))
    (hr : |r| ≤ 4*R^2/U) (hs : |s| ≤ 4*R^2/U)
    (he : |e| ≤ (3*J*T/(2*σ*M^2)+1)*(4*R^2/U))
    (hv : |v| ≤ (3*J*T/(2*σ*M^2)+1)*(4*R^2/U)) :
    let C := 1+4*(3*J/(2*σ)+1+Jv/2)
    1 ≤ T ∧ 1 ≤ C ∧
      1+(|v|+|s| *V)*Q ≤ C*T^3 ∧
      1+(|r| *V+|e|)*Q ≤ C*T^3 := by
  intro C
  have hN : 1 ≤ N := hR.trans (hRQ.trans hQN)
  have hNp : 0 < N := zero_lt_one.trans_le hN
  have hQ₀ : 0 ≤ Q := (zero_lt_one.trans_le (hR.trans hRQ)).le
  have hR₀ : 0 ≤ R := (zero_lt_one.trans_le hR).le
  have hNM' : N ≤ M := (by nlinarith only [hN] : N ≤ N^2).trans hNM
  have hM1 : 1 ≤ M := hN.trans hNM'
  have hR₂ : R^2 ≤ M :=
    (pow_le_pow_left₀ hR₀ (hRQ.trans hQN) 2).trans hNM
  have hprod : N*R^2 ≤ M^2 := by
    calc
      _ ≤ M*M := mul_le_mul hNM' hR₂ (sq_nonneg R) hM.le
      _ = _ := by ring
  have hMT : M ≤ T := by
    apply (mul_le_mul_iff_left₀ (sq_pos_of_pos hM)).mp
    calc
      M*M^2 = M^3 := by ring
      _ = T*(N*R^2) := by nlinarith only [hscale]
      _ ≤ T*M^2 := mul_le_mul_of_nonneg_left hprod hT.le
  have hT1 : 1 ≤ T := hM1.trans hMT
  have hQT : Q ≤ T := hQN.trans (hNM'.trans hMT)
  have hM₂ : 1 ≤ M^2 := one_le_pow₀ hM1
  have hK : 4*R^2/U ≤ 4*T :=
    (div_le_self (by positivity) hU).trans (mul_le_mul_of_nonneg_left (hR₂.trans hMT) (by norm_num))
  let c := 3*J/(2*σ)
  have hc : 0 ≤ c := by dsimp only [c]; positivity
  have hcurv : 3*J*T/(2*σ*M^2) ≤ c*T := by
    calc
      _ = c*T/M^2 := by dsimp only [c]; ring
      _ ≤ c*T := div_le_self (mul_nonneg hc hT.le) hM₂
  have hV' : V ≤ (Jv/2)*T := hV.trans (by
    calc
      Jv*T/(2*M^2) = ((Jv/2)*T)/M^2 := by ring
      _ ≤ (Jv/2)*T := div_le_self (by positivity) hM₂)
  have hlabel {z : ℝ}
      (hz : |z| ≤ (3*J*T/(2*σ*M^2)+1)*(4*R^2/U)) :
      |z| ≤ 4*(c+1)*T^2 := by
    have htop : 3*J*T/(2*σ*M^2)+1 ≤ (c+1)*T := by nlinarith only [hcurv,hT1]
    apply hz.trans
    calc
      _ ≤ ((c+1)*T)*(4*T) :=
        mul_le_mul htop hK (by positivity) (by positivity)
      _ = _ := by ring
  have hr' : |r| ≤ 4*T := hr.trans hK
  have hs' : |s| ≤ 4*T := hs.trans hK
  have he' := hlabel he
  have hv' := hlabel hv
  have hvV : |s| *V ≤ 2*Jv*T^2 := by
    calc
      _ ≤ (4*T)*((Jv/2)*T) := mul_le_mul hs' hV' hV₀ (by positivity)
      _ = _ := by ring
  have hrV : |r| *V ≤ 2*Jv*T^2 := by
    calc
      _ ≤ (4*T)*((Jv/2)*T) := mul_le_mul hr' hV' hV₀ (by positivity)
      _ = _ := by ring
  have hC : 1 ≤ C := by
    change 1 ≤ 1+4*(c+1+Jv/2)
    exact le_add_of_nonneg_right (by positivity)
  have hpow : 1 ≤ T^3 := one_le_pow₀ hT1
  refine ⟨hT1,hC,?_,?_⟩
  · have hsum : |v|+|s| *V ≤ (4*(c+1)+2*Jv)*T^2 := by linarith only [hv',hvV]
    have hh := mul_le_mul hsum hQT hQ₀ (by positivity : 0 ≤ (4*(c+1)+2*Jv)*T^2)
    change 1+(|v|+|s| *V)*Q ≤ (1+4*(c+1+Jv/2))*T^3
    nlinarith only [hh,hpow]
  · have hsum : |r| *V+|e| ≤ (4*(c+1)+2*Jv)*T^2 := by linarith only [he',hrV]
    have hh := mul_le_mul hsum hQT hQ₀ (by positivity : 0 ≤ (4*(c+1)+2*Jv)*T^2)
    change 1+(|r| *V+|e|)*Q ≤ (1+4*(c+1+Jv/2))*T^3
    nlinarith only [hh,hpow]

/-- Every fixed power of the signed dyadic label cost is absorbed
uniformly once its actual coordinate rectangle has polynomial T-height.
The threshold depends on C, m and epsilon, not on the rectangle. -/
theorem eventually_signed_height_coefficient_cost
    {C ε : ℝ} (hC : 1 ≤ C) (m : ℕ) (hε : 0 < ε) :
    ∀ᶠ T : ℝ in Filter.atTop, ∀ P₁ P₂ : ℝ,
      1 ≤ P₁ → 1 ≤ P₂ → P₁ ≤ C*T^3 → P₂ ≤ C*T^3 →
      (((6+216*(⌊Real.logb 2 (P₁*P₂)⌋₊+1):ℕ):ℝ)^m) ≤ T^ε := by
  let K : ℝ := 222+1728/Real.log 2
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hK : 0 ≤ K := by dsimp only [K]; positivity
  filter_upwards [eventually_const_log_pow_le_rpow (K^m) (pow_nonneg hK m) m hε,
    Filter.eventually_ge_atTop C,Filter.eventually_ge_atTop (1:ℝ),
    Real.tendsto_log_atTop.eventually_ge_atTop 1] with T hsmall hCT hT hlogT
  intro P₁ P₂ hP₁ hP₂ hP₁T hP₂T
  have hTp : 0 < T := zero_lt_one.trans_le hT
  have hC₀ : 0 ≤ C := zero_le_one.trans hC
  have hP₁₀ : 0 ≤ P₁ := zero_le_one.trans hP₁
  have hP₂₀ : 0 ≤ P₂ := zero_le_one.trans hP₂
  have hprod1 : 1 ≤ P₁*P₂ := one_le_mul_of_one_le_of_one_le hP₁ hP₂
  have hprod : P₁*P₂ ≤ T^8 := by
    calc
      _ ≤ (C*T^3)*(C*T^3) := mul_le_mul hP₁T hP₂T hP₂₀ (by positivity)
      _ = C^2*T^6 := by ring
      _ ≤ T^2*T^6 := mul_le_mul_of_nonneg_right
        (pow_le_pow_left₀ hC₀ hCT 2) (pow_nonneg hTp.le 6)
      _ = _ := by ring
  have hlogP : 0 ≤ Real.logb 2 (P₁*P₂) :=
    Real.logb_nonneg (by norm_num) hprod1
  have hfloor := Nat.floor_le hlogP
  have hlogbound := Real.logb_le_logb_of_le (by norm_num : (1:ℝ)<2)
    (zero_lt_one.trans_le hprod1) hprod
  rw [Real.logb_pow] at hlogbound
  have hcost : ((6+216*(⌊Real.logb 2 (P₁*P₂)⌋₊+1):ℕ):ℝ) ≤ K*Real.log T := by
    have he : K*Real.log T = 222*Real.log T+216*(8*Real.logb 2 T) := by
      dsimp only [K,Real.logb]
      ring
    rw [he]
    push_cast
    norm_num only [Nat.cast_ofNat] at hlogbound
    linarith only [hfloor,hlogbound,hlogT]
  have hh := pow_le_pow_left₀ (Nat.cast_nonneg (6+216*(⌊Real.logb 2 (P₁*P₂)⌋₊+1))) hcost m
  rw [mul_pow] at hh
  exact hh.trans hsmall

/-- Uniform subpower control of the actual rounded coefficient image,
using the physical rational seeds, bounded original reference labels
and the linked source scales. The threshold precedes all physical
parameters and phases. This is not yet the family fifth moment. -/
theorem eventually_physicalModelPhase_bounded_reference_coefficient_count
    {ι : Type*} {σ Jref ε : ℝ}
    (hσ : 0 < σ) (hJref : 0 ≤ Jref) (m : ℕ) (hε : 0 < ε) :
    ∀ᶠ T : ℝ in Filter.atTop, ∀
    (S : Finset ι) (rat : ι → ℚ) (Q : ℕ) (e r v s : ℤ)
    {δ M A W μ ν μ₁ ν₁ r₁ s₁ C J N R d Bcut l w y₀ ac bc D : ℝ}
    {P : ℕ} {F : ℝ → ℝ} {x : ι → ℝ} {k : Fin 17}
    (_ : Expdb.IsApproximateModelPhaseFunction F σ P δ)
    (_ : 1 ≤ P) (_ : 0 < T) (_ : 0 < M)
    (_ : M ≤ A) (_ : A+W ≤ 2*M) (_ : ∀ i∈S, x i∈Ioo 0 W)
    (_ : ∀ i∈S, (rat i).den ≤ Q)
    (_ : ∀ i∈S,
      iteratedDeriv 2 (heathBrownPhysicalPhase F T M A 1) (x i)/2=(rat i:ℝ))
    (_ : 0 < μ) (_ : μ₁ ≠ 0) (_ : r ≠ 0) (_ : r₁ ≠ 0)
    (_ : 0 ≤ C) (_ : 0 < J) (_ : 0 < N) (_ : 1 ≤ R) (_ : 0 < d)
    (_ : ∀ z∈Icc l w, d ≤ (r:ℝ)*z+s ∧ (r:ℝ)*z+s ≤ 2*d)
    (_ : ∀ z∈Icc l w, r₁*z+s₁ ≠ 0)
    (_ : |(r:ℝ)| * max |l| |w| ≤ 2*d)
    (_ : μ ≤ J/(6*N*R^2))
    (_ : 0 < Bcut) (_ : 5*C*J ≤ Bcut)
    (_ : |minorArcCoordinate μ r s l| ≤ |(r:ℝ)| *N^2/(Bcut*R^2))
    (_ : 0 ≤ D) (_ : D ≤ 1/2)
    (_ : δ ≤ 1) {Uref : ℝ}
    (_ : R ≤ (Q:ℝ)) (_ : (Q:ℝ) ≤ N) (_ : N^2 ≤ M)
    (_ : 1 ≤ Uref) (_ : T*N*R^2=M^3)
    (_ : |(r:ℝ)| ≤ 4*R^2/Uref) (_ : |(s:ℝ)| ≤ 4*R^2/Uref)
    (_ : |(e:ℝ)| ≤ (3*Jref*T/(2*σ*M^2)+1)*(4*R^2/Uref))
    (_ : |(v:ℝ)| ≤ (3*Jref*T/(2*σ*M^2)+1)*(4*R^2/Uref)),
    let p : ι → ℤ × ℤ := fun i =>
      (v*((rat i).den:ℤ)-s*(rat i).num,r*(rat i).num-e*((rat i).den:ℤ))
    let U := C*R^4/(N*d^3)
    let g := rationalPhase μ r s μ₁ r₁ s₁
    let h := quarticPhase μ ν r s μ₁ ν₁ r₁ s₁
    let φ := fun z => g z-h z
    let y := fun i => ((p i).1:ℝ)/(p i).2
    let Z := quarticCurvatureBoundaryRoots μ ν r s μ₁ ν₁ r₁ s₁ U
    (∀ i∈S, 0 < (p i).2) →
    y₀∈finiteBoundaryCell Z l w k →
    (∀ i∈S, y i∈finiteBoundaryCell Z l w k) →
    |iteratedDeriv 2 g y₀-iteratedDeriv 2 h y₀| ≤ U →
    (∀ i∈S, |(ac-round (ac-deriv φ (y i)))*y i+
      bc-round (bc-φ (y i)+y i*deriv φ (y i))-φ (y i)| ≤ D/(p i).2) →
    (((S.image (fun i => (round (ac-deriv φ (y i)),
      round (bc-φ (y i)+y i*deriv φ (y i))))).card:ℝ)^m) ≤ T^ε := by
  let Jv := modelPhaseJetCoefficient σ 1+1
  let Cheight := 1+4*(3*Jref/(2*σ)+1+Jv/2)
  have hJv : 0 ≤ Jv := add_nonneg (modelPhaseJetCoefficient_nonneg σ 1) zero_le_one
  have hCheight : 1 ≤ Cheight := by
    dsimp only [Cheight]
    exact le_add_of_nonneg_right (by positivity)
  filter_upwards [eventually_signed_height_coefficient_cost hCheight m hε] with T hcost
  intro S rat Q e r v s δ M A W μ ν μ₁ ν₁ r₁ s₁ C J N R d Bcut l w y₀ ac bc D P F x k hF hP hT hM hA hW hx hQ hlevel hμ hμ₁ hr hr₁ hC hJ hN hR hd hden hden₁ hcoord hμupper hBcut hBsize hG hD₀ hD hδmax Uref hRQ hQN hNM hUref hscale hrHeight hsHeight heHeight hvHeight p U g h φ y Z hp hy₀ hy hcurv hres
  let V := T*(modelPhaseJetCoefficient σ 1+δ)/(2*M^2)
  let P₁ := 1+(|(v:ℝ)|+|(s:ℝ)| *V)*(Q:ℝ)
  let P₂ := 1+(|(r:ℝ)| *V+|(e:ℝ)|)*(Q:ℝ)
  have hδ₀ : 0 ≤ δ := approximateModelPhase_tolerance_nonneg hF
  have hV₀ : 0 ≤ V := div_nonneg
    (mul_nonneg hT.le (add_nonneg (modelPhaseJetCoefficient_nonneg σ 1) hδ₀))
    (by positivity)
  have hVupper : V ≤ Jv*T/(2*M^2) := by
    dsimp only [V,Jv]
    rw [mul_comm (modelPhaseJetCoefficient σ 1+1) T]
    exact div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left (add_le_add le_rfl hδmax) hT.le) (by positivity)
  have hheight := source_reference_seed_height_polynomial hσ hJref hJv
    hT hM hR hRQ hQN hNM hUref hscale hV₀ hVupper hrHeight hsHeight heHeight hvHeight
  have hP₁ : 1 ≤ P₁ := le_add_of_nonneg_right
    (mul_nonneg (add_nonneg (abs_nonneg _) (mul_nonneg (abs_nonneg _) hV₀))
      (Nat.cast_nonneg Q))
  have hP₂ : 1 ≤ P₂ := le_add_of_nonneg_right
    (mul_nonneg (add_nonneg (mul_nonneg (abs_nonneg _) hV₀) (abs_nonneg _))
      (Nat.cast_nonneg Q))
  have hc := physicalModelPhase_signed_integer_height_source_coefficient_count S rat Q e r v s
    hσ.le hF hP hT hM hA hW hx hQ hlevel hμ hμ₁ hr hr₁ hC hJ hN
    (zero_lt_one.trans_le hR) hd hden hden₁ hcoord hμupper hBcut hBsize hG hD₀ hD
    hp hy₀ hy hcurv hres
  have hcR : ((S.image (fun i => (round (ac-deriv φ (y i)),
      round (bc-φ (y i)+y i*deriv φ (y i))))).card:ℝ) ≤
      ((6+216*(⌊Real.logb 2 (P₁*P₂)⌋₊+1):ℕ):ℝ) := by
    change (S.image (fun i => (round (ac-deriv φ (y i)),
      round (bc-φ (y i)+y i*deriv φ (y i))))).card ≤
        6+216*(⌊Real.logb 2 (P₁*P₂)⌋₊+1) at hc
    exact Nat.cast_le.mpr hc
  exact (pow_le_pow_left₀ (Nat.cast_nonneg _) hcR m).trans
