      C₂*n/(2*N*R^2)+5*C₃*n^3/(12*M*N*R^2) := by
  have hT : T=M^3/(N*R^2) := (eq_div_iff (by positivity)).mpr (by nlinarith only [hscale])
  rw [hT]
  field_simp

