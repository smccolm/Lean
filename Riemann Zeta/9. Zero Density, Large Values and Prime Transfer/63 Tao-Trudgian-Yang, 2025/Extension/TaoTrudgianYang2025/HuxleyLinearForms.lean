  have hCc : 0 ≤ Cc := by dsimp only [Cc,C₂,C₃]; positivity
  have hDbase : 0 ≤ Dbase := by dsimp only [Dbase]; positivity
  have hTbase : 0 ≤ Tbase := by dsimp only [Tbase]; positivity
