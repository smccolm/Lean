    max ((w-l)*(K:ℝ)^2/Bd) 2 ≤ S.card →
    3840*Bd*η*((-l)*(K:ℝ))*(K:ℝ) < S.card →
    -(p₀.1:ℝ) ≤ 12*((-l)*(K:ℝ)) →
    (p₀.2:ℝ) ≤ 12*(K:ℝ) →
