  have hcommon := physicalModelPhase_quartic_sector_labels_from_seed
    (p₀:=pseed) (x₀:=xref) (xseed:=x₀) (x₁:=ξ) (e:=ep) (r:=rp) (v:=vp) (s:=sp)
