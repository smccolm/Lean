    (∀ i∈S, x i∈finiteBoundaryCell Z l w k) →
    |iteratedDeriv 2 g x₀-iteratedDeriv 2 h x₀| ≤ U →
    (∀ i∈S, |(ac-round (ac-deriv φ (x i)))*x i+
      bc-round (bc-φ (x i)+x i*deriv φ (x i))-φ (x i)| ≤ D*x i) →
    (S.image (fun i => (round (ac-deriv φ (x i)),
      round (bc-φ (x i)+x i*deriv φ (x i))))).card ≤ 5+108*(⌊Real.logb 2 (w/l)⌋₊+1) := by
  classical
  intro g h φ Z hx₀ hx hcurv hres
  let P := quarticCurvatureNumerator μ ν r s μ₁ ν₁ r₁ s₁
  let V := P.roots.toFinset
  let c := fun z => (round (ac-deriv φ z),round (bc-φ z+z*deriv φ z))
  let K := ⌊Real.logb 2 (w/l)⌋₊+1
  let lo := fun n : ℕ => max l (l*(2:ℝ)^n)
  let hi := fun n : ℕ => min w (2*(l*(2:ℝ)^n))
  let fiber := fun n j : ℕ => S.filter (fun i =>
    x i∈Icc (lo n) (hi n) ∧ x i∉V ∧ (V.filter (fun z => z<x i)).card=j)
  let labels := fun n j => (fiber n j).image (fun i => c (x i))
  have hv : V.card ≤ 5 := (Multiset.toFinset_card_le _).trans
    ((Polynomial.card_roots' _).trans (quarticCurvatureNumerator_degree μ ν r s μ₁ ν₁ r₁ s₁))
  have hwgt (i) (hiS : i∈S) :
      |bc-φ (x i)+x i*deriv φ (x i)-(bc-φ x₀+x₀*deriv φ x₀)| ≤ 1/2 :=
    quartic_phase_weighted_coefficient_variation hμ hμ₁ hr hr₁ hden hden₁ hheight
      hx₀ (hx i hiS) hcurv
  have hsubI (n : ℕ) : Icc (lo n) (hi n) ⊆ Icc l w := by
    intro z hz
    exact ⟨(le_max_left _ _).trans hz.1,hz.2.trans (min_le_left _ _)⟩
  have hlabels (n j : ℕ) : (labels n j).card ≤ 18 := by
    have hlpos : 0 < lo n := hl.trans_le (le_max_left _ _)
    have hdyad : hi n ≤ 2*lo n := by
      exact (min_le_right _ _).trans
        (mul_le_mul_of_nonneg_left (le_max_right _ _) (by norm_num))
    apply quartic_phase_dyadic_root_cell_coefficient_count (fiber n j) x
      hμ hμ₁ hr hr₁ (fun z hz => hden z (hsubI n hz))
      (fun z hz => hden₁ z (hsubI n hz)) hlpos hdyad hD
    · intro i hiS
      obtain ⟨_,hxi,hvi,hrank⟩ := Finset.mem_filter.mp hiS
      exact ⟨hxi,hvi,hrank⟩
    · intro i hiS
      exact hwgt i (Finset.mem_filter.mp hiS).1
    · intro i hiS
      exact hres i (Finset.mem_filter.mp hiS).1
  have hcover (i) (hiS : i∈S) : ∃ n∈Finset.range K, x i∈Icc (lo n) (hi n) := by
    have hxi := (hx i hiS).1
    have hwpos : 0 < w := hl.trans_le (hx₀.1.1.trans hx₀.1.2)
    obtain ⟨n,hnL,hnU⟩ := exists_nat_pow_near
      ((one_le_div hl).mpr hxi.1) (by norm_num : (1:ℝ) < 2)
    have hlow : l*(2:ℝ)^n ≤ x i := by
      have hh := (le_div_iff₀ hl).mp hnL
      nlinarith only [hh]
    have hupp : x i ≤ 2*(l*(2:ℝ)^n) := by
      have hh := (div_lt_iff₀ hl).mp hnU
      rw [pow_succ] at hh
      nlinarith only [hh]
    have hpw : (2:ℝ)^n ≤ w/l := hnL.trans (div_le_div_of_nonneg_right hxi.2 hl.le)
    have hnlog : (n:ℝ) ≤ Real.logb 2 (w/l) := by
      apply (Real.le_logb_iff_rpow_le (by norm_num : (1:ℝ)<2) (div_pos hwpos hl)).mpr
      simpa only [Real.rpow_natCast] using hpw
    have hn : n < K := by
      have hh := Nat.le_floor hnlog
      dsimp only [K]
      omega
    exact ⟨n,Finset.mem_range.mpr hn,max_le hxi.1 hlow,le_min hxi.2 hupp⟩
  have hsub : S.image (fun i => c (x i)) ⊆
      V.image c ∪ (Finset.range K).biUnion (fun n => (Finset.range 6).biUnion (labels n)) := by
    intro z hz
    obtain ⟨i,hiS,rfl⟩ := Finset.mem_image.mp hz
    by_cases hiv : x i∈V
    · exact Finset.mem_union_left _ (Finset.mem_image_of_mem c hiv)
    · apply Finset.mem_union_right
      obtain ⟨n,hn,hxi⟩ := hcover i hiS
      apply Finset.mem_biUnion.mpr
      refine ⟨n,hn,Finset.mem_biUnion.mpr ?_⟩
      have hrank : (V.filter (fun z => z<x i)).card < 6 :=
        lt_of_le_of_lt (Finset.card_filter_le _ _) (by omega)
      refine ⟨(V.filter (fun z => z<x i)).card,Finset.mem_range.mpr hrank,?_⟩
      exact Finset.mem_image.mpr ⟨i,Finset.mem_filter.mpr ⟨hiS,hxi,hiv,rfl⟩,rfl⟩
  have hroot : (V.image c).card ≤ 5 := (Finset.card_image_le).trans hv
  have hbin (n : ℕ) : ((Finset.range 6).biUnion (labels n)).card ≤ 108 := by
    calc
      _ ≤ ∑ j∈Finset.range 6, (labels n j).card := Finset.card_biUnion_le
      _ ≤ ∑ _j∈Finset.range 6, 18 := Finset.sum_le_sum (fun j _ => hlabels n j)
      _ = 108 := by norm_num
  have hrest : ((Finset.range K).biUnion (fun n => (Finset.range 6).biUnion (labels n))).card ≤
      108*K := by
    calc
      _ ≤ ∑ n∈Finset.range K, ((Finset.range 6).biUnion (labels n)).card := Finset.card_biUnion_le
      _ ≤ ∑ _n∈Finset.range K, 108 := Finset.sum_le_sum (fun n _ => hbin n)
      _ = 108*K := by simp [Nat.mul_comm]
  change (S.image (fun i => c (x i))).card ≤ 5+108*K
  exact (Finset.card_le_card hsub).trans ((Finset.card_union_le _ _).trans (by omega))


