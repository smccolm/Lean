import Tao2026.BadIntervalLargePrimeSum
import Tao2026.SmoothNumberStability
import Tao2026.BadOneTermAsymptotics

/-!
# Smooth-number branches of the non-typical interval estimate

This file begins the remaining smooth-number part of Proposition 6.5.  It
isolates the exact finite reduction used when the distinguished largest prime
`p₀` is small: every point covered by such a normalized interval is itself
smooth at the chosen cutoff, and all points lie below `2x`.
-/

namespace Tao2026

noncomputable section

open Filter Topology

/-- Comparable-scale normalized intervals admitting distinguished data with
`p₀ ≤ y`. -/
noncomputable def taoSmallPrimeFailureIndices (x y : ℕ) :
    Finset (ℕ × ℕ) := by
  classical
  exact (scaleNormalizedBadIntervalIndices x).filter fun NH =>
    ∃ p₀ k m : ℕ,
      IsNormalizedBadInterval NH.1 NH.2 p₀ k m ∧ p₀ ≤ y

/-- The union of all intervals in the small-distinguished-prime branch. -/
noncomputable def taoSmallPrimeFailureUnion (x y : ℕ) : Finset ℕ := by
  classical
  exact (taoSmallPrimeFailureIndices x y).biUnion fun NH =>
    consecutiveInterval NH.1 NH.2

theorem mem_taoSmallPrimeFailureIndices {x y N H : ℕ} :
    (N, H) ∈ taoSmallPrimeFailureIndices x y ↔
      (N, H) ∈ scaleNormalizedBadIntervalIndices x ∧
        ∃ p₀ k m : ℕ,
          IsNormalizedBadInterval N H p₀ k m ∧ p₀ ≤ y := by
  classical
  simp [taoSmallPrimeFailureIndices]

/-- Every point in the small-`p₀` interval union is a positive `y`-smooth
integer at most `2x`. -/
theorem taoSmallPrimeFailureUnion_subset_smoothNumbersUpTo
    (x y : ℕ) :
    taoSmallPrimeFailureUnion x y ⊆
      Nat.smoothNumbersUpTo (2 * x) (y + 1) := by
  classical
  intro n hn
  rw [taoSmallPrimeFailureUnion, Finset.mem_biUnion] at hn
  obtain ⟨NH, hNH, hnInterval⟩ := hn
  have hindex := mem_taoSmallPrimeFailureIndices.mp hNH
  obtain ⟨p₀, k, m, hnorm, hp₀y⟩ := hindex.2
  have hscale := (mem_scaleNormalizedBadIntervalIndices.mp hindex.1).2.2
  obtain ⟨_p, _k, _m, _hnorm, _hleft, hright⟩ := hscale
  rw [mem_smoothNumbersUpTo_source]
  constructor
  · exact (Finset.mem_Ioc.mp hnInterval).2.trans hright
  · have hsmooth := hnorm.isSmooth_of_mem hnInterval
    rw [isSmooth_iff] at hsmooth ⊢
    exact ⟨hsmooth.1, fun q hq hqn =>
      (hsmooth.2 q hq hqn).trans hp₀y⟩

/-- Exact finite cardinality reduction for Tao's small-`p₀` branch. -/
theorem card_taoSmallPrimeFailureUnion_le_psiNat (x y : ℕ) :
    (taoSmallPrimeFailureUnion x y).card ≤ psiNat (2 * x) y := by
  exact Finset.card_le_card
    (taoSmallPrimeFailureUnion_subset_smoothNumbersUpTo x y)

/-! ## Smooth-cofactor covers for the later prime bands -/

/-- All smooth cofactors permitted by the normalized square endpoint
`p₀²m ≤ 2x`. -/
def badIntervalSmoothCofactors (x p₀ : ℕ) : Finset ℕ :=
  Nat.smoothNumbersUpTo (badIntervalCofactorBudget x p₀) (p₀ + 1)

/-- Intervals generated by the smooth cofactors in one endpoint
orientation. -/
def badIntervalSmoothCofactorOrientationCover
    (o : BadIntervalEndpointOrientation) (x p₀ H : ℕ) : Finset ℕ :=
  (badIntervalSmoothCofactors x p₀).biUnion fun m =>
    consecutiveInterval (badIntervalCofactorStart o p₀ H m) H

theorem card_badIntervalSmoothCofactorOrientationCover_le
    (o : BadIntervalEndpointOrientation) (x p₀ H : ℕ) :
    (badIntervalSmoothCofactorOrientationCover o x p₀ H).card ≤
      H * psiNat (badIntervalCofactorBudget x p₀) p₀ := by
  classical
  calc
    (badIntervalSmoothCofactorOrientationCover o x p₀ H).card ≤
        ∑ _m ∈ badIntervalSmoothCofactors x p₀,
          (consecutiveInterval
            (badIntervalCofactorStart o p₀ H _m) H).card := by
      exact Finset.card_biUnion_le
    _ = ∑ _m ∈ badIntervalSmoothCofactors x p₀, H := by
      apply Finset.sum_congr rfl
      intro m hm
      simp [consecutiveInterval]
    _ = H * psiNat (badIntervalCofactorBudget x p₀) p₀ := by
      simp [badIntervalSmoothCofactors, psiNat, Nat.mul_comm]

/-- Every actual fixed-`(p₀,H)` normalized interval is covered by the two
smooth-cofactor endpoint families. -/
theorem scaleNormalizedBadIntervalUnionAt_subset_smoothCofactorCovers
    (x p₀ H : ℕ) :
    scaleNormalizedBadIntervalUnionAt x p₀ H ⊆
      badIntervalSmoothCofactorOrientationCover .first x p₀ H ∪
        badIntervalSmoothCofactorOrientationCover .second x p₀ H := by
  classical
  intro n hn
  rw [scaleNormalizedBadIntervalUnionAt, Finset.mem_biUnion] at hn
  obtain ⟨N, hN, hnInterval⟩ := hn
  obtain ⟨_hNbound, k, m, hnorm, _hleft, hscale⟩ :=
    mem_scaleNormalizedBadIntervalStartsAt.mp hN
  obtain ⟨_hH, _hbad, hpPrime, _hHp, _hpMax, hkMem, hmSmooth,
    hkEq, hkEndpoint, _hpow⟩ := hnorm
  have hmBudget : m ≤ badIntervalCofactorBudget x p₀ := by
    rw [badIntervalCofactorBudget]
    apply (Nat.le_div_iff_mul_le (pow_pos hpPrime.pos 2)).2
    have hkLe : k ≤ 2 * x :=
      (Finset.mem_Ioc.mp hkMem).2.trans hscale
    simpa only [hkEq, Nat.mul_comm] using hkLe
  have hm : m ∈ badIntervalSmoothCofactors x p₀ := by
    rw [badIntervalSmoothCofactors, mem_smoothNumbersUpTo_source]
    exact ⟨hmBudget, hmSmooth⟩
  rcases hkEndpoint with hkFirst | hkSecond
  · have hstart : badIntervalCofactorStart .first p₀ H m = N := by
      simp only [badIntervalCofactorStart]
      omega
    apply Finset.mem_union_left
    rw [badIntervalSmoothCofactorOrientationCover, Finset.mem_biUnion]
    exact ⟨m, hm, by simpa only [hstart] using hnInterval⟩
  · have hstart : badIntervalCofactorStart .second p₀ H m = N := by
      simp only [badIntervalCofactorStart]
      omega
    apply Finset.mem_union_right
    rw [badIntervalSmoothCofactorOrientationCover, Finset.mem_biUnion]
    exact ⟨m, hm, by simpa only [hstart] using hnInterval⟩

/-- Exact fixed-fiber smooth-number reduction used in the remaining
Proposition 6.5 prime bands. -/
theorem card_scaleNormalizedBadIntervalUnionAt_le_smoothCofactors
    (x p₀ H : ℕ) :
    (scaleNormalizedBadIntervalUnionAt x p₀ H).card ≤
      2 * H * psiNat (badIntervalCofactorBudget x p₀) p₀ := by
  calc
    (scaleNormalizedBadIntervalUnionAt x p₀ H).card ≤
        (badIntervalSmoothCofactorOrientationCover .first x p₀ H ∪
          badIntervalSmoothCofactorOrientationCover .second x p₀ H).card :=
      Finset.card_le_card
        (scaleNormalizedBadIntervalUnionAt_subset_smoothCofactorCovers x p₀ H)
    _ ≤ (badIntervalSmoothCofactorOrientationCover .first x p₀ H).card +
        (badIntervalSmoothCofactorOrientationCover .second x p₀ H).card :=
      Finset.card_union_le _ _
    _ ≤ H * psiNat (badIntervalCofactorBudget x p₀) p₀ +
        H * psiNat (badIntervalCofactorBudget x p₀) p₀ :=
      Nat.add_le_add
        (card_badIntervalSmoothCofactorOrientationCover_le .first x p₀ H)
        (card_badIntervalSmoothCofactorOrientationCover_le .second x p₀ H)
    _ = 2 * H * psiNat (badIntervalCofactorBudget x p₀) p₀ := by ring

/-! ## Finite covers for the deficient condition-(iii) branch -/

/-- All lists of elements of `S` having length strictly less than `n`.  This
recursive finite universe will make the fewer-than-1000 factor enumeration
literal rather than existential. -/
def listsOfLengthLT {α : Type*} [DecidableEq α]
    (S : Finset α) : ℕ → Finset (List α)
  | 0 => ∅
  | n + 1 => insert [] (S.biUnion fun a =>
      (listsOfLengthLT S n).image fun l => a :: l)

theorem mem_listsOfLengthLT {α : Type*} [DecidableEq α]
    {S : Finset α} {n : ℕ} {l : List α} :
    l ∈ listsOfLengthLT S n ↔
      l.length < n ∧ ∀ a ∈ l, a ∈ S := by
  induction n generalizing l with
  | zero => simp [listsOfLengthLT]
  | succ n ih =>
      constructor
      · intro hl
        simp only [listsOfLengthLT, Finset.mem_insert, Finset.mem_biUnion,
          Finset.mem_image] at hl
        rcases hl with rfl | ⟨a, ha, t, ht, rfl⟩
        · simp
        · have htData := ih.mp ht
          refine ⟨by simp [htData.1], ?_⟩
          intro b hb
          rcases List.mem_cons.mp hb with rfl | hb
          · exact ha
          · exact htData.2 b hb
      · rintro ⟨hlen, hall⟩
        cases l with
        | nil => simp [listsOfLengthLT]
        | cons a t =>
            have ha : a ∈ S := hall a (by simp)
            have htAll : ∀ b ∈ t, b ∈ S := by
              intro b hb
              exact hall b (by simp [hb])
            have htLen : t.length < n := by
              simp only [List.length_cons] at hlen
              omega
            simp only [listsOfLengthLT, Finset.mem_insert, Finset.mem_biUnion,
              Finset.mem_image]
            exact Or.inr ⟨a, ha, t, ih.mpr ⟨htLen, htAll⟩, rfl⟩

/-- A finite union can be summed with multiplicity on the right when all
summands are nonnegative. -/
theorem sum_biUnion_le_sum_of_nonneg
    {α β : Type*} [DecidableEq α] [DecidableEq β]
    (S : Finset α) (T : α → Finset β) (f : β → ℝ)
    (hf : ∀ b, 0 ≤ f b) :
    (∑ b ∈ S.biUnion T, f b) ≤ ∑ a ∈ S, ∑ b ∈ T a, f b := by
  classical
  induction S using Finset.induction with
  | empty => simp
  | @insert a S ha ih =>
      rw [Finset.biUnion_insert, Finset.sum_insert ha]
      exact (sum_union_le_add_sum_of_nonneg (T a) (S.biUnion T) f hf).trans
        (by simpa [add_comm] using
          (add_le_add_left ih (∑ b ∈ T a, f b)))

/-- Multiplicative real weight of a finite factor list. -/
def realListProductWeight {α : Type*} (w : α → ℝ) (l : List α) : ℝ :=
  (l.map w).prod

@[simp] theorem realListProductWeight_nil {α : Type*} (w : α → ℝ) :
    realListProductWeight w [] = 1 := rfl

@[simp] theorem realListProductWeight_cons {α : Type*}
    (w : α → ℝ) (a : α) (l : List α) :
    realListProductWeight w (a :: l) =
      w a * realListProductWeight w l := rfl

/-- One recursive step of the weighted list enumeration. -/
theorem sum_listsOfLengthLT_weight_succ_le
    {α : Type*} [DecidableEq α] (S : Finset α) (w : α → ℝ)
    (hw : ∀ a, 0 ≤ w a) (n : ℕ) :
    (∑ l ∈ listsOfLengthLT S (n + 1), realListProductWeight w l) ≤
      1 + (∑ a ∈ S, w a) *
        ∑ l ∈ listsOfLengthLT S n, realListProductWeight w l := by
  classical
  let T : α → Finset (List α) := fun a =>
    (listsOfLengthLT S n).image fun l => a :: l
  have hnil : [] ∉ S.biUnion T := by
    simp [T]
  have hweightNonneg : ∀ l : List α, 0 ≤ realListProductWeight w l := by
    intro l
    unfold realListProductWeight
    exact List.prod_nonneg (fun a ha => by
      obtain ⟨b, hb, rfl⟩ := List.mem_map.mp ha
      exact hw b)
  have hbi := sum_biUnion_le_sum_of_nonneg S T
    (realListProductWeight w) hweightNonneg
  have himage (a : α) :
      (∑ l ∈ T a, realListProductWeight w l) =
        w a * ∑ l ∈ listsOfLengthLT S n, realListProductWeight w l := by
    rw [show T a = (listsOfLengthLT S n).image (fun l => a :: l) by rfl]
    rw [Finset.sum_image]
    · rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro l hl
      simp
    · intro l₁ hl₁ l₂ hl₂ heq
      exact (List.cons.inj heq).2
  rw [listsOfLengthLT, Finset.sum_insert hnil]
  simp only [realListProductWeight_nil]
  calc
    1 + ∑ l ∈ S.biUnion T, realListProductWeight w l ≤
        1 + ∑ a ∈ S, ∑ l ∈ T a, realListProductWeight w l :=
      by simpa [add_comm] using add_le_add_left hbi 1
    _ = 1 + (∑ a ∈ S, w a) *
        ∑ l ∈ listsOfLengthLT S n, realListProductWeight w l := by
      simp_rw [himage]
      rw [Finset.sum_mul]

theorem one_add_mul_sum_range_pow (W : ℝ) (n : ℕ) :
    1 + W * (∑ j ∈ Finset.range n, W ^ j) =
      ∑ j ∈ Finset.range (n + 1), W ^ j := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Finset.sum_range_succ, Finset.sum_range_succ, ← ih]
      ring

/-- Weighted mass of all lists of length below `n` is bounded by the finite
geometric series in the one-factor mass. -/
theorem sum_listsOfLengthLT_weight_le_geometric
    {α : Type*} [DecidableEq α] (S : Finset α) (w : α → ℝ)
    (hw : ∀ a, 0 ≤ w a) (n : ℕ) :
    (∑ l ∈ listsOfLengthLT S n, realListProductWeight w l) ≤
      ∑ j ∈ Finset.range n, (∑ a ∈ S, w a) ^ j := by
  induction n with
  | zero => simp [listsOfLengthLT]
  | succ n ih =>
      have hmass : 0 ≤ ∑ a ∈ S, w a :=
        Finset.sum_nonneg fun a ha => hw a
      calc
        (∑ l ∈ listsOfLengthLT S (n + 1), realListProductWeight w l) ≤
            1 + (∑ a ∈ S, w a) *
              ∑ l ∈ listsOfLengthLT S n, realListProductWeight w l :=
          sum_listsOfLengthLT_weight_succ_le S w hw n
        _ ≤ 1 + (∑ a ∈ S, w a) *
              ∑ j ∈ Finset.range n, (∑ a ∈ S, w a) ^ j := by
          simpa [add_comm] using
            add_le_add_left (mul_le_mul_of_nonneg_left ih hmass) 1
        _ = ∑ j ∈ Finset.range (n + 1),
              (∑ a ∈ S, w a) ^ j :=
          one_add_mul_sum_range_pow _ n

/-- Reciprocal weight of a natural factor list equals the reciprocal of its
product after casting to the reals. -/
theorem realListProductWeight_inv_natCast (l : List ℕ) :
    realListProductWeight (fun q : ℕ => ((q : ℝ)⁻¹)) l =
      ((l.prod : ℕ) : ℝ)⁻¹ := by
  induction l with
  | nil => simp
  | cons q l ih =>
      simp only [realListProductWeight_cons, List.prod_cons, Nat.cast_mul, ih]
      rw [mul_inv]

/-- The finite prime alphabet used by the deficient factor lists. -/
def deficientPrimeFactorRange (lowerPrime upperPrime : ℕ) : Finset ℕ :=
  (Finset.range (upperPrime + 1)).filter fun q =>
    q.Prime ∧ lowerPrime ≤ q

theorem mem_deficientPrimeFactorRange
    {lowerPrime upperPrime q : ℕ} :
    q ∈ deficientPrimeFactorRange lowerPrime upperPrime ↔
      q.Prime ∧ lowerPrime ≤ q ∧ q ≤ upperPrime := by
  simp only [deficientPrimeFactorRange, Finset.mem_filter, Finset.mem_range,
    Nat.lt_add_one_iff]
  tauto

/-- Literal finite enumeration of the admissible large-factor lists. -/
def deficientLargeFactorLists (lowerPrime upperPrime : ℕ) :
    Finset (List ℕ) :=
  listsOfLengthLT (deficientPrimeFactorRange lowerPrime upperPrime) 1000

theorem mem_deficientLargeFactorLists
    {lowerPrime upperPrime : ℕ} {qs : List ℕ} :
    qs ∈ deficientLargeFactorLists lowerPrime upperPrime ↔
      qs.length < 1000 ∧
        ∀ q ∈ qs, q.Prime ∧ lowerPrime ≤ q ∧ q ≤ upperPrime := by
  rw [deficientLargeFactorLists, mem_listsOfLengthLT]
  constructor
  · rintro ⟨hlen, hall⟩
    exact ⟨hlen, fun q hq => mem_deficientPrimeFactorRange.mp (hall q hq)⟩
  · rintro ⟨hlen, hall⟩
    exact ⟨hlen, fun q hq => mem_deficientPrimeFactorRange.mpr (hall q hq)⟩

/-- The reciprocal mass of all admissible fewer-than-1000 factor lists is
bounded by the corresponding finite geometric series in the reciprocal-prime
mass. -/
theorem sum_inv_deficientLargeFactorLists_le_geometric
    (lowerPrime upperPrime : ℕ) :
    (∑ qs ∈ deficientLargeFactorLists lowerPrime upperPrime,
        (((qs.prod : ℕ) : ℝ)⁻¹)) ≤
      ∑ j ∈ Finset.range 1000,
        (∑ q ∈ deficientPrimeFactorRange lowerPrime upperPrime,
          ((q : ℝ)⁻¹)) ^ j := by
  have h := sum_listsOfLengthLT_weight_le_geometric
    (deficientPrimeFactorRange lowerPrime upperPrime)
    (fun q : ℕ => ((q : ℝ)⁻¹)) (fun q => inv_nonneg.mpr (Nat.cast_nonneg q))
    1000
  simpa only [deficientLargeFactorLists,
    realListProductWeight_inv_natCast] using h

/-- A deliberately elementary upper bound for the reciprocal mass of the
admissible prime alphabet.  The full Mertens asymptotic is unnecessary here:
the harmonic bound costs only powers of `log upperPrime`, which are
`z(x)^{o(1)}` for the fixed factor-count cutoff. -/
theorem sum_inv_deficientPrimeFactorRange_le_log
    (lowerPrime upperPrime : ℕ) :
    (∑ q ∈ deficientPrimeFactorRange lowerPrime upperPrime,
        ((q : ℝ)⁻¹)) ≤ 1 + Real.log (upperPrime : ℝ) := by
  have hsubset : deficientPrimeFactorRange lowerPrime upperPrime ⊆
      Finset.Icc 1 upperPrime := by
    intro q hq
    obtain ⟨hqPrime, _hqLower, hqUpper⟩ :=
      mem_deficientPrimeFactorRange.mp hq
    exact Finset.mem_Icc.mpr ⟨hqPrime.one_le, hqUpper⟩
  calc
    (∑ q ∈ deficientPrimeFactorRange lowerPrime upperPrime,
        ((q : ℝ)⁻¹)) ≤ ∑ q ∈ Finset.Icc 1 upperPrime, 1 / (q : ℝ) := by
      simpa only [one_div] using
        Finset.sum_le_sum_of_subset_of_nonneg hsubset
          (fun q _hq _hnot => inv_nonneg.mpr (Nat.cast_nonneg q))
    _ = ((harmonic upperPrime : ℚ) : ℝ) :=
      sum_Icc_one_div_natCast_eq_harmonic upperPrime
    _ ≤ 1 + Real.log (upperPrime : ℝ) :=
      harmonic_le_one_add_log upperPrime

/-- Closed polylogarithmic envelope for all fewer-than-1000 reciprocal factor
lists. -/
theorem sum_inv_deficientLargeFactorLists_le_log_pow
    {lowerPrime upperPrime : ℕ} (hupper : 2 ≤ upperPrime) :
    (∑ qs ∈ deficientLargeFactorLists lowerPrime upperPrime,
        (((qs.prod : ℕ) : ℝ)⁻¹)) ≤
      1000 * (1 + Real.log (upperPrime : ℝ)) ^ (999 : ℕ) := by
  let W : ℝ := ∑ q ∈ deficientPrimeFactorRange lowerPrime upperPrime,
    ((q : ℝ)⁻¹)
  let B : ℝ := 1 + Real.log (upperPrime : ℝ)
  have hW0 : 0 ≤ W := Finset.sum_nonneg fun q hq =>
    inv_nonneg.mpr (Nat.cast_nonneg q)
  have hWB : W ≤ B :=
    sum_inv_deficientPrimeFactorRange_le_log lowerPrime upperPrime
  have hlog0 : 0 ≤ Real.log (upperPrime : ℝ) :=
    Real.log_nonneg (by exact_mod_cast (show 1 ≤ upperPrime by omega))
  have hB1 : 1 ≤ B := by dsimp only [B]; linarith
  calc
    (∑ qs ∈ deficientLargeFactorLists lowerPrime upperPrime,
        (((qs.prod : ℕ) : ℝ)⁻¹)) ≤
        ∑ j ∈ Finset.range 1000, W ^ j := by
      simpa only [W] using
        sum_inv_deficientLargeFactorLists_le_geometric lowerPrime upperPrime
    _ ≤ ∑ _j ∈ Finset.range 1000, B ^ (999 : ℕ) := by
      apply Finset.sum_le_sum
      intro j hj
      have hj999 : j ≤ 999 := by
        have := Finset.mem_range.mp hj
        omega
      exact (pow_le_pow_left₀ hW0 hWB j).trans
        (pow_le_pow_right₀ hB1 hj999)
    _ = 1000 * B ^ (999 : ℕ) := by simp
    _ = 1000 * (1 + Real.log (upperPrime : ℝ)) ^ (999 : ℕ) := rfl

/-- Named reciprocal mass, used to keep the 1000-level recursive finite list
universe opaque during later outer summations. -/
noncomputable def deficientFactorReciprocalMass
    (lowerPrime upperPrime : ℕ) : ℝ :=
  ∑ qs ∈ deficientLargeFactorLists lowerPrime upperPrime,
    (((qs.prod : ℕ) : ℝ)⁻¹)

theorem deficientFactorReciprocalMass_le_log_pow
    {lowerPrime upperPrime : ℕ} (hupper : 2 ≤ upperPrime) :
    deficientFactorReciprocalMass lowerPrime upperPrime ≤
      1000 * (1 + Real.log (upperPrime : ℝ)) ^ (999 : ℕ) := by
  exact sum_inv_deficientLargeFactorLists_le_log_pow hupper

theorem sum_inv_deficientLargeFactorLists_le_log_pow_of_le
    {lowerPrime p₀ upperPrime : ℕ} (hpTwo : 2 ≤ p₀)
    (hpUpper : p₀ ≤ upperPrime) :
    (∑ qs ∈ deficientLargeFactorLists lowerPrime p₀,
        (((qs.prod : ℕ) : ℝ)⁻¹)) ≤
      1000 * (1 + Real.log (upperPrime : ℝ)) ^ (999 : ℕ) := by
  have hbase0 : 0 ≤ 1 + Real.log (p₀ : ℝ) := by
    have : 0 ≤ Real.log (p₀ : ℝ) :=
      Real.log_nonneg (by exact_mod_cast (show 1 ≤ p₀ by omega))
    linarith
  have hlog : Real.log (p₀ : ℝ) ≤ Real.log (upperPrime : ℝ) :=
    Real.log_le_log (by positivity) (by exact_mod_cast hpUpper)
  have hbase : 1 + Real.log (p₀ : ℝ) ≤
      1 + Real.log (upperPrime : ℝ) := by linarith
  exact (sum_inv_deficientLargeFactorLists_le_log_pow hpTwo).trans
    (by gcongr)

theorem deficientFactorReciprocalMass_le_log_pow_of_le
    {lowerPrime p₀ upperPrime : ℕ} (hpTwo : 2 ≤ p₀)
    (hpUpper : p₀ ≤ upperPrime) :
    deficientFactorReciprocalMass lowerPrime p₀ ≤
      1000 * (1 + Real.log (upperPrime : ℝ)) ^ (999 : ℕ) := by
  exact sum_inv_deficientLargeFactorLists_le_log_pow_of_le hpTwo hpUpper

/-- Abstract outer reciprocal-square summation.  Separating this lemma keeps
large finite factor enumerations opaque to the kernel. -/
theorem sum_inv_sq_mul_le_of_inner
    {lowerPrime upperPrime : ℕ} (P : Finset ℕ) (F : ℕ → ℝ) (C : ℝ)
    (hlower : 2 ≤ lowerPrime) (hC : 0 ≤ C)
    (hPinterval : P ⊆ Finset.Icc lowerPrime upperPrime)
    (hinner : ∀ p ∈ P, F p ≤ C) :
    (∑ p ∈ P, (1 / (p : ℝ) ^ 2) * F p) ≤
      (1 / ((lowerPrime - 1 : ℕ) : ℝ)) * C := by
  have htailP : (∑ p ∈ P, 1 / (p : ℝ) ^ 2) ≤
      1 / ((lowerPrime - 1 : ℕ) : ℝ) := by
    calc
      (∑ p ∈ P, 1 / (p : ℝ) ^ 2) ≤
          ∑ p ∈ Finset.Icc lowerPrime upperPrime,
            1 / (p : ℝ) ^ 2 :=
        Finset.sum_le_sum_of_subset_of_nonneg hPinterval
          (fun p _hp _hnot => by positivity)
      _ ≤ 1 / ((lowerPrime - 1 : ℕ) : ℝ) :=
        sum_Icc_one_div_nat_sq_le hlower
  calc
    (∑ p ∈ P, (1 / (p : ℝ) ^ 2) * F p) ≤
        ∑ p ∈ P, (1 / (p : ℝ) ^ 2) * C := by
      apply Finset.sum_le_sum
      intro p hp
      exact mul_le_mul_of_nonneg_left (hinner p hp) (by positivity)
    _ = C * ∑ p ∈ P, 1 / (p : ℝ) ^ 2 := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro p hp
      ring
    _ ≤ C * (1 / ((lowerPrime - 1 : ℕ) : ℝ)) :=
      mul_le_mul_of_nonneg_left htailP hC
    _ = (1 / ((lowerPrime - 1 : ℕ) : ℝ)) * C := by ring

/-- After the distinguished-prime square is included, the entire deficient
factor enumeration has the source-shaped reciprocal tail: one inverse power
of the lower cutoff, up to a fixed polylogarithmic factor. -/
theorem sum_inv_sq_mul_deficientFactorLists_le
    {lowerPrime upperPrime : ℕ} (P : Finset ℕ)
    (hlower : 2 ≤ lowerPrime) (hupper : 2 ≤ upperPrime)
    (hP : P ⊆ deficientPrimeFactorRange lowerPrime upperPrime) :
    (∑ p₀ ∈ P, (1 / (p₀ : ℝ) ^ 2) *
        deficientFactorReciprocalMass lowerPrime p₀) ≤
      (1 / ((lowerPrime - 1 : ℕ) : ℝ)) *
        (1000 * (1 + Real.log (upperPrime : ℝ)) ^ (999 : ℕ)) := by
  have hPinterval : P ⊆ Finset.Icc lowerPrime upperPrime := by
    intro p hp
    have hpData := mem_deficientPrimeFactorRange.mp (hP hp)
    exact Finset.mem_Icc.mpr ⟨hpData.2.1, hpData.2.2⟩
  have hlogUpper0 : 0 ≤ Real.log (upperPrime : ℝ) :=
    Real.log_nonneg (by exact_mod_cast (show 1 ≤ upperPrime by omega))
  apply sum_inv_sq_mul_le_of_inner P
    (deficientFactorReciprocalMass lowerPrime)
    (1000 * (1 + Real.log (upperPrime : ℝ)) ^ (999 : ℕ))
    hlower (mul_nonneg (by norm_num) (pow_nonneg (by linarith) _))
    hPinterval
  intro p hp
  have hpData := mem_deficientPrimeFactorRange.mp (hP hp)
  exact deficientFactorReciprocalMass_le_log_pow_of_le
    (hlower.trans hpData.2.1) hpData.2.2

/-- Products of fewer than 1000 primes in the supplied interval, truncated at
the cofactor budget.  Lists are used so that prime multiplicity is retained. -/
noncomputable def deficientLargeFactorProducts
    (budget lowerPrime upperPrime : ℕ) : Finset ℕ := by
  classical
  exact (Finset.range (budget + 1)).filter fun a =>
    ∃ qs : List ℕ,
      qs.length < 1000 ∧ qs.prod = a ∧
        ∀ q ∈ qs, q.Prime ∧ lowerPrime ≤ q ∧ q ≤ upperPrime

theorem mem_deficientLargeFactorProducts
    {budget lowerPrime upperPrime a : ℕ} :
    a ∈ deficientLargeFactorProducts budget lowerPrime upperPrime ↔
      a ≤ budget ∧ ∃ qs : List ℕ,
        qs.length < 1000 ∧ qs.prod = a ∧
          ∀ q ∈ qs, q.Prime ∧ lowerPrime ≤ q ∧ q ≤ upperPrime := by
  classical
  simp [deficientLargeFactorProducts]

/-- Concrete enumeration of the preceding product set by admissible factor
lists.  Different lists with the same product are intentionally collapsed by
`image`. -/
def deficientLargeFactorProductEnumeration
    (budget lowerPrime upperPrime : ℕ) : Finset ℕ :=
  ((deficientLargeFactorLists lowerPrime upperPrime).filter fun qs =>
    qs.prod ≤ budget).image List.prod

theorem deficientLargeFactorProducts_eq_enumeration
    (budget lowerPrime upperPrime : ℕ) :
    deficientLargeFactorProducts budget lowerPrime upperPrime =
      deficientLargeFactorProductEnumeration budget lowerPrime upperPrime := by
  classical
  ext a
  rw [mem_deficientLargeFactorProducts]
  simp only [deficientLargeFactorProductEnumeration, Finset.mem_image,
    Finset.mem_filter]
  constructor
  · rintro ⟨haBudget, qs, hlen, hprod, hall⟩
    refine ⟨qs, ⟨mem_deficientLargeFactorLists.mpr ⟨hlen, hall⟩, ?_⟩, hprod⟩
    simpa only [hprod] using haBudget
  · rintro ⟨qs, ⟨hqs, hprodBudget⟩, hprod⟩
    obtain ⟨hlen, hall⟩ := mem_deficientLargeFactorLists.mp hqs
    exact ⟨by simpa only [hprod] using hprodBudget, qs, hlen, hprod, hall⟩

/-- A nonnegative sum over distinct admissible products is bounded by the
literal sum over all admissible factor lists. -/
theorem sum_deficientLargeFactorProducts_le_lists
    (budget lowerPrime upperPrime : ℕ) (f : ℕ → ℕ) :
    (∑ a ∈ deficientLargeFactorProducts budget lowerPrime upperPrime, f a) ≤
      ∑ qs ∈ deficientLargeFactorLists lowerPrime upperPrime, f qs.prod := by
  classical
  rw [deficientLargeFactorProducts_eq_enumeration,
    deficientLargeFactorProductEnumeration]
  calc
    (∑ a ∈ ((deficientLargeFactorLists lowerPrime upperPrime).filter fun qs =>
        qs.prod ≤ budget).image List.prod, f a) ≤
        ∑ qs ∈ (deficientLargeFactorLists lowerPrime upperPrime).filter
          (fun qs => qs.prod ≤ budget), f qs.prod :=
      Finset.sum_image_le_of_nonneg (fun _ _ => Nat.zero_le _)
    _ ≤ ∑ qs ∈ deficientLargeFactorLists lowerPrime upperPrime, f qs.prod :=
      Finset.sum_le_sum_of_subset (Finset.filter_subset _ _)

/-- The deficient `Psi` target expanded into its literal factor-list sum. -/
theorem sum_psiNat_deficientLargeFactorProducts_le_lists
    (budget lowerPrime upperPrime : ℕ) :
    (∑ a ∈ deficientLargeFactorProducts budget lowerPrime upperPrime,
        psiNat (budget / a) lowerPrime) ≤
      ∑ qs ∈ deficientLargeFactorLists lowerPrime upperPrime,
        psiNat (budget / qs.prod) lowerPrime :=
  sum_deficientLargeFactorProducts_le_lists budget lowerPrime upperPrime
    (fun a => psiNat (budget / a) lowerPrime)

/-- Explicit cofactor cover for the deficient branch: choose the product of
the fewer-than-1000 large prime factors, then choose a lower-cutoff-smooth
remainder in the quotient budget. -/
noncomputable def deficientCofactorProductCover
    (budget lowerPrime upperPrime : ℕ) : Finset ℕ := by
  classical
  exact (deficientLargeFactorProducts budget lowerPrime upperPrime).biUnion
    fun a => (Nat.smoothNumbersUpTo (budget / a) (lowerPrime + 1)).image
      fun r => a * r

/-- Every bounded cofactor carrying a deficient factorization packet belongs
to the explicit product/remainder cover. -/
theorem mem_deficientCofactorProductCover_of_factorization
    {budget lowerPrime upperPrime m : ℕ}
    (hmBudget : m ≤ budget)
    (d : DeficientPrimeFactorization lowerPrime upperPrime m) :
    m ∈ deficientCofactorProductCover budget lowerPrime upperPrime := by
  classical
  have hremPos : 0 < d.remainder :=
    Nat.pos_of_ne_zero (isSmooth_iff.mp d.remainder_smooth).1
  have hprodLeM : d.largeFactors.prod ≤ m := by
    calc
      d.largeFactors.prod ≤ d.largeFactors.prod * d.remainder :=
        Nat.le_mul_of_pos_right d.largeFactors.prod hremPos
      _ = m := d.factorization.symm
  have hprodMem : d.largeFactors.prod ∈
      deficientLargeFactorProducts budget lowerPrime upperPrime := by
    rw [mem_deficientLargeFactorProducts]
    refine ⟨hprodLeM.trans hmBudget, d.largeFactors, d.largeFactors_length_lt,
      rfl, ?_⟩
    intro q hq
    exact ⟨d.largeFactors_prime q hq, d.lower_le_largeFactors q hq,
      d.largeFactors_le_p₀ q hq⟩
  have hprodPos : 0 < d.largeFactors.prod := by
    apply List.prod_pos
    intro q hq
    exact (d.largeFactors_prime q hq).pos
  have hremBudget : d.remainder ≤ budget / d.largeFactors.prod := by
    rw [Nat.le_div_iff_mul_le hprodPos]
    calc
      d.remainder * d.largeFactors.prod =
          d.largeFactors.prod * d.remainder := Nat.mul_comm _ _
      _ = m := d.factorization.symm
      _ ≤ budget := hmBudget
  have hremMem : d.remainder ∈
      Nat.smoothNumbersUpTo (budget / d.largeFactors.prod)
        (lowerPrime + 1) := by
    rw [mem_smoothNumbersUpTo_source]
    exact ⟨hremBudget, d.remainder_smooth⟩
  rw [deficientCofactorProductCover, Finset.mem_biUnion]
  refine ⟨d.largeFactors.prod, hprodMem, ?_⟩
  rw [Finset.mem_image]
  exact ⟨d.remainder, hremMem, d.factorization.symm⟩

/-- Exact finite `Psi` sum controlling the deficient cofactor cover. -/
theorem card_deficientCofactorProductCover_le
    (budget lowerPrime upperPrime : ℕ) :
    (deficientCofactorProductCover budget lowerPrime upperPrime).card ≤
      ∑ a ∈ deficientLargeFactorProducts budget lowerPrime upperPrime,
        psiNat (budget / a) lowerPrime := by
  classical
  calc
    (deficientCofactorProductCover budget lowerPrime upperPrime).card ≤
        ∑ a ∈ deficientLargeFactorProducts budget lowerPrime upperPrime,
          ((Nat.smoothNumbersUpTo (budget / a) (lowerPrime + 1)).image
            fun r => a * r).card := Finset.card_biUnion_le
    _ ≤ ∑ a ∈ deficientLargeFactorProducts budget lowerPrime upperPrime,
          (Nat.smoothNumbersUpTo (budget / a) (lowerPrime + 1)).card := by
      apply Finset.sum_le_sum
      intro a ha
      exact Finset.card_image_le
    _ = ∑ a ∈ deficientLargeFactorProducts budget lowerPrime upperPrime,
          psiNat (budget / a) lowerPrime := by
      simp [psiNat]

/-- Interval cover obtained from every deficient cofactor and one fixed
endpoint orientation. -/
noncomputable def badIntervalDeficientCofactorOrientationCover
    (o : BadIntervalEndpointOrientation)
    (x p₀ H lowerPrime : ℕ) : Finset ℕ := by
  classical
  exact (deficientCofactorProductCover
    (badIntervalCofactorBudget x p₀) lowerPrime p₀).biUnion fun m =>
      consecutiveInterval (badIntervalCofactorStart o p₀ H m) H

/-- A fixed endpoint orientation costs one interval length for each covered
deficient cofactor. -/
theorem card_badIntervalDeficientCofactorOrientationCover_le
    (o : BadIntervalEndpointOrientation) (x p₀ H lowerPrime : ℕ) :
    (badIntervalDeficientCofactorOrientationCover o x p₀ H lowerPrime).card ≤
      H * ∑ a ∈ deficientLargeFactorProducts
        (badIntervalCofactorBudget x p₀) lowerPrime p₀,
          psiNat (badIntervalCofactorBudget x p₀ / a) lowerPrime := by
  classical
  calc
    (badIntervalDeficientCofactorOrientationCover o x p₀ H lowerPrime).card ≤
        ∑ _m ∈ deficientCofactorProductCover
          (badIntervalCofactorBudget x p₀) lowerPrime p₀,
            (consecutiveInterval
              (badIntervalCofactorStart o p₀ H _m) H).card :=
      Finset.card_biUnion_le
    _ = ∑ _m ∈ deficientCofactorProductCover
          (badIntervalCofactorBudget x p₀) lowerPrime p₀, H := by
      apply Finset.sum_congr rfl
      intro m hm
      simp [consecutiveInterval]
    _ = H * (deficientCofactorProductCover
          (badIntervalCofactorBudget x p₀) lowerPrime p₀).card := by
      simp [Nat.mul_comm]
    _ ≤ H * ∑ a ∈ deficientLargeFactorProducts
          (badIntervalCofactorBudget x p₀) lowerPrime p₀,
            psiNat (badIntervalCofactorBudget x p₀ / a) lowerPrime :=
      Nat.mul_le_mul_left H
        (card_deficientCofactorProductCover_le
          (badIntervalCofactorBudget x p₀) lowerPrime p₀)

/-- Fixed starts whose named normalized witness has a deficient cofactor
factorization at `lowerPrime`. -/
noncomputable def deficientScaleNormalizedBadIntervalStartsAt
    (x p₀ H lowerPrime : ℕ) : Finset ℕ := by
  classical
  exact (scaleNormalizedBadIntervalStartsAt x p₀ H).filter fun N =>
    ∃ k m : ℕ,
      IsNormalizedBadInterval N H p₀ k m ∧
        Nonempty (DeficientPrimeFactorization lowerPrime p₀ m)

/-- Union of the fixed-`(p₀,H)` normalized intervals in the deficient
condition-(iii) branch. -/
noncomputable def deficientScaleNormalizedBadIntervalUnionAt
    (x p₀ H lowerPrime : ℕ) : Finset ℕ := by
  classical
  exact (deficientScaleNormalizedBadIntervalStartsAt x p₀ H lowerPrime).biUnion
    fun N => consecutiveInterval N H

/-- The two endpoint orientations cover every fixed deficient fiber. -/
theorem deficientScaleNormalizedBadIntervalUnionAt_subset_covers
    (x p₀ H lowerPrime : ℕ) :
    deficientScaleNormalizedBadIntervalUnionAt x p₀ H lowerPrime ⊆
      badIntervalDeficientCofactorOrientationCover .first x p₀ H lowerPrime ∪
        badIntervalDeficientCofactorOrientationCover .second x p₀ H lowerPrime := by
  classical
  intro n hn
  rw [deficientScaleNormalizedBadIntervalUnionAt, Finset.mem_biUnion] at hn
  obtain ⟨N, hN, hnInterval⟩ := hn
  rw [deficientScaleNormalizedBadIntervalStartsAt, Finset.mem_filter] at hN
  obtain ⟨hstartData, k, m, hnorm, ⟨d⟩⟩ := hN
  obtain ⟨_hNbound, _k, _m, _hnorm, _hleft, hscale⟩ :=
    mem_scaleNormalizedBadIntervalStartsAt.mp hstartData
  obtain ⟨_hH, _hbad, hpPrime, _hHp, _hpMax, hkMem, _hmSmooth,
    hkEq, hkEndpoint, _hpow⟩ := hnorm
  have hmBudget : m ≤ badIntervalCofactorBudget x p₀ := by
    rw [badIntervalCofactorBudget]
    apply (Nat.le_div_iff_mul_le (pow_pos hpPrime.pos 2)).2
    have hkLe : k ≤ 2 * x :=
      (Finset.mem_Ioc.mp hkMem).2.trans hscale
    simpa only [hkEq, Nat.mul_comm] using hkLe
  have hmCover : m ∈ deficientCofactorProductCover
      (badIntervalCofactorBudget x p₀) lowerPrime p₀ :=
    mem_deficientCofactorProductCover_of_factorization hmBudget d
  rcases hkEndpoint with hkFirst | hkSecond
  · have hstart : badIntervalCofactorStart .first p₀ H m = N := by
      simp only [badIntervalCofactorStart]
      omega
    apply Finset.mem_union_left
    rw [badIntervalDeficientCofactorOrientationCover, Finset.mem_biUnion]
    exact ⟨m, hmCover, by simpa only [hstart] using hnInterval⟩
  · have hstart : badIntervalCofactorStart .second p₀ H m = N := by
      simp only [badIntervalCofactorStart]
      omega
    apply Finset.mem_union_right
    rw [badIntervalDeficientCofactorOrientationCover, Finset.mem_biUnion]
    exact ⟨m, hmCover, by simpa only [hstart] using hnInterval⟩

/-- Exact fixed-fiber count for the deficient condition-(iii) branch. -/
theorem card_deficientScaleNormalizedBadIntervalUnionAt_le
    (x p₀ H lowerPrime : ℕ) :
    (deficientScaleNormalizedBadIntervalUnionAt x p₀ H lowerPrime).card ≤
      2 * H * ∑ a ∈ deficientLargeFactorProducts
        (badIntervalCofactorBudget x p₀) lowerPrime p₀,
          psiNat (badIntervalCofactorBudget x p₀ / a) lowerPrime := by
  let S := ∑ a ∈ deficientLargeFactorProducts
    (badIntervalCofactorBudget x p₀) lowerPrime p₀,
      psiNat (badIntervalCofactorBudget x p₀ / a) lowerPrime
  calc
    (deficientScaleNormalizedBadIntervalUnionAt x p₀ H lowerPrime).card ≤
        (badIntervalDeficientCofactorOrientationCover .first x p₀ H lowerPrime ∪
          badIntervalDeficientCofactorOrientationCover .second x p₀ H
            lowerPrime).card :=
      Finset.card_le_card
        (deficientScaleNormalizedBadIntervalUnionAt_subset_covers
          x p₀ H lowerPrime)
    _ ≤ (badIntervalDeficientCofactorOrientationCover .first x p₀ H
          lowerPrime).card +
        (badIntervalDeficientCofactorOrientationCover .second x p₀ H
          lowerPrime).card := Finset.card_union_le _ _
    _ ≤ H * S + H * S := Nat.add_le_add
      (card_badIntervalDeficientCofactorOrientationCover_le
        .first x p₀ H lowerPrime)
      (card_badIntervalDeficientCofactorOrientationCover_le
        .second x p₀ H lowerPrime)
    _ = 2 * H * S := by ring

/-! ## Finite aggregation over prime and dyadic-length ranges -/

/-- Dyadic exponents containing every power-of-two length below the literal
typicality cutoff `⌈log(x)^20⌉`. -/
def badIntervalTypicalDyadicExponents (x : ℕ) : Finset ℕ :=
  Finset.range (Nat.log 2 (taoTypicalLengthCutoff x) + 1)

/-- Actual remaining non-typical indices after the short-length and
square-avoidance conditions have been imposed, with distinguished prime in
`P` and below `upperPrime`. -/
noncomputable def taoDeficientPrimeFailureIndices
    (x squareThreshold lowerPrime upperPrime : ℕ) (P : Finset ℕ) :
    Finset (ℕ × ℕ) := by
  classical
  exact (scaleNormalizedBadIntervalIndices x).filter fun NH =>
    NH.2 < taoTypicalLengthCutoff x ∧
      AvoidsSquareMultiplesAtLeast NH.1 NH.2 squareThreshold ∧
      ∃ p₀ k m : ℕ,
        IsNonTypicalScaleNormalizedBadInterval x (taoTypicalLengthCutoff x)
          squareThreshold lowerPrime upperPrime NH.1 NH.2 p₀ k m ∧
          p₀ ≤ upperPrime ∧ p₀ ∈ P

/-- Actual interval union in the remaining deficient condition-(iii)
branch. -/
noncomputable def taoDeficientPrimeFailureUnion
    (x squareThreshold lowerPrime upperPrime : ℕ) (P : Finset ℕ) : Finset ℕ := by
  classical
  exact (taoDeficientPrimeFailureIndices x squareThreshold lowerPrime
    upperPrime P).biUnion fun NH => consecutiveInterval NH.1 NH.2

/-- Product of the fixed deficient fibers over the supplied prime range and
all short dyadic lengths. -/
noncomputable def deficientBadIntervalPrimeFiberUnion
    (x lowerPrime : ℕ) (P : Finset ℕ) : Finset ℕ := by
  classical
  exact (P.product (badIntervalTypicalDyadicExponents x)).biUnion fun pr =>
    deficientScaleNormalizedBadIntervalUnionAt x pr.1 (2 ^ pr.2) lowerPrime

/-- Every actual remaining condition-(iii) interval is contained in the
explicit deficient fixed-fiber union. -/
theorem taoDeficientPrimeFailureUnion_subset_fiberUnion
    {x squareThreshold lowerPrime upperPrime : ℕ} {P : Finset ℕ} :
    taoDeficientPrimeFailureUnion x squareThreshold lowerPrime upperPrime P ⊆
      deficientBadIntervalPrimeFiberUnion x lowerPrime P := by
  classical
  intro n hn
  rw [taoDeficientPrimeFailureUnion, Finset.mem_biUnion] at hn
  obtain ⟨⟨N, H⟩, hNH, hnInterval⟩ := hn
  rw [taoDeficientPrimeFailureIndices, Finset.mem_filter] at hNH
  obtain ⟨hscaleIndex, hshort, havoid, p₀, k, m, hnon, hpUpper, hpMem⟩ := hNH
  obtain ⟨_hHTwo, _hbad, _hpPrime, _hHltp, _hpMax, _hkMem, _hmSmooth,
    _hkEq, _hkEndpoint, r, hr⟩ := hnon.1
  have hrPowLe : 2 ^ r ≤ taoTypicalLengthCutoff x := by
    simpa [← hr] using Nat.le_of_lt hshort
  have hrLog : r ≤ Nat.log 2 (taoTypicalLengthCutoff x) :=
    Nat.le_log_of_pow_le (by norm_num) hrPowLe
  have hrMem : r ∈ badIntervalTypicalDyadicExponents x := by
    simp [badIntervalTypicalDyadicExponents, hrLog]
  obtain ⟨d⟩ := hnon.exists_deficientPrimeFactorization hshort havoid hpUpper
  have hscaleData := mem_scaleNormalizedBadIntervalIndices.mp hscaleIndex
  have hstartData : N ∈ scaleNormalizedBadIntervalStartsAt x p₀ H := by
    rw [mem_scaleNormalizedBadIntervalStartsAt]
    exact ⟨hscaleData.1, k, m, hnon.1, hnon.2.1, hnon.2.2.1⟩
  have hdefStart : N ∈
      deficientScaleNormalizedBadIntervalStartsAt x p₀ H lowerPrime := by
    rw [deficientScaleNormalizedBadIntervalStartsAt, Finset.mem_filter]
    exact ⟨hstartData, k, m, hnon.1, ⟨d⟩⟩
  rw [deficientBadIntervalPrimeFiberUnion, Finset.mem_biUnion]
  refine ⟨(p₀, r), Finset.mem_product.mpr ⟨hpMem, hrMem⟩, ?_⟩
  rw [deficientScaleNormalizedBadIntervalUnionAt, Finset.mem_biUnion]
  exact ⟨N, by simpa [← hr] using hdefStart,
    by simpa [← hr] using hnInterval⟩

/-- Exact finite double-sum reduction for the actual deficient union. -/
theorem card_taoDeficientPrimeFailureUnion_le_sum
    (x squareThreshold lowerPrime upperPrime : ℕ) (P : Finset ℕ) :
    (taoDeficientPrimeFailureUnion x squareThreshold lowerPrime upperPrime
      P).card ≤
      ∑ p₀ ∈ P, ∑ r ∈ badIntervalTypicalDyadicExponents x,
        2 * 2 ^ r * ∑ a ∈ deficientLargeFactorProducts
          (badIntervalCofactorBudget x p₀) lowerPrime p₀,
            psiNat (badIntervalCofactorBudget x p₀ / a) lowerPrime := by
  classical
  calc
    (taoDeficientPrimeFailureUnion x squareThreshold lowerPrime upperPrime
        P).card ≤ (deficientBadIntervalPrimeFiberUnion x lowerPrime P).card :=
      Finset.card_le_card taoDeficientPrimeFailureUnion_subset_fiberUnion
    _ ≤ ∑ pr ∈ P.product (badIntervalTypicalDyadicExponents x),
          (deficientScaleNormalizedBadIntervalUnionAt
            x pr.1 (2 ^ pr.2) lowerPrime).card := Finset.card_biUnion_le
    _ ≤ ∑ pr ∈ P.product (badIntervalTypicalDyadicExponents x),
          2 * 2 ^ pr.2 * ∑ a ∈ deficientLargeFactorProducts
            (badIntervalCofactorBudget x pr.1) lowerPrime pr.1,
              psiNat (badIntervalCofactorBudget x pr.1 / a) lowerPrime := by
      apply Finset.sum_le_sum
      intro pr hpr
      exact card_deficientScaleNormalizedBadIntervalUnionAt_le
        x pr.1 (2 ^ pr.2) lowerPrime
    _ = ∑ p₀ ∈ P, ∑ r ∈ badIntervalTypicalDyadicExponents x,
          2 * 2 ^ r * ∑ a ∈ deficientLargeFactorProducts
            (badIntervalCofactorBudget x p₀) lowerPrime p₀,
              psiNat (badIntervalCofactorBudget x p₀ / a) lowerPrime := by
      simpa using Finset.sum_product' P (badIntervalTypicalDyadicExponents x)
        (fun p₀ r => 2 * 2 ^ r * ∑ a ∈ deficientLargeFactorProducts
          (badIntervalCofactorBudget x p₀) lowerPrime p₀,
            psiNat (badIntervalCofactorBudget x p₀ / a) lowerPrime)

/-- Union of all normalized fixed fibers over a supplied finite prime set
and every dyadic length below the typicality cutoff. -/
def badIntervalSmoothPrimeFiberUnion (x : ℕ) (P : Finset ℕ) : Finset ℕ :=
  (P.product (badIntervalTypicalDyadicExponents x)).biUnion fun pr =>
    scaleNormalizedBadIntervalUnionAt x pr.1 (2 ^ pr.2)

/-- Actual normalized intervals in the short branch whose named
distinguished prime belongs to `P`. -/
noncomputable def taoShortSmoothPrimeFailureIndices
    (x : ℕ) (P : Finset ℕ) : Finset (ℕ × ℕ) := by
  classical
  exact (scaleNormalizedBadIntervalIndices x).filter fun NH =>
    NH.2 < taoTypicalLengthCutoff x ∧
      ∃ p₀ k m : ℕ,
        IsNormalizedBadInterval NH.1 NH.2 p₀ k m ∧ p₀ ∈ P

/-- Actual interval union belonging to the supplied short smooth-prime
range. -/
noncomputable def taoShortSmoothPrimeFailureUnion
    (x : ℕ) (P : Finset ℕ) : Finset ℕ := by
  classical
  exact (taoShortSmoothPrimeFailureIndices x P).biUnion fun NH =>
    consecutiveInterval NH.1 NH.2

theorem mem_taoShortSmoothPrimeFailureIndices
    {x N H : ℕ} {P : Finset ℕ} :
    (N, H) ∈ taoShortSmoothPrimeFailureIndices x P ↔
      (N, H) ∈ scaleNormalizedBadIntervalIndices x ∧
        H < taoTypicalLengthCutoff x ∧
        ∃ p₀ k m : ℕ,
          IsNormalizedBadInterval N H p₀ k m ∧ p₀ ∈ P := by
  classical
  simp [taoShortSmoothPrimeFailureIndices]

/-- Every actual short interval with distinguished prime in `P` occurs in
the explicit product of fixed fibers. -/
theorem taoShortSmoothPrimeFailureUnion_subset_fiberUnion
    {x : ℕ} {P : Finset ℕ} :
    taoShortSmoothPrimeFailureUnion x P ⊆
      badIntervalSmoothPrimeFiberUnion x P := by
  classical
  intro n hn
  obtain ⟨⟨N, H⟩, hNH, hnInterval⟩ := Finset.mem_biUnion.mp hn
  rw [mem_taoShortSmoothPrimeFailureIndices] at hNH
  obtain ⟨hscale, hshort, p₀, k, m, hnorm, hpMem⟩ := hNH
  have hscaleData := mem_scaleNormalizedBadIntervalIndices.mp hscale
  obtain ⟨_p, _k, _m, _hnorm, hleft, hright⟩ := hscaleData.2.2
  have hstart : N ∈ scaleNormalizedBadIntervalStartsAt x p₀ H :=
    mem_scaleNormalizedBadIntervalStartsAt.mpr
      ⟨hscaleData.1, k, m, hnorm, hleft, hright⟩
  obtain ⟨_hHTwo, _hbad, _hpPrime, _hHltp, _hpMax, _hk, _hm,
      _hkm, _hendpoint, r, hr⟩ := hnorm
  have hrPowLe : 2 ^ r ≤ taoTypicalLengthCutoff x := by
    simpa [← hr] using Nat.le_of_lt hshort
  have hrLog : r ≤ Nat.log 2 (taoTypicalLengthCutoff x) :=
    Nat.le_log_of_pow_le (by norm_num) hrPowLe
  have hrMem : r ∈ badIntervalTypicalDyadicExponents x := by
    simp [badIntervalTypicalDyadicExponents, hrLog]
  rw [badIntervalSmoothPrimeFiberUnion, Finset.mem_biUnion]
  refine ⟨(p₀, r), Finset.mem_product.mpr ⟨hpMem, hrMem⟩, ?_⟩
  rw [scaleNormalizedBadIntervalUnionAt, Finset.mem_biUnion]
  exact ⟨N, by simpa [← hr] using hstart, by simpa [← hr] using hnInterval⟩

/-- Exact finite double-sum reduction over a supplied prime range and the
literal short dyadic lengths. -/
theorem card_badIntervalSmoothPrimeFiberUnion_cast_le_sum
    (x : ℕ) (P : Finset ℕ) :
    ((badIntervalSmoothPrimeFiberUnion x P).card : ℝ) ≤
      ∑ p₀ ∈ P, ∑ r ∈ badIntervalTypicalDyadicExponents x,
        2 * (2 ^ r : ℝ) *
          (psiNat (badIntervalCofactorBudget x p₀) p₀ : ℝ) := by
  classical
  have hunionNat : (badIntervalSmoothPrimeFiberUnion x P).card ≤
      ∑ pr ∈ P.product (badIntervalTypicalDyadicExponents x),
        (scaleNormalizedBadIntervalUnionAt x pr.1 (2 ^ pr.2)).card :=
    Finset.card_biUnion_le
  have hunion : ((badIntervalSmoothPrimeFiberUnion x P).card : ℝ) ≤
      ∑ pr ∈ P.product (badIntervalTypicalDyadicExponents x),
        ((scaleNormalizedBadIntervalUnionAt x pr.1 (2 ^ pr.2)).card : ℝ) := by
    exact_mod_cast hunionNat
  calc
    ((badIntervalSmoothPrimeFiberUnion x P).card : ℝ) ≤
        ∑ pr ∈ P.product (badIntervalTypicalDyadicExponents x),
          ((scaleNormalizedBadIntervalUnionAt x pr.1 (2 ^ pr.2)).card : ℝ) :=
      hunion
    _ ≤ ∑ pr ∈ P.product (badIntervalTypicalDyadicExponents x),
          2 * (2 ^ pr.2 : ℝ) *
            (psiNat (badIntervalCofactorBudget x pr.1) pr.1 : ℝ) := by
      apply Finset.sum_le_sum
      intro pr hpr
      exact_mod_cast
        card_scaleNormalizedBadIntervalUnionAt_le_smoothCofactors
          x pr.1 (2 ^ pr.2)
    _ = ∑ p₀ ∈ P, ∑ r ∈ badIntervalTypicalDyadicExponents x,
          2 * (2 ^ r : ℝ) *
            (psiNat (badIntervalCofactorBudget x p₀) p₀ : ℝ) := by
      simpa using Finset.sum_product' P (badIntervalTypicalDyadicExponents x)
        (fun p₀ r => 2 * (2 ^ r : ℝ) *
          (psiNat (badIntervalCofactorBudget x p₀) p₀ : ℝ))

/-- The same finite double-sum controls the actual normalized union. -/
theorem card_taoShortSmoothPrimeFailureUnion_cast_le_sum
    (x : ℕ) (P : Finset ℕ) :
    ((taoShortSmoothPrimeFailureUnion x P).card : ℝ) ≤
      ∑ p₀ ∈ P, ∑ r ∈ badIntervalTypicalDyadicExponents x,
        2 * (2 ^ r : ℝ) *
          (psiNat (badIntervalCofactorBudget x p₀) p₀ : ℝ) := by
  have hcard : (taoShortSmoothPrimeFailureUnion x P).card ≤
      (badIntervalSmoothPrimeFiberUnion x P).card :=
    Finset.card_le_card taoShortSmoothPrimeFailureUnion_subset_fiberUnion
  have hcardReal : ((taoShortSmoothPrimeFailureUnion x P).card : ℝ) ≤
      ((badIntervalSmoothPrimeFiberUnion x P).card : ℝ) := by
    exact_mod_cast hcard
  exact hcardReal.trans
    (card_badIntervalSmoothPrimeFiberUnion_cast_le_sum x P)

/-- The total of the dyadic lengths below the literal typicality cutoff is
at most twice that cutoff. -/
theorem sum_badIntervalTypicalDyadicExponents_pow_nat_le
    {x : ℕ} (hcutoff : 0 < taoTypicalLengthCutoff x) :
    (∑ r ∈ badIntervalTypicalDyadicExponents x, 2 ^ r) ≤
      2 * taoTypicalLengthCutoff x := by
  have hpowLog :
      2 ^ Nat.log 2 (taoTypicalLengthCutoff x) ≤
        taoTypicalLengthCutoff x :=
    Nat.pow_log_le_self 2 hcutoff.ne'
  rw [badIntervalTypicalDyadicExponents, sum_range_two_pow, pow_succ]
  omega

/-- Real-cast form of the dyadic-length sum. -/
theorem sum_badIntervalTypicalDyadicExponents_pow_le
    {x : ℕ} (hcutoff : 0 < taoTypicalLengthCutoff x) :
    (∑ r ∈ badIntervalTypicalDyadicExponents x, (2 ^ r : ℝ)) ≤
      2 * (taoTypicalLengthCutoff x : ℝ) := by
  exact_mod_cast sum_badIntervalTypicalDyadicExponents_pow_nat_le hcutoff

/-- Closed finite reduction of the actual deficient union to the prime-product
smooth-number sum.  This is the exact analytic target for the final
condition-(iii) estimate. -/
theorem card_taoDeficientPrimeFailureUnion_le
    {x squareThreshold lowerPrime upperPrime : ℕ} (P : Finset ℕ)
    (hcutoff : 0 < taoTypicalLengthCutoff x) :
    (taoDeficientPrimeFailureUnion x squareThreshold lowerPrime upperPrime
      P).card ≤
      4 * taoTypicalLengthCutoff x *
        ∑ p₀ ∈ P, ∑ a ∈ deficientLargeFactorProducts
          (badIntervalCofactorBudget x p₀) lowerPrime p₀,
            psiNat (badIntervalCofactorBudget x p₀ / a) lowerPrime := by
  let S : ℕ → ℕ := fun p₀ =>
    ∑ a ∈ deficientLargeFactorProducts
      (badIntervalCofactorBudget x p₀) lowerPrime p₀,
        psiNat (badIntervalCofactorBudget x p₀ / a) lowerPrime
  have hlength := sum_badIntervalTypicalDyadicExponents_pow_nat_le hcutoff
  calc
    (taoDeficientPrimeFailureUnion x squareThreshold lowerPrime upperPrime
        P).card ≤
        ∑ p₀ ∈ P, ∑ r ∈ badIntervalTypicalDyadicExponents x,
          2 * 2 ^ r * S p₀ := by
      simpa only [S] using card_taoDeficientPrimeFailureUnion_le_sum
        x squareThreshold lowerPrime upperPrime P
    _ = ∑ p₀ ∈ P,
          (2 * (∑ r ∈ badIntervalTypicalDyadicExponents x, 2 ^ r)) *
            S p₀ := by
      apply Finset.sum_congr rfl
      intro p₀ hp₀
      rw [← Finset.sum_mul]
      congr 1
      rw [Finset.mul_sum]
    _ ≤ ∑ p₀ ∈ P, (4 * taoTypicalLengthCutoff x) * S p₀ := by
      apply Finset.sum_le_sum
      intro p₀ hp₀
      apply Nat.mul_le_mul_right
      exact (Nat.mul_le_mul_left 2 hlength).trans_eq (by ring)
    _ = 4 * taoTypicalLengthCutoff x * ∑ p₀ ∈ P, S p₀ := by
      rw [Finset.mul_sum]

/-- List-expanded form of the deficient-union target, ready for grouping by
the number of large prime factors and applying reciprocal-prime estimates. -/
theorem card_taoDeficientPrimeFailureUnion_le_lists
    {x squareThreshold lowerPrime upperPrime : ℕ} (P : Finset ℕ)
    (hcutoff : 0 < taoTypicalLengthCutoff x) :
    (taoDeficientPrimeFailureUnion x squareThreshold lowerPrime upperPrime
      P).card ≤
      4 * taoTypicalLengthCutoff x *
        ∑ p₀ ∈ P, ∑ qs ∈ deficientLargeFactorLists lowerPrime p₀,
          psiNat (badIntervalCofactorBudget x p₀ / qs.prod) lowerPrime := by
  apply (card_taoDeficientPrimeFailureUnion_le P hcutoff).trans
  apply Nat.mul_le_mul_left
  apply Finset.sum_le_sum
  intro p₀ hp₀
  exact sum_psiNat_deficientLargeFactorProducts_le_lists
    (badIntervalCofactorBudget x p₀) lowerPrime p₀

/-- Pointwise smooth-number input needed by Tao's deficient-factor summation.
The saving is separated from the exact reciprocal weights of `p₀²` and the
large-factor list. -/
def DeficientSmoothPointwiseBound
    (x lowerPrime : ℕ) (P : Finset ℕ) (saving : ℝ) : Prop :=
  ∀ p₀ ∈ P, ∀ qs ∈ deficientLargeFactorLists lowerPrime p₀,
    (psiNat (badIntervalCofactorBudget x p₀ / qs.prod) lowerPrime : ℝ) ≤
      saving * (2 * x : ℕ) * (1 / (p₀ : ℝ) ^ 2) *
        (((qs.prod : ℕ) : ℝ)⁻¹)

/-- Real-cast form of the exact deficient list-sum reduction. -/
theorem card_taoDeficientPrimeFailureUnion_cast_le_lists
    {x squareThreshold lowerPrime upperPrime : ℕ} (P : Finset ℕ)
    (hcutoff : 0 < taoTypicalLengthCutoff x) :
    ((taoDeficientPrimeFailureUnion x squareThreshold lowerPrime upperPrime
      P).card : ℝ) ≤
      4 * (taoTypicalLengthCutoff x : ℝ) *
        ∑ p₀ ∈ P, ∑ qs ∈ deficientLargeFactorLists lowerPrime p₀,
          (psiNat (badIntervalCofactorBudget x p₀ / qs.prod)
            lowerPrime : ℝ) := by
  exact_mod_cast card_taoDeficientPrimeFailureUnion_le_lists P hcutoff

/-- Source-shaped closure of the deficient branch from a uniform pointwise
smooth-number estimate.  The remaining losses are exactly one reciprocal
lower-cutoff factor and a fixed power of the upper-cutoff logarithm. -/
theorem card_taoDeficientPrimeFailureUnion_cast_le_of_pointwise
    {x squareThreshold lowerPrime upperPrime : ℕ} (P : Finset ℕ)
    {saving : ℝ} (hsaving : 0 ≤ saving)
    (hcutoff : 0 < taoTypicalLengthCutoff x)
    (hlower : 2 ≤ lowerPrime) (hupper : 2 ≤ upperPrime)
    (hP : P ⊆ deficientPrimeFactorRange lowerPrime upperPrime)
    (hpsi : DeficientSmoothPointwiseBound x lowerPrime P saving) :
    ((taoDeficientPrimeFailureUnion x squareThreshold lowerPrime upperPrime
      P).card : ℝ) ≤
      4 * (taoTypicalLengthCutoff x : ℝ) *
        ((saving * (2 * x : ℕ)) *
          ((1 / ((lowerPrime - 1 : ℕ) : ℝ)) *
            (1000 * (1 + Real.log (upperPrime : ℝ)) ^ (999 : ℕ)))) := by
  have hcard := card_taoDeficientPrimeFailureUnion_cast_le_lists
    (squareThreshold := squareThreshold) (lowerPrime := lowerPrime)
    (upperPrime := upperPrime) P hcutoff
  have hsum :
      (∑ p₀ ∈ P, ∑ qs ∈ deficientLargeFactorLists lowerPrime p₀,
          (psiNat (badIntervalCofactorBudget x p₀ / qs.prod)
            lowerPrime : ℝ)) ≤
        (saving * (2 * x : ℕ)) *
          ∑ p₀ ∈ P, (1 / (p₀ : ℝ) ^ 2) *
            deficientFactorReciprocalMass lowerPrime p₀ := by
    calc
      (∑ p₀ ∈ P, ∑ qs ∈ deficientLargeFactorLists lowerPrime p₀,
          (psiNat (badIntervalCofactorBudget x p₀ / qs.prod)
            lowerPrime : ℝ)) ≤
          ∑ p₀ ∈ P, ∑ qs ∈ deficientLargeFactorLists lowerPrime p₀,
            (saving * (2 * x : ℕ)) * (1 / (p₀ : ℝ) ^ 2) *
              (((qs.prod : ℕ) : ℝ)⁻¹) := by
        apply Finset.sum_le_sum
        intro p₀ hp₀
        apply Finset.sum_le_sum
        intro qs hqs
        exact hpsi p₀ hp₀ qs hqs
      _ = (saving * (2 * x : ℕ)) *
          ∑ p₀ ∈ P, (1 / (p₀ : ℝ) ^ 2) *
            deficientFactorReciprocalMass lowerPrime p₀ := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro p₀ hp₀
        rw [deficientFactorReciprocalMass, Finset.mul_sum, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro qs hqs
        ring
  have hrecip := sum_inv_sq_mul_deficientFactorLists_le
    P hlower hupper hP
  have hmain0 : 0 ≤ saving * (2 * x : ℕ) :=
    mul_nonneg hsaving (Nat.cast_nonneg _)
  exact hcard.trans <| (mul_le_mul_of_nonneg_left hsum (by positivity)).trans <|
    mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_left hrecip hmain0) (by positivity)

/-- Closed finite aggregation: the sum of all short dyadic lengths costs at
most four times the literal typicality cutoff. -/
theorem card_taoShortSmoothPrimeFailureUnion_cast_le
    {x : ℕ} (P : Finset ℕ) (hcutoff : 0 < taoTypicalLengthCutoff x) :
    ((taoShortSmoothPrimeFailureUnion x P).card : ℝ) ≤
      4 * (taoTypicalLengthCutoff x : ℝ) *
        ∑ p₀ ∈ P,
          (psiNat (badIntervalCofactorBudget x p₀) p₀ : ℝ) := by
  have hlength := sum_badIntervalTypicalDyadicExponents_pow_le hcutoff
  calc
    ((taoShortSmoothPrimeFailureUnion x P).card : ℝ) ≤
        ∑ p₀ ∈ P, ∑ r ∈ badIntervalTypicalDyadicExponents x,
          2 * (2 ^ r : ℝ) *
            (psiNat (badIntervalCofactorBudget x p₀) p₀ : ℝ) :=
      card_taoShortSmoothPrimeFailureUnion_cast_le_sum x P
    _ = ∑ p₀ ∈ P,
          (2 * (∑ r ∈ badIntervalTypicalDyadicExponents x, (2 ^ r : ℝ))) *
            (psiNat (badIntervalCofactorBudget x p₀) p₀ : ℝ) := by
      apply Finset.sum_congr rfl
      intro p₀ hp₀
      rw [← Finset.sum_mul]
      congr 1
      rw [Finset.mul_sum]
    _ ≤ ∑ p₀ ∈ P,
          (4 * (taoTypicalLengthCutoff x : ℝ)) *
            (psiNat (badIntervalCofactorBudget x p₀) p₀ : ℝ) := by
      apply Finset.sum_le_sum
      intro p₀ hp₀
      have htwo :
          2 * (∑ r ∈ badIntervalTypicalDyadicExponents x, (2 ^ r : ℝ)) ≤
            4 * (taoTypicalLengthCutoff x : ℝ) := by linarith
      exact mul_le_mul_of_nonneg_right htwo (by positivity)
    _ = 4 * (taoTypicalLengthCutoff x : ℝ) *
          ∑ p₀ ∈ P,
            (psiNat (badIntervalCofactorBudget x p₀) p₀ : ℝ) := by
      rw [Finset.mul_sum]

theorem tendsto_two_mul_nat_atTop :
    Tendsto (fun x : ℕ => 2 * x) atTop atTop := by
  rw [← tendsto_natCast_atTop_iff (R := ℝ)]
  simpa only [Nat.cast_mul, Nat.cast_ofNat] using
    tendsto_natCast_atTop_atTop.const_mul_atTop (by norm_num : (0 : ℝ) < 2)

theorem six_fifths_le_taoOneTermGridExponent_sixty
    {k : ℕ} (hk : 28 ≤ k) :
    (6 / 5 : ℝ) ≤ taoOneTermGridExponent 60 k := by
  have hkReal : (28 : ℝ) ≤ k := by exact_mod_cast hk
  unfold taoOneTermGridExponent
  norm_num
  linarith

/-- On every width-`1/40` grid cell starting at exponent at least `6/5`,
the source exponent `a+1/b` retains a fixed margin above `2`. -/
theorem two_add_one_div_hundred_le_gridExponent_sixty_add_inv_succ
    {k : ℕ} (hk : 28 ≤ k) :
    2 + (1 / 100 : ℝ) ≤
      taoOneTermGridExponent 60 k +
        1 / taoOneTermGridExponent 60 (k + 1) := by
  let a := taoOneTermGridExponent 60 k
  let b := taoOneTermGridExponent 60 (k + 1)
  change 2 + (1 / 100 : ℝ) ≤ a + 1 / b
  have ha : (6 / 5 : ℝ) ≤ a :=
    six_fifths_le_taoOneTermGridExponent_sixty hk
  have hba : b = a + 1 / 40 := by
    have hdiff := taoOneTermGridExponent_succ_sub
      (K := 60) (k := k) (by norm_num)
    dsimp only [a, b]
    norm_num at hdiff ⊢
    linarith
  have hbPos : 0 < b := by
    rw [hba]
    linarith
  have hfactor : 0 ≤ (a - 6 / 5) * (a - 157 / 200) := by
    exact mul_nonneg (by linarith) (by linarith)
  have hmul : (2 + (1 / 100 : ℝ) - a) * b ≤ 1 := by
    rw [hba]
    nlinarith
  have hdiv : 2 + (1 / 100 : ℝ) - a ≤ 1 / b :=
    (le_div_iff₀ hbPos).2 hmul
  linarith

/-- Grid cells from exponent `6/5` through exponent `2`. -/
def taoBadIntervalLargeSmoothGridIndices : Finset ℕ :=
  Finset.Ico 28 60

/-- Prime union for the exponent range from `6/5` through `2`, using the
existing sixty-cell critical smooth-number grid. -/
noncomputable def taoBadIntervalLargeSmoothGridPrimeUnion
    (X : ℕ) : Finset ℕ :=
  taoBadIntervalLargeSmoothGridIndices.biUnion fun k =>
    taoOneTermExponentPrimeBand
      (taoOneTermGridExponent 60 k)
      (taoOneTermGridExponent 60 (k + 1)) X

theorem sum_taoBadIntervalLargeSmoothGridPrimeUnion
    {X : ℕ} (hz : 1 ≤ taoZ X) (f : ℕ → ℝ) :
    (∑ p ∈ taoBadIntervalLargeSmoothGridPrimeUnion X, f p) =
      ∑ k ∈ taoBadIntervalLargeSmoothGridIndices,
        ∑ p ∈ taoOneTermExponentPrimeBand
          (taoOneTermGridExponent 60 k)
          (taoOneTermGridExponent 60 (k + 1)) X, f p := by
  apply Finset.sum_biUnion
  intro i hi j hj hij
  exact disjoint_taoOneTermExponentPrimeBand_grid (by norm_num) hz hij

/-- Each retained large-smooth grid cell has a `z^(-2-1/200)` saving. -/
theorem eventually_sum_psiNat_largeSmoothGridBand_le
    {k : ℕ} (hk : k ∈ taoBadIntervalLargeSmoothGridIndices) :
    ∀ᶠ X : ℕ in atTop,
      (∑ p ∈ taoOneTermExponentPrimeBand
          (taoOneTermGridExponent 60 k)
          (taoOneTermGridExponent 60 (k + 1)) X,
          (psiNat (X / p ^ 2) p : ℝ)) ≤
        (X : ℝ) / (taoZ X) ^ (2 + 1 / 200 : ℝ) := by
  have hkLower : 28 ≤ k := (Finset.mem_Ico.mp hk).1
  filter_upwards [
    eventually_sum_psiNat_gridPrimeBand_le
      (K := 60) (k := k) (by norm_num) (show (0 : ℝ) < 1 / 200 by norm_num),
    tendsto_taoZ_atTop.eventually (eventually_ge_atTop (1 : ℝ))] with
      X hband hz
  have hexponent : (2 + 1 / 200 : ℝ) ≤
      taoOneTermGridExponent 60 k +
        1 / taoOneTermGridExponent 60 (k + 1) - 1 / 200 := by
    have hmargin :=
      two_add_one_div_hundred_le_gridExponent_sixty_add_inv_succ hkLower
    linarith
  have hpow := Real.rpow_le_rpow_of_exponent_le hz hexponent
  exact hband.trans (div_le_div_of_nonneg_left (by positivity)
    (Real.rpow_pos_of_pos (taoZ_pos X) _) hpow)

/-- The large-smooth grid estimate holds simultaneously on all retained
cells. -/
theorem eventually_forall_sum_psiNat_largeSmoothGridBand_le :
    ∀ᶠ X : ℕ in atTop, ∀ k ∈ taoBadIntervalLargeSmoothGridIndices,
      (∑ p ∈ taoOneTermExponentPrimeBand
          (taoOneTermGridExponent 60 k)
          (taoOneTermGridExponent 60 (k + 1)) X,
          (psiNat (X / p ^ 2) p : ℝ)) ≤
        (X : ℝ) / (taoZ X) ^ (2 + 1 / 200 : ℝ) := by
  rw [Filter.eventually_all_finset]
  intro k hk
  exact eventually_sum_psiNat_largeSmoothGridBand_le hk

/-- Summing the 32 retained grid cells preserves the fixed margin above
the critical exponent `2`. -/
theorem eventually_sum_psiNat_largeSmoothGridPrimeUnion_le :
    ∀ᶠ X : ℕ in atTop,
      (∑ p ∈ taoBadIntervalLargeSmoothGridPrimeUnion X,
          (psiNat (X / p ^ 2) p : ℝ)) ≤
        32 * ((X : ℝ) / (taoZ X) ^ (2 + 1 / 200 : ℝ)) := by
  filter_upwards [eventually_forall_sum_psiNat_largeSmoothGridBand_le,
    tendsto_taoZ_atTop.eventually (eventually_ge_atTop (1 : ℝ))] with
      X hbands hz
  calc
    (∑ p ∈ taoBadIntervalLargeSmoothGridPrimeUnion X,
        (psiNat (X / p ^ 2) p : ℝ)) =
        ∑ k ∈ taoBadIntervalLargeSmoothGridIndices,
          ∑ p ∈ taoOneTermExponentPrimeBand
            (taoOneTermGridExponent 60 k)
            (taoOneTermGridExponent 60 (k + 1)) X,
            (psiNat (X / p ^ 2) p : ℝ) :=
      sum_taoBadIntervalLargeSmoothGridPrimeUnion hz _
    _ ≤ ∑ _k ∈ taoBadIntervalLargeSmoothGridIndices,
        ((X : ℝ) / (taoZ X) ^ (2 + 1 / 200 : ℝ)) := by
      apply Finset.sum_le_sum
      intro k hk
      exact hbands k hk
    _ = 32 * ((X : ℝ) / (taoZ X) ^ (2 + 1 / 200 : ℝ)) := by
      simp [taoBadIntervalLargeSmoothGridIndices]

/-- The remaining source prime range from exponent `2` through exponent `3`
is one fixed critical band. -/
theorem eventually_sum_psiNat_largeSmoothTwoToThreeBand_le :
    ∀ᶠ X : ℕ in atTop,
      (∑ p ∈ taoOneTermExponentPrimeBand (2 : ℝ) (3 : ℝ) X,
          (psiNat (X / p ^ 2) p : ℝ)) ≤
        (X : ℝ) / (taoZ X) ^ (2 + 1 / 200 : ℝ) := by
  have hband := eventually_sum_psiNat_exponentPrimeBand_le
    (α := (2 : ℝ)) (β := (3 : ℝ)) (ε := (1 / 4 : ℝ))
    (by norm_num) (by norm_num)
    (eventually_exponentPrimeBand_nonempty (by norm_num) (by norm_num))
    (by norm_num)
  filter_upwards [hband,
    tendsto_taoZ_atTop.eventually (eventually_ge_atTop (1 : ℝ))] with
      X hband' hz
  have hexponent : (2 + 1 / 200 : ℝ) ≤ 2 + 1 / 3 - 1 / 4 := by
    norm_num
  have hpow := Real.rpow_le_rpow_of_exponent_le hz hexponent
  exact hband'.trans (div_le_div_of_nonneg_left (by positivity)
    (Real.rpow_pos_of_pos (taoZ_pos X) _) hpow)

/-- Concrete finite prime range covering exponents from `6/5` through `3`. -/
noncomputable def taoBadIntervalLargeSmoothPrimeRange (X : ℕ) : Finset ℕ :=
  taoBadIntervalLargeSmoothGridPrimeUnion X ∪
    taoOneTermExponentPrimeBand (2 : ℝ) (3 : ℝ) X

/-- The complete fixed large-smooth prime range has a uniform exponent
strictly larger than `2`. -/
theorem eventually_sum_psiNat_largeSmoothPrimeRange_le :
    ∀ᶠ X : ℕ in atTop,
      (∑ p ∈ taoBadIntervalLargeSmoothPrimeRange X,
          (psiNat (X / p ^ 2) p : ℝ)) ≤
        33 * ((X : ℝ) / (taoZ X) ^ (2 + 1 / 200 : ℝ)) := by
  filter_upwards [eventually_sum_psiNat_largeSmoothGridPrimeUnion_le,
    eventually_sum_psiNat_largeSmoothTwoToThreeBand_le] with X hgrid hupper
  let f : ℕ → ℝ := fun p => (psiNat (X / p ^ 2) p : ℝ)
  calc
    (∑ p ∈ taoBadIntervalLargeSmoothPrimeRange X,
        (psiNat (X / p ^ 2) p : ℝ)) ≤
        (∑ p ∈ taoBadIntervalLargeSmoothGridPrimeUnion X, f p) +
          ∑ p ∈ taoOneTermExponentPrimeBand (2 : ℝ) (3 : ℝ) X, f p := by
      exact sum_union_le_add_sum_of_nonneg _ _ f (fun _ => by positivity)
    _ ≤ 32 * ((X : ℝ) / (taoZ X) ^ (2 + 1 / 200 : ℝ)) +
        (X : ℝ) / (taoZ X) ^ (2 + 1 / 200 : ℝ) :=
      add_le_add hgrid hupper
    _ = 33 * ((X : ℝ) / (taoZ X) ^ (2 + 1 / 200 : ℝ)) := by ring

/-- After summing all literal short dyadic lengths, the actual normalized
large-smooth union retains an explicit pre-absorption `z^(-2-1/200)` bound
at ambient scale `2x`. -/
theorem eventually_card_taoShortSmoothPrimeFailureUnion_largeSmooth_le :
    ∀ᶠ x : ℕ in atTop,
      ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalLargeSmoothPrimeRange (2 * x))).card : ℝ) ≤
        132 * (taoTypicalLengthCutoff x : ℝ) *
          ((2 * x : ℕ) / (taoZ (2 * x)) ^ (2 + 1 / 200 : ℝ)) := by
  have hprime := tendsto_two_mul_nat_atTop.eventually
    eventually_sum_psiNat_largeSmoothPrimeRange_le
  filter_upwards [hprime, eventually_ge_atTop (2 : ℕ)] with x hsum hx
  have hcutoff : 0 < taoTypicalLengthCutoff x := by
    have hlog : 0 < Real.log (x : ℝ) := Real.log_pos (by exact_mod_cast hx)
    have hcutoffReal : (0 : ℝ) < taoTypicalLengthCutoff x :=
      (pow_pos hlog 20).trans_le (taoTypicalLengthCutoff_spec x)
    exact_mod_cast hcutoffReal
  have hfinite := card_taoShortSmoothPrimeFailureUnion_cast_le
    (taoBadIntervalLargeSmoothPrimeRange (2 * x)) hcutoff
  have hfinite' :
      ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalLargeSmoothPrimeRange (2 * x))).card : ℝ) ≤
        4 * (taoTypicalLengthCutoff x : ℝ) *
          ∑ p ∈ taoBadIntervalLargeSmoothPrimeRange (2 * x),
            (psiNat ((2 * x) / p ^ 2) p : ℝ) := by
    simpa only [badIntervalCofactorBudget] using hfinite
  calc
    ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalLargeSmoothPrimeRange (2 * x))).card : ℝ) ≤
        4 * (taoTypicalLengthCutoff x : ℝ) *
          ∑ p ∈ taoBadIntervalLargeSmoothPrimeRange (2 * x),
            (psiNat ((2 * x) / p ^ 2) p : ℝ) := hfinite'
    _ ≤ 4 * (taoTypicalLengthCutoff x : ℝ) *
        (33 * ((2 * x : ℕ) /
          (taoZ (2 * x)) ^ (2 + 1 / 200 : ℝ))) := by
      exact mul_le_mul_of_nonneg_left hsum (by positivity)
    _ = 132 * (taoTypicalLengthCutoff x : ℝ) *
        ((2 * x : ℕ) /
          (taoZ (2 * x)) ^ (2 + 1 / 200 : ℝ)) := by ring

/-- Every fixed logarithmic power is negligible compared with a fixed
positive power of `z`; this concrete form absorbs the complete finite
prime-grid and dyadic-length constant. -/
theorem eventually_132_mul_taoTypicalLengthCutoff_le_taoZ_rpow :
    ∀ᶠ X : ℕ in atTop,
      132 * (taoTypicalLengthCutoff X : ℝ) ≤
        (taoZ X) ^ (1 / 400 : ℝ) := by
  have hlogZ : Tendsto (fun X : ℕ => Real.log (taoZ X)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_taoZ_atTop
  have hconst : Tendsto (fun X : ℕ =>
      Real.log 264 / Real.log (taoZ X)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop hlogZ
  have hiter : Tendsto (fun X : ℕ =>
      20 * (iteratedLog X / Real.log (taoZ X))) atTop (𝓝 0) := by
    simpa using
      (tendsto_iteratedLog_div_log_taoZ_zero.const_mul 20)
  filter_upwards [
    hconst.eventually (Iio_mem_nhds (show (0 : ℝ) < 1 / 800 by norm_num)),
    hiter.eventually (Iio_mem_nhds (show (0 : ℝ) < 1 / 800 by norm_num)),
    hlogZ.eventually (eventually_gt_atTop (0 : ℝ)),
    (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop).eventually
      (eventually_ge_atTop (1 : ℝ))] with X hconstBound hiterBound hlogZPos hlogX
  have hPnonneg : 0 ≤ (Real.log X) ^ (20 : ℕ) := by positivity
  have hPpos : 0 < (Real.log X) ^ (20 : ℕ) :=
    pow_pos (zero_lt_one.trans_le hlogX) 20
  have hceil : (taoTypicalLengthCutoff X : ℝ) <
      (Real.log X) ^ (20 : ℕ) + 1 := by
    simpa only [taoTypicalLengthCutoff] using
      Nat.ceil_lt_add_one hPnonneg
  have hPone : 1 ≤ (Real.log X) ^ (20 : ℕ) := by
    exact one_le_pow₀ hlogX
  have hlength : 132 * (taoTypicalLengthCutoff X : ℝ) ≤
      264 * (Real.log X) ^ (20 : ℕ) := by
    nlinarith
  have hconstMul : Real.log 264 <
      (1 / 800 : ℝ) * Real.log (taoZ X) :=
    (div_lt_iff₀ hlogZPos).mp hconstBound
  have hiterDiv :
      (20 * iteratedLog X) / Real.log (taoZ X) < (1 / 800 : ℝ) := by
    calc
      (20 * iteratedLog X) / Real.log (taoZ X) =
          20 * (iteratedLog X / Real.log (taoZ X)) := by ring
      _ < 1 / 800 := hiterBound
  have hiterMul : 20 * iteratedLog X <
      (1 / 800 : ℝ) * Real.log (taoZ X) :=
    (div_lt_iff₀ hlogZPos).mp hiterDiv
  have hlogBound :
      Real.log (264 * (Real.log X) ^ (20 : ℕ)) ≤
        (1 / 400 : ℝ) * Real.log (taoZ X) := by
    rw [Real.log_mul (by norm_num : (264 : ℝ) ≠ 0) hPpos.ne',
      Real.log_pow]
    change Real.log 264 + 20 * iteratedLog X ≤
      (1 / 400 : ℝ) * Real.log (taoZ X)
    linarith
  exact hlength.trans
    (Real.le_rpow_of_log_le (taoZ_pos X) hlogBound)

theorem taoTypicalLengthCutoff_le_two_mul
    {x : ℕ} (hx : 1 ≤ x) :
    taoTypicalLengthCutoff x ≤ taoTypicalLengthCutoff (2 * x) := by
  unfold taoTypicalLengthCutoff
  apply Nat.ceil_mono
  have hxPos : (0 : ℝ) < x := by exact_mod_cast (zero_lt_one.trans_le hx)
  have htwoXPos : (0 : ℝ) < 2 * x := by positivity
  have hxLe : (x : ℝ) ≤ 2 * (x : ℝ) := by
    nlinarith [show (0 : ℝ) ≤ (x : ℝ) by positivity]
  have hlogLe :=
    Real.strictMonoOn_log.monotoneOn hxPos htwoXPos hxLe
  have hpow := pow_le_pow_left₀
    (Real.log_nonneg (by exact_mod_cast hx)) hlogLe 20
  simpa only [Nat.cast_mul, Nat.cast_ofNat] using hpow

/-- The polylogarithmic length factor is absorbed while retaining half of
the explicit large-smooth exponent margin. -/
theorem eventually_card_taoShortSmoothPrimeFailureUnion_largeSmooth_weak :
    ∀ᶠ x : ℕ in atTop,
      ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalLargeSmoothPrimeRange (2 * x))).card : ℝ) ≤
        (2 * x : ℕ) / (taoZ (2 * x)) ^ (2 + 1 / 400 : ℝ) := by
  have habsorb := tendsto_two_mul_nat_atTop.eventually
    eventually_132_mul_taoTypicalLengthCutoff_le_taoZ_rpow
  filter_upwards [
    eventually_card_taoShortSmoothPrimeFailureUnion_largeSmooth_le,
    habsorb, eventually_ge_atTop (1 : ℕ)] with x hunion habsorb' hx
  have hlength : 132 * (taoTypicalLengthCutoff x : ℝ) ≤
      (taoZ (2 * x)) ^ (1 / 400 : ℝ) := by
    calc
      132 * (taoTypicalLengthCutoff x : ℝ) ≤
          132 * (taoTypicalLengthCutoff (2 * x) : ℝ) := by
        gcongr
        exact_mod_cast taoTypicalLengthCutoff_le_two_mul hx
      _ ≤ (taoZ (2 * x)) ^ (1 / 400 : ℝ) := habsorb'
  have hzPos : 0 < taoZ (2 * x) := taoZ_pos _
  have hmainNonneg : 0 ≤ (2 * x : ℕ) := by positivity
  calc
    ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalLargeSmoothPrimeRange (2 * x))).card : ℝ) ≤
        132 * (taoTypicalLengthCutoff x : ℝ) *
          ((2 * x : ℕ) / (taoZ (2 * x)) ^ (2 + 1 / 200 : ℝ)) := hunion
    _ ≤ (taoZ (2 * x)) ^ (1 / 400 : ℝ) *
          ((2 * x : ℕ) / (taoZ (2 * x)) ^ (2 + 1 / 200 : ℝ)) := by
      gcongr
    _ = (2 * x : ℕ) / (taoZ (2 * x)) ^ (2 + 1 / 400 : ℝ) := by
      rw [show (2 + 1 / 200 : ℝ) = 1 / 400 + (2 + 1 / 400) by norm_num,
        Real.rpow_add hzPos]
      field_simp [ne_of_gt (Real.rpow_pos_of_pos hzPos (1 / 400 : ℝ))]

/-- Tao's `z` scale is eventually monotone under the fixed dilation `x ↦ 2x`.
This finite comparison avoids replacing the source scale by an asymptotic
equivalent in the final exceptional-set estimate. -/
theorem eventually_taoZ_le_taoZ_two_mul :
    ∀ᶠ x : ℕ in atTop, taoZ x ≤ taoZ (2 * x) := by
  have hlogTop : Tendsto (fun x : ℕ => Real.log x) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  filter_upwards [hlogTop.eventually (eventually_ge_atTop (1 : ℝ))] with
      x hlogX
  have hxPos : (0 : ℝ) < x := by
    have : (0 : ℝ) < Real.log x := zero_lt_one.trans_le hlogX
    exact zero_lt_one.trans ((Real.log_pos_iff (Nat.cast_nonneg x)).mp this)
  have htwoXPos : (0 : ℝ) < (2 * x : ℕ) := by
    exact_mod_cast (mul_pos (by norm_num : 0 < 2) (by exact_mod_cast hxPos))
  have hxLe : (x : ℝ) ≤ (2 * x : ℕ) := by
    exact_mod_cast (by omega : x ≤ 2 * x)
  have hlogLe : Real.log x ≤ Real.log (2 * x : ℕ) :=
    Real.strictMonoOn_log.monotoneOn hxPos htwoXPos hxLe
  have hlogTwoPos : 0 < Real.log (2 * x : ℕ) :=
    (zero_lt_one.trans_le hlogX).trans_le hlogLe
  have hiterLe : iteratedLog x ≤ iteratedLog (2 * x) := by
    unfold iteratedLog
    exact Real.strictMonoOn_log.monotoneOn
      (zero_lt_one.trans_le hlogX) hlogTwoPos hlogLe
  have hsqrtLogLe : Real.sqrt (Real.log x) ≤
      Real.sqrt (Real.log (2 * x : ℕ)) := Real.sqrt_le_sqrt hlogLe
  have hsqrtIterLe : Real.sqrt (iteratedLog x) ≤
      Real.sqrt (iteratedLog (2 * x)) := Real.sqrt_le_sqrt hiterLe
  have hsqrtLogNonneg : 0 ≤ Real.sqrt (Real.log x) := Real.sqrt_nonneg _
  have hsqrtIterNonneg : 0 ≤ Real.sqrt (iteratedLog x) := Real.sqrt_nonneg _
  have hproduct :
      Real.sqrt (Real.log x) * Real.sqrt (iteratedLog x) ≤
        Real.sqrt (Real.log (2 * x : ℕ)) * Real.sqrt (iteratedLog (2 * x)) :=
    mul_le_mul hsqrtLogLe hsqrtIterLe hsqrtIterNonneg
      (Real.sqrt_nonneg _)
  rw [taoZ, taoZ]
  apply Real.exp_le_exp.mpr
  calc
    (1 / Real.sqrt 2) * Real.sqrt (Real.log x) *
        Real.sqrt (iteratedLog x) =
      (1 / Real.sqrt 2) *
        (Real.sqrt (Real.log x) * Real.sqrt (iteratedLog x)) := by ring
    _ ≤ (1 / Real.sqrt 2) *
        (Real.sqrt (Real.log (2 * x : ℕ)) *
          Real.sqrt (iteratedLog (2 * x))) :=
      mul_le_mul_of_nonneg_left hproduct (by positivity)
    _ = (1 / Real.sqrt 2) * Real.sqrt (Real.log (2 * x : ℕ)) *
        Real.sqrt (iteratedLog (2 * x)) := by ring

/-- Source-scale form of the large-smooth disposal: the actual normalized
union has the acceptable fixed saving `x/z(x)^(2+1/800)`. -/
theorem eventually_card_taoShortSmoothPrimeFailureUnion_largeSmooth_source :
    ∀ᶠ x : ℕ in atTop,
      ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalLargeSmoothPrimeRange (2 * x))).card : ℝ) ≤
        (x : ℝ) / (taoZ x) ^ (2 + 1 / 800 : ℝ) := by
  have hzPowerTop : Tendsto (fun z : ℝ => z ^ (1 / 800 : ℝ)) atTop atTop :=
    tendsto_rpow_atTop (by norm_num)
  filter_upwards [
    eventually_card_taoShortSmoothPrimeFailureUnion_largeSmooth_weak,
    eventually_taoZ_le_taoZ_two_mul,
    (hzPowerTop.comp tendsto_taoZ_atTop).eventually
      (eventually_ge_atTop (2 : ℝ))] with x hunion hzMono hzPower
  have hzPos : 0 < taoZ x := taoZ_pos x
  have hzTwoPos : 0 < taoZ (2 * x) := taoZ_pos _
  have hexponentPos : 0 ≤ (2 + 1 / 400 : ℝ) := by norm_num
  have hpowMono : (taoZ x) ^ (2 + 1 / 400 : ℝ) ≤
      (taoZ (2 * x)) ^ (2 + 1 / 400 : ℝ) :=
    Real.rpow_le_rpow hzPos.le hzMono hexponentPos
  have hscale :
      (2 * x : ℕ) / (taoZ (2 * x)) ^ (2 + 1 / 400 : ℝ) ≤
        (2 * (x : ℝ)) / (taoZ x) ^ (2 + 1 / 400 : ℝ) := by
    have hfirst := div_le_div_of_nonneg_left
      (show (0 : ℝ) ≤ (2 * x : ℕ) by positivity)
      (Real.rpow_pos_of_pos hzPos _) hpowMono
    simpa only [Nat.cast_mul, Nat.cast_ofNat] using hfirst
  have hcoeff : (2 : ℝ) / (taoZ x) ^ (1 / 800 : ℝ) ≤ 1 :=
    (div_le_one (Real.rpow_pos_of_pos hzPos _)).2 hzPower
  calc
    ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalLargeSmoothPrimeRange (2 * x))).card : ℝ) ≤
        (2 * x : ℕ) / (taoZ (2 * x)) ^ (2 + 1 / 400 : ℝ) := hunion
    _ ≤ (2 * (x : ℝ)) / (taoZ x) ^ (2 + 1 / 400 : ℝ) := hscale
    _ = ((2 : ℝ) / (taoZ x) ^ (1 / 800 : ℝ)) *
        ((x : ℝ) / (taoZ x) ^ (2 + 1 / 800 : ℝ)) := by
      rw [show (2 + 1 / 400 : ℝ) =
        1 / 800 + (2 + 1 / 800) by norm_num, Real.rpow_add hzPos]
      field_simp [ne_of_gt (Real.rpow_pos_of_pos hzPos (1 / 800 : ℝ)),
        ne_of_gt (Real.rpow_pos_of_pos hzPos (2 + 1 / 800 : ℝ))]
    _ ≤ 1 * ((x : ℝ) / (taoZ x) ^ (2 + 1 / 800 : ℝ)) := by
      exact mul_le_mul_of_nonneg_right hcoeff (by positivity)
    _ = (x : ℝ) / (taoZ x) ^ (2 + 1 / 800 : ℝ) := one_mul _

/-- The existing finite exponent grid, evaluated at the exact cofactor
ambient scale `2x`, bounds the corresponding actual short interval union. -/
theorem eventually_card_taoShortSmoothPrimeFailureUnion_grid_le
    {K : ℕ} (hK : 0 < K) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ x : ℕ in atTop,
      ((taoShortSmoothPrimeFailureUnion x
        (taoOneTermGridPrimeUnion K (2 * x))).card : ℝ) ≤
        4 * (taoTypicalLengthCutoff x : ℝ) *
          ((K : ℝ) * ((2 * x : ℕ) /
            (taoZ (2 * x)) ^ (2 - 6 / (K : ℝ) - ε))) := by
  have hgrid := tendsto_two_mul_nat_atTop.eventually
    (eventually_sum_psiNat_gridPrimeUnion_le hK hε)
  filter_upwards [hgrid, eventually_ge_atTop (2 : ℕ)] with x hsum hx
  have hcutoff : 0 < taoTypicalLengthCutoff x := by
    have hlog : 0 < Real.log (x : ℝ) := Real.log_pos (by exact_mod_cast hx)
    have hcutoffReal : (0 : ℝ) < taoTypicalLengthCutoff x :=
      (pow_pos hlog 20).trans_le (taoTypicalLengthCutoff_spec x)
    exact_mod_cast hcutoffReal
  have hfinite := card_taoShortSmoothPrimeFailureUnion_cast_le
    (taoOneTermGridPrimeUnion K (2 * x)) hcutoff
  have hfinite' :
      ((taoShortSmoothPrimeFailureUnion x
        (taoOneTermGridPrimeUnion K (2 * x))).card : ℝ) ≤
        4 * (taoTypicalLengthCutoff x : ℝ) *
          ∑ p₀ ∈ taoOneTermGridPrimeUnion K (2 * x),
            (psiNat ((2 * x) / p₀ ^ 2) p₀ : ℝ) := by
    simpa only [badIntervalCofactorBudget] using hfinite
  exact hfinite'.trans
    (mul_le_mul_of_nonneg_left hsum (by positivity))

/-! ## Literal source-scale large-smooth branch -/

theorem taoNaturalDilation_two (x : ℕ) :
    taoNaturalDilation 2 x = 2 * x := by
  unfold taoNaturalDilation
  rw [show (2 : ℝ) * (x : ℝ) = ((2 * x : ℕ) : ℝ) by norm_num]
  exact Nat.floor_natCast (R := ℝ) (2 * x)

/-- Multiplication of the ambient natural scale by two does not change its
logarithmic exponent. -/
theorem tendsto_log_two_mul_div_log_nat :
    Tendsto (fun x : ℕ => Real.log (2 * x : ℕ) / Real.log x)
      atTop (nhds 1) := by
  simpa only [taoNaturalDilation_two] using
    (tendsto_log_taoNaturalDilation_div_log_nat
      (c := (2 : ℝ)) (by norm_num))

/-- The same fixed dilation is invisible after taking two logarithms. -/
theorem tendsto_iteratedLog_two_mul_div_iteratedLog :
    Tendsto (fun x : ℕ => iteratedLog (2 * x) / iteratedLog x)
      atTop (nhds 1) := by
  have hlogRatio := tendsto_log_two_mul_div_log_nat
  have hlogLogRatio : Tendsto (fun x : ℕ =>
      Real.log (Real.log (2 * x : ℕ) / Real.log x)) atTop (nhds 0) := by
    simpa using hlogRatio.log
  have hdiff : Tendsto (fun x : ℕ =>
      iteratedLog (2 * x) - iteratedLog x) atTop (nhds 0) := by
    apply hlogLogRatio.congr'
    filter_upwards [
      (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop).eventually
        (eventually_gt_atTop (0 : ℝ))] with x hlogPos
    change 0 < Real.log (x : ℝ) at hlogPos
    have hxOneReal : (1 : ℝ) < x :=
      (Real.log_pos_iff (Nat.cast_nonneg x)).mp hlogPos
    have hxOne : 1 < x := by exact_mod_cast hxOneReal
    have hlogTwoPos : 0 < Real.log (2 * x : ℕ) :=
      Real.log_pos (by exact_mod_cast (show (1 : ℕ) < 2 * x by omega))
    rw [Real.log_div hlogTwoPos.ne' hlogPos.ne']
    simp only [iteratedLog]
  have hsmall := hdiff.div_atTop tendsto_iteratedLog_atTop
  have hsum := hsmall.add (tendsto_const_nhds :
    Tendsto (fun _ : ℕ => (1 : ℝ)) atTop (nhds 1))
  have hsum' : Tendsto (fun x : ℕ =>
      (iteratedLog (2 * x) - iteratedLog x) / iteratedLog x + 1)
      atTop (nhds 1) := by simpa using hsum
  apply hsum'.congr'
  filter_upwards [tendsto_iteratedLog_atTop.eventually
      (eventually_gt_atTop (0 : ℝ))] with x hiterPos
  field_simp [hiterPos.ne']
  ring

/-- Tao's saddle scale is slowly varying under `x ↦ 2x`, at its exact
logarithmic scale. -/
theorem tendsto_log_taoZ_two_mul_div_log_taoZ :
    Tendsto (fun x : ℕ =>
      Real.log (taoZ (2 * x)) / Real.log (taoZ x)) atTop (nhds 1) := by
  have hlogSqrt := tendsto_log_two_mul_div_log_nat.sqrt
  have hiterSqrt :=
    tendsto_iteratedLog_two_mul_div_iteratedLog.sqrt
  have hproduct := hlogSqrt.mul hiterSqrt
  have hproduct' : Tendsto (fun x : ℕ =>
      Real.sqrt (Real.log (2 * x : ℕ) / Real.log x) *
        Real.sqrt (iteratedLog (2 * x) / iteratedLog x))
      atTop (nhds 1) := by simpa using hproduct
  apply hproduct'.congr'
  filter_upwards [
    (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop).eventually
      (eventually_gt_atTop (0 : ℝ)),
    tendsto_iteratedLog_atTop.eventually
      (eventually_gt_atTop (0 : ℝ))] with x hlogPos hiterPos
  change 0 < Real.log (x : ℝ) at hlogPos
  have hxOneReal : (1 : ℝ) < x :=
    (Real.log_pos_iff (Nat.cast_nonneg x)).mp hlogPos
  have hxOne : 1 < x := by exact_mod_cast hxOneReal
  have hlogTwoPos : 0 < Real.log (2 * x : ℕ) :=
    Real.log_pos (by exact_mod_cast (show (1 : ℕ) < 2 * x by omega))
  have hiterTwoPos : 0 < iteratedLog (2 * x) := by
    unfold iteratedLog at hiterPos ⊢
    have hlogLe : Real.log (x : ℝ) ≤ Real.log (2 * x : ℕ) :=
      Real.strictMonoOn_log.monotoneOn
        (by positivity : (0 : ℝ) < x)
        (by positivity : (0 : ℝ) < (2 * x : ℕ))
        (by exact_mod_cast (show x ≤ 2 * x by omega))
    exact hiterPos.trans_le
      (Real.strictMonoOn_log.monotoneOn hlogPos hlogTwoPos hlogLe)
  rw [log_taoZ, log_taoZ, Real.sqrt_div hlogTwoPos.le,
    Real.sqrt_div hiterTwoPos.le]
  have hsqrtTwo : Real.sqrt (2 : ℝ) ≠ 0 := by positivity
  have hsqrtLog : Real.sqrt (Real.log x) ≠ 0 := by positivity
  have hsqrtIter : Real.sqrt (iteratedLog x) ≠ 0 := by positivity
  field_simp [hsqrtTwo, hsqrtLog, hsqrtIter]

/-- A small fixed exponent slack transfers the lower prime cutoff from the
source scale `x` to the exact cofactor scale `2x`. -/
theorem eventually_exponentCutoff_six_fifths_two_mul_le_five_fourths :
    ∀ᶠ x : ℕ in atTop,
      taoOneTermExponentCutoff (6 / 5 : ℝ) (2 * x) ≤
        taoOneTermExponentCutoff (5 / 4 : ℝ) x := by
  filter_upwards [
    tendsto_log_taoZ_two_mul_div_log_taoZ.eventually
      (Iio_mem_nhds (show (1 : ℝ) < 25 / 24 by norm_num)),
    (Real.tendsto_log_atTop.comp tendsto_taoZ_atTop).eventually
      (eventually_gt_atTop (0 : ℝ))] with x hratio hlogZPos
  change 0 < Real.log (taoZ x) at hlogZPos
  have hlogCompare :
      (6 / 5 : ℝ) * Real.log (taoZ (2 * x)) ≤
        (5 / 4 : ℝ) * Real.log (taoZ x) := by
    have hstrict := (div_lt_iff₀ hlogZPos).mp hratio
    nlinarith
  unfold taoOneTermExponentCutoff
  apply Nat.ceil_mono
  rw [Real.rpow_def_of_pos (taoZ_pos _),
    Real.rpow_def_of_pos (taoZ_pos _)]
  apply Real.exp_le_exp.mpr
  nlinarith

theorem taoOneTermGridExponent_sixty_twenty_eight :
    taoOneTermGridExponent 60 28 = (6 / 5 : ℝ) := by
  norm_num [taoOneTermGridExponent]

theorem taoOneTermGridExponent_sixty_sixty :
    taoOneTermGridExponent 60 60 = (2 : ℝ) := by
  norm_num [taoOneTermGridExponent]

/-- The 32 retained grid cells together with the final `[2,3]` cell cover
the single rounded exponent band `(6/5,3]`. -/
theorem exponentPrimeBand_six_fifths_three_subset_largeSmoothPrimeRange
    {X : ℕ} :
    taoOneTermExponentPrimeBand (6 / 5 : ℝ) (3 : ℝ) X ⊆
      taoBadIntervalLargeSmoothPrimeRange X := by
  intro p hp
  have hpData := Finset.mem_filter.mp hp
  have hpBase := hpData.1
  have hpLower := hpData.2.1
  have hpUpper := hpData.2.2
  by_cases hpTwo : p ≤ taoOneTermExponentCutoff (2 : ℝ) X
  · have hexists : ∃ j : ℕ, 28 ≤ j ∧
        p ≤ taoOneTermExponentCutoff (taoOneTermGridExponent 60 j) X := by
      refine ⟨60, by norm_num, ?_⟩
      simpa only [taoOneTermGridExponent_sixty_sixty] using hpTwo
    let j := Nat.find hexists
    have hjSpec : 28 ≤ j ∧
        p ≤ taoOneTermExponentCutoff (taoOneTermGridExponent 60 j) X :=
      Nat.find_spec hexists
    have hjLe : j ≤ 60 := Nat.find_min' hexists ⟨by norm_num, by
      simpa only [taoOneTermGridExponent_sixty_sixty] using hpTwo⟩
    have hjGt : 28 < j := by
      have hjNe : j ≠ 28 := by
        intro hj
        rw [hj, taoOneTermGridExponent_sixty_twenty_eight] at hjSpec
        omega
      omega
    let k := j - 1
    have hkMem : k ∈ taoBadIntervalLargeSmoothGridIndices := by
      rw [taoBadIntervalLargeSmoothGridIndices, Finset.mem_Ico]
      dsimp only [k]
      omega
    have hkj : k + 1 = j := by
      dsimp only [k]
      omega
    have hkLower : taoOneTermExponentCutoff
        (taoOneTermGridExponent 60 k) X < p := by
      have hkNot := Nat.find_min hexists (show k < j by
        dsimp only [k]
        omega)
      have hkGe : 28 ≤ k := (Finset.mem_Ico.mp hkMem).1
      by_contra hnot
      exact hkNot ⟨hkGe, Nat.le_of_not_gt hnot⟩
    have hkUpper : p ≤ taoOneTermExponentCutoff
        (taoOneTermGridExponent 60 (k + 1)) X := by
      rw [hkj]
      exact hjSpec.2
    have hpCell : p ∈ taoOneTermExponentPrimeBand
        (taoOneTermGridExponent 60 k)
        (taoOneTermGridExponent 60 (k + 1)) X :=
      Finset.mem_filter.mpr ⟨hpBase, hkLower, hkUpper⟩
    apply Finset.mem_union_left
    rw [taoBadIntervalLargeSmoothGridPrimeUnion, Finset.mem_biUnion]
    exact ⟨k, hkMem, hpCell⟩
  · apply Finset.mem_union_right
    exact Finset.mem_filter.mpr ⟨hpBase, by omega, hpUpper⟩

theorem taoOneTermExponentCutoff_three_eq_taoTypicalSquareThreshold
    (x : ℕ) :
    taoOneTermExponentCutoff (3 : ℝ) x = taoTypicalSquareThreshold x := by
  simp only [taoOneTermExponentCutoff, taoTypicalSquareThreshold]
  norm_num [Real.rpow_natCast]

/-- Literal source branch after the small-prime disposal and condition (ii):
`p₀` lies above `z(x)^(5/4)` and at most `⌈z(x)^3⌉`. -/
noncomputable def taoBadIntervalSourceLargeSmoothPrimeRange
    (x : ℕ) : Finset ℕ :=
  ((Finset.Icc 2 (2 * x).sqrt).filter Nat.Prime).filter fun p =>
    taoOneTermExponentCutoff (5 / 4 : ℝ) x < p ∧
      p ≤ taoTypicalSquareThreshold x

/-- Eventually the literal source branch is covered by the concrete
60-cell large-smooth range at the exact cofactor scale `2x`. -/
theorem eventually_sourceLargeSmoothPrimeRange_subset :
    ∀ᶠ x : ℕ in atTop,
      taoBadIntervalSourceLargeSmoothPrimeRange x ⊆
        taoBadIntervalLargeSmoothPrimeRange (2 * x) := by
  filter_upwards [
    eventually_exponentCutoff_six_fifths_two_mul_le_five_fourths,
    eventually_taoZ_le_taoZ_two_mul] with x hlower hzMono
  intro p hp
  have hpData := Finset.mem_filter.mp hp
  have hpBase := hpData.1
  have hpLower : taoOneTermExponentCutoff (6 / 5 : ℝ) (2 * x) < p :=
    lt_of_le_of_lt hlower hpData.2.1
  have hupperCut : taoOneTermExponentCutoff (3 : ℝ) x ≤
      taoOneTermExponentCutoff (3 : ℝ) (2 * x) := by
    unfold taoOneTermExponentCutoff
    apply Nat.ceil_mono
    exact Real.rpow_le_rpow (taoZ_pos x).le hzMono (by norm_num)
  have hpUpper : p ≤ taoOneTermExponentCutoff (3 : ℝ) (2 * x) := by
    rw [taoOneTermExponentCutoff_three_eq_taoTypicalSquareThreshold] at hupperCut
    exact hpData.2.2.trans hupperCut
  exact exponentPrimeBand_six_fifths_three_subset_largeSmoothPrimeRange
    (Finset.mem_filter.mpr ⟨hpBase, hpLower, hpUpper⟩)

theorem taoShortSmoothPrimeFailureUnion_mono
    {x : ℕ} {P Q : Finset ℕ} (hPQ : P ⊆ Q) :
    taoShortSmoothPrimeFailureUnion x P ⊆
      taoShortSmoothPrimeFailureUnion x Q := by
  intro n hn
  rw [taoShortSmoothPrimeFailureUnion, Finset.mem_biUnion] at hn ⊢
  obtain ⟨NH, hNH, hn⟩ := hn
  refine ⟨NH, ?_, hn⟩
  rw [mem_taoShortSmoothPrimeFailureIndices] at hNH ⊢
  obtain ⟨p, k, m, hnorm, hp⟩ := hNH.2.2
  exact ⟨hNH.1, hNH.2.1, p, k, m, hnorm, hPQ hp⟩

/-- Final source-scale estimate for the actual short normalized intervals
whose distinguished prime lies in the literal fixed large-smooth branch. -/
theorem eventually_card_taoSourceLargeSmoothPrimeFailureUnion_le :
    ∀ᶠ x : ℕ in atTop,
      ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalSourceLargeSmoothPrimeRange x)).card : ℝ) ≤
        (x : ℝ) / (taoZ x) ^ (2 + 1 / 800 : ℝ) := by
  filter_upwards [eventually_sourceLargeSmoothPrimeRange_subset,
    eventually_card_taoShortSmoothPrimeFailureUnion_largeSmooth_source] with
      x hsubset hbound
  have hcard : (taoShortSmoothPrimeFailureUnion x
      (taoBadIntervalSourceLargeSmoothPrimeRange x)).card ≤
        (taoShortSmoothPrimeFailureUnion x
          (taoBadIntervalLargeSmoothPrimeRange (2 * x))).card :=
    Finset.card_le_card (taoShortSmoothPrimeFailureUnion_mono hsubset)
  have hcardReal :
      ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalSourceLargeSmoothPrimeRange x)).card : ℝ) ≤
        ((taoShortSmoothPrimeFailureUnion x
          (taoBadIntervalLargeSmoothPrimeRange (2 * x))).card : ℝ) := by
    exact_mod_cast hcard
  exact hcardReal.trans hbound

/-- Natural cutoff for the source scale `z(x)^β`. -/
noncomputable def taoZPowerFloor (β : ℝ) (x : ℕ) : ℕ :=
  ⌊(taoZ x) ^ β⌋₊

theorem tendsto_taoZPowerFloor_atTop {β : ℝ} (hβ : 0 < β) :
    Tendsto (taoZPowerFloor β) atTop atTop := by
  simpa [taoZPowerFloor] using
    tendsto_nat_floor_atTop.comp
      ((tendsto_rpow_atTop hβ).comp tendsto_taoZ_atTop)

/-- Flooring `z(x)^β` preserves its logarithmic exponent. -/
theorem tendsto_log_taoZPowerFloor_div_log_taoZ
    {β : ℝ} (hβ : 0 < β) :
    Tendsto (fun x =>
      Real.log (taoZPowerFloor β x) / Real.log (taoZ x))
      atTop (𝓝 β) := by
  have hpower : Tendsto (fun x => (taoZ x) ^ β) atTop atTop :=
    (tendsto_rpow_atTop hβ).comp tendsto_taoZ_atTop
  have hfloorRatio : Tendsto (fun x =>
      (taoZPowerFloor β x : ℝ) / (taoZ x) ^ β)
      atTop (𝓝 1) := by
    simpa [taoZPowerFloor] using
      tendsto_nat_floor_div_atTop.comp hpower
  have hlogRatio : Tendsto (fun x =>
      Real.log ((taoZPowerFloor β x : ℝ) / (taoZ x) ^ β))
      atTop (𝓝 0) := by
    simpa using
      ((Real.continuousAt_log (by norm_num : (1 : ℝ) ≠ 0)).tendsto.comp
        hfloorRatio)
  have hdiff : Tendsto (fun x =>
      Real.log (taoZPowerFloor β x) - Real.log ((taoZ x) ^ β))
      atTop (𝓝 0) := by
    apply hlogRatio.congr'
    filter_upwards [hpower.eventually (eventually_gt_atTop (1 : ℝ))] with x hx
    have hfloorPos : (0 : ℝ) < taoZPowerFloor β x := by
      exact_mod_cast (Nat.floor_pos.mpr hx.le : 0 < ⌊(taoZ x) ^ β⌋₊)
    rw [Real.log_div hfloorPos.ne'
      (Real.rpow_pos_of_pos (taoZ_pos x) β).ne']
  have hnormalized := hdiff.div_atTop
    (Real.tendsto_log_atTop.comp tendsto_taoZ_atTop)
  have hsum : Tendsto (fun x =>
      (Real.log (taoZPowerFloor β x) - Real.log ((taoZ x) ^ β)) /
          Real.log (taoZ x) + β)
      atTop (𝓝 β) := by
    simpa using hnormalized.add
      (tendsto_const_nhds : Tendsto (fun _ : ℕ => β) atTop (𝓝 β))
  apply hsum.congr'
  filter_upwards [tendsto_taoZ_atTop.eventually
      (eventually_gt_atTop (1 : ℝ))] with x hx
  have hlogZ : Real.log (taoZ x) ≠ 0 := (Real.log_pos hx).ne'
  rw [Real.log_rpow (taoZ_pos x)]
  field_simp [hlogZ]
  ring

/-- The exact floored source cutoff gives a critical smooth-number regime
with ambient range `2x`. -/
theorem isTaoCriticalSmoothRegime_two_mul_taoZPowerFloor
    {β : ℝ} (hβ : 0 < β) :
    IsTaoCriticalSmoothRegime (fun x => 2 * x) (taoZPowerFloor β) β := by
  constructor
  · have h := tendsto_log_taoNaturalDilation_div_log_nat
      (c := (2 : ℝ)) (by norm_num)
    apply h.congr'
    filter_upwards with x
    have hdilation : taoNaturalDilation 2 x = 2 * x := by
      unfold taoNaturalDilation
      rw [show (2 : ℝ) * (x : ℝ) = ((2 * x : ℕ) : ℝ) by norm_num]
      exact Nat.floor_natCast (R := ℝ) (2 * x)
    rw [hdilation]
  · exact tendsto_log_taoZPowerFloor_div_log_taoZ hβ

/-- The small-distinguished-prime interval union inherits the critical
smooth-number upper bound at every fixed positive cutoff exponent. -/
theorem eventually_card_taoSmallPrimeFailureUnion_le
    {β ε : ℝ} (hβ : 0 < β) (hε : 0 < ε) :
    ∀ᶠ x : ℕ in atTop,
      ((taoSmallPrimeFailureUnion x (taoZPowerFloor β x)).card : ℝ) ≤
        (2 * x : ℕ) / (taoZ x) ^ (1 / β - ε) := by
  have hregime := isTaoCriticalSmoothRegime_two_mul_taoZPowerFloor hβ
  filter_upwards [
    hregime.eventually_psiNat_cast_le_self_div_taoZ_rpow hβ hε] with x hx
  have hcard :
      ((taoSmallPrimeFailureUnion x (taoZPowerFloor β x)).card : ℝ) ≤
        (psiNat (2 * x) (taoZPowerFloor β x) : ℝ) := by
    exact_mod_cast card_taoSmallPrimeFailureUnion_le_psiNat
      x (taoZPowerFloor β x)
  exact hcard.trans hx

/-- At the concrete source cutoff `z(x)^(2/5)`, the small-prime branch has
the stronger `z(x)^(-12/5)` saving. -/
theorem eventually_card_taoSmallPrimeFailureUnion_two_fifths_le :
    ∀ᶠ x : ℕ in atTop,
      ((taoSmallPrimeFailureUnion x
        (taoZPowerFloor (2 / 5 : ℝ) x)).card : ℝ) ≤
        (2 * x : ℕ) / (taoZ x) ^ (12 / 5 : ℝ) := by
  have hexponent :
      1 / (2 / 5 : ℝ) - (1 / 10 : ℝ) = 12 / 5 := by
    norm_num
  simpa only [hexponent] using
    eventually_card_taoSmallPrimeFailureUnion_le
      (β := (2 / 5 : ℝ)) (ε := (1 / 10 : ℝ)) (by norm_num) (by norm_num)

/-! ## Uniform smooth-number estimate for deficient factor lists -/

/-- Dividing a sequence of logarithmic exponent one by a positive
subpolynomial natural selector preserves logarithmic exponent one. -/
theorem tendsto_log_natDiv_div_log_nat_one
    {A D : ℕ → ℕ}
    (hApos : ∀ᶠ x : ℕ in atTop, 0 < A x)
    (hDpos : ∀ᶠ x : ℕ in atTop, 0 < D x)
    (hDle : ∀ᶠ x : ℕ in atTop, D x ≤ A x)
    (hA : Tendsto (fun x => Real.log (A x : ℝ) / Real.log x)
      atTop (𝓝 1))
    (hD : Tendsto (fun x => Real.log (D x : ℝ) / Real.log x)
      atTop (𝓝 0)) :
    Tendsto (fun x => Real.log (A x / D x : ℕ) / Real.log x)
      atTop (𝓝 1) := by
  have hlogx : Tendsto (fun x : ℕ => Real.log x) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hconst : Tendsto (fun x : ℕ => Real.log 2 / Real.log x)
      atTop (𝓝 0) := tendsto_const_nhds.div_atTop hlogx
  have hlower : Tendsto (fun x : ℕ =>
      Real.log (A x : ℝ) / Real.log x -
        Real.log (D x : ℝ) / Real.log x - Real.log 2 / Real.log x)
      atTop (𝓝 1) := by
    convert (hA.sub hD).sub hconst using 1
    all_goals norm_num
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hlower hA
  · filter_upwards [hApos, hDpos, hDle,
      tendsto_natCast_atTop_atTop.eventually
        (eventually_gt_atTop (1 : ℝ))] with x ha hd hda hx
    have hlogxPos : 0 < Real.log x := Real.log_pos hx
    have hqPos : 0 < A x / D x := Nat.div_pos hda hd
    have hquot := cast_div_le_two_mul_natDiv hd hda
    have hquotPos : 0 < (A x : ℝ) / (D x : ℕ) := by positivity
    have htwoQPos : 0 < (2 : ℝ) * (A x / D x : ℕ) := by positivity
    have hlogs := Real.strictMonoOn_log.monotoneOn hquotPos htwoQPos hquot
    rw [Real.log_div (by exact_mod_cast ha.ne')
          (by exact_mod_cast hd.ne'),
      Real.log_mul (by norm_num : (2 : ℝ) ≠ 0)
        (by exact_mod_cast hqPos.ne')] at hlogs
    rw [show Real.log (A x : ℝ) / Real.log x -
          Real.log (D x : ℝ) / Real.log x - Real.log 2 / Real.log x =
        (Real.log (A x : ℝ) - Real.log (D x : ℝ) - Real.log 2) /
          Real.log x by field_simp]
    rw [div_le_div_iff_of_pos_right hlogxPos]
    linarith
  · filter_upwards [hApos, hDpos, hDle,
      tendsto_natCast_atTop_atTop.eventually
        (eventually_gt_atTop (1 : ℝ))] with x ha hd hda hx
    have hlogxPos : 0 < Real.log x := Real.log_pos hx
    have hqPos : 0 < A x / D x := Nat.div_pos hda hd
    have hqLe : A x / D x ≤ A x := Nat.div_le_self _ _
    have hlogLe : Real.log (A x / D x : ℕ) ≤ Real.log (A x : ℝ) :=
      Real.strictMonoOn_log.monotoneOn
        (show (0 : ℝ) < (A x / D x : ℕ) by exact_mod_cast hqPos)
        (show (0 : ℝ) < A x by exact_mod_cast ha)
        (by exact_mod_cast hqLe)
    exact (div_le_div_iff_of_pos_right hlogxPos).2 hlogLe

/-- A positive selector bounded by a fixed power of a rounded `taoZ`
cutoff is still subpolynomial on the ambient scale. -/
theorem tendsto_log_selector_div_log_nat_zero_of_le_exponentCutoff_pow
    {D : ℕ → ℕ} {β : ℝ} {k : ℕ} (hβ : 0 < β)
    (hD : ∀ᶠ x : ℕ in atTop,
      1 ≤ D x ∧ D x ≤ taoOneTermExponentCutoff β x ^ k) :
    Tendsto (fun x => Real.log (D x : ℝ) / Real.log x)
      atTop (𝓝 0) := by
  have hcut : ∀ᶠ x : ℕ in atTop,
      1 ≤ taoOneTermExponentCutoff β x := by
    filter_upwards with x
    exact Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (taoZ_pos x) _)
  have hcutSmall :=
    tendsto_log_selector_div_log_nat_zero_of_le_exponentCutoff hβ
      (hcut.mono fun _ hc => ⟨hc, le_rfl⟩)
  have hupper : Tendsto (fun x : ℕ =>
      (k : ℝ) * (Real.log (taoOneTermExponentCutoff β x : ℝ) /
        Real.log x)) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.mul hcutSmall : Tendsto (fun x : ℕ =>
      (k : ℝ) * (Real.log (taoOneTermExponentCutoff β x : ℝ) /
        Real.log x)) atTop (𝓝 ((k : ℝ) * 0)))
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le'
    tendsto_const_nhds hupper
  · filter_upwards [hD,
      tendsto_natCast_atTop_atTop.eventually
        (eventually_gt_atTop (1 : ℝ))] with x hd hx
    exact div_nonneg (Real.log_nonneg (by exact_mod_cast hd.1))
      (Real.log_pos hx).le
  · filter_upwards [hD, hcut,
      tendsto_natCast_atTop_atTop.eventually
        (eventually_gt_atTop (1 : ℝ))] with x hd hc hx
    have hDpos : (0 : ℝ) < D x := by
      exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hd.1)
    have hpowPos : (0 : ℝ) <
        ((taoOneTermExponentCutoff β x ^ k : ℕ) : ℝ) := by
      exact_mod_cast pow_pos (lt_of_lt_of_le Nat.zero_lt_one hc) k
    have hlogLe : Real.log (D x : ℝ) ≤
        Real.log ((taoOneTermExponentCutoff β x : ℕ) ^ k : ℕ) :=
      Real.strictMonoOn_log.monotoneOn hDpos hpowPos
        (by exact_mod_cast hd.2)
    rw [Nat.cast_pow, Real.log_pow] at hlogLe
    rw [show (k : ℝ) *
          (Real.log (taoOneTermExponentCutoff β x : ℝ) / Real.log x) =
        ((k : ℝ) * Real.log (taoOneTermExponentCutoff β x : ℝ)) /
          Real.log x by ring]
    exact (div_le_div_iff_of_pos_right (Real.log_pos hx)).2 hlogLe

/-- The square of the distinguished prime together with fewer than 1000
large factors is bounded by the 1001st power of any common upper bound. -/
theorem deficientDenominator_le_pow
    {lower p₀ C : ℕ} {qs : List ℕ}
    (hC : 1 ≤ C) (hp₀C : p₀ ≤ C)
    (hqs : qs ∈ deficientLargeFactorLists lower p₀) :
    p₀ ^ 2 * qs.prod ≤ C ^ 1001 := by
  obtain ⟨hlen, hall⟩ := mem_deficientLargeFactorLists.mp hqs
  have hprod : qs.prod ≤ C ^ qs.length :=
    List.prod_le_pow_card qs C fun q hq => (hall q hq).2.2.trans hp₀C
  calc
    p₀ ^ 2 * qs.prod ≤ C ^ 2 * C ^ qs.length :=
      Nat.mul_le_mul (Nat.pow_le_pow_left hp₀C 2) hprod
    _ = C ^ (2 + qs.length) := by rw [pow_add]
    _ ≤ C ^ 1001 := pow_le_pow_right' hC (by omega)

/-- A positive subpolynomial natural sequence is eventually below a positive
sequence of logarithmic exponent one. -/
theorem eventually_le_of_log_ratios_zero_one
    {D A : ℕ → ℕ}
    (hDpos : ∀ᶠ x : ℕ in atTop, 0 < D x)
    (hApos : ∀ᶠ x : ℕ in atTop, 0 < A x)
    (hD : Tendsto (fun x => Real.log (D x : ℝ) / Real.log x)
      atTop (𝓝 0))
    (hA : Tendsto (fun x => Real.log (A x : ℝ) / Real.log x)
      atTop (𝓝 1)) :
    ∀ᶠ x : ℕ in atTop, D x ≤ A x := by
  filter_upwards [hDpos, hApos,
    hD.eventually (Iio_mem_nhds (show (0 : ℝ) < 1 / 4 by norm_num)),
    hA.eventually (Ioi_mem_nhds (show (1 / 2 : ℝ) < 1 by norm_num)),
    tendsto_natCast_atTop_atTop.eventually
      (eventually_gt_atTop (1 : ℝ))] with x hd ha hdRatio haRatio hx
  have hlogx : 0 < Real.log x := Real.log_pos hx
  have hlogLt : Real.log (D x : ℝ) < Real.log (A x : ℝ) := by
    have hd' := (div_lt_iff₀ hlogx).mp hdRatio
    have ha' := (lt_div_iff₀ hlogx).mp haRatio
    nlinarith
  have hexp := Real.exp_lt_exp.mpr hlogLt
  rw [Real.exp_log (by exact_mod_cast hd),
    Real.exp_log (by exact_mod_cast ha)] at hexp
  exact_mod_cast hexp.le

/-- Uniform selector form of the critical regime for the exact deficient
cofactor ambient range `(2x / p₀²) / ∏q`. -/
theorem isTaoCriticalSmoothRegime_deficientSelectors
    {P : ℕ → ℕ} {Q : ℕ → List ℕ} {Y : ℕ → ℕ}
    {α β : ℝ} (hβ : 0 < β)
    (hY : Tendsto (fun x => Real.log (Y x : ℝ) / Real.log (taoZ x))
      atTop (𝓝 α))
    (hsel : ∀ᶠ x : ℕ in atTop,
      1 ≤ P x ∧ P x ≤ taoOneTermExponentCutoff β x ∧
        Q x ∈ deficientLargeFactorLists (Y x) (P x)) :
    IsTaoCriticalSmoothRegime
      (fun x => (2 * x / P x ^ 2) / (Q x).prod) Y α := by
  let D : ℕ → ℕ := fun x => P x ^ 2 * (Q x).prod
  have hDbound : ∀ᶠ x : ℕ in atTop,
      1 ≤ D x ∧ D x ≤ taoOneTermExponentCutoff β x ^ 1001 := by
    filter_upwards [hsel] with x hs
    have hqData := mem_deficientLargeFactorLists.mp hs.2.2
    have hprodPos : 0 < (Q x).prod := List.prod_pos fun q hq =>
      (hqData.2 q hq).1.pos
    constructor
    · exact Nat.one_le_iff_ne_zero.mpr (mul_ne_zero
        (pow_ne_zero 2 (by omega)) hprodPos.ne')
    · exact deficientDenominator_le_pow
        (Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (taoZ_pos x) _))
        hs.2.1 hs.2.2
  have hDpos : ∀ᶠ x : ℕ in atTop, 0 < D x :=
    hDbound.mono fun _ hd => lt_of_lt_of_le Nat.zero_lt_one hd.1
  have hDsmall :=
    tendsto_log_selector_div_log_nat_zero_of_le_exponentCutoff_pow hβ hDbound
  have hApos : ∀ᶠ x : ℕ in atTop, 0 < 2 * x := by
    filter_upwards [eventually_gt_atTop (0 : ℕ)] with x hx
    omega
  have hDle : ∀ᶠ x : ℕ in atTop, D x ≤ 2 * x :=
    eventually_le_of_log_ratios_zero_one hDpos hApos hDsmall
      tendsto_log_two_mul_div_log_nat
  constructor
  · have hquot := tendsto_log_natDiv_div_log_nat_one
      hApos hDpos hDle tendsto_log_two_mul_div_log_nat hDsmall
    simpa only [D, Nat.div_div_eq_div_mul] using hquot
  · exact hY

set_option maxHeartbeats 800000 in
/-- The critical smooth-number estimate holds uniformly for every deficient
factor list below a fixed rounded `taoZ` power.  Its right side retains the
exact reciprocal weight `1/(p₀² ∏q)`. -/
theorem eventually_deficientSmoothPointwiseBound_uniform
    {α β ε : ℝ} (hα : 0 < α) (hβ : 0 < β) (hε : 0 < ε) :
    ∀ᶠ x : ℕ in atTop, ∀ p₀,
      1 ≤ p₀ → p₀ ≤ taoOneTermExponentCutoff β x →
      ∀ qs ∈ deficientLargeFactorLists (taoZPowerFloor α x) p₀,
        (psiNat (badIntervalCofactorBudget x p₀ / qs.prod)
          (taoZPowerFloor α x) : ℝ) ≤
          (1 / (taoZ x) ^ (1 / α - ε)) * (2 * x : ℕ) *
            (1 / (p₀ : ℝ) ^ 2) * (((qs.prod : ℕ) : ℝ)⁻¹) := by
  let R : ℕ → (ℕ × List ℕ) → Prop := fun x a =>
    1 ≤ a.1 ∧ a.1 ≤ taoOneTermExponentCutoff β x ∧
      a.2 ∈ deficientLargeFactorLists (taoZPowerFloor α x) a.1
  let Goal : ℕ → (ℕ × List ℕ) → Prop := fun x a =>
    (psiNat (badIntervalCofactorBudget x a.1 / a.2.prod)
      (taoZPowerFloor α x) : ℝ) ≤
      (1 / (taoZ x) ^ (1 / α - ε)) * (2 * x : ℕ) *
        (1 / (a.1 : ℝ) ^ 2) * (((a.2.prod : ℕ) : ℝ)⁻¹)
  have hne : ∀ᶠ x : ℕ in atTop, ∃ a, R x a := by
    filter_upwards with x
    refine ⟨(1, []), ?_⟩
    refine ⟨le_rfl, Nat.ceil_pos.mpr
      (Real.rpow_pos_of_pos (taoZ_pos x) _), ?_⟩
    exact mem_deficientLargeFactorLists.mpr ⟨by norm_num, by simp⟩
  have huniform : ∀ᶠ x : ℕ in atTop, ∀ a, R x a → Goal x a := by
    apply eventually_forall_of_forall_selector hne
    intro S hS
    have hregime := isTaoCriticalSmoothRegime_deficientSelectors hβ
      (tendsto_log_taoZPowerFloor_div_log_taoZ hα) hS
    filter_upwards [hS,
      hregime.eventually_psiNat_cast_le_self_div_taoZ_rpow hα hε] with
        x hs hpsi
    have hqData := mem_deficientLargeFactorLists.mp hs.2.2
    have hpPos : 0 < (S x).1 := lt_of_lt_of_le Nat.zero_lt_one hs.1
    have hprodPos : 0 < (S x).2.prod := List.prod_pos fun q hq =>
      (hqData.2 q hq).1.pos
    have hcast : (((2 * x / (S x).1 ^ 2) / (S x).2.prod : ℕ) : ℝ) ≤
        (((2 * x : ℕ) : ℝ) / ((S x).1 : ℝ) ^ 2) /
          (((S x).2.prod : ℕ) : ℝ) := by
      calc
        (((2 * x / (S x).1 ^ 2) / (S x).2.prod : ℕ) : ℝ) ≤
            ((2 * x / (S x).1 ^ 2 : ℕ) : ℝ) /
              (((S x).2.prod : ℕ) : ℝ) := Nat.cast_div_le
        _ ≤ ((((2 * x : ℕ) : ℝ) / (((S x).1 ^ 2 : ℕ) : ℝ)) /
              (((S x).2.prod : ℕ) : ℝ)) := by
          exact div_le_div_of_nonneg_right Nat.cast_div_le (by positivity)
        _ = (((2 * x : ℕ) : ℝ) / ((S x).1 : ℝ) ^ 2) /
              (((S x).2.prod : ℕ) : ℝ) := by rw [Nat.cast_pow]
    dsimp only [Goal]
    calc
      (psiNat (badIntervalCofactorBudget x (S x).1 / (S x).2.prod)
          (taoZPowerFloor α x) : ℝ) =
          (psiNat ((2 * x / (S x).1 ^ 2) / (S x).2.prod)
            (taoZPowerFloor α x) : ℝ) := by
        simp only [badIntervalCofactorBudget]
      _ ≤ (((2 * x / (S x).1 ^ 2) / (S x).2.prod : ℕ) : ℝ) /
          (taoZ x) ^ (1 / α - ε) := hpsi
      _ ≤ ((((2 * x : ℕ) : ℝ) / ((S x).1 : ℝ) ^ 2) /
          (((S x).2.prod : ℕ) : ℝ)) /
          (taoZ x) ^ (1 / α - ε) :=
        div_le_div_of_nonneg_right hcast
          (Real.rpow_pos_of_pos (taoZ_pos x) _).le
      _ = (1 / (taoZ x) ^ (1 / α - ε)) * (2 * x : ℕ) *
          (1 / ((S x).1 : ℝ) ^ 2) *
            ((((S x).2.prod : ℕ) : ℝ)⁻¹) := by
        field_simp [show ((S x).1 : ℝ) ≠ 0 by exact_mod_cast hpPos.ne',
          show (((S x).2.prod : ℕ) : ℝ) ≠ 0 by exact_mod_cast hprodPos.ne',
          ne_of_gt (Real.rpow_pos_of_pos (taoZ_pos x) _)]
  filter_upwards [huniform] with x hx p₀ hp₀ hp₀Cut qs hqs
  exact hx (p₀, qs) ⟨hp₀, hp₀Cut, hqs⟩

/-- Concrete source-scale pointwise estimate for the deficient branch, using
the factor threshold `z^(9/10)` and the source upper prime exponent three. -/
theorem eventually_sourceDeficientSmoothPointwiseBound :
    ∀ᶠ x : ℕ in atTop,
      DeficientSmoothPointwiseBound x (taoZPowerFloor (9 / 10 : ℝ) x)
        (taoBadIntervalSourceLargeSmoothPrimeRange x)
        (1 / (taoZ x) ^ (10 / 9 - 1 / 1000 : ℝ)) := by
  filter_upwards [eventually_deficientSmoothPointwiseBound_uniform
      (α := (9 / 10 : ℝ)) (β := (3 : ℝ)) (ε := (1 / 1000 : ℝ))
      (by norm_num) (by norm_num) (by norm_num)] with x huniform
  intro p₀ hp₀ qs hqs
  have hpData := Finset.mem_filter.mp hp₀
  have hpPrime := (Finset.mem_filter.mp hpData.1).2
  have hpUpper : p₀ ≤ taoOneTermExponentCutoff (3 : ℝ) x := by
    simpa only [taoOneTermExponentCutoff_three_eq_taoTypicalSquareThreshold]
      using hpData.2.2
  simpa only [show (1 / (9 / 10 : ℝ)) = 10 / 9 by norm_num] using
    huniform p₀ hpPrime.one_le hpUpper qs hqs

/-- The deficient-factor threshold `⌊z^(9/10)⌋` lies below the literal
source lower distinguished-prime cutoff `⌈z^(5/4)⌉`. -/
theorem eventually_taoZPowerFloor_nine_tenths_le_sourceLowerCutoff :
    ∀ᶠ x : ℕ in atTop,
      taoZPowerFloor (9 / 10 : ℝ) x ≤
        taoOneTermExponentCutoff (5 / 4 : ℝ) x := by
  filter_upwards [tendsto_taoZ_atTop.eventually
      (eventually_ge_atTop (1 : ℝ))] with x hz
  have hpow : (taoZ x) ^ (9 / 10 : ℝ) ≤
      (taoZ x) ^ (5 / 4 : ℝ) :=
    Real.rpow_le_rpow_of_exponent_le hz (by norm_num)
  have hfloor : (taoZPowerFloor (9 / 10 : ℝ) x : ℝ) ≤
      (taoZ x) ^ (9 / 10 : ℝ) := by
    exact Nat.floor_le (Real.rpow_nonneg (taoZ_pos x).le _)
  have hceil : (taoZ x) ^ (5 / 4 : ℝ) ≤
      (taoOneTermExponentCutoff (5 / 4 : ℝ) x : ℝ) := Nat.le_ceil _
  exact_mod_cast hfloor.trans (hpow.trans hceil)

/-- Every distinguished prime in the literal source large-smooth range lies
in the finite deficient-factor summation range. -/
theorem eventually_sourceLargeSmoothPrimeRange_subset_deficientRange :
    ∀ᶠ x : ℕ in atTop,
      taoBadIntervalSourceLargeSmoothPrimeRange x ⊆
        deficientPrimeFactorRange (taoZPowerFloor (9 / 10 : ℝ) x)
          (taoTypicalSquareThreshold x) := by
  filter_upwards [
    eventually_taoZPowerFloor_nine_tenths_le_sourceLowerCutoff] with
      x hlower p hp
  have hpData := Finset.mem_filter.mp hp
  have hpPrime := (Finset.mem_filter.mp hpData.1).2
  exact mem_deficientPrimeFactorRange.mpr
    ⟨hpPrime, hlower.trans (Nat.le_of_lt hpData.2.1), hpData.2.2⟩

/-- Exact source-facing deficient-union estimate before absorbing the fixed
polylogarithmic loss. -/
theorem eventually_card_taoSourceDeficientPrimeFailureUnion_le_raw :
    ∀ᶠ x : ℕ in atTop,
      ((taoDeficientPrimeFailureUnion x (taoTypicalSquareThreshold x)
        (taoZPowerFloor (9 / 10 : ℝ) x) (taoTypicalSquareThreshold x)
        (taoBadIntervalSourceLargeSmoothPrimeRange x)).card : ℝ) ≤
      4 * (taoTypicalLengthCutoff x : ℝ) *
        (((1 / (taoZ x) ^ (10 / 9 - 1 / 1000 : ℝ)) * (2 * x : ℕ)) *
          ((1 / ((taoZPowerFloor (9 / 10 : ℝ) x - 1 : ℕ) : ℝ)) *
            (1000 * (1 + Real.log (taoTypicalSquareThreshold x : ℝ)) ^
              (999 : ℕ)))) := by
  filter_upwards [eventually_sourceDeficientSmoothPointwiseBound,
    eventually_sourceLargeSmoothPrimeRange_subset_deficientRange,
    (tendsto_taoZPowerFloor_atTop (by norm_num : (0 : ℝ) < 9 / 10)).eventually
      (eventually_ge_atTop (2 : ℕ)),
    eventually_two_le_taoTypicalSquareThreshold,
    eventually_ge_atTop (2 : ℕ)] with x hpsi hsubset hlower hupper hx
  have hcutoff : 0 < taoTypicalLengthCutoff x := by
    have hlog : 0 < Real.log (x : ℝ) := Real.log_pos (by exact_mod_cast hx)
    have hcutoffReal : (0 : ℝ) < taoTypicalLengthCutoff x :=
      (pow_pos hlog 20).trans_le (taoTypicalLengthCutoff_spec x)
    exact_mod_cast hcutoffReal
  exact card_taoDeficientPrimeFailureUnion_cast_le_of_pointwise
    (taoBadIntervalSourceLargeSmoothPrimeRange x)
    (one_div_nonneg.mpr (Real.rpow_nonneg (taoZ_pos x).le _))
    hcutoff hlower hupper hsubset hpsi

/-- The rounded source square cutoff is subpolynomial, hence eventually lies
below the exact ambient range `2x`. -/
theorem eventually_taoTypicalSquareThreshold_le_two_mul :
    ∀ᶠ x : ℕ in atTop, taoTypicalSquareThreshold x ≤ 2 * x := by
  have hDsmall : Tendsto (fun x =>
      Real.log (taoTypicalSquareThreshold x : ℝ) / Real.log x)
      atTop (𝓝 0) := by
    apply tendsto_log_selector_div_log_nat_zero_of_le_exponentCutoff
      (β := (3 : ℝ)) (by norm_num)
    filter_upwards [eventually_two_le_taoTypicalSquareThreshold] with x hx
    rw [taoOneTermExponentCutoff_three_eq_taoTypicalSquareThreshold]
    exact ⟨by omega, le_rfl⟩
  have hDpos : ∀ᶠ x : ℕ in atTop, 0 < taoTypicalSquareThreshold x := by
    filter_upwards with x
    exact taoTypicalSquareThreshold_pos x
  have hApos : ∀ᶠ x : ℕ in atTop, 0 < 2 * x := by
    filter_upwards [eventually_gt_atTop (0 : ℕ)] with x hx
    omega
  exact eventually_le_of_log_ratios_zero_one hDpos hApos hDsmall
    tendsto_log_two_mul_div_log_nat

/-- Removing the floor and the subtraction in the deficient reciprocal tail
costs only the explicit factor two. -/
theorem eventually_one_div_taoZPowerFloor_sub_one_le :
    ∀ᶠ x : ℕ in atTop,
      1 / ((taoZPowerFloor (9 / 10 : ℝ) x - 1 : ℕ) : ℝ) ≤
        2 / (taoZ x) ^ (9 / 10 : ℝ) := by
  have hpower : Tendsto (fun x => (taoZ x) ^ (9 / 10 : ℝ)) atTop atTop :=
    (tendsto_rpow_atTop (by norm_num : (0 : ℝ) < 9 / 10)).comp
      tendsto_taoZ_atTop
  filter_upwards [hpower.eventually (eventually_ge_atTop (4 : ℝ))] with x hx
  let Z : ℝ := (taoZ x) ^ (9 / 10 : ℝ)
  have hfloorLt : Z < (taoZPowerFloor (9 / 10 : ℝ) x : ℝ) + 1 := by
    simpa only [taoZPowerFloor, Z] using Nat.lt_floor_add_one Z
  have hfloorOne : 1 ≤ taoZPowerFloor (9 / 10 : ℝ) x := by
    have hthree : (3 : ℝ) <
        (taoZPowerFloor (9 / 10 : ℝ) x : ℝ) := by
      linarith
    have hthreeNat : 3 < taoZPowerFloor (9 / 10 : ℝ) x := by
      exact_mod_cast hthree
    omega
  have hden : Z / 2 ≤
      ((taoZPowerFloor (9 / 10 : ℝ) x - 1 : ℕ) : ℝ) := by
    rw [Nat.cast_sub hfloorOne]
    norm_num at hfloorLt ⊢
    change 4 ≤ Z at hx
    linarith
  have hZpos : 0 < Z := by dsimp only [Z]; positivity
  calc
    1 / ((taoZPowerFloor (9 / 10 : ℝ) x - 1 : ℕ) : ℝ) ≤
        1 / (Z / 2) := one_div_le_one_div_of_le (half_pos hZpos) hden
    _ = 2 / (taoZ x) ^ (9 / 10 : ℝ) := by
      dsimp only [Z]
      field_simp [ne_of_gt (Real.rpow_pos_of_pos (taoZ_pos x) _)]

/-- All fixed combinatorial, dyadic-length, and reciprocal-factor logarithmic
losses in the deficient branch are absorbed by `z^(1/200)`. -/
theorem eventually_deficientPolylogFactor_le_taoZ_rpow :
    ∀ᶠ x : ℕ in atTop,
      16000 * (taoTypicalLengthCutoff x : ℝ) *
          (1 + Real.log (taoTypicalSquareThreshold x : ℝ)) ^ (999 : ℕ) ≤
        (taoZ x) ^ (1 / 200 : ℝ) := by
  let C : ℝ := 32000 * (3 : ℝ) ^ (999 : ℕ)
  have hlogZ : Tendsto (fun x : ℕ => Real.log (taoZ x)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_taoZ_atTop
  have hconst : Tendsto (fun x : ℕ =>
      Real.log C / Real.log (taoZ x)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop hlogZ
  have hiter : Tendsto (fun x : ℕ =>
      1019 * (iteratedLog x / Real.log (taoZ x))) atTop (𝓝 0) := by
    simpa using tendsto_iteratedLog_div_log_taoZ_zero.const_mul 1019
  filter_upwards [eventually_taoTypicalSquareThreshold_le_two_mul,
    hconst.eventually (Iio_mem_nhds (show (0 : ℝ) < 1 / 400 by norm_num)),
    hiter.eventually (Iio_mem_nhds (show (0 : ℝ) < 1 / 400 by norm_num)),
    hlogZ.eventually (eventually_gt_atTop (0 : ℝ)),
    (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop).eventually
      (eventually_ge_atTop (1 : ℝ)),
    eventually_ge_atTop (2 : ℕ)] with
      x hthreshold hconstBound hiterBound hlogZPos hlogX hx
  change 1 ≤ Real.log (x : ℝ) at hlogX
  have hlogXPos : 0 < Real.log (x : ℝ) := zero_lt_one.trans_le hlogX
  have hlengthLt : (taoTypicalLengthCutoff x : ℝ) <
      (Real.log (x : ℝ)) ^ (20 : ℕ) + 1 := by
    simpa only [taoTypicalLengthCutoff] using
      Nat.ceil_lt_add_one (pow_nonneg hlogXPos.le 20)
  have hPone : 1 ≤ (Real.log (x : ℝ)) ^ (20 : ℕ) :=
    one_le_pow₀ hlogX
  have hlength : (taoTypicalLengthCutoff x : ℝ) ≤
      2 * (Real.log (x : ℝ)) ^ (20 : ℕ) := by
    linarith
  have hthresholdPos : (0 : ℝ) < taoTypicalSquareThreshold x := by
    exact_mod_cast taoTypicalSquareThreshold_pos x
  have htwoXPos : (0 : ℝ) < (2 * x : ℕ) := by positivity
  have hlogThreshold : Real.log (taoTypicalSquareThreshold x : ℝ) ≤
      Real.log (2 * x : ℕ) :=
    Real.strictMonoOn_log.monotoneOn hthresholdPos htwoXPos
      (by exact_mod_cast hthreshold)
  have hlogTwoLe : Real.log (2 : ℝ) ≤ Real.log (x : ℝ) :=
    Real.strictMonoOn_log.monotoneOn (by norm_num)
      (show (0 : ℝ) < x by exact_mod_cast (show 0 < x by omega))
      (by exact_mod_cast hx)
  have hlogTwoX : Real.log (2 * x : ℕ) =
      Real.log 2 + Real.log (x : ℝ) := by
    rw [show ((2 * x : ℕ) : ℝ) = 2 * (x : ℝ) by norm_num,
      Real.log_mul (by norm_num) (by positivity)]
  have hB : 1 + Real.log (taoTypicalSquareThreshold x : ℝ) ≤
      3 * Real.log (x : ℝ) := by
    rw [hlogTwoX] at hlogThreshold
    linarith
  have hB0 : 0 ≤ 1 + Real.log (taoTypicalSquareThreshold x : ℝ) := by
    have : 0 ≤ Real.log (taoTypicalSquareThreshold x : ℝ) :=
      Real.log_nonneg (by exact_mod_cast
        (taoTypicalSquareThreshold_pos x : 0 < taoTypicalSquareThreshold x))
    linarith
  have hpoly :
      16000 * (taoTypicalLengthCutoff x : ℝ) *
          (1 + Real.log (taoTypicalSquareThreshold x : ℝ)) ^ (999 : ℕ) ≤
        C * (Real.log (x : ℝ)) ^ (1019 : ℕ) := by
    calc
      16000 * (taoTypicalLengthCutoff x : ℝ) *
          (1 + Real.log (taoTypicalSquareThreshold x : ℝ)) ^ (999 : ℕ) ≤
          16000 * (2 * (Real.log (x : ℝ)) ^ (20 : ℕ)) *
            (3 * Real.log (x : ℝ)) ^ (999 : ℕ) := by
        gcongr
      _ = C * (Real.log (x : ℝ)) ^ (1019 : ℕ) := by
        dsimp only [C]
        rw [mul_pow]
        rw [show (32000 : ℝ) = 16000 * 2 by norm_num,
          show (1019 : ℕ) = 20 + 999 by norm_num, pow_add]
        ac_rfl
  have hCpos : 0 < C := by dsimp only [C]; positivity
  have hconstMul : Real.log C <
      (1 / 400 : ℝ) * Real.log (taoZ x) :=
    (div_lt_iff₀ hlogZPos).mp hconstBound
  have hiterDiv :
      (1019 * iteratedLog x) / Real.log (taoZ x) < (1 / 400 : ℝ) := by
    calc
      (1019 * iteratedLog x) / Real.log (taoZ x) =
          1019 * (iteratedLog x / Real.log (taoZ x)) := by ring
      _ < 1 / 400 := hiterBound
  have hiterMul : 1019 * iteratedLog x <
      (1 / 400 : ℝ) * Real.log (taoZ x) :=
    (div_lt_iff₀ hlogZPos).mp hiterDiv
  have hlogBound :
      Real.log (C * (Real.log (x : ℝ)) ^ (1019 : ℕ)) ≤
        (1 / 200 : ℝ) * Real.log (taoZ x) := by
    rw [Real.log_mul hCpos.ne'
      (pow_pos hlogXPos (1019 : ℕ)).ne', Real.log_pow]
    change Real.log C + 1019 * iteratedLog x ≤
      (1 / 200 : ℝ) * Real.log (taoZ x)
    linarith
  exact hpoly.trans
    (Real.le_rpow_of_log_le (taoZ_pos x) hlogBound)

/-- Final quantitative disposal of the actual deficient condition-(iii)
interval union.  The exponent remains strictly larger than two after every
finite factor-list and dyadic-length loss has been absorbed. -/
theorem eventually_card_taoSourceDeficientPrimeFailureUnion_le :
    ∀ᶠ x : ℕ in atTop,
      ((taoDeficientPrimeFailureUnion x (taoTypicalSquareThreshold x)
        (taoZPowerFloor (9 / 10 : ℝ) x) (taoTypicalSquareThreshold x)
        (taoBadIntervalSourceLargeSmoothPrimeRange x)).card : ℝ) ≤
        (x : ℝ) / (taoZ x) ^ (2 + 1 / 200 : ℝ) := by
  filter_upwards [eventually_card_taoSourceDeficientPrimeFailureUnion_le_raw,
    eventually_one_div_taoZPowerFloor_sub_one_le,
    eventually_deficientPolylogFactor_le_taoZ_rpow,
    tendsto_taoZ_atTop.eventually (eventually_ge_atTop (1 : ℝ))] with
      x hraw hden hpoly hz
  let B : ℝ := 1 + Real.log (taoTypicalSquareThreshold x : ℝ)
  have hzPos : 0 < taoZ x := taoZ_pos x
  have hB0 : 0 ≤ B := by
    dsimp only [B]
    have hthresholdOne : 1 ≤ taoTypicalSquareThreshold x :=
      taoTypicalSquareThreshold_pos x
    exact add_nonneg (by norm_num)
      (Real.log_nonneg (by exact_mod_cast hthresholdOne))
  have hpoly' :
      16000 * (taoTypicalLengthCutoff x : ℝ) * B ^ (999 : ℕ) ≤
        (taoZ x) ^ (1 / 200 : ℝ) := by
    simpa only [B] using hpoly
  have hcombine (L X T Z₁ Z₂ : ℝ) (hZ₁ : Z₁ ≠ 0) (hZ₂ : Z₂ ≠ 0) :
      4 * L * ((1 / Z₁ * (2 * X)) * ((2 / Z₂) * (1000 * T))) =
        (16000 * L * T) * (X / (Z₁ * Z₂)) := by
    field_simp [hZ₁, hZ₂]
    ring
  have hcancel (X A D : ℝ) (hA : A ≠ 0) (hD : D ≠ 0) :
      A * (X / (A * D)) = X / D := by
    field_simp [hA, hD]
  calc
    ((taoDeficientPrimeFailureUnion x (taoTypicalSquareThreshold x)
        (taoZPowerFloor (9 / 10 : ℝ) x) (taoTypicalSquareThreshold x)
        (taoBadIntervalSourceLargeSmoothPrimeRange x)).card : ℝ) ≤
        4 * (taoTypicalLengthCutoff x : ℝ) *
          (((1 / (taoZ x) ^ (10 / 9 - 1 / 1000 : ℝ)) * (2 * x : ℕ)) *
            ((1 / ((taoZPowerFloor (9 / 10 : ℝ) x - 1 : ℕ) : ℝ)) *
              (1000 * B ^ (999 : ℕ)))) := by
      simpa only [B] using hraw
    _ ≤ 4 * (taoTypicalLengthCutoff x : ℝ) *
          (((1 / (taoZ x) ^ (10 / 9 - 1 / 1000 : ℝ)) * (2 * x : ℕ)) *
            ((2 / (taoZ x) ^ (9 / 10 : ℝ)) *
              (1000 * B ^ (999 : ℕ)))) := by
      gcongr
    _ = (16000 * (taoTypicalLengthCutoff x : ℝ) * B ^ (999 : ℕ)) *
          ((x : ℝ) / (taoZ x) ^
            ((10 / 9 - 1 / 1000 : ℝ) + 9 / 10)) := by
      rw [Real.rpow_add hzPos]
      simpa only [Nat.cast_mul, Nat.cast_ofNat] using hcombine
        (taoTypicalLengthCutoff x : ℝ) (x : ℝ) (B ^ (999 : ℕ))
        ((taoZ x) ^ (10 / 9 - 1 / 1000 : ℝ))
        ((taoZ x) ^ (9 / 10 : ℝ))
        (ne_of_gt (Real.rpow_pos_of_pos hzPos _))
        (ne_of_gt (Real.rpow_pos_of_pos hzPos _))
    _ ≤ (taoZ x) ^ (1 / 200 : ℝ) *
          ((x : ℝ) / (taoZ x) ^
            ((10 / 9 - 1 / 1000 : ℝ) + 9 / 10)) := by
      exact mul_le_mul_of_nonneg_right hpoly'
        (div_nonneg (Nat.cast_nonneg x) (Real.rpow_nonneg hzPos.le _))
    _ = (x : ℝ) / (taoZ x) ^
          ((10 / 9 - 1 / 1000 : ℝ) + 9 / 10 - 1 / 200) := by
      rw [show ((10 / 9 - 1 / 1000 : ℝ) + 9 / 10) =
          1 / 200 + ((10 / 9 - 1 / 1000 : ℝ) + 9 / 10 - 1 / 200) by
        ring, Real.rpow_add hzPos]
      convert hcancel (x : ℝ) ((taoZ x) ^ (1 / 200 : ℝ))
        ((taoZ x) ^
          ((10 / 9 - 1 / 1000 : ℝ) + 9 / 10 - 1 / 200))
        (ne_of_gt (Real.rpow_pos_of_pos hzPos _))
        (ne_of_gt (Real.rpow_pos_of_pos hzPos _)) using 1
      all_goals ring_nf
    _ ≤ (x : ℝ) / (taoZ x) ^ (2 + 1 / 200 : ℝ) := by
      have hexponent : (2 + 1 / 200 : ℝ) ≤
          (10 / 9 - 1 / 1000 : ℝ) + 9 / 10 - 1 / 200 := by
        norm_num
      have hpow := Real.rpow_le_rpow_of_exponent_le hz hexponent
      exact div_le_div_of_nonneg_left (Nat.cast_nonneg x)
        (Real.rpow_pos_of_pos hzPos _) hpow

/-! ## Central deficient prime band -/

/-- The fixed central band used before the final slowly varying
diagonalization: `z^(9/10) < p₀ ≤ z^(11/10)`. -/
noncomputable def taoBadIntervalCentralPrimeRange (x : ℕ) : Finset ℕ :=
  taoOneTermExponentPrimeBand (9 / 10 : ℝ) (11 / 10 : ℝ) x

/-- The uniform deficient smooth-number estimate specialized to the central
prime band. -/
theorem eventually_centralDeficientSmoothPointwiseBound :
    ∀ᶠ x : ℕ in atTop,
      DeficientSmoothPointwiseBound x (taoZPowerFloor (9 / 10 : ℝ) x)
        (taoBadIntervalCentralPrimeRange x)
        (1 / (taoZ x) ^ (10 / 9 - 1 / 1000 : ℝ)) := by
  filter_upwards [eventually_deficientSmoothPointwiseBound_uniform
      (α := (9 / 10 : ℝ)) (β := (11 / 10 : ℝ)) (ε := (1 / 1000 : ℝ))
      (by norm_num) (by norm_num) (by norm_num)] with x huniform
  intro p₀ hp₀ qs hqs
  have hpData := Finset.mem_filter.mp hp₀
  have hpPrime := (Finset.mem_filter.mp hpData.1).2
  simpa only [show (1 / (9 / 10 : ℝ)) = 10 / 9 by norm_num] using
    huniform p₀ hpPrime.one_le hpData.2.2 qs hqs

/-- The central band is contained in the exact finite deficient summation
range with lower floor `z^(9/10)` and source upper square cutoff. -/
theorem eventually_centralPrimeRange_subset_deficientRange :
    ∀ᶠ x : ℕ in atTop,
      taoBadIntervalCentralPrimeRange x ⊆
        deficientPrimeFactorRange (taoZPowerFloor (9 / 10 : ℝ) x)
          (taoTypicalSquareThreshold x) := by
  filter_upwards [tendsto_taoZ_atTop.eventually
      (eventually_ge_atTop (1 : ℝ))] with x hz p hp
  have hpData := Finset.mem_filter.mp hp
  have hpPrime := (Finset.mem_filter.mp hpData.1).2
  have hfloor : taoZPowerFloor (9 / 10 : ℝ) x ≤
      taoOneTermExponentCutoff (9 / 10 : ℝ) x := by
    have hfloorReal : (taoZPowerFloor (9 / 10 : ℝ) x : ℝ) ≤
        (taoZ x) ^ (9 / 10 : ℝ) :=
      Nat.floor_le (Real.rpow_nonneg (taoZ_pos x).le _)
    have hceilReal : (taoZ x) ^ (9 / 10 : ℝ) ≤
        (taoOneTermExponentCutoff (9 / 10 : ℝ) x : ℝ) := Nat.le_ceil _
    exact_mod_cast hfloorReal.trans hceilReal
  have hupperCut : taoOneTermExponentCutoff (11 / 10 : ℝ) x ≤
      taoTypicalSquareThreshold x := by
    rw [← taoOneTermExponentCutoff_three_eq_taoTypicalSquareThreshold]
    exact taoOneTermExponentCutoff_mono_of_one_le hz (by norm_num)
  exact mem_deficientPrimeFactorRange.mpr
    ⟨hpPrime, hfloor.trans (Nat.le_of_lt hpData.2.1),
      hpData.2.2.trans hupperCut⟩

/-- Pre-absorption estimate for the actual central deficient union. -/
theorem eventually_card_taoCentralDeficientPrimeFailureUnion_le_raw :
    ∀ᶠ x : ℕ in atTop,
      ((taoDeficientPrimeFailureUnion x (taoTypicalSquareThreshold x)
        (taoZPowerFloor (9 / 10 : ℝ) x) (taoTypicalSquareThreshold x)
        (taoBadIntervalCentralPrimeRange x)).card : ℝ) ≤
      4 * (taoTypicalLengthCutoff x : ℝ) *
        (((1 / (taoZ x) ^ (10 / 9 - 1 / 1000 : ℝ)) * (2 * x : ℕ)) *
          ((1 / ((taoZPowerFloor (9 / 10 : ℝ) x - 1 : ℕ) : ℝ)) *
            (1000 * (1 + Real.log (taoTypicalSquareThreshold x : ℝ)) ^
              (999 : ℕ)))) := by
  filter_upwards [eventually_centralDeficientSmoothPointwiseBound,
    eventually_centralPrimeRange_subset_deficientRange,
    (tendsto_taoZPowerFloor_atTop (by norm_num : (0 : ℝ) < 9 / 10)).eventually
      (eventually_ge_atTop (2 : ℕ)),
    eventually_two_le_taoTypicalSquareThreshold,
    eventually_ge_atTop (2 : ℕ)] with x hpsi hsubset hlower hupper hx
  have hcutoff : 0 < taoTypicalLengthCutoff x := by
    have hlog : 0 < Real.log (x : ℝ) := Real.log_pos (by exact_mod_cast hx)
    have hcutoffReal : (0 : ℝ) < taoTypicalLengthCutoff x :=
      (pow_pos hlog 20).trans_le (taoTypicalLengthCutoff_spec x)
    exact_mod_cast hcutoffReal
  exact card_taoDeficientPrimeFailureUnion_cast_le_of_pointwise
    (taoBadIntervalCentralPrimeRange x)
    (one_div_nonneg.mpr (Real.rpow_nonneg (taoZ_pos x).le _))
    hcutoff hlower hupper hsubset hpsi

/-- Final quantitative disposal of the actual central deficient branch. -/
theorem eventually_card_taoCentralDeficientPrimeFailureUnion_le :
    ∀ᶠ x : ℕ in atTop,
      ((taoDeficientPrimeFailureUnion x (taoTypicalSquareThreshold x)
        (taoZPowerFloor (9 / 10 : ℝ) x) (taoTypicalSquareThreshold x)
        (taoBadIntervalCentralPrimeRange x)).card : ℝ) ≤
        (x : ℝ) / (taoZ x) ^ (2 + 1 / 200 : ℝ) := by
  filter_upwards [eventually_card_taoCentralDeficientPrimeFailureUnion_le_raw,
    eventually_one_div_taoZPowerFloor_sub_one_le,
    eventually_deficientPolylogFactor_le_taoZ_rpow,
    tendsto_taoZ_atTop.eventually (eventually_ge_atTop (1 : ℝ))] with
      x hraw hden hpoly hz
  let B : ℝ := 1 + Real.log (taoTypicalSquareThreshold x : ℝ)
  have hzPos : 0 < taoZ x := taoZ_pos x
  have hB0 : 0 ≤ B := by
    dsimp only [B]
    have hthresholdOne : 1 ≤ taoTypicalSquareThreshold x :=
      taoTypicalSquareThreshold_pos x
    exact add_nonneg (by norm_num)
      (Real.log_nonneg (by exact_mod_cast hthresholdOne))
  have hpoly' :
      16000 * (taoTypicalLengthCutoff x : ℝ) * B ^ (999 : ℕ) ≤
        (taoZ x) ^ (1 / 200 : ℝ) := by
    simpa only [B] using hpoly
  have hcombine (L X T Z₁ Z₂ : ℝ) (hZ₁ : Z₁ ≠ 0) (hZ₂ : Z₂ ≠ 0) :
      4 * L * ((1 / Z₁ * (2 * X)) * ((2 / Z₂) * (1000 * T))) =
        (16000 * L * T) * (X / (Z₁ * Z₂)) := by
    field_simp [hZ₁, hZ₂]
    ring
  have hcancel (X A D : ℝ) (hA : A ≠ 0) (hD : D ≠ 0) :
      A * (X / (A * D)) = X / D := by
    field_simp [hA, hD]
  calc
    ((taoDeficientPrimeFailureUnion x (taoTypicalSquareThreshold x)
        (taoZPowerFloor (9 / 10 : ℝ) x) (taoTypicalSquareThreshold x)
        (taoBadIntervalCentralPrimeRange x)).card : ℝ) ≤
        4 * (taoTypicalLengthCutoff x : ℝ) *
          (((1 / (taoZ x) ^ (10 / 9 - 1 / 1000 : ℝ)) * (2 * x : ℕ)) *
            ((1 / ((taoZPowerFloor (9 / 10 : ℝ) x - 1 : ℕ) : ℝ)) *
              (1000 * B ^ (999 : ℕ)))) := by
      simpa only [B] using hraw
    _ ≤ 4 * (taoTypicalLengthCutoff x : ℝ) *
          (((1 / (taoZ x) ^ (10 / 9 - 1 / 1000 : ℝ)) * (2 * x : ℕ)) *
            ((2 / (taoZ x) ^ (9 / 10 : ℝ)) *
              (1000 * B ^ (999 : ℕ)))) := by
      gcongr
    _ = (16000 * (taoTypicalLengthCutoff x : ℝ) * B ^ (999 : ℕ)) *
          ((x : ℝ) / (taoZ x) ^
            ((10 / 9 - 1 / 1000 : ℝ) + 9 / 10)) := by
      rw [Real.rpow_add hzPos]
      simpa only [Nat.cast_mul, Nat.cast_ofNat] using hcombine
        (taoTypicalLengthCutoff x : ℝ) (x : ℝ) (B ^ (999 : ℕ))
        ((taoZ x) ^ (10 / 9 - 1 / 1000 : ℝ))
        ((taoZ x) ^ (9 / 10 : ℝ))
        (ne_of_gt (Real.rpow_pos_of_pos hzPos _))
        (ne_of_gt (Real.rpow_pos_of_pos hzPos _))
    _ ≤ (taoZ x) ^ (1 / 200 : ℝ) *
          ((x : ℝ) / (taoZ x) ^
            ((10 / 9 - 1 / 1000 : ℝ) + 9 / 10)) := by
      exact mul_le_mul_of_nonneg_right hpoly'
        (div_nonneg (Nat.cast_nonneg x) (Real.rpow_nonneg hzPos.le _))
    _ = (x : ℝ) / (taoZ x) ^
          ((10 / 9 - 1 / 1000 : ℝ) + 9 / 10 - 1 / 200) := by
      rw [show ((10 / 9 - 1 / 1000 : ℝ) + 9 / 10) =
          1 / 200 + ((10 / 9 - 1 / 1000 : ℝ) + 9 / 10 - 1 / 200) by
        ring, Real.rpow_add hzPos]
      convert hcancel (x : ℝ) ((taoZ x) ^ (1 / 200 : ℝ))
        ((taoZ x) ^
          ((10 / 9 - 1 / 1000 : ℝ) + 9 / 10 - 1 / 200))
        (ne_of_gt (Real.rpow_pos_of_pos hzPos _))
        (ne_of_gt (Real.rpow_pos_of_pos hzPos _)) using 1
      all_goals ring_nf
    _ ≤ (x : ℝ) / (taoZ x) ^ (2 + 1 / 200 : ℝ) := by
      have hexponent : (2 + 1 / 200 : ℝ) ≤
          (10 / 9 - 1 / 1000 : ℝ) + 9 / 10 - 1 / 200 := by
        norm_num
      have hpow := Real.rpow_le_rpow_of_exponent_le hz hexponent
      exact div_le_div_of_nonneg_left (Nat.cast_nonneg x)
        (Real.rpow_pos_of_pos hzPos _) hpow

/-! ## Fixed outside-central smooth prime bands -/

/-- The fine grid cells covering the two fixed windows
`[1/2,91/100]` and `[109/100,63/50]`.  The small initial cell
`[39/100,1/2]` is treated separately. -/
def taoBadIntervalOutsideCentralGridIndices : Finset ℕ :=
  Finset.Ico 0 164 ∪ Finset.Ico 236 304

/-- Both components of the outside-central grid retain a fixed margin over
the critical exponent two. -/
theorem two_add_one_div_two_hundred_fifty_le_outsideCentralGridExponent
    {k : ℕ} (hk : k ∈ taoBadIntervalOutsideCentralGridIndices) :
    2 + (1 / 250 : ℝ) ≤
      taoOneTermGridExponent 600 k +
        1 / taoOneTermGridExponent 600 (k + 1) := by
  let a := taoOneTermGridExponent 600 k
  let b := taoOneTermGridExponent 600 (k + 1)
  change 2 + (1 / 250 : ℝ) ≤ a + 1 / b
  have hba : b = a + 1 / 400 := by
    have hdiff := taoOneTermGridExponent_succ_sub
      (K := 600) (k := k) (by norm_num)
    dsimp only [a, b]
    norm_num at hdiff ⊢
    linarith
  have haHalf : (1 / 2 : ℝ) ≤ a := by
    dsimp only [a, taoOneTermGridExponent]
    exact le_add_of_nonneg_right (by positivity)
  have hbPos : 0 < b := by
    rw [hba]
    linarith
  rw [taoBadIntervalOutsideCentralGridIndices, Finset.mem_union,
    Finset.mem_Ico, Finset.mem_Ico] at hk
  have hmul : (2 + (1 / 250 : ℝ) - a) * b ≤ 1 := by
    rcases hk with hlower | hupper
    · have hkReal : (k : ℝ) ≤ 163 := by exact_mod_cast (by omega : k ≤ 163)
      have haUpper : a ≤ 363 / 400 := by
        dsimp only [a, taoOneTermGridExponent]
        norm_num
        linarith
      have hfactor :
          0 ≤ (363 / 400 - a) * (547 / 500 - a) := by
        exact mul_nonneg (by linarith) (by linarith)
      rw [hba]
      nlinarith
    · have hkReal : (236 : ℝ) ≤ k := by exact_mod_cast hupper.1
      have haLower : 109 / 100 ≤ a := by
        dsimp only [a, taoOneTermGridExponent]
        norm_num
        linarith
      have hfactor :
          0 ≤ (a - 109 / 100) * (a - 1823 / 2000) := by
        exact mul_nonneg (by linarith) (by linarith)
      rw [hba]
      nlinarith
  have hdiv : 2 + (1 / 250 : ℝ) - a ≤ 1 / b :=
    (le_div_iff₀ hbPos).2 hmul
  linarith

/-- Prime union over all fine outside-central grid cells. -/
noncomputable def taoBadIntervalOutsideCentralGridPrimeUnion
    (X : ℕ) : Finset ℕ :=
  taoBadIntervalOutsideCentralGridIndices.biUnion fun k =>
    taoOneTermExponentPrimeBand
      (taoOneTermGridExponent 600 k)
      (taoOneTermGridExponent 600 (k + 1)) X

/-- Each fine outside-central grid cell has a uniform
`z^(-2-3/1000)` smooth-number saving. -/
theorem eventually_sum_psiNat_outsideCentralGridBand_le
    {k : ℕ} (hk : k ∈ taoBadIntervalOutsideCentralGridIndices) :
    ∀ᶠ X : ℕ in atTop,
      (∑ p ∈ taoOneTermExponentPrimeBand
          (taoOneTermGridExponent 600 k)
          (taoOneTermGridExponent 600 (k + 1)) X,
          (psiNat (X / p ^ 2) p : ℝ)) ≤
        (X : ℝ) / (taoZ X) ^ (2 + 3 / 1000 : ℝ) := by
  filter_upwards [eventually_sum_psiNat_gridPrimeBand_le
      (K := 600) (k := k) (by norm_num)
      (show (0 : ℝ) < 1 / 1000 by norm_num),
    tendsto_taoZ_atTop.eventually (eventually_ge_atTop (1 : ℝ))] with
      X hband hz
  have hexponent : (2 + 3 / 1000 : ℝ) ≤
      taoOneTermGridExponent 600 k +
        1 / taoOneTermGridExponent 600 (k + 1) - 1 / 1000 := by
    have hmargin :=
      two_add_one_div_two_hundred_fifty_le_outsideCentralGridExponent hk
    linarith
  have hpow := Real.rpow_le_rpow_of_exponent_le hz hexponent
  exact hband.trans (div_le_div_of_nonneg_left (by positivity)
    (Real.rpow_pos_of_pos (taoZ_pos X) _) hpow)

/-- The outside-central cell estimate holds simultaneously on the fixed
finite grid. -/
theorem eventually_forall_sum_psiNat_outsideCentralGridBand_le :
    ∀ᶠ X : ℕ in atTop,
      ∀ k ∈ taoBadIntervalOutsideCentralGridIndices,
        (∑ p ∈ taoOneTermExponentPrimeBand
            (taoOneTermGridExponent 600 k)
            (taoOneTermGridExponent 600 (k + 1)) X,
            (psiNat (X / p ^ 2) p : ℝ)) ≤
          (X : ℝ) / (taoZ X) ^ (2 + 3 / 1000 : ℝ) := by
  rw [Filter.eventually_all_finset]
  intro k hk
  exact eventually_sum_psiNat_outsideCentralGridBand_le hk

/-- The initial fixed cell below the standard grid has more than enough
exponent margin. -/
theorem eventually_sum_psiNat_thirtyNineHundredths_to_half_le :
    ∀ᶠ X : ℕ in atTop,
      (∑ p ∈ taoOneTermExponentPrimeBand
          (39 / 100 : ℝ) (1 / 2 : ℝ) X,
          (psiNat (X / p ^ 2) p : ℝ)) ≤
        (X : ℝ) / (taoZ X) ^ (2 + 3 / 1000 : ℝ) := by
  have hband := eventually_sum_psiNat_exponentPrimeBand_le
    (α := (39 / 100 : ℝ)) (β := (1 / 2 : ℝ))
    (ε := (1 / 100 : ℝ)) (by norm_num) (by norm_num)
    (eventually_exponentPrimeBand_nonempty (by norm_num) (by norm_num))
    (by norm_num)
  filter_upwards [hband,
    tendsto_taoZ_atTop.eventually (eventually_ge_atTop (1 : ℝ))] with
      X hband' hz
  have hexponent : (2 + 3 / 1000 : ℝ) ≤
      39 / 100 + 1 / (1 / 2 : ℝ) - 1 / 100 := by
    norm_num
  have hpow := Real.rpow_le_rpow_of_exponent_le hz hexponent
  exact hband'.trans (div_le_div_of_nonneg_left (by positivity)
    (Real.rpow_pos_of_pos (taoZ_pos X) _) hpow)

/-- Concrete ambient prime range covering the fixed outside-central windows
from exponent `39/100` through `91/100` and from `109/100` through `63/50`. -/
noncomputable def taoBadIntervalOutsideCentralPrimeRange (X : ℕ) : Finset ℕ :=
  taoOneTermExponentPrimeBand (39 / 100 : ℝ) (1 / 2 : ℝ) X ∪
    taoBadIntervalOutsideCentralGridPrimeUnion X

/-- The complete ambient outside-central prime range has a fixed exponent
margin over two. -/
theorem eventually_sum_psiNat_outsideCentralPrimeRange_le :
    ∀ᶠ X : ℕ in atTop,
      (∑ p ∈ taoBadIntervalOutsideCentralPrimeRange X,
          (psiNat (X / p ^ 2) p : ℝ)) ≤
        233 * ((X : ℝ) / (taoZ X) ^ (2 + 3 / 1000 : ℝ)) := by
  filter_upwards [eventually_sum_psiNat_thirtyNineHundredths_to_half_le,
    eventually_forall_sum_psiNat_outsideCentralGridBand_le] with
      X hinitial hbands
  let f : ℕ → ℝ := fun p => (psiNat (X / p ^ 2) p : ℝ)
  have hgrid :
      (∑ p ∈ taoBadIntervalOutsideCentralGridPrimeUnion X, f p) ≤
        232 * ((X : ℝ) / (taoZ X) ^ (2 + 3 / 1000 : ℝ)) := by
    calc
      (∑ p ∈ taoBadIntervalOutsideCentralGridPrimeUnion X, f p) ≤
          ∑ k ∈ taoBadIntervalOutsideCentralGridIndices,
            ∑ p ∈ taoOneTermExponentPrimeBand
              (taoOneTermGridExponent 600 k)
              (taoOneTermGridExponent 600 (k + 1)) X, f p := by
        exact sum_biUnion_le_sum_of_nonneg _ _ f (fun _ => by positivity)
      _ ≤ ∑ _k ∈ taoBadIntervalOutsideCentralGridIndices,
          ((X : ℝ) / (taoZ X) ^ (2 + 3 / 1000 : ℝ)) := by
        apply Finset.sum_le_sum
        intro k hk
        exact hbands k hk
      _ = 232 * ((X : ℝ) / (taoZ X) ^ (2 + 3 / 1000 : ℝ)) := by
        have hcard : taoBadIntervalOutsideCentralGridIndices.card = 232 := by
          have hdisjoint : Disjoint (Finset.Ico 0 164) (Finset.Ico 236 304) := by
            rw [Finset.disjoint_left]
            intro k hkLower hkUpper
            simp only [Finset.mem_Ico] at hkLower hkUpper
            omega
          rw [taoBadIntervalOutsideCentralGridIndices,
            Finset.card_union_of_disjoint hdisjoint]
          norm_num
        rw [Finset.sum_const, hcard]
        norm_num
  calc
    (∑ p ∈ taoBadIntervalOutsideCentralPrimeRange X,
        (psiNat (X / p ^ 2) p : ℝ)) ≤
        (∑ p ∈ taoOneTermExponentPrimeBand
          (39 / 100 : ℝ) (1 / 2 : ℝ) X, f p) +
          ∑ p ∈ taoBadIntervalOutsideCentralGridPrimeUnion X, f p := by
      exact sum_union_le_add_sum_of_nonneg _ _ f (fun _ => by positivity)
    _ ≤ (X : ℝ) / (taoZ X) ^ (2 + 3 / 1000 : ℝ) +
        232 * ((X : ℝ) / (taoZ X) ^ (2 + 3 / 1000 : ℝ)) :=
      add_le_add hinitial hgrid
    _ = 233 * ((X : ℝ) / (taoZ X) ^ (2 + 3 / 1000 : ℝ)) := by ring

/-- A fixed positive exponent slack transfers a rounded cutoff from the
cofactor scale `2x` down to the source scale `x`. -/
theorem eventually_exponentCutoff_two_mul_le_of_lt
    {α β : ℝ} (hα : 0 < α) (hαβ : α < β) :
    ∀ᶠ x : ℕ in atTop,
      taoOneTermExponentCutoff α (2 * x) ≤
        taoOneTermExponentCutoff β x := by
  have hratioOne : (1 : ℝ) < β / α := by
    rw [lt_div_iff₀ hα]
    simpa only [one_mul] using hαβ
  filter_upwards [
    tendsto_log_taoZ_two_mul_div_log_taoZ.eventually
      (Iio_mem_nhds hratioOne),
    (Real.tendsto_log_atTop.comp tendsto_taoZ_atTop).eventually
      (eventually_gt_atTop (0 : ℝ))] with x hratio hlogZPos
  change 0 < Real.log (taoZ x) at hlogZPos
  have hstrict : Real.log (taoZ (2 * x)) <
      (β / α) * Real.log (taoZ x) :=
    (div_lt_iff₀ hlogZPos).mp hratio
  have hlogCompare :
      α * Real.log (taoZ (2 * x)) ≤ β * Real.log (taoZ x) := by
    have hscaled := mul_lt_mul_of_pos_left hstrict hα
    have hαne : α ≠ 0 := hα.ne'
    calc
      α * Real.log (taoZ (2 * x)) ≤
          α * ((β / α) * Real.log (taoZ x)) := hscaled.le
      _ = β * Real.log (taoZ x) := by field_simp
  unfold taoOneTermExponentCutoff
  apply Nat.ceil_mono
  rw [Real.rpow_def_of_pos (taoZ_pos _),
    Real.rpow_def_of_pos (taoZ_pos _)]
  exact Real.exp_le_exp.mpr (by simpa only [mul_comm] using hlogCompare)

/-- In the other direction, monotonicity of `z` and of a nonnegative power
transfers a smaller source exponent into a larger cofactor-scale exponent. -/
theorem eventually_exponentCutoff_le_two_mul_of_le
    {α β : ℝ} (hα : 0 ≤ α) (hαβ : α ≤ β) :
    ∀ᶠ x : ℕ in atTop,
      taoOneTermExponentCutoff α x ≤
        taoOneTermExponentCutoff β (2 * x) := by
  filter_upwards [eventually_taoZ_le_taoZ_two_mul,
    tendsto_taoZ_atTop.eventually (eventually_ge_atTop (1 : ℝ))] with
      x hzMono hzOne
  calc
    taoOneTermExponentCutoff α x ≤
        taoOneTermExponentCutoff α (2 * x) := by
      unfold taoOneTermExponentCutoff
      apply Nat.ceil_mono
      exact Real.rpow_le_rpow (taoZ_pos x).le hzMono hα
    _ ≤ taoOneTermExponentCutoff β (2 * x) := by
      exact taoOneTermExponentCutoff_mono_of_one_le
        (hzOne.trans hzMono) hαβ

/-- A rounded exponent band whose endpoints are grid points is covered by
the intervening adjacent grid cells. -/
theorem exponentPrimeBand_gridEndpoints_subset_biUnion
    {K lo hi X : ℕ} (hlohi : lo < hi) :
    taoOneTermExponentPrimeBand
        (taoOneTermGridExponent K lo)
        (taoOneTermGridExponent K hi) X ⊆
      (Finset.Ico lo hi).biUnion fun k =>
        taoOneTermExponentPrimeBand
          (taoOneTermGridExponent K k)
          (taoOneTermGridExponent K (k + 1)) X := by
  intro p hp
  have hpData := Finset.mem_filter.mp hp
  have hpBase := hpData.1
  have hpLower := hpData.2.1
  have hpUpper := hpData.2.2
  have hexists : ∃ j : ℕ, lo ≤ j ∧
      p ≤ taoOneTermExponentCutoff (taoOneTermGridExponent K j) X :=
    ⟨hi, hlohi.le, hpUpper⟩
  let j := Nat.find hexists
  have hjSpec : lo ≤ j ∧
      p ≤ taoOneTermExponentCutoff (taoOneTermGridExponent K j) X :=
    Nat.find_spec hexists
  have hjLe : j ≤ hi := Nat.find_min' hexists ⟨hlohi.le, hpUpper⟩
  have hjGt : lo < j := by
    by_contra hnot
    have hjEq : j = lo := by omega
    rw [hjEq] at hjSpec
    omega
  let k := j - 1
  have hkMem : k ∈ Finset.Ico lo hi := by
    rw [Finset.mem_Ico]
    dsimp only [k]
    omega
  have hkj : k + 1 = j := by
    dsimp only [k]
    omega
  have hkLower : taoOneTermExponentCutoff
      (taoOneTermGridExponent K k) X < p := by
    have hkNot := Nat.find_min hexists (show k < j by
      dsimp only [k]
      omega)
    have hkGe : lo ≤ k := (Finset.mem_Ico.mp hkMem).1
    by_contra hnot
    exact hkNot ⟨hkGe, Nat.le_of_not_gt hnot⟩
  have hkUpper : p ≤ taoOneTermExponentCutoff
      (taoOneTermGridExponent K (k + 1)) X := by
    rw [hkj]
    exact hjSpec.2
  rw [Finset.mem_biUnion]
  exact ⟨k, hkMem, Finset.mem_filter.mpr ⟨hpBase, hkLower, hkUpper⟩⟩

theorem taoOneTermGridExponent_sixHundred_zero :
    taoOneTermGridExponent 600 0 = (1 / 2 : ℝ) := by
  norm_num [taoOneTermGridExponent]

theorem taoOneTermGridExponent_sixHundred_oneSixtyFour :
    taoOneTermGridExponent 600 164 = (91 / 100 : ℝ) := by
  norm_num [taoOneTermGridExponent]

theorem taoOneTermGridExponent_sixHundred_twoThirtySix :
    taoOneTermGridExponent 600 236 = (109 / 100 : ℝ) := by
  norm_num [taoOneTermGridExponent]

theorem taoOneTermGridExponent_sixHundred_threeHundredFour :
    taoOneTermGridExponent 600 304 = (63 / 50 : ℝ) := by
  norm_num [taoOneTermGridExponent]

set_option maxRecDepth 4000 in
/-- The expanded fixed band below exponent one is covered by the concrete
outside-central ambient range. -/
theorem exponentPrimeBand_thirtyNine_to_ninetyOne_subset_outsideCentral
    {X : ℕ} :
    taoOneTermExponentPrimeBand (39 / 100 : ℝ) (91 / 100 : ℝ) X ⊆
      taoBadIntervalOutsideCentralPrimeRange X := by
  intro p hp
  have hpData := Finset.mem_filter.mp hp
  by_cases hpHalf : p ≤ taoOneTermExponentCutoff (1 / 2 : ℝ) X
  · apply Finset.mem_union_left
    exact Finset.mem_filter.mpr ⟨hpData.1, hpData.2.1, hpHalf⟩
  · apply Finset.mem_union_right
    have hpGridBand : p ∈ taoOneTermExponentPrimeBand
        (taoOneTermGridExponent 600 0)
        (taoOneTermGridExponent 600 164) X := by
      rw [taoOneTermGridExponent_sixHundred_zero,
        taoOneTermGridExponent_sixHundred_oneSixtyFour]
      exact Finset.mem_filter.mpr
        ⟨hpData.1, Nat.lt_of_not_ge hpHalf, hpData.2.2⟩
    have hpCells := exponentPrimeBand_gridEndpoints_subset_biUnion
      (K := 600) (lo := 0) (hi := 164) (X := X) (by norm_num) hpGridBand
    rw [taoBadIntervalOutsideCentralGridPrimeUnion, Finset.mem_biUnion]
    rw [Finset.mem_biUnion] at hpCells
    obtain ⟨k, hk, hpk⟩ := hpCells
    exact ⟨k, Finset.mem_union.mpr (Or.inl hk), hpk⟩

set_option maxRecDepth 4000 in
/-- The expanded fixed band above exponent one is covered by the concrete
outside-central ambient range. -/
theorem exponentPrimeBand_oneOhNine_to_oneTwentySix_subset_outsideCentral
    {X : ℕ} :
    taoOneTermExponentPrimeBand (109 / 100 : ℝ) (63 / 50 : ℝ) X ⊆
      taoBadIntervalOutsideCentralPrimeRange X := by
  intro p hp
  apply Finset.mem_union_right
  have hpGridBand : p ∈ taoOneTermExponentPrimeBand
      (taoOneTermGridExponent 600 236)
      (taoOneTermGridExponent 600 304) X := by
    rw [taoOneTermGridExponent_sixHundred_twoThirtySix,
      taoOneTermGridExponent_sixHundred_threeHundredFour]
    exact hp
  have hpCells := exponentPrimeBand_gridEndpoints_subset_biUnion
    (K := 600) (lo := 236) (hi := 304) (X := X) (by norm_num) hpGridBand
  rw [taoBadIntervalOutsideCentralGridPrimeUnion, Finset.mem_biUnion]
  rw [Finset.mem_biUnion] at hpCells
  obtain ⟨k, hk, hpk⟩ := hpCells
  exact ⟨k, Finset.mem_union.mpr (Or.inr hk), hpk⟩

/-- Literal source-scale outside-central windows.  The one-percent ambient
slack is used only to transfer from `x` to the exact cofactor scale `2x`. -/
noncomputable def taoBadIntervalSourceOutsideCentralPrimeRange
    (x : ℕ) : Finset ℕ :=
  taoOneTermExponentPrimeBand (2 / 5 : ℝ) (9 / 10 : ℝ) x ∪
    taoOneTermExponentPrimeBand (11 / 10 : ℝ) (5 / 4 : ℝ) x

set_option maxRecDepth 4000 in
/-- The literal fixed source windows embed in the expanded ambient range at
the exact cofactor scale. -/
theorem eventually_sourceOutsideCentralPrimeRange_subset :
    ∀ᶠ x : ℕ in atTop,
      taoBadIntervalSourceOutsideCentralPrimeRange x ⊆
        taoBadIntervalOutsideCentralPrimeRange (2 * x) := by
  filter_upwards [
    eventually_exponentCutoff_two_mul_le_of_lt
      (α := (39 / 100 : ℝ)) (β := (2 / 5 : ℝ)) (by norm_num) (by norm_num),
    eventually_exponentCutoff_le_two_mul_of_le
      (α := (9 / 10 : ℝ)) (β := (91 / 100 : ℝ)) (by norm_num) (by norm_num),
    eventually_exponentCutoff_two_mul_le_of_lt
      (α := (109 / 100 : ℝ)) (β := (11 / 10 : ℝ)) (by norm_num) (by norm_num),
    eventually_exponentCutoff_le_two_mul_of_le
      (α := (5 / 4 : ℝ)) (β := (63 / 50 : ℝ)) (by norm_num) (by norm_num)] with
      x hlowerLow hupperLow hlowerHigh hupperHigh
  intro p hp
  rw [taoBadIntervalSourceOutsideCentralPrimeRange, Finset.mem_union] at hp
  rcases hp with hpLow | hpHigh
  · have hpData := Finset.mem_filter.mp hpLow
    have hpBaseData := Finset.mem_filter.mp hpData.1
    have hpRange := Finset.mem_Icc.mp hpBaseData.1
    have hpSq : p * p ≤ 2 * x := by
      have hpSqX : p * p ≤ x := Nat.le_sqrt.mp hpRange.2
      omega
    have hpBase : p ∈ (Finset.Icc 2 (2 * x).sqrt).filter Nat.Prime := by
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_Icc.mpr ⟨hpRange.1, (Nat.le_sqrt.mpr hpSq)⟩,
        hpBaseData.2⟩
    apply exponentPrimeBand_thirtyNine_to_ninetyOne_subset_outsideCentral
    exact Finset.mem_filter.mpr
      ⟨hpBase, lt_of_le_of_lt hlowerLow hpData.2.1,
        hpData.2.2.trans hupperLow⟩
  · have hpData := Finset.mem_filter.mp hpHigh
    have hpBaseData := Finset.mem_filter.mp hpData.1
    have hpRange := Finset.mem_Icc.mp hpBaseData.1
    have hpSq : p * p ≤ 2 * x := by
      have hpSqX : p * p ≤ x := Nat.le_sqrt.mp hpRange.2
      omega
    have hpBase : p ∈ (Finset.Icc 2 (2 * x).sqrt).filter Nat.Prime := by
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_Icc.mpr ⟨hpRange.1, (Nat.le_sqrt.mpr hpSq)⟩,
        hpBaseData.2⟩
    apply exponentPrimeBand_oneOhNine_to_oneTwentySix_subset_outsideCentral
    exact Finset.mem_filter.mpr
      ⟨hpBase, lt_of_le_of_lt hlowerHigh hpData.2.1,
        hpData.2.2.trans hupperHigh⟩

/-- Any fixed positive multiple of the literal dyadic-length cutoff is
absorbed by any fixed positive power of Tao's `z` scale. -/
theorem eventually_const_mul_taoTypicalLengthCutoff_le_taoZ_rpow
    {C δ : ℝ} (hC : 0 < C) (hδ : 0 < δ) :
    ∀ᶠ x : ℕ in atTop,
      C * (taoTypicalLengthCutoff x : ℝ) ≤ (taoZ x) ^ δ := by
  have hlogZ : Tendsto (fun x : ℕ => Real.log (taoZ x)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_taoZ_atTop
  have hconst : Tendsto (fun x : ℕ =>
      Real.log (2 * C) / Real.log (taoZ x)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop hlogZ
  have hiter : Tendsto (fun x : ℕ =>
      20 * (iteratedLog x / Real.log (taoZ x))) atTop (𝓝 0) := by
    simpa using tendsto_iteratedLog_div_log_taoZ_zero.const_mul 20
  filter_upwards [
    hconst.eventually (Iio_mem_nhds (half_pos hδ)),
    hiter.eventually (Iio_mem_nhds (half_pos hδ)),
    hlogZ.eventually (eventually_gt_atTop (0 : ℝ)),
    (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop).eventually
      (eventually_ge_atTop (1 : ℝ))] with
      x hconstBound hiterBound hlogZPos hlogX
  have hlogXPos : 0 < Real.log (x : ℝ) := zero_lt_one.trans_le hlogX
  have hPpos : 0 < (Real.log (x : ℝ)) ^ (20 : ℕ) :=
    pow_pos hlogXPos 20
  have hPone : 1 ≤ (Real.log (x : ℝ)) ^ (20 : ℕ) :=
    one_le_pow₀ hlogX
  have hceil : (taoTypicalLengthCutoff x : ℝ) <
      (Real.log (x : ℝ)) ^ (20 : ℕ) + 1 := by
    simpa only [taoTypicalLengthCutoff] using
      Nat.ceil_lt_add_one (pow_nonneg hlogXPos.le 20)
  have hlength : (taoTypicalLengthCutoff x : ℝ) ≤
      2 * (Real.log (x : ℝ)) ^ (20 : ℕ) := by
    linarith
  have hconstMul : Real.log (2 * C) <
      (δ / 2) * Real.log (taoZ x) :=
    (div_lt_iff₀ hlogZPos).mp hconstBound
  have hiterDiv :
      (20 * iteratedLog x) / Real.log (taoZ x) < δ / 2 := by
    calc
      (20 * iteratedLog x) / Real.log (taoZ x) =
          20 * (iteratedLog x / Real.log (taoZ x)) := by ring
      _ < δ / 2 := hiterBound
  have hiterMul : 20 * iteratedLog x <
      (δ / 2) * Real.log (taoZ x) :=
    (div_lt_iff₀ hlogZPos).mp hiterDiv
  have htwoCPos : 0 < 2 * C := mul_pos (by norm_num) hC
  have hlogBound :
      Real.log (2 * C * (Real.log (x : ℝ)) ^ (20 : ℕ)) ≤
        δ * Real.log (taoZ x) := by
    rw [Real.log_mul htwoCPos.ne' hPpos.ne', Real.log_pow]
    change Real.log (2 * C) + 20 * iteratedLog x ≤
      δ * Real.log (taoZ x)
    linarith
  calc
    C * (taoTypicalLengthCutoff x : ℝ) ≤
        2 * C * (Real.log (x : ℝ)) ^ (20 : ℕ) := by
      nlinarith [mul_le_mul_of_nonneg_left hlength hC.le]
    _ ≤ (taoZ x) ^ δ :=
      Real.le_rpow_of_log_le (taoZ_pos x) hlogBound

/-- Before logarithmic absorption, the actual short normalized interval
union over the ambient outside-central range costs exactly the 233 prime
bands and the finite dyadic-length factor. -/
theorem eventually_card_taoShortSmoothPrimeFailureUnion_outsideCentral_raw :
    ∀ᶠ x : ℕ in atTop,
      ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalOutsideCentralPrimeRange (2 * x))).card : ℝ) ≤
        932 * (taoTypicalLengthCutoff x : ℝ) *
          ((2 * x : ℕ) /
            (taoZ (2 * x)) ^ (2 + 3 / 1000 : ℝ)) := by
  have hprime := tendsto_two_mul_nat_atTop.eventually
    eventually_sum_psiNat_outsideCentralPrimeRange_le
  filter_upwards [hprime, eventually_ge_atTop (2 : ℕ)] with x hsum hx
  have hcutoff : 0 < taoTypicalLengthCutoff x := by
    have hlog : 0 < Real.log (x : ℝ) := Real.log_pos (by exact_mod_cast hx)
    have hcutoffReal : (0 : ℝ) < taoTypicalLengthCutoff x :=
      (pow_pos hlog 20).trans_le (taoTypicalLengthCutoff_spec x)
    exact_mod_cast hcutoffReal
  have hfinite := card_taoShortSmoothPrimeFailureUnion_cast_le
    (taoBadIntervalOutsideCentralPrimeRange (2 * x)) hcutoff
  have hfinite' :
      ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalOutsideCentralPrimeRange (2 * x))).card : ℝ) ≤
        4 * (taoTypicalLengthCutoff x : ℝ) *
          ∑ p ∈ taoBadIntervalOutsideCentralPrimeRange (2 * x),
            (psiNat ((2 * x) / p ^ 2) p : ℝ) := by
    simpa only [badIntervalCofactorBudget] using hfinite
  calc
    ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalOutsideCentralPrimeRange (2 * x))).card : ℝ) ≤
        4 * (taoTypicalLengthCutoff x : ℝ) *
          ∑ p ∈ taoBadIntervalOutsideCentralPrimeRange (2 * x),
            (psiNat ((2 * x) / p ^ 2) p : ℝ) := hfinite'
    _ ≤ 4 * (taoTypicalLengthCutoff x : ℝ) *
        (233 * ((2 * x : ℕ) /
          (taoZ (2 * x)) ^ (2 + 3 / 1000 : ℝ))) := by
      exact mul_le_mul_of_nonneg_left hsum (by positivity)
    _ = 932 * (taoTypicalLengthCutoff x : ℝ) *
        ((2 * x : ℕ) /
          (taoZ (2 * x)) ^ (2 + 3 / 1000 : ℝ)) := by ring

/-- Absorbing the fixed grid and length cost leaves a
`z(2x)^(-2-1/500)` estimate. -/
theorem eventually_card_taoShortSmoothPrimeFailureUnion_outsideCentral_weak :
    ∀ᶠ x : ℕ in atTop,
      ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalOutsideCentralPrimeRange (2 * x))).card : ℝ) ≤
        (2 * x : ℕ) / (taoZ (2 * x)) ^ (2 + 1 / 500 : ℝ) := by
  have habsorb := tendsto_two_mul_nat_atTop.eventually
    (eventually_const_mul_taoTypicalLengthCutoff_le_taoZ_rpow
      (C := (932 : ℝ)) (δ := (1 / 1000 : ℝ)) (by norm_num) (by norm_num))
  filter_upwards [
    eventually_card_taoShortSmoothPrimeFailureUnion_outsideCentral_raw,
    habsorb, eventually_ge_atTop (1 : ℕ)] with x hunion habsorb' hx
  have hlength : 932 * (taoTypicalLengthCutoff x : ℝ) ≤
      (taoZ (2 * x)) ^ (1 / 1000 : ℝ) := by
    calc
      932 * (taoTypicalLengthCutoff x : ℝ) ≤
          932 * (taoTypicalLengthCutoff (2 * x) : ℝ) := by
        gcongr
        exact_mod_cast taoTypicalLengthCutoff_le_two_mul hx
      _ ≤ (taoZ (2 * x)) ^ (1 / 1000 : ℝ) := habsorb'
  have hzPos : 0 < taoZ (2 * x) := taoZ_pos _
  calc
    ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalOutsideCentralPrimeRange (2 * x))).card : ℝ) ≤
        932 * (taoTypicalLengthCutoff x : ℝ) *
          ((2 * x : ℕ) /
            (taoZ (2 * x)) ^ (2 + 3 / 1000 : ℝ)) := hunion
    _ ≤ (taoZ (2 * x)) ^ (1 / 1000 : ℝ) *
          ((2 * x : ℕ) /
            (taoZ (2 * x)) ^ (2 + 3 / 1000 : ℝ)) := by
      gcongr
    _ = (2 * x : ℕ) / (taoZ (2 * x)) ^ (2 + 1 / 500 : ℝ) := by
      rw [show (2 + 3 / 1000 : ℝ) =
          1 / 1000 + (2 + 1 / 500) by norm_num,
        Real.rpow_add hzPos]
      field_simp [ne_of_gt
        (Real.rpow_pos_of_pos hzPos (1 / 1000 : ℝ))]

/-- Final source-scale estimate for the actual short normalized intervals in
the two fixed outside-central windows. -/
theorem eventually_card_taoSourceOutsideCentralPrimeFailureUnion_le :
    ∀ᶠ x : ℕ in atTop,
      ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalSourceOutsideCentralPrimeRange x)).card : ℝ) ≤
        (x : ℝ) / (taoZ x) ^ (2 + 1 / 1000 : ℝ) := by
  have hzPowerTop : Tendsto (fun z : ℝ => z ^ (1 / 1000 : ℝ)) atTop atTop :=
    tendsto_rpow_atTop (by norm_num)
  filter_upwards [eventually_sourceOutsideCentralPrimeRange_subset,
    eventually_card_taoShortSmoothPrimeFailureUnion_outsideCentral_weak,
    eventually_taoZ_le_taoZ_two_mul,
    (hzPowerTop.comp tendsto_taoZ_atTop).eventually
      (eventually_ge_atTop (2 : ℝ))] with
      x hsubset hunion hzMono hzPower
  have hcard : (taoShortSmoothPrimeFailureUnion x
      (taoBadIntervalSourceOutsideCentralPrimeRange x)).card ≤
        (taoShortSmoothPrimeFailureUnion x
          (taoBadIntervalOutsideCentralPrimeRange (2 * x))).card :=
    Finset.card_le_card (taoShortSmoothPrimeFailureUnion_mono hsubset)
  have hcardReal :
      ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalSourceOutsideCentralPrimeRange x)).card : ℝ) ≤
        ((taoShortSmoothPrimeFailureUnion x
          (taoBadIntervalOutsideCentralPrimeRange (2 * x))).card : ℝ) := by
    exact_mod_cast hcard
  have hzPos : 0 < taoZ x := taoZ_pos x
  have hpowMono : (taoZ x) ^ (2 + 1 / 500 : ℝ) ≤
      (taoZ (2 * x)) ^ (2 + 1 / 500 : ℝ) :=
    Real.rpow_le_rpow hzPos.le hzMono (by norm_num)
  have hscale :
      (2 * x : ℕ) / (taoZ (2 * x)) ^ (2 + 1 / 500 : ℝ) ≤
        (2 * (x : ℝ)) / (taoZ x) ^ (2 + 1 / 500 : ℝ) := by
    have hfirst := div_le_div_of_nonneg_left
      (show (0 : ℝ) ≤ (2 * x : ℕ) by positivity)
      (Real.rpow_pos_of_pos hzPos _) hpowMono
    simpa only [Nat.cast_mul, Nat.cast_ofNat] using hfirst
  have hcoeff : (2 : ℝ) / (taoZ x) ^ (1 / 1000 : ℝ) ≤ 1 :=
    (div_le_one (Real.rpow_pos_of_pos hzPos _)).2 hzPower
  calc
    ((taoShortSmoothPrimeFailureUnion x
        (taoBadIntervalSourceOutsideCentralPrimeRange x)).card : ℝ) ≤
        ((taoShortSmoothPrimeFailureUnion x
          (taoBadIntervalOutsideCentralPrimeRange (2 * x))).card : ℝ) :=
      hcardReal
    _ ≤ (2 * x : ℕ) /
        (taoZ (2 * x)) ^ (2 + 1 / 500 : ℝ) := hunion
    _ ≤ (2 * (x : ℝ)) /
        (taoZ x) ^ (2 + 1 / 500 : ℝ) := hscale
    _ = ((2 : ℝ) / (taoZ x) ^ (1 / 1000 : ℝ)) *
        ((x : ℝ) / (taoZ x) ^ (2 + 1 / 1000 : ℝ)) := by
      rw [show (2 + 1 / 500 : ℝ) =
        1 / 1000 + (2 + 1 / 1000) by norm_num, Real.rpow_add hzPos]
      field_simp [ne_of_gt
        (Real.rpow_pos_of_pos hzPos (1 / 1000 : ℝ)),
        ne_of_gt (Real.rpow_pos_of_pos hzPos (2 + 1 / 1000 : ℝ))]
    _ ≤ 1 * ((x : ℝ) / (taoZ x) ^ (2 + 1 / 1000 : ℝ)) := by
      exact mul_le_mul_of_nonneg_right hcoeff (by positivity)
    _ = (x : ℝ) / (taoZ x) ^ (2 + 1 / 1000 : ℝ) := one_mul _

end

