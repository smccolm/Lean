import RiemannZeta.GuthMaynard.KloostermanPrimeWeil
import Mathlib.GroupTheory.Coset.Basic
import Mathlib.RingTheory.ZMod.UnitsCyclic

/-!
# Prime-power Kloosterman sums

This module develops the local lifting and stationary-phase layer needed for
the prime-power part of the classical Weil--Estermann bound used in DFI
equation (25).
-/

namespace RiemannZeta.GuthMaynard

open Complex
open scoped BigOperators
open Classical

/-- The `squareFiber` definition used by the source-facing construction in `KloostermanPrimePower`. -/
def squareFiber (G : Type*) [CommGroup G] (c : G) :=
  {x : G // x ^ 2 = c}

/-- The `squareFiberEquivPowKer` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def squareFiberEquivPowKer
    {G : Type*} [CommGroup G] (c x : G) (hx : x ^ 2 = c) :
    squareFiber G c ≃ (powMonoidHom 2 : G →* G).ker := by
  let f : G →* G := powMonoidHom 2
  let e : squareFiber G c ≃ f ⁻¹' {f x} :=
    { toFun := fun y => ⟨y.1, by
        simp only [Set.mem_preimage, Set.mem_singleton_iff, f,
          powMonoidHom_apply]
        exact y.2.trans hx.symm⟩
      invFun := fun y => ⟨y.1, by
        simpa only [Set.mem_preimage, Set.mem_singleton_iff, f,
          powMonoidHom_apply, hx] using y.2⟩
      left_inv := fun y => by rfl
      right_inv := fun y => by rfl }
  exact e.trans (f.fiberEquivKer x)

/-- In a finite cyclic commutative group, a quadratic equation has at most
two solutions. -/
theorem card_squareFiber_le_two
    (G : Type*) [CommGroup G] [Fintype G] [IsCyclic G] (c : G) :
    Nat.card (squareFiber G c) ≤ 2 := by
  letI : Finite (squareFiber G c) := by
    dsimp only [squareFiber]
    infer_instance
  by_cases h : Nonempty (squareFiber G c)
  · let x : squareFiber G c := Classical.choice h
    calc
      Nat.card (squareFiber G c) =
          Nat.card (powMonoidHom 2 : G →* G).ker :=
        Nat.card_congr (squareFiberEquivPowKer c x.1 x.2)
      _ = (Nat.card G).gcd 2 := by
        exact IsCyclic.card_powMonoidHom_ker G 2
      _ ≤ 2 := Nat.gcd_le_right _ (by omega)
  · letI : IsEmpty (squareFiber G c) := not_nonempty_iff.mp h
    rw [Finite.card_eq_zero_iff.mpr inferInstance]
    omega

/-- A square fiber is either empty or a torsor for the kernel of the
squaring homomorphism.  This version does not assume that the ambient group
is cyclic and is used for the unit group modulo a power of two. -/
theorem card_squareFiber_le_card_powMonoidHom_ker
    (G : Type*) [CommGroup G] [Fintype G] (c : G) :
    Nat.card (squareFiber G c) ≤
      Nat.card (powMonoidHom 2 : G →* G).ker := by
  letI : Finite (squareFiber G c) := by
    dsimp only [squareFiber]
    infer_instance
  by_cases h : Nonempty (squareFiber G c)
  · let x : squareFiber G c := Classical.choice h
    exact (Nat.card_congr (squareFiberEquivPowKer c x.1 x.2)).le
  · letI : IsEmpty (squareFiber G c) := not_nonempty_iff.mp h
    rw [Finite.card_eq_zero_iff.mpr inferInstance]
    exact Nat.zero_le _

/-- The kernel of squaring on the units modulo `2^r` has at most four
elements.  For `r ≥ 3`, the cyclic subgroup generated by `5^2` supplies
the complementary lower bound on the image; the two small moduli are
handled directly. -/
theorem card_powMonoidHom_two_ker_zmod_two_pow_le_four
    (r : ℕ) (hr : 0 < r) :
    Nat.card
        (powMonoidHom 2 : (ZMod (2 ^ r))ˣ →* (ZMod (2 ^ r))ˣ).ker ≤ 4 := by
  let G := (ZMod (2 ^ r))ˣ
  let f : G →* G := powMonoidHom 2
  by_cases hr3 : 3 ≤ r
  · let five : G :=
      ZMod.unitOfCoprime 5
        ((show Nat.Coprime 5 2 by norm_num).pow_right r)
    have horderFive : orderOf five = 2 ^ (r - 2) := by
      rw [← ZMod.orderOf_five (r - 2), show r - 2 + 2 = r by omega,
        show (5 : ZMod (2 ^ r)) = five by rfl, orderOf_units]
    have horderFiveSq : orderOf (five ^ 2) = 2 ^ (r - 3) := by
      rw [orderOf_pow, horderFive]
      have hpow : r - 2 = (r - 3) + 1 := by omega
      rw [hpow, pow_succ]
      rw [Nat.gcd_eq_right (dvd_mul_left 2 (2 ^ (r - 3)))]
      simp [mul_comm]
    have hfiveSqRange : five ^ 2 ∈ f.range := by
      exact ⟨five, rfl⟩
    have hsub : Subgroup.zpowers (five ^ 2) ≤ f.range :=
      Subgroup.zpowers_le.mpr hfiveSqRange
    have hrangeLower : 2 ^ (r - 3) ≤ Nat.card f.range := by
      rw [← horderFiveSq, ← Nat.card_zpowers]
      exact Subgroup.card_le_of_le hsub
    have hgroupCard : Nat.card G = 2 ^ (r - 1) := by
      rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient,
        Nat.totient_prime_pow Nat.prime_two hr]
      simp
    have hkernelRange : Nat.card f.ker * Nat.card f.range = Nat.card G := by
      rw [← Subgroup.index_ker f]
      exact f.ker.card_mul_index
    have hfactor : 2 ^ (r - 1) = 4 * 2 ^ (r - 3) := by
      rw [show r - 1 = 2 + (r - 3) by omega, pow_add]
      norm_num
    have hpositive : 0 < 2 ^ (r - 3) := pow_pos (by omega) _
    apply Nat.le_of_mul_le_mul_right (c := 2 ^ (r - 3))
    · calc
        Nat.card f.ker * 2 ^ (r - 3) ≤
            Nat.card f.ker * Nat.card f.range :=
          Nat.mul_le_mul_left _ hrangeLower
        _ = 4 * 2 ^ (r - 3) := by rw [hkernelRange, hgroupCard, hfactor]
    · exact hpositive
  · have hrle : r ≤ 2 := by omega
    change Nat.card f.ker ≤ 4
    have hle : Nat.card f.ker ≤ Nat.card G :=
      Subgroup.card_le_card_group f.ker
    change Nat.card f.ker ≤ Nat.card (ZMod (2 ^ r))ˣ at hle
    have hGcard : Nat.card (ZMod (2 ^ r))ˣ = 2 ^ (r - 1) := by
      rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient,
        Nat.totient_prime_pow Nat.prime_two hr]
      simp
    rw [hGcard] at hle
    have hpow : 2 ^ (r - 1) ≤ 4 := by
      have hr12 : r = 1 ∨ r = 2 := by omega
      rcases hr12 with rfl | rfl <;> norm_num
    exact hle.trans (by simpa using hpow)

/-- A quadratic equation in the unit group modulo `2^r` has at most four
solutions. -/
theorem card_squareFiber_zmod_two_pow_le_four
    (r : ℕ) (hr : 0 < r) (c : (ZMod (2 ^ r))ˣ) :
    Nat.card (squareFiber (ZMod (2 ^ r))ˣ c) ≤ 4 :=
  (card_squareFiber_le_card_powMonoidHom_ker (ZMod (2 ^ r))ˣ c).trans
    (card_powMonoidHom_two_ker_zmod_two_pow_le_four r hr)

/-- The `inverseStationaryFiber` definition used by the source-facing construction in `KloostermanPrimePower`. -/
def inverseStationaryFiber (G : Type*) [CommGroup G] (a b : G) :=
  {x : G // a * x = b * x⁻¹}

/-- Multiplicative stationary points are exactly a fiber of the squaring
map. -/
def inverseStationaryFiberEquivSquareFiber
    (G : Type*) [CommGroup G] (a b : G) :
    inverseStationaryFiber G a b ≃ squareFiber G (a⁻¹ * b) where
  toFun x := ⟨x.1, by
    rw [pow_two]
    calc
      x.1 * x.1 = a⁻¹ * (a * x.1) * x.1 := by group
      _ = a⁻¹ * (b * x.1⁻¹) * x.1 := by rw [x.2]
      _ = a⁻¹ * b := by group⟩
  invFun x := ⟨x.1, by
    calc
      a * x.1 = a * x.1 ^ 2 * x.1⁻¹ := by rw [pow_two]; group
      _ = a * (a⁻¹ * b) * x.1⁻¹ := by rw [x.2]
      _ = b * x.1⁻¹ := by group⟩
  left_inv x := by rfl
  right_inv x := by rfl

theorem card_inverseStationaryFiber_le_two
    (G : Type*) [CommGroup G] [Fintype G] [IsCyclic G] (a b : G) :
    Nat.card (inverseStationaryFiber G a b) ≤ 2 := by
  rw [Nat.card_congr (inverseStationaryFiberEquivSquareFiber G a b)]
  exact card_squareFiber_le_two G (a⁻¹ * b)

/-- The `zmodStationaryFiber` definition used by the source-facing construction in `KloostermanPrimePower`. -/
def zmodStationaryFiber (q : ℕ) (A B : ZMod q) :=
  {u : (ZMod q)ˣ // A * (u : ZMod q) - B * (↑(u⁻¹) : ZMod q) = 0}

/-- The `zmodStationaryFiberEquivInverse` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def zmodStationaryFiberEquivInverse
    (q : ℕ) (A B : ZMod q) (hA : IsUnit A) (hB : IsUnit B) :
    zmodStationaryFiber q A B ≃
      inverseStationaryFiber (ZMod q)ˣ hA.unit hB.unit where
  toFun u := ⟨u.1, by
    apply Units.ext
    simpa only [IsUnit.unit_spec] using sub_eq_zero.mp u.2⟩
  invFun u := ⟨u.1, by
    apply sub_eq_zero.mpr
    simpa only [IsUnit.unit_spec] using congrArg Units.val u.2⟩
  left_inv u := by rfl
  right_inv u := by rfl

theorem card_zmodStationaryFiber_le_two
    (q : ℕ) [NeZero q] [IsCyclic (ZMod q)ˣ]
    (A B : ZMod q) (hA : IsUnit A) (hB : IsUnit B) :
    Nat.card (zmodStationaryFiber q A B) ≤ 2 := by
  rw [Nat.card_congr (zmodStationaryFiberEquivInverse q A B hA hB)]
  exact card_inverseStationaryFiber_le_two (ZMod q)ˣ hA.unit hB.unit

/-- The 2-adic stationary congruence has at most four unit solutions. -/
theorem card_zmodStationaryFiber_two_pow_le_four
    (r : ℕ) (hr : 0 < r) (A B : ZMod (2 ^ r))
    (hA : IsUnit A) (hB : IsUnit B) :
    Nat.card (zmodStationaryFiber (2 ^ r) A B) ≤ 4 := by
  rw [Nat.card_congr
    (zmodStationaryFiberEquivInverse (2 ^ r) A B hA hB)]
  rw [Nat.card_congr
    (inverseStationaryFiberEquivSquareFiber
      (ZMod (2 ^ r))ˣ hA.unit hB.unit)]
  exact card_squareFiber_zmod_two_pow_le_four r hr _

/-- At modulus two the unit group is trivial, so the stationary congruence
has at most one solution. -/
theorem card_zmodStationaryFiber_two_le_one
    (A B : ZMod 2) (hA : IsUnit A) (hB : IsUnit B) :
    Nat.card (zmodStationaryFiber 2 A B) ≤ 1 := by
  rw [Nat.card_congr (zmodStationaryFiberEquivInverse 2 A B hA hB)]
  rw [Nat.card_congr
    (inverseStationaryFiberEquivSquareFiber (ZMod 2)ˣ hA.unit hB.unit)]
  calc
    Nat.card (squareFiber (ZMod 2)ˣ (hA.unit⁻¹ * hB.unit)) ≤
        Nat.card (ZMod 2)ˣ := Finite.card_subtype_le _
    _ = 1 := by
      rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient]
      norm_num

/-- Mixed-radix decomposition `z = y + p*w` of residues modulo `q*p`. -/
def zmodDigitEquiv (q p : ℕ) [NeZero q] [NeZero p] :
    ZMod q × ZMod p ≃ ZMod (q * p) :=
  (Equiv.prodCongr (ZMod.finEquiv q).symm.toEquiv
      (ZMod.finEquiv p).symm.toEquiv).trans
    (finProdFinEquiv.trans (ZMod.finEquiv (q * p)).toEquiv)

theorem zmodDigitEquiv_apply
    (q p : ℕ) [NeZero q] [NeZero p] (w : ZMod q) (y : ZMod p) :
    zmodDigitEquiv q p ⟨w, y⟩ =
      (y.val + p * w.val : ℕ) := by
  rcases q with _ | q
  · exact (NeZero.ne 0 rfl).elim
  rcases p with _ | p
  · exact (NeZero.ne 0 rfl).elim
  apply ZMod.val_injective
  have hw := w.val_lt
  have hy := y.val_lt
  change y.val + (p + 1) * w.val =
    ((y.val + (p + 1) * w.val : ℕ) : ZMod ((q + 1) * (p + 1))).val
  rw [ZMod.val_natCast_of_lt]
  nlinarith

/-- The `differencePairEquiv` definition used by the source-facing construction in `KloostermanPrimePower`. -/
def differencePairEquiv (G : Type*) [AddGroup G] : G × G ≃ G × G where
  toFun xy := (xy.1 - xy.2, xy.2)
  invFun hy := (hy.1 + hy.2, hy.2)
  left_inv xy := by
    ext <;> simp
  right_inv hy := by
    ext <;> simp

theorem differencePairEquiv_symm_apply
    (G : Type*) [AddGroup G] (h y : G) :
    (differencePairEquiv G).symm (h, y) = (h + y, y) := rfl

theorem star_stdAddChar (q : ℕ) [NeZero q] (x : ZMod q) :
    star (ZMod.stdAddChar x : ℂ) = ZMod.stdAddChar (-x) := by
  have hq : 0 < ringChar (ZMod q) := by
    rw [ZMod.ringChar_zmod_n]
    exact Nat.pos_of_ne_zero (NeZero.ne q)
  calc
    star (ZMod.stdAddChar x : ℂ) =
        starRingEnd ℂ (ZMod.stdAddChar x) := rfl
    _ = (ZMod.stdAddChar⁻¹) x := AddChar.starComp_apply hq x
    _ = ZMod.stdAddChar (-x) := AddChar.inv_apply _ _

/-- The `quadraticGaussSum` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def quadraticGaussSum
    (p : ℕ) [NeZero p] (c d : ZMod p) : ℂ :=
  ∑ x : ZMod p, ZMod.stdAddChar (c * x + d * x ^ 2)

theorem star_mul_quadraticGaussSum
    (p : ℕ) [Fact p.Prime] (hp2 : p ≠ 2)
    (c d : ZMod p) (hd : d ≠ 0) :
    star (quadraticGaussSum p c d) * quadraticGaussSum p c d = (p : ℂ) := by
  have htwo : (2 : ZMod p) ≠ 0 := by
    intro h
    have hdiv : p ∣ 2 := (ZMod.natCast_eq_zero_iff 2 p).mp h
    have hle : p ≤ 2 := Nat.le_of_dvd (by omega) hdiv
    have hone : 1 < p := (show p.Prime from Fact.out).one_lt
    exact hp2 (by omega)
  have hcoeff (h : ZMod p) : -(2 * d * h) = 0 ↔ h = 0 := by
    simp only [neg_eq_zero, mul_eq_zero, htwo, hd, false_or]
  have horth (C : ZMod p) :
      (∑ y : ZMod p, (ZMod.stdAddChar (y * C) : ℂ)) =
        if C = 0 then (p : ℂ) else 0 := by
    simpa [ZMod.card] using
      (AddChar.sum_mulShift C (ZMod.isPrimitive_stdAddChar p))
  unfold quadraticGaussSum
  rw [star_sum, Finset.sum_mul]
  simp_rw [Finset.mul_sum]
  calc
    (∑ x : ZMod p, ∑ y : ZMod p,
        star (ZMod.stdAddChar (c * x + d * x ^ 2) : ℂ) *
          ZMod.stdAddChar (c * y + d * y ^ 2)) =
        ∑ x : ZMod p, ∑ y : ZMod p,
          ZMod.stdAddChar
            (-(c * x + d * x ^ 2) + (c * y + d * y ^ 2)) := by
      apply Finset.sum_congr rfl
      intro x _hx
      apply Finset.sum_congr rfl
      intro y _hy
      rw [star_stdAddChar, ← ZMod.stdAddChar.map_add_eq_mul]
    _ = ∑ h : ZMod p, ∑ y : ZMod p,
          ZMod.stdAddChar
            (-(c * (h + y) + d * (h + y) ^ 2) +
              (c * y + d * y ^ 2)) := by
      have hpair :
          (∑ xy : ZMod p × ZMod p,
            ZMod.stdAddChar
              (-(c * xy.1 + d * xy.1 ^ 2) +
                (c * xy.2 + d * xy.2 ^ 2))) =
          ∑ hy : ZMod p × ZMod p,
            ZMod.stdAddChar
              (-(c * (hy.1 + hy.2) + d * (hy.1 + hy.2) ^ 2) +
                (c * hy.2 + d * hy.2 ^ 2)) := by
        apply Fintype.sum_equiv (differencePairEquiv (ZMod p))
        rintro ⟨x, y⟩
        apply congrArg ZMod.stdAddChar
        change (-(c * x + d * x ^ 2) + (c * y + d * y ^ 2)) =
          (-(c * ((x - y) + y) + d * ((x - y) + y) ^ 2) +
            (c * y + d * y ^ 2))
        rw [sub_add_cancel]
      simpa only [Fintype.sum_prod_type] using hpair
    _ = ∑ h : ZMod p, ∑ y : ZMod p,
          ZMod.stdAddChar
            (-(c * h + d * h ^ 2) + (-(2 * d * h)) * y) := by
      apply Finset.sum_congr rfl
      intro h _hh
      apply Finset.sum_congr rfl
      intro y _hy
      apply congrArg ZMod.stdAddChar
      ring
    _ = ∑ h : ZMod p,
          ZMod.stdAddChar (-(c * h + d * h ^ 2)) *
            ∑ y : ZMod p, ZMod.stdAddChar ((-(2 * d * h)) * y) := by
      apply Finset.sum_congr rfl
      intro h _hh
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro y _hy
      rw [← ZMod.stdAddChar.map_add_eq_mul]
    _ = ∑ h : ZMod p,
          ZMod.stdAddChar (-(c * h + d * h ^ 2)) *
            if h = 0 then (p : ℂ) else 0 := by
      apply Finset.sum_congr rfl
      intro h _hh
      congr 1
      rw [show (∑ y : ZMod p, ZMod.stdAddChar ((-(2 * d * h)) * y)) =
          ∑ y : ZMod p, ZMod.stdAddChar (y * (-(2 * d * h))) by
            apply Finset.sum_congr rfl
            intro y _hy
            rw [mul_comm]]
      rw [horth]
      simp only [hcoeff h]
    _ = (p : ℂ) := by simp

theorem norm_quadraticGaussSum
    (p : ℕ) [Fact p.Prime] (hp2 : p ≠ 2)
    (c d : ZMod p) (hd : d ≠ 0) :
    ‖quadraticGaussSum p c d‖ = Real.sqrt p := by
  let G := quadraticGaussSum p c d
  have hcomplex : ((‖G‖ ^ 2 : ℝ) : ℂ) = (p : ℂ) := by
    calc
      ((‖G‖ ^ 2 : ℝ) : ℂ) = star G * G := by
        push_cast
        rw [← Complex.conj_mul' G]
        rfl
      _ = (p : ℂ) := star_mul_quadraticGaussSum p hp2 c d hd
  have hsquare : ‖G‖ ^ 2 = (p : ℝ) := by exact_mod_cast hcomplex
  have hsqrt : Real.sqrt p ^ 2 = (p : ℝ) :=
    Real.sq_sqrt (by positivity)
  nlinarith [norm_nonneg G, Real.sqrt_nonneg (p : ℝ)]

/-- The elementary cardinality bound for a quadratic Gauss sum.  Unlike the
sharp odd-prime evaluation, this remains valid at `p = 2`. -/
theorem norm_quadraticGaussSum_le_card
    (p : ℕ) [NeZero p] (c d : ZMod p) :
    ‖quadraticGaussSum p c d‖ ≤ (p : ℝ) := by
  unfold quadraticGaussSum
  calc
    ‖∑ x : ZMod p, ZMod.stdAddChar (c * x + d * x ^ 2)‖ ≤
        ∑ x : ZMod p, ‖ZMod.stdAddChar (c * x + d * x ^ 2)‖ :=
      norm_sum_le _ _
    _ = ∑ _x : ZMod p, (1 : ℝ) := by
      apply Finset.sum_congr rfl
      intro x _hx
      exact AddChar.norm_apply _ _
    _ = (p : ℝ) := by simp [ZMod.card]

theorem quadraticPhase_zmodDigit
    (q p : ℕ) [NeZero q] [NeZero p]
    (C D : ZMod (q * p)) (w : ZMod q) (y : ZMod p) :
    let z := zmodDigitEquiv q p ⟨w, y⟩
    z * C + (q : ZMod (q * p)) * z ^ 2 * D =
      (y.val : ZMod (q * p)) * C +
        (q : ZMod (q * p)) * (y.val : ZMod (q * p)) ^ 2 * D +
        (p : ZMod (q * p)) * (w.val : ZMod (q * p)) * C := by
  dsimp only
  rw [zmodDigitEquiv_apply]
  push_cast
  have hmod : ((q * p : ℕ) : ZMod (q * p)) = 0 := by simp
  calc
    ((y.val : ZMod (q * p)) +
          (p : ZMod (q * p)) * (w.val : ZMod (q * p))) * C +
        (q : ZMod (q * p)) *
          ((y.val : ZMod (q * p)) +
            (p : ZMod (q * p)) * (w.val : ZMod (q * p))) ^ 2 * D =
      (y.val : ZMod (q * p)) * C +
        (q : ZMod (q * p)) * (y.val : ZMod (q * p)) ^ 2 * D +
        (p : ZMod (q * p)) * (w.val : ZMod (q * p)) * C +
        (q : ZMod (q * p)) * (p : ZMod (q * p)) *
          (2 * (y.val : ZMod (q * p)) * (w.val : ZMod (q * p)) +
            (p : ZMod (q * p)) * (w.val : ZMod (q * p)) ^ 2) * D := by
        ring
    _ = _ := by
      have hqp : (q : ZMod (q * p)) * (p : ZMod (q * p)) = 0 := by
        rw [← Nat.cast_mul]
        exact hmod
      rw [hqp]
      ring

theorem stdAddChar_modulus_factor_right
    (q p : ℕ) [NeZero q] [NeZero p] (x : ZMod (q * p)) :
    ZMod.stdAddChar ((p : ZMod (q * p)) * x) =
      ZMod.stdAddChar (x.cast : ZMod q) := by
  rw [← ZMod.natCast_zmod_val x]
  rw [show (p : ZMod (q * p)) * (x.val : ZMod (q * p)) =
      ((p * x.val : ℕ) : ZMod (q * p)) by push_cast; rfl]
  rw [show ((x.val : ZMod (q * p)).cast : ZMod q) =
      (x.val : ZMod q) by
        exact ZMod.cast_natCast (dvd_mul_right q p) x.val]
  rw [show ((p * x.val : ℕ) : ZMod (q * p)) =
      (((p * x.val : ℕ) : ℤ) : ZMod (q * p)) by norm_cast]
  rw [show (x.val : ZMod q) = (((x.val : ℕ) : ℤ) : ZMod q) by norm_cast]
  rw [ZMod.stdAddChar_coe, ZMod.stdAddChar_coe]
  apply congrArg Complex.exp
  have hp : (p : ℂ) ≠ 0 := by exact_mod_cast NeZero.ne p
  have hq : (q : ℂ) ≠ 0 := by exact_mod_cast NeZero.ne q
  push_cast
  field_simp

theorem stdAddChar_modulus_factor_left
    (q p : ℕ) [NeZero q] [NeZero p] (x : ZMod (q * p)) :
    ZMod.stdAddChar ((q : ZMod (q * p)) * x) =
      ZMod.stdAddChar (x.cast : ZMod p) := by
  rw [← ZMod.natCast_zmod_val x]
  rw [show (q : ZMod (q * p)) * (x.val : ZMod (q * p)) =
      ((q * x.val : ℕ) : ZMod (q * p)) by push_cast; rfl]
  rw [show ((x.val : ZMod (q * p)).cast : ZMod p) =
      (x.val : ZMod p) by
        exact ZMod.cast_natCast (dvd_mul_left p q) x.val]
  rw [show ((q * x.val : ℕ) : ZMod (q * p)) =
      (((q * x.val : ℕ) : ℤ) : ZMod (q * p)) by norm_cast]
  rw [show (x.val : ZMod p) = (((x.val : ℕ) : ℤ) : ZMod p) by norm_cast]
  rw [ZMod.stdAddChar_coe, ZMod.stdAddChar_coe]
  apply congrArg Complex.exp
  have hp : (p : ℂ) ≠ 0 := by exact_mod_cast NeZero.ne p
  have hq : (q : ℂ) ≠ 0 := by exact_mod_cast NeZero.ne q
  push_cast
  field_simp

/-- The `quadraticLiftSum` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def quadraticLiftSum
    (q p : ℕ) [NeZero q] [NeZero p] (C D : ZMod (q * p)) : ℂ :=
  ∑ z : ZMod (q * p),
    ZMod.stdAddChar (z * C + (q : ZMod (q * p)) * z ^ 2 * D)

theorem quadraticLiftSum_decomposition
    (q p : ℕ) [NeZero q] [NeZero p] (C D : ZMod (q * p)) :
    quadraticLiftSum q p C D =
      ∑ y : ZMod p,
        ZMod.stdAddChar
            ((y.val : ZMod (q * p)) * C +
              (q : ZMod (q * p)) * (y.val : ZMod (q * p)) ^ 2 * D) *
          ∑ w : ZMod q, ZMod.stdAddChar (w * (C.cast : ZMod q)) := by
  unfold quadraticLiftSum
  calc
    (∑ z : ZMod (q * p),
        ZMod.stdAddChar (z * C + (q : ZMod (q * p)) * z ^ 2 * D)) =
      ∑ wy : ZMod q × ZMod p,
        ZMod.stdAddChar
          ((zmodDigitEquiv q p wy) * C +
            (q : ZMod (q * p)) * (zmodDigitEquiv q p wy) ^ 2 * D) := by
      symm
      apply Fintype.sum_equiv (zmodDigitEquiv q p)
      intro wy
      rfl
    _ = ∑ w : ZMod q, ∑ y : ZMod p,
        ZMod.stdAddChar
          ((zmodDigitEquiv q p ⟨w, y⟩) * C +
            (q : ZMod (q * p)) * (zmodDigitEquiv q p ⟨w, y⟩) ^ 2 * D) := by
      rw [Fintype.sum_prod_type]
    _ = ∑ w : ZMod q, ∑ y : ZMod p,
        ZMod.stdAddChar
            ((y.val : ZMod (q * p)) * C +
              (q : ZMod (q * p)) * (y.val : ZMod (q * p)) ^ 2 * D) *
          ZMod.stdAddChar (w * (C.cast : ZMod q)) := by
      apply Finset.sum_congr rfl
      intro w _hw
      apply Finset.sum_congr rfl
      intro y _hy
      rw [quadraticPhase_zmodDigit]
      rw [ZMod.stdAddChar.map_add_eq_mul]
      congr 1
      rw [show (p : ZMod (q * p)) * (w.val : ZMod (q * p)) * C =
          (p : ZMod (q * p)) *
            ((w.val : ZMod (q * p)) * C) by ring]
      rw [stdAddChar_modulus_factor_right]
      apply congrArg ZMod.stdAddChar
      rw [ZMod.cast_mul (dvd_mul_right q p),
        ZMod.cast_natCast (dvd_mul_right q p), ZMod.natCast_zmod_val]
    _ = ∑ y : ZMod p,
        ZMod.stdAddChar
            ((y.val : ZMod (q * p)) * C +
              (q : ZMod (q * p)) * (y.val : ZMod (q * p)) ^ 2 * D) *
          ∑ w : ZMod q, ZMod.stdAddChar (w * (C.cast : ZMod q)) := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro y _hy
      rw [Finset.mul_sum]

theorem quadraticLiftSum_eq_zero_of_cast_ne
    (q p : ℕ) [NeZero q] [NeZero p] (C D : ZMod (q * p))
    (hC : (C.cast : ZMod q) ≠ 0) :
    quadraticLiftSum q p C D = 0 := by
  rw [quadraticLiftSum_decomposition]
  have horth :
      (∑ w : ZMod q, ZMod.stdAddChar (w * (C.cast : ZMod q))) = 0 := by
    simpa [hC, ZMod.card] using
      (AddChar.sum_mulShift (C.cast : ZMod q)
        (ZMod.isPrimitive_stdAddChar q))
  rw [horth]
  simp

theorem eq_modulus_mul_highDigit_of_cast_eq_zero
    (q p : ℕ) [NeZero q] [NeZero p] (C : ZMod (q * p))
    (hC : (C.cast : ZMod q) = 0) :
    C = (q : ZMod (q * p)) * (C.val / q : ℕ) := by
  have hcastVal : (C.val : ZMod q) = 0 := by
    calc
      (C.val : ZMod q) = C.cast := ZMod.natCast_val C
      _ = 0 := hC
  have hdvd : q ∣ C.val :=
    (ZMod.natCast_eq_zero_iff C.val q).mp hcastVal
  calc
    C = (C.val : ZMod (q * p)) := (ZMod.natCast_zmod_val C).symm
    _ = (q * (C.val / q) : ℕ) := by rw [Nat.mul_div_cancel' hdvd]
    _ = (q : ZMod (q * p)) * (C.val / q : ℕ) := by push_cast; rfl

theorem quadraticLiftSum_eq_modulus_mul_gauss
    (q p : ℕ) [NeZero q] [NeZero p] (C D : ZMod (q * p))
    (hC : (C.cast : ZMod q) = 0) :
    quadraticLiftSum q p C D =
      (q : ℂ) * quadraticGaussSum p (C.val / q : ℕ) (D.cast : ZMod p) := by
  rw [quadraticLiftSum_decomposition]
  have horth :
      (∑ w : ZMod q, ZMod.stdAddChar (w * (C.cast : ZMod q))) = (q : ℂ) := by
    simpa only [hC, if_pos, ZMod.card, Nat.cast_ofNat] using
      (AddChar.sum_mulShift (C.cast : ZMod q)
        (ZMod.isPrimitive_stdAddChar q))
  rw [horth]
  unfold quadraticGaussSum
  rw [mul_comm (q : ℂ)]
  conv_rhs => rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro y _hy
  congr 1
  nth_rewrite 1 [eq_modulus_mul_highDigit_of_cast_eq_zero q p C hC]
  rw [show
      (y.val : ZMod (q * p)) *
            ((q : ZMod (q * p)) * (C.val / q : ℕ)) +
          (q : ZMod (q * p)) * (y.val : ZMod (q * p)) ^ 2 * D =
        (q : ZMod (q * p)) *
          ((y.val : ZMod (q * p)) * (C.val / q : ℕ) +
            (y.val : ZMod (q * p)) ^ 2 * D) by ring]
  rw [stdAddChar_modulus_factor_left q p]
  apply congrArg ZMod.stdAddChar
  let hdiv : p ∣ q * p := dvd_mul_left p q
  rw [ZMod.cast_add hdiv, ZMod.cast_mul hdiv, ZMod.cast_mul hdiv,
    ZMod.cast_pow hdiv, ZMod.cast_natCast hdiv,
    ZMod.cast_natCast hdiv, ZMod.natCast_zmod_val]
  ring

theorem norm_quadraticLiftSum_of_stationary
    (q p : ℕ) [NeZero q] [Fact p.Prime] (hp2 : p ≠ 2)
    (C D : ZMod (q * p)) (hC : (C.cast : ZMod q) = 0)
    (hD : (D.cast : ZMod p) ≠ 0) :
    ‖quadraticLiftSum q p C D‖ = (q : ℝ) * Real.sqrt p := by
  rw [quadraticLiftSum_eq_modulus_mul_gauss q p C D hC]
  rw [norm_mul, norm_natCast, norm_quadraticGaussSum p hp2 _ _ hD]

theorem norm_quadraticLiftSum_le
    (q p : ℕ) [NeZero q] [Fact p.Prime] (hp2 : p ≠ 2)
    (C D : ZMod (q * p)) (hD : (D.cast : ZMod p) ≠ 0) :
    ‖quadraticLiftSum q p C D‖ ≤ (q : ℝ) * Real.sqrt p := by
  by_cases hC : (C.cast : ZMod q) = 0
  · exact (norm_quadraticLiftSum_of_stationary q p hp2 C D hC hD).le
  · rw [quadraticLiftSum_eq_zero_of_cast_ne q p C D hC, norm_zero]
    positivity

/-- A uniform quadratic-lift bound obtained from the elementary Gauss-sum
cardinality estimate.  It is deliberately weaker than the odd-prime square-
root bound and supplies the 2-adic factor. -/
theorem norm_quadraticLiftSum_le_card
    (q p : ℕ) [NeZero q] [NeZero p]
    (C D : ZMod (q * p)) :
    ‖quadraticLiftSum q p C D‖ ≤ (q : ℝ) * p := by
  by_cases hC : (C.cast : ZMod q) = 0
  · rw [quadraticLiftSum_eq_modulus_mul_gauss q p C D hC, norm_mul,
      norm_natCast]
    exact mul_le_mul_of_nonneg_left
      (norm_quadraticGaussSum_le_card p _ _) (Nat.cast_nonneg q)
  · rw [quadraticLiftSum_eq_zero_of_cast_ne q p C D hC, norm_zero]
    positivity

/-- The `quadraticLiftSumPrimePow` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def quadraticLiftSumPrimePow
    (p r : ℕ) [Fact p.Prime]
    (C D : ZMod (p ^ (r + 1))) : ℂ :=
  ∑ z : ZMod (p ^ (r + 1)),
    ZMod.stdAddChar
      (z * C + (p ^ r : ZMod (p ^ (r + 1))) * z ^ 2 * D)

theorem norm_quadraticLiftSumPrimePow_le
    (p r : ℕ) [Fact p.Prime] (hp2 : p ≠ 2)
    (C D : ZMod (p ^ (r + 1))) (hD : (D.cast : ZMod p) ≠ 0) :
    ‖quadraticLiftSumPrimePow p r C D‖ ≤
      (p ^ r : ℝ) * Real.sqrt p := by
  simpa only [quadraticLiftSumPrimePow, quadraticLiftSum, pow_succ,
    Nat.cast_pow] using
    norm_quadraticLiftSum_le (p ^ r) p hp2 C D hD

/-- Prime-power specialization of the elementary lift bound. -/
theorem norm_quadraticLiftSumPrimePow_le_card
    (p r : ℕ) [Fact p.Prime]
    (C D : ZMod (p ^ (r + 1))) :
    ‖quadraticLiftSumPrimePow p r C D‖ ≤
      (p ^ r : ℝ) * p := by
  simpa only [quadraticLiftSumPrimePow, quadraticLiftSum, pow_succ,
    Nat.cast_pow] using
    norm_quadraticLiftSum_le_card (p ^ r) p C D

theorem quadraticLiftSumPrimePow_eq_zero_of_cast_ne
    (p r : ℕ) [Fact p.Prime] (C D : ZMod (p ^ (r + 1)))
    (hC : (C.cast : ZMod (p ^ r)) ≠ 0) :
    quadraticLiftSumPrimePow p r C D = 0 := by
  simpa only [quadraticLiftSumPrimePow, quadraticLiftSum, pow_succ,
    Nat.cast_pow] using
    quadraticLiftSum_eq_zero_of_cast_ne (p ^ r) p C D hC

theorem sum_comp_surjective_monoidHom
    {G H : Type*} [Group G] [Group H] [Fintype G] [Fintype H]
    (f : G →* H) (hf : Function.Surjective f) (F : H → ℂ) :
    (∑ x : G, F (f x)) = (Nat.card f.ker : ℂ) * ∑ y : H, F y := by
  rw [← Finset.sum_fiberwise Finset.univ f (fun x => F (f x))]
  calc
    (∑ y : H, ∑ x ∈ Finset.univ with f x = y, F (f x)) =
        ∑ y : H, (Nat.card f.ker : ℂ) * F y := by
      apply Finset.sum_congr rfl
      intro y _hy
      have hcard : (Finset.univ.filter fun x : G => f x = y).card =
          Nat.card f.ker := by
        let e := MonoidHom.fiberEquivKerOfSurjective hf y
        have hfilter : Fintype.card {x : G // f x = y} =
            (Finset.univ.filter fun x : G => f x = y).card := by
          exact Fintype.card_ofFinset
            (p := {x : G | f x = y}) _ (by intro x; simp)
        calc
          (Finset.univ.filter fun x : G => f x = y).card =
              Fintype.card {x : G // f x = y} := hfilter.symm
          _ = Nat.card f.ker := by
            rw [Nat.card_eq_fintype_card]
            exact Fintype.card_congr e
      calc
        (∑ x ∈ Finset.univ with f x = y, F (f x)) =
            ∑ _x ∈ Finset.univ.filter (fun x : G => f x = y), F y := by
          apply Finset.sum_congr rfl
          intro x hx
          rw [Finset.mem_filter] at hx
          rw [hx.2]
        _ = (Nat.card f.ker : ℂ) * F y := by
          rw [Finset.sum_const, nsmul_eq_mul, hcard]
    _ = (Nat.card f.ker : ℂ) * ∑ y : H, F y := by
      rw [Finset.mul_sum]

/-- Scaling the argument and modulus by the same positive integer commutes
with the standard additive character. -/
theorem stdAddChar_mul_modulus_factor
    (d q : ℕ) [NeZero d] [NeZero q] (x : ZMod (d * q)) :
    ZMod.stdAddChar ((d : ZMod (d * q)) * x) =
      ZMod.stdAddChar (x.cast : ZMod q) := by
  rw [← ZMod.natCast_zmod_val x]
  rw [show (d : ZMod (d * q)) * (x.val : ZMod (d * q)) =
      ((d * x.val : ℕ) : ZMod (d * q)) by push_cast; rfl]
  rw [show ((x.val : ZMod (d * q)).cast : ZMod q) =
      (x.val : ZMod q) by
        exact ZMod.cast_natCast (dvd_mul_left q d) x.val]
  rw [show ((d * x.val : ℕ) : ZMod (d * q)) =
      (((d * x.val : ℕ) : ℤ) : ZMod (d * q)) by norm_cast]
  rw [show (x.val : ZMod q) = (((x.val : ℕ) : ℤ) : ZMod q) by norm_cast]
  rw [ZMod.stdAddChar_coe, ZMod.stdAddChar_coe]
  apply congrArg Complex.exp
  have hd : (d : ℂ) ≠ 0 := by exact_mod_cast NeZero.ne d
  have hq : (q : ℂ) ≠ 0 := by exact_mod_cast NeZero.ne q
  push_cast
  field_simp

theorem kloostermanSumZMod_scale_modulus
    (d q A B : ℕ) [NeZero d] [NeZero q] :
    kloostermanSumZMod (d * q) (d * A : ℕ) (d * B : ℕ) =
      (Nat.card (ZMod.unitsMap (dvd_mul_left q d)).ker : ℂ) *
        kloostermanSumZMod q A B := by
  let π : (ZMod (d * q))ˣ →* (ZMod q)ˣ :=
    ZMod.unitsMap (dvd_mul_left q d)
  let F : (ZMod q)ˣ → ℂ := fun u =>
    ZMod.stdAddChar
      ((A : ZMod q) * (u : ZMod q) +
        (B : ZMod q) * (↑(u⁻¹) : ZMod q))
  have hπ : Function.Surjective π :=
    ZMod.unitsMap_surjective (dvd_mul_left q d)
  unfold kloostermanSumZMod
  calc
    (∑ u : (ZMod (d * q))ˣ,
        ZMod.stdAddChar
          (((d * A : ℕ) : ZMod (d * q)) * (u : ZMod (d * q)) +
            ((d * B : ℕ) : ZMod (d * q)) *
              (↑(u⁻¹) : ZMod (d * q)))) =
        ∑ u : (ZMod (d * q))ˣ, F (π u) := by
      apply Finset.sum_congr rfl
      intro u _hu
      have hphase :
          (((d * A : ℕ) : ZMod (d * q)) * (u : ZMod (d * q)) +
              ((d * B : ℕ) : ZMod (d * q)) *
                (↑(u⁻¹) : ZMod (d * q))) =
            (d : ZMod (d * q)) *
              ((A : ZMod (d * q)) * (u : ZMod (d * q)) +
                (B : ZMod (d * q)) *
                  (↑(u⁻¹) : ZMod (d * q))) := by
        push_cast
        ring
      rw [hphase, stdAddChar_mul_modulus_factor d q]
      dsimp [F, π]
      apply congrArg ZMod.stdAddChar
      let hdiv : q ∣ d * q := dvd_mul_left q d
      rw [ZMod.cast_add hdiv, ZMod.cast_mul hdiv, ZMod.cast_mul hdiv,
        ZMod.cast_natCast hdiv, ZMod.cast_natCast hdiv]
      rw [← ZMod.unitsMap_val hdiv u, ← ZMod.unitsMap_val hdiv u⁻¹]
      simp
    _ = (Nat.card π.ker : ℂ) * ∑ u : (ZMod q)ˣ, F u :=
      by
        convert sum_comp_surjective_monoidHom π hπ F using 1
    _ = (Nat.card (ZMod.unitsMap (dvd_mul_left q d)).ker : ℂ) *
        ∑ u : (ZMod q)ˣ,
          ZMod.stdAddChar
            ((A : ZMod q) * (u : ZMod q) +
              (B : ZMod q) * (↑(u⁻¹) : ZMod q)) := by rfl

theorem card_ker_unitsMap_primePower_succ
    (p k : ℕ) [Fact p.Prime] (hk : 0 < k) :
    Nat.card
        (ZMod.unitsMap (dvd_mul_left (p ^ k) p)).ker = p := by
  let hdiv : p ^ k ∣ p * p ^ k := dvd_mul_left (p ^ k) p
  let π : (ZMod (p * p ^ k))ˣ →* (ZMod (p ^ k))ˣ :=
    ZMod.unitsMap hdiv
  have hπ : Function.Surjective π := ZMod.unitsMap_surjective hdiv
  have hcardC := sum_comp_surjective_monoidHom π hπ (fun _ => (1 : ℂ))
  have hcardC' :
      (Fintype.card (ZMod (p * p ^ k))ˣ : ℂ) =
        (Nat.card π.ker : ℂ) *
          (Fintype.card (ZMod (p ^ k))ˣ : ℂ) := by
    simpa only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]
      using hcardC
  have hcard : Fintype.card (ZMod (p * p ^ k))ˣ =
      Nat.card π.ker * Fintype.card (ZMod (p ^ k))ˣ := by
    exact_mod_cast hcardC'
  rw [ZMod.card_units_eq_totient, ZMod.card_units_eq_totient] at hcard
  have hpow : p * p ^ k = p ^ (k + 1) := by rw [pow_succ']
  have hcardPow : (p ^ (k + 1)).totient =
      Nat.card π.ker * (p ^ k).totient :=
    (congrArg Nat.totient hpow).symm.trans hcard
  rw [
    Nat.totient_prime_pow (show p.Prime from Fact.out) (by omega),
    Nat.totient_prime_pow (show p.Prime from Fact.out) hk] at hcardPow
  have hcard' : p * (p ^ (k - 1) * (p - 1)) =
      Nat.card π.ker * (p ^ (k - 1) * (p - 1)) := by
    calc
      p * (p ^ (k - 1) * (p - 1)) = p ^ k * (p - 1) := by
        rw [← mul_assoc, mul_pow_sub_one hk.ne' p]
      _ = _ := hcardPow
  have hcancel : 0 < p ^ (k - 1) * (p - 1) := Nat.mul_pos
    (pow_pos (show 0 < p from (show p.Prime from Fact.out).pos) (k - 1))
    (Nat.sub_pos_of_lt (show 1 < p from (show p.Prime from Fact.out).one_lt))
  have hker : Nat.card π.ker = p := by
    exact (Nat.eq_of_mul_eq_mul_right hcancel hcard').symm
  simpa [π, hdiv] using hker

/-- Exact prime-power lifting after both frequencies acquire one common
factor of the underlying prime. -/
theorem kloostermanSumZMod_primePower_lift
    (p k A B : ℕ) [Fact p.Prime] (hk : 0 < k) :
    kloostermanSumZMod (p * p ^ k) (p * A : ℕ) (p * B : ℕ) =
      (p : ℂ) * kloostermanSumZMod (p ^ k) A B := by
  have hp : 0 < p := (show p.Prime from Fact.out).pos
  letI : NeZero p := ⟨hp.ne'⟩
  letI : NeZero (p ^ k) := inferInstance
  have h := kloostermanSumZMod_scale_modulus p (p ^ k) A B
  rw [show Nat.card
      (ZMod.unitsMap (dvd_mul_left (p ^ k) p)).ker = p by
        exact card_ker_unitsMap_primePower_succ p k hk] at h
  simpa only [Nat.cast_mul] using h

/-- The `primePowerKernelPerturb` definition used by the source-facing construction in `KloostermanPrimePower`. -/
-- The parameter records the source-domain or uniformity contract even though the body is independent of it.
@[nolint unusedArguments]
noncomputable def primePowerKernelPerturb
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a) (z : ZMod (p ^ b)) :
    (ZMod (p ^ a * p ^ b))ˣ := by
  have hpow : p ^ a = p * p ^ (a - 1) := by
    rw [mul_pow_sub_one ha.ne' p]
  have hcopPrime : (1 + p ^ a * z.val).Coprime p := by
    rw [hpow, mul_assoc]
    exact (Nat.coprime_add_mul_left_left 1 p (p ^ (a - 1) * z.val)).2
      (Nat.coprime_one_left p)
  have hcop : (1 + p ^ a * z.val).Coprime (p ^ a * p ^ b) := by
    rw [← pow_add]
    exact hcopPrime.pow_right (a + b)
  exact ZMod.unitOfCoprime (1 + p ^ a * z.val) hcop

@[simp]
theorem coe_primePowerKernelPerturb
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a) (z : ZMod (p ^ b)) :
    ((primePowerKernelPerturb p a b ha z :
      (ZMod (p ^ a * p ^ b))ˣ) : ZMod (p ^ a * p ^ b)) =
      (1 + p ^ a * z.val : ℕ) := by
  unfold primePowerKernelPerturb
  exact ZMod.coe_unitOfCoprime _ _

theorem primePowerKernelPerturb_mem_ker
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a) (z : ZMod (p ^ b)) :
    primePowerKernelPerturb p a b ha z ∈
      (ZMod.unitsMap (show p ^ a ∣ p ^ a * p ^ b by exact dvd_mul_right _ _)).ker := by
  rw [MonoidHom.mem_ker]
  apply Units.ext
  rw [ZMod.unitsMap_val]
  rw [coe_primePowerKernelPerturb]
  rw [ZMod.cast_natCast (dvd_mul_right (p ^ a) (p ^ b))]
  push_cast
  rw [← Nat.cast_pow, ZMod.natCast_self]
  simp

theorem primePowerKernelPerturb_injective
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a) :
    Function.Injective (primePowerKernelPerturb p a b ha) := by
  intro z w hzw
  have hcoe := congrArg
    (fun u : (ZMod (p ^ a * p ^ b))ˣ => (u : ZMod (p ^ a * p ^ b))) hzw
  change ((primePowerKernelPerturb p a b ha z :
      (ZMod (p ^ a * p ^ b))ˣ) : ZMod (p ^ a * p ^ b)) =
    ((primePowerKernelPerturb p a b ha w :
      (ZMod (p ^ a * p ^ b))ˣ) : ZMod (p ^ a * p ^ b)) at hcoe
  rw [coe_primePowerKernelPerturb, coe_primePowerKernelPerturb] at hcoe
  have hmod : 1 + p ^ a * z.val ≡ 1 + p ^ a * w.val
      [MOD p ^ a * p ^ b] :=
    (ZMod.natCast_eq_natCast_iff _ _ _).mp hcoe
  have hmul : p ^ a * z.val ≡ p ^ a * w.val
      [MOD p ^ a * p ^ b] :=
    Nat.ModEq.add_left_cancel Nat.ModEq.rfl hmod
  have hzmod : z.val ≡ w.val [MOD p ^ b] :=
    Nat.ModEq.mul_left_cancel' (pow_ne_zero a
      (show p ≠ 0 from (show p.Prime from Fact.out).ne_zero)) hmul
  apply ZMod.val_injective (p ^ b)
  exact hzmod.eq_of_lt_of_lt z.val_lt w.val_lt

theorem card_ker_unitsMap_primePower_split
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a) :
    Nat.card
      (ZMod.unitsMap (show p ^ a ∣ p ^ a * p ^ b by
        exact dvd_mul_right _ _)).ker = p ^ b := by
  let hdiv : p ^ a ∣ p ^ a * p ^ b := dvd_mul_right _ _
  let π : (ZMod (p ^ a * p ^ b))ˣ →* (ZMod (p ^ a))ˣ :=
    ZMod.unitsMap hdiv
  have hπ : Function.Surjective π := ZMod.unitsMap_surjective hdiv
  have hcardC := sum_comp_surjective_monoidHom π hπ (fun _ => (1 : ℂ))
  have hcardC' :
      (Fintype.card (ZMod (p ^ a * p ^ b))ˣ : ℂ) =
        (Nat.card π.ker : ℂ) *
          (Fintype.card (ZMod (p ^ a))ˣ : ℂ) := by
    simpa only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]
      using hcardC
  have hcard : Fintype.card (ZMod (p ^ a * p ^ b))ˣ =
      Nat.card π.ker * Fintype.card (ZMod (p ^ a))ˣ := by
    exact_mod_cast hcardC'
  rw [ZMod.card_units_eq_totient, ZMod.card_units_eq_totient] at hcard
  have hpow : p ^ a * p ^ b = p ^ (a + b) := pow_add p a b |>.symm
  have hcardPow : (p ^ (a + b)).totient =
      Nat.card π.ker * (p ^ a).totient :=
    (congrArg Nat.totient hpow).symm.trans hcard
  rw [Nat.totient_prime_pow (show p.Prime from Fact.out) (by omega),
    Nat.totient_prime_pow (show p.Prime from Fact.out) ha] at hcardPow
  have hexp : a + b - 1 = b + (a - 1) := by omega
  rw [hexp, pow_add] at hcardPow
  have hcancel : 0 < p ^ (a - 1) * (p - 1) := Nat.mul_pos
    (pow_pos (show 0 < p from (show p.Prime from Fact.out).pos) (a - 1))
    (Nat.sub_pos_of_lt (show 1 < p from (show p.Prime from Fact.out).one_lt))
  have hrewrite : p ^ b * (p ^ (a - 1) * (p - 1)) =
      Nat.card π.ker * (p ^ (a - 1) * (p - 1)) := by
    simpa only [mul_assoc] using hcardPow
  have hker : Nat.card π.ker = p ^ b :=
    (Nat.eq_of_mul_eq_mul_right hcancel hrewrite).symm
  simpa [π, hdiv] using hker

/-- The `primePowerKernelPerturbEquiv` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def primePowerKernelPerturbEquiv
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a) :
    ZMod (p ^ b) ≃
      (ZMod.unitsMap (show p ^ a ∣ p ^ a * p ^ b by
        exact dvd_mul_right _ _)).ker := by
  let f : ZMod (p ^ b) →
      (ZMod.unitsMap (show p ^ a ∣ p ^ a * p ^ b by
        exact dvd_mul_right _ _)).ker := fun z =>
    ⟨primePowerKernelPerturb p a b ha z,
      primePowerKernelPerturb_mem_ker p a b ha z⟩
  apply Equiv.ofBijective f
  rw [Fintype.bijective_iff_injective_and_card]
  constructor
  · intro z w h
    apply primePowerKernelPerturb_injective p a b ha
    exact congrArg Subtype.val h
  · rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card,
      Nat.card_zmod, card_ker_unitsMap_primePower_split p a b ha]

/-- The `primePowerUnitLift` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def primePowerUnitLift
    (p a b : ℕ) [Fact p.Prime] (u : (ZMod (p ^ a))ˣ) :
    (ZMod (p ^ a * p ^ b))ˣ :=
  (ZMod.unitsMap_surjective
    (show p ^ a ∣ p ^ a * p ^ b by exact dvd_mul_right _ _) u).choose

theorem primePowerUnitLift_spec
    (p a b : ℕ) [Fact p.Prime] (u : (ZMod (p ^ a))ˣ) :
    ZMod.unitsMap (show p ^ a ∣ p ^ a * p ^ b by exact dvd_mul_right _ _)
      (primePowerUnitLift p a b u) = u :=
  (ZMod.unitsMap_surjective
    (show p ^ a ∣ p ^ a * p ^ b by exact dvd_mul_right _ _) u).choose_spec

theorem cast_primePowerUnitLift_val
    (p a b : ℕ) [Fact p.Prime] (u : (ZMod (p ^ a))ˣ) :
    (((primePowerUnitLift p a b u : ZMod (p ^ a * p ^ b)).cast) :
      ZMod (p ^ a)) = u := by
  have h := congrArg Units.val (primePowerUnitLift_spec p a b u)
  simpa only [ZMod.unitsMap_val] using h

theorem cast_primePowerUnitLift_inv_val
    (p a b : ℕ) [Fact p.Prime] (u : (ZMod (p ^ a))ˣ) :
    (((↑((primePowerUnitLift p a b u)⁻¹) :
        ZMod (p ^ a * p ^ b)).cast) : ZMod (p ^ a)) =
      (↑(u⁻¹) : ZMod (p ^ a)) := by
  let hdiv : p ^ a ∣ p ^ a * p ^ b := dvd_mul_right _ _
  have hmap : ZMod.unitsMap hdiv (primePowerUnitLift p a b u)⁻¹ = u⁻¹ := by
    rw [map_inv, primePowerUnitLift_spec]
  have h := congrArg Units.val hmap
  simpa only [ZMod.unitsMap_val] using h

theorem zmod_cast_cast_of_dvd
    {q m n : ℕ} [NeZero q] [NeZero m] [NeZero n]
    (hqm : q ∣ m) (x : ZMod n) :
    (((x.cast : ZMod m).cast) : ZMod q) = (x.cast : ZMod q) := by
  calc
    (((x.cast : ZMod m).cast) : ZMod q) =
        (((x.val : ZMod m).cast) : ZMod q) := by
          rw [ZMod.natCast_val]
    _ = (x.val : ZMod q) := ZMod.cast_natCast hqm x.val
    _ = (x.cast : ZMod q) := ZMod.natCast_val x

@[simp]
theorem primePowerKernelPerturbEquiv_apply_val
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a) (z : ZMod (p ^ b)) :
    (primePowerKernelPerturbEquiv p a b ha z).1 =
      primePowerKernelPerturb p a b ha z := rfl

/-- The `primePowerUnitFiberEquiv` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def primePowerUnitFiberEquiv
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a)
    (u : (ZMod (p ^ a))ˣ) :
    ZMod (p ^ b) ≃
      {x : (ZMod (p ^ a * p ^ b))ˣ //
        ZMod.unitsMap (show p ^ a ∣ p ^ a * p ^ b by
          exact dvd_mul_right _ _) x = u} := by
  let hdiv : p ^ a ∣ p ^ a * p ^ b := dvd_mul_right _ _
  let π : (ZMod (p ^ a * p ^ b))ˣ →* (ZMod (p ^ a))ˣ :=
    ZMod.unitsMap hdiv
  let L := primePowerUnitLift p a b u
  have hL : π L = u := primePowerUnitLift_spec p a b u
  let K := primePowerKernelPerturbEquiv p a b ha
  refine
    { toFun := fun z => ⟨L * (K z).1, by
        rw [map_mul, hL]
        have hK : π (K z).1 = 1 := (K z).2
        rw [hK, mul_one]⟩
      invFun := fun x => K.symm ⟨L⁻¹ * x.1, by
        rw [MonoidHom.mem_ker]
        rw [map_mul, map_inv, hL, x.2]
        simp⟩
      left_inv := fun z => by
        apply K.injective
        apply Subtype.ext
        simp
      right_inv := fun x => by
        apply Subtype.ext
        change L * (K (K.symm ⟨L⁻¹ * x.1, _⟩)).1 = x.1
        rw [K.apply_symm_apply]
        simp }

/-- The `primePowerUnitsSigmaEquiv` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def primePowerUnitsSigmaEquiv
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a) :
    ((_u : (ZMod (p ^ a))ˣ) × ZMod (p ^ b)) ≃
      (ZMod (p ^ a * p ^ b))ˣ :=
  (Equiv.sigmaCongrRight fun u => primePowerUnitFiberEquiv p a b ha u).trans
    (Equiv.sigmaFiberEquiv
      (ZMod.unitsMap (show p ^ a ∣ p ^ a * p ^ b by
        exact dvd_mul_right _ _)))

theorem primePowerUnitFiberEquiv_apply_val
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a)
    (u : (ZMod (p ^ a))ˣ) (z : ZMod (p ^ b)) :
    (primePowerUnitFiberEquiv p a b ha u z).1 =
      primePowerUnitLift p a b u * primePowerKernelPerturb p a b ha z := by
  simp [primePowerUnitFiberEquiv, primePowerUnitLift,
    primePowerKernelPerturbEquiv_apply_val]

theorem primePowerUnitsSigmaEquiv_apply
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a)
    (u : (ZMod (p ^ a))ˣ) (z : ZMod (p ^ b)) :
    primePowerUnitsSigmaEquiv p a b ha ⟨u, z⟩ =
      primePowerUnitLift p a b u * primePowerKernelPerturb p a b ha z := by
  exact primePowerUnitFiberEquiv_apply_val p a b ha u z

theorem primePowerScale_sq_eq_zero
    (p a b : ℕ) [Fact p.Prime] (hba : b ≤ a) :
    ((p ^ a : ℕ) : ZMod (p ^ a * p ^ b)) ^ 2 = 0 := by
  rw [← Nat.cast_pow]
  rw [ZMod.natCast_eq_zero_iff]
  have hexp : a + b ≤ a + a := by omega
  simpa only [pow_two, ← pow_add] using pow_dvd_pow p hexp

theorem coe_primePowerKernelPerturb_inv
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a) (hba : b ≤ a)
    (z : ZMod (p ^ b)) :
    ((↑((primePowerKernelPerturb p a b ha z)⁻¹) :
      ZMod (p ^ a * p ^ b))) =
      1 - (p ^ a : ℕ) * z.val := by
  let K := primePowerKernelPerturb p a b ha z
  let t : ZMod (p ^ a * p ^ b) := (p ^ a : ℕ) * z.val
  have ht2 : t ^ 2 = 0 := by
    dsimp [t]
    rw [mul_pow]
    rw [primePowerScale_sq_eq_zero p a b hba, zero_mul]
  have hK : (K : ZMod (p ^ a * p ^ b)) = 1 + t := by
    dsimp [K, t]
    rw [coe_primePowerKernelPerturb]
    push_cast
    rfl
  have hprod : (K : ZMod (p ^ a * p ^ b)) * (1 - t) = 1 := by
    rw [hK]
    calc
      (1 + t) * (1 - t) = 1 - t ^ 2 := by ring
      _ = 1 := by rw [ht2, sub_zero]
  calc
    (↑(K⁻¹) : ZMod (p ^ a * p ^ b)) =
        (↑(K⁻¹) : ZMod (p ^ a * p ^ b)) * 1 := by simp
    _ = (↑(K⁻¹) : ZMod (p ^ a * p ^ b)) *
        ((K : ZMod (p ^ a * p ^ b)) * (1 - t)) := by rw [hprod]
    _ = 1 - t := by
      rw [← mul_assoc]
      norm_cast
      simp
    _ = _ := by rfl

theorem primePowerScale_cube_eq_zero
    (p a b : ℕ) [Fact p.Prime] (hba : b ≤ 2 * a) :
    ((p ^ a : ℕ) : ZMod (p ^ a * p ^ b)) ^ 3 = 0 := by
  rw [← Nat.cast_pow]
  rw [ZMod.natCast_eq_zero_iff]
  have hexp : a + b ≤ a * 3 := by omega
  rw [← pow_add]
  simpa only [pow_mul] using pow_dvd_pow p hexp

/-- Second-order inverse expansion in the odd-exponent range. -/
theorem coe_primePowerKernelPerturb_inv_quadratic
    (p a b : ℕ) [Fact p.Prime] (ha : 0 < a) (hba : b ≤ 2 * a)
    (z : ZMod (p ^ b)) :
    ((↑((primePowerKernelPerturb p a b ha z)⁻¹) :
      ZMod (p ^ a * p ^ b))) =
      1 - (p ^ a : ℕ) * z.val +
        ((p ^ a : ℕ) * z.val : ZMod (p ^ a * p ^ b)) ^ 2 := by
  let K := primePowerKernelPerturb p a b ha z
  let t : ZMod (p ^ a * p ^ b) := (p ^ a : ℕ) * z.val
  have ht3 : t ^ 3 = 0 := by
    dsimp [t]
    rw [mul_pow]
    rw [primePowerScale_cube_eq_zero p a b hba, zero_mul]
  have hK : (K : ZMod (p ^ a * p ^ b)) = 1 + t := by
    dsimp [K, t]
    rw [coe_primePowerKernelPerturb]
    push_cast
    rfl
  have hprod :
      (K : ZMod (p ^ a * p ^ b)) * (1 - t + t ^ 2) = 1 := by
    rw [hK]
    calc
      (1 + t) * (1 - t + t ^ 2) = 1 + t ^ 3 := by ring
      _ = 1 := by rw [ht3, add_zero]
  calc
    (↑(K⁻¹) : ZMod (p ^ a * p ^ b)) =
        (↑(K⁻¹) : ZMod (p ^ a * p ^ b)) * 1 := by simp
    _ = (↑(K⁻¹) : ZMod (p ^ a * p ^ b)) *
        ((K : ZMod (p ^ a * p ^ b)) * (1 - t + t ^ 2)) := by rw [hprod]
    _ = 1 - t + t ^ 2 := by
      rw [← mul_assoc]
      norm_cast
      simp
    _ = _ := by rfl

theorem primePowerStationaryPhase_expansion_quadratic
    (p a b A B : ℕ) [Fact p.Prime] (ha : 0 < a) (hba : b ≤ 2 * a)
    (u : (ZMod (p ^ a))ˣ) (z : ZMod (p ^ b)) :
    let L := primePowerUnitLift p a b u
    let K := primePowerKernelPerturb p a b ha z
    let t : ZMod (p ^ a * p ^ b) := (p ^ a : ℕ) * z.val
    (A : ZMod (p ^ a * p ^ b)) * (L * K :
        (ZMod (p ^ a * p ^ b))ˣ) +
      (B : ZMod (p ^ a * p ^ b)) *
        (↑((L * K)⁻¹) : ZMod (p ^ a * p ^ b)) =
      ((A : ZMod (p ^ a * p ^ b)) * (L : ZMod (p ^ a * p ^ b)) +
        (B : ZMod (p ^ a * p ^ b)) *
          (↑(L⁻¹) : ZMod (p ^ a * p ^ b))) +
      t *
        ((A : ZMod (p ^ a * p ^ b)) * (L : ZMod (p ^ a * p ^ b)) -
          (B : ZMod (p ^ a * p ^ b)) *
            (↑(L⁻¹) : ZMod (p ^ a * p ^ b))) +
      t ^ 2 *
        ((B : ZMod (p ^ a * p ^ b)) *
          (↑(L⁻¹) : ZMod (p ^ a * p ^ b))) := by
  dsimp only
  rw [mul_inv_rev]
  push_cast
  rw [coe_primePowerKernelPerturb,
    coe_primePowerKernelPerturb_inv_quadratic p a b ha hba]
  push_cast
  ring

/-- In the odd-exponent split `p ^ r * p ^ (r + 1)`, the exact lifted
phase is a quadratic polynomial modulo `p ^ (r + 1)`. -/
theorem primePowerOddCharacter_expansion
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r)
    (u : (ZMod (p ^ r))ˣ) (z : ZMod (p ^ (r + 1))) :
    let L := primePowerUnitLift p r (r + 1) u
    let C : ZMod (p ^ r * p ^ (r + 1)) :=
      (A : ZMod (p ^ r * p ^ (r + 1))) *
          (L : ZMod (p ^ r * p ^ (r + 1))) -
        (B : ZMod (p ^ r * p ^ (r + 1))) *
          (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))
    let D : ZMod (p ^ r * p ^ (r + 1)) :=
      (B : ZMod (p ^ r * p ^ (r + 1))) *
        (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))
    ZMod.stdAddChar
        ((A : ZMod (p ^ r * p ^ (r + 1))) *
            (↑(primePowerUnitsSigmaEquiv p r (r + 1) hr ⟨u, z⟩) :
              ZMod (p ^ r * p ^ (r + 1))) +
          (B : ZMod (p ^ r * p ^ (r + 1))) *
            (↑((primePowerUnitsSigmaEquiv p r (r + 1) hr ⟨u, z⟩)⁻¹) :
              ZMod (p ^ r * p ^ (r + 1)))) =
      ZMod.stdAddChar
          ((A : ZMod (p ^ r * p ^ (r + 1))) *
              (L : ZMod (p ^ r * p ^ (r + 1))) +
            (B : ZMod (p ^ r * p ^ (r + 1))) *
              (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))) *
        ZMod.stdAddChar
          (z * (C.cast : ZMod (p ^ (r + 1))) +
            (p ^ r : ZMod (p ^ (r + 1))) * z ^ 2 *
              (D.cast : ZMod (p ^ (r + 1)))) := by
  dsimp only
  rw [primePowerUnitsSigmaEquiv_apply]
  rw [primePowerStationaryPhase_expansion_quadratic p r (r + 1) A B hr (by omega)]
  rw [show
      ((A : ZMod (p ^ r * p ^ (r + 1))) *
            (primePowerUnitLift p r (r + 1) u :
              ZMod (p ^ r * p ^ (r + 1))) +
          (B : ZMod (p ^ r * p ^ (r + 1))) *
            (↑((primePowerUnitLift p r (r + 1) u)⁻¹) :
              ZMod (p ^ r * p ^ (r + 1)))) +
        ((p ^ r : ℕ) * z.val : ZMod (p ^ r * p ^ (r + 1))) *
          ((A : ZMod (p ^ r * p ^ (r + 1))) *
              (primePowerUnitLift p r (r + 1) u :
                ZMod (p ^ r * p ^ (r + 1))) -
            (B : ZMod (p ^ r * p ^ (r + 1))) *
              (↑((primePowerUnitLift p r (r + 1) u)⁻¹) :
                ZMod (p ^ r * p ^ (r + 1)))) +
        ((p ^ r : ℕ) * z.val : ZMod (p ^ r * p ^ (r + 1))) ^ 2 *
          ((B : ZMod (p ^ r * p ^ (r + 1))) *
            (↑((primePowerUnitLift p r (r + 1) u)⁻¹) :
              ZMod (p ^ r * p ^ (r + 1)))) =
      ((A : ZMod (p ^ r * p ^ (r + 1))) *
            (primePowerUnitLift p r (r + 1) u :
              ZMod (p ^ r * p ^ (r + 1))) +
          (B : ZMod (p ^ r * p ^ (r + 1))) *
            (↑((primePowerUnitLift p r (r + 1) u)⁻¹) :
              ZMod (p ^ r * p ^ (r + 1)))) +
        ((p ^ r : ℕ) : ZMod (p ^ r * p ^ (r + 1))) *
          ((z.val : ZMod (p ^ r * p ^ (r + 1))) *
              ((A : ZMod (p ^ r * p ^ (r + 1))) *
                  (primePowerUnitLift p r (r + 1) u :
                    ZMod (p ^ r * p ^ (r + 1))) -
                (B : ZMod (p ^ r * p ^ (r + 1))) *
                  (↑((primePowerUnitLift p r (r + 1) u)⁻¹) :
                    ZMod (p ^ r * p ^ (r + 1)))) +
            ((p ^ r : ℕ) : ZMod (p ^ r * p ^ (r + 1))) *
              (z.val : ZMod (p ^ r * p ^ (r + 1))) ^ 2 *
              ((B : ZMod (p ^ r * p ^ (r + 1))) *
                (↑((primePowerUnitLift p r (r + 1) u)⁻¹) :
                  ZMod (p ^ r * p ^ (r + 1))))) by ring]
  rw [ZMod.stdAddChar.map_add_eq_mul]
  congr 1
  rw [stdAddChar_mul_modulus_factor (p ^ r) (p ^ (r + 1))]
  apply congrArg ZMod.stdAddChar
  let hdiv : p ^ (r + 1) ∣ p ^ r * p ^ (r + 1) := dvd_mul_left _ _
  rw [ZMod.cast_add hdiv, ZMod.cast_mul hdiv, ZMod.cast_mul hdiv,
    ZMod.cast_mul hdiv, ZMod.cast_pow hdiv,
    ZMod.cast_natCast hdiv, ZMod.cast_natCast hdiv]
  rw [ZMod.natCast_zmod_val]
  push_cast
  ring

theorem primePowerOddFiberSum_eq
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r)
    (u : (ZMod (p ^ r))ˣ) :
    let L := primePowerUnitLift p r (r + 1) u
    let C : ZMod (p ^ r * p ^ (r + 1)) :=
      (A : ZMod (p ^ r * p ^ (r + 1))) *
          (L : ZMod (p ^ r * p ^ (r + 1))) -
        (B : ZMod (p ^ r * p ^ (r + 1))) *
          (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))
    let D : ZMod (p ^ r * p ^ (r + 1)) :=
      (B : ZMod (p ^ r * p ^ (r + 1))) *
        (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))
    (∑ z : ZMod (p ^ (r + 1)),
      ZMod.stdAddChar
        ((A : ZMod (p ^ r * p ^ (r + 1))) *
            (↑(primePowerUnitsSigmaEquiv p r (r + 1) hr ⟨u, z⟩) :
              ZMod (p ^ r * p ^ (r + 1))) +
          (B : ZMod (p ^ r * p ^ (r + 1))) *
            (↑((primePowerUnitsSigmaEquiv p r (r + 1) hr ⟨u, z⟩)⁻¹) :
              ZMod (p ^ r * p ^ (r + 1))))) =
      ZMod.stdAddChar
          ((A : ZMod (p ^ r * p ^ (r + 1))) *
              (L : ZMod (p ^ r * p ^ (r + 1))) +
            (B : ZMod (p ^ r * p ^ (r + 1))) *
              (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))) *
        quadraticLiftSumPrimePow p r
          (C.cast : ZMod (p ^ (r + 1)))
          (D.cast : ZMod (p ^ (r + 1))) := by
  dsimp only
  unfold quadraticLiftSumPrimePow
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro z _hz
  exact primePowerOddCharacter_expansion p r A B hr u z

theorem primePowerOddQuadraticCoeff_ne_zero
    (p r B : ℕ) [Fact p.Prime] (hB : B.Coprime p)
    (u : (ZMod (p ^ r))ˣ) :
    let L := primePowerUnitLift p r (r + 1) u
    let D : ZMod (p ^ r * p ^ (r + 1)) :=
      (B : ZMod (p ^ r * p ^ (r + 1))) *
        (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))
    ((((D.cast : ZMod (p ^ (r + 1))).cast) : ZMod p) ≠ 0) := by
  dsimp only
  let M := p ^ r * p ^ (r + 1)
  let L := primePowerUnitLift p r (r + 1) u
  let D : ZMod M :=
    (B : ZMod M) * (↑(L⁻¹) : ZMod M)
  have hBpow : B.Coprime M := by
    dsimp only [M]
    rw [← pow_add]
    exact hB.pow_right (r + (r + 1))
  have hBunit : IsUnit (B : ZMod M) := by
    rw [ZMod.isUnit_iff_coprime]
    exact hBpow
  have hDunit : IsUnit D := by
    exact hBunit.mul (Units.isUnit L⁻¹)
  let hdiv₁ : p ^ (r + 1) ∣ M := by
    dsimp only [M]
    exact dvd_mul_left _ _
  have hDmid : IsUnit (D.cast : ZMod (p ^ (r + 1))) :=
    hDunit.map (ZMod.castHom hdiv₁ (ZMod (p ^ (r + 1))))
  let hdiv₂ : p ∣ p ^ (r + 1) := by
    exact dvd_pow_self p (by omega)
  have hDprime : IsUnit (((D.cast : ZMod (p ^ (r + 1))).cast) : ZMod p) :=
    hDmid.map (ZMod.castHom hdiv₂ (ZMod p))
  exact hDprime.ne_zero

theorem primePowerOddStationaryResidue
    (p r A B : ℕ) [Fact p.Prime]
    (u : (ZMod (p ^ r))ˣ) :
    let L := primePowerUnitLift p r (r + 1) u
    let C : ZMod (p ^ r * p ^ (r + 1)) :=
      (A : ZMod (p ^ r * p ^ (r + 1))) *
          (L : ZMod (p ^ r * p ^ (r + 1))) -
        (B : ZMod (p ^ r * p ^ (r + 1))) *
          (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))
    ((((C.cast : ZMod (p ^ (r + 1))).cast) : ZMod (p ^ r))) =
      (A : ZMod (p ^ r)) * (u : ZMod (p ^ r)) -
        (B : ZMod (p ^ r)) * (↑(u⁻¹) : ZMod (p ^ r)) := by
  dsimp only
  let C : ZMod (p ^ r * p ^ (r + 1)) :=
    (A : ZMod (p ^ r * p ^ (r + 1))) *
        (primePowerUnitLift p r (r + 1) u :
          ZMod (p ^ r * p ^ (r + 1))) -
      (B : ZMod (p ^ r * p ^ (r + 1))) *
        (↑((primePowerUnitLift p r (r + 1) u)⁻¹) :
          ZMod (p ^ r * p ^ (r + 1)))
  calc
    ((((C.cast : ZMod (p ^ (r + 1))).cast) : ZMod (p ^ r))) =
        (C.cast : ZMod (p ^ r)) :=
      zmod_cast_cast_of_dvd (pow_dvd_pow p (Nat.le_succ r)) C
    _ = _ := by
      dsimp only [C]
      let hdiv : p ^ r ∣ p ^ r * p ^ (r + 1) := dvd_mul_right _ _
      rw [ZMod.cast_sub hdiv, ZMod.cast_mul hdiv, ZMod.cast_mul hdiv,
        ZMod.cast_natCast hdiv, ZMod.cast_natCast hdiv]
      rw [cast_primePowerUnitLift_val, cast_primePowerUnitLift_inv_val]

/-- The `oddPrimePowerStationaryFiber` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def oddPrimePowerStationaryFiber
    (p r A B : ℕ) [Fact p.Prime] :=
  {u : (ZMod (p ^ r))ˣ //
    let L := primePowerUnitLift p r (r + 1) u
    let C : ZMod (p ^ r * p ^ (r + 1)) :=
      (A : ZMod (p ^ r * p ^ (r + 1))) *
          (L : ZMod (p ^ r * p ^ (r + 1))) -
        (B : ZMod (p ^ r * p ^ (r + 1))) *
          (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))
    (((C.cast : ZMod (p ^ (r + 1))).cast) : ZMod (p ^ r)) = 0}

/-- The `oddPrimePowerStationaryFiberEquiv` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def oddPrimePowerStationaryFiberEquiv
    (p r A B : ℕ) [Fact p.Prime] :
    oddPrimePowerStationaryFiber p r A B ≃
      zmodStationaryFiber (p ^ r) A B where
  toFun u := ⟨u.1, by
    have hu := u.2
    dsimp only at hu
    rw [primePowerOddStationaryResidue p r A B u.1] at hu
    exact hu⟩
  invFun u := ⟨u.1, by
    dsimp only
    rw [primePowerOddStationaryResidue p r A B u.1]
    exact u.2⟩
  left_inv u := by rfl
  right_inv u := by rfl

theorem card_oddPrimePowerStationaryFiber_le_two
    (p r A B : ℕ) [Fact p.Prime] (hp2 : p ≠ 2)
    (hA : A.Coprime p) (hB : B.Coprime p) :
    Nat.card (oddPrimePowerStationaryFiber p r A B) ≤ 2 := by
  letI : IsCyclic (ZMod (p ^ r))ˣ :=
    ZMod.isCyclic_units_of_prime_pow p Fact.out hp2 r
  have hAunit : IsUnit (A : ZMod (p ^ r)) := by
    rw [ZMod.isUnit_iff_coprime]
    exact hA.pow_right r
  have hBunit : IsUnit (B : ZMod (p ^ r)) := by
    rw [ZMod.isUnit_iff_coprime]
    exact hB.pow_right r
  rw [Nat.card_congr (oddPrimePowerStationaryFiberEquiv p r A B)]
  exact card_zmodStationaryFiber_le_two (p ^ r) A B hAunit hBunit

theorem card_oddTwoPowerStationaryFiber_le_four
    (r A B : ℕ) (hr : 0 < r)
    (hA : A.Coprime 2) (hB : B.Coprime 2) :
    Nat.card (oddPrimePowerStationaryFiber 2 r A B) ≤ 4 := by
  have hAunit : IsUnit (A : ZMod (2 ^ r)) := by
    rw [ZMod.isUnit_iff_coprime]
    exact hA.pow_right r
  have hBunit : IsUnit (B : ZMod (2 ^ r)) := by
    rw [ZMod.isUnit_iff_coprime]
    exact hB.pow_right r
  rw [Nat.card_congr (oddPrimePowerStationaryFiberEquiv 2 r A B)]
  exact card_zmodStationaryFiber_two_pow_le_four r hr A B hAunit hBunit

theorem card_oddTwoPowerStationaryFiber_one_le_one
    (A B : ℕ) (hA : A.Coprime 2) (hB : B.Coprime 2) :
    Nat.card (oddPrimePowerStationaryFiber 2 1 A B) ≤ 1 := by
  have hAunit : IsUnit (A : ZMod 2) := by
    rw [ZMod.isUnit_iff_coprime]
    simpa using hA
  have hBunit : IsUnit (B : ZMod 2) := by
    rw [ZMod.isUnit_iff_coprime]
    simpa using hB
  rw [Nat.card_congr (oddPrimePowerStationaryFiberEquiv 2 1 A B)]
  simpa using card_zmodStationaryFiber_two_le_one A B hAunit hBunit

theorem kloostermanSumZMod_primePower_odd_fibers
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r) :
    kloostermanSumZMod (p ^ r * p ^ (r + 1)) A B =
      ∑ u : (ZMod (p ^ r))ˣ,
        let L := primePowerUnitLift p r (r + 1) u
        let C : ZMod (p ^ r * p ^ (r + 1)) :=
          (A : ZMod (p ^ r * p ^ (r + 1))) *
              (L : ZMod (p ^ r * p ^ (r + 1))) -
            (B : ZMod (p ^ r * p ^ (r + 1))) *
              (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))
        let D : ZMod (p ^ r * p ^ (r + 1)) :=
          (B : ZMod (p ^ r * p ^ (r + 1))) *
            (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))
        ZMod.stdAddChar
            ((A : ZMod (p ^ r * p ^ (r + 1))) *
                (L : ZMod (p ^ r * p ^ (r + 1))) +
              (B : ZMod (p ^ r * p ^ (r + 1))) *
                (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))) *
          quadraticLiftSumPrimePow p r
            (C.cast : ZMod (p ^ (r + 1)))
            (D.cast : ZMod (p ^ (r + 1))) := by
  unfold kloostermanSumZMod
  calc
    (∑ d : (ZMod (p ^ r * p ^ (r + 1)))ˣ,
        ZMod.stdAddChar
          ((A : ZMod (p ^ r * p ^ (r + 1))) *
              (d : ZMod (p ^ r * p ^ (r + 1))) +
            (B : ZMod (p ^ r * p ^ (r + 1))) *
              (↑(d⁻¹) : ZMod (p ^ r * p ^ (r + 1))))) =
      ∑ x : Σ _u : (ZMod (p ^ r))ˣ, ZMod (p ^ (r + 1)),
        ZMod.stdAddChar
          ((A : ZMod (p ^ r * p ^ (r + 1))) *
              (↑(primePowerUnitsSigmaEquiv p r (r + 1) hr x) :
                ZMod (p ^ r * p ^ (r + 1))) +
            (B : ZMod (p ^ r * p ^ (r + 1))) *
              (↑((primePowerUnitsSigmaEquiv p r (r + 1) hr x)⁻¹) :
                ZMod (p ^ r * p ^ (r + 1)))) := by
      symm
      apply Fintype.sum_equiv (primePowerUnitsSigmaEquiv p r (r + 1) hr)
      intro x
      rfl
    _ = ∑ u : (ZMod (p ^ r))ˣ, ∑ z : ZMod (p ^ (r + 1)),
        ZMod.stdAddChar
          ((A : ZMod (p ^ r * p ^ (r + 1))) *
              (↑(primePowerUnitsSigmaEquiv p r (r + 1) hr ⟨u, z⟩) :
                ZMod (p ^ r * p ^ (r + 1))) +
            (B : ZMod (p ^ r * p ^ (r + 1))) *
              (↑((primePowerUnitsSigmaEquiv p r (r + 1) hr ⟨u, z⟩)⁻¹) :
                ZMod (p ^ r * p ^ (r + 1)))) := by
      exact Fintype.sum_sigma' (fun u z =>
        ZMod.stdAddChar
          ((A : ZMod (p ^ r * p ^ (r + 1))) *
              (↑(primePowerUnitsSigmaEquiv p r (r + 1) hr ⟨u, z⟩) :
                ZMod (p ^ r * p ^ (r + 1))) +
            (B : ZMod (p ^ r * p ^ (r + 1))) *
              (↑((primePowerUnitsSigmaEquiv p r (r + 1) hr ⟨u, z⟩)⁻¹) :
                ZMod (p ^ r * p ^ (r + 1)))))
    _ = _ := by
      apply Finset.sum_congr rfl
      intro u _hu
      exact primePowerOddFiberSum_eq p r A B hr u

/-- The nondegenerate odd-exponent prime-power Kloosterman bound. -/
theorem norm_kloostermanSumZMod_primePower_odd_le
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r) (hp2 : p ≠ 2)
    (hA : A.Coprime p) (hB : B.Coprime p) :
    ‖kloostermanSumZMod (p ^ r * p ^ (r + 1)) A B‖ ≤
      2 * ((p ^ r : ℝ) * Real.sqrt p) := by
  let P : (ZMod (p ^ r))ˣ → Prop := fun u =>
    let L := primePowerUnitLift p r (r + 1) u
    let C : ZMod (p ^ r * p ^ (r + 1)) :=
      (A : ZMod (p ^ r * p ^ (r + 1))) *
          (L : ZMod (p ^ r * p ^ (r + 1))) -
        (B : ZMod (p ^ r * p ^ (r + 1))) *
          (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))
    (((C.cast : ZMod (p ^ (r + 1))).cast) : ZMod (p ^ r)) = 0
  let term : (ZMod (p ^ r))ˣ → ℂ := fun u =>
    let L := primePowerUnitLift p r (r + 1) u
    let C : ZMod (p ^ r * p ^ (r + 1)) :=
      (A : ZMod (p ^ r * p ^ (r + 1))) *
          (L : ZMod (p ^ r * p ^ (r + 1))) -
        (B : ZMod (p ^ r * p ^ (r + 1))) *
          (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))
    let D : ZMod (p ^ r * p ^ (r + 1)) :=
      (B : ZMod (p ^ r * p ^ (r + 1))) *
        (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))
    ZMod.stdAddChar
        ((A : ZMod (p ^ r * p ^ (r + 1))) *
            (L : ZMod (p ^ r * p ^ (r + 1))) +
          (B : ZMod (p ^ r * p ^ (r + 1))) *
            (↑(L⁻¹) : ZMod (p ^ r * p ^ (r + 1)))) *
      quadraticLiftSumPrimePow p r
        (C.cast : ZMod (p ^ (r + 1)))
        (D.cast : ZMod (p ^ (r + 1)))
  have hzero (u : (ZMod (p ^ r))ˣ) (hu : ¬P u) : term u = 0 := by
    dsimp only [P] at hu
    dsimp only [term]
    rw [quadraticLiftSumPrimePow_eq_zero_of_cast_ne p r _ _ hu, mul_zero]
  have hterm (u : (ZMod (p ^ r))ˣ) :
      ‖term u‖ ≤ (p ^ r : ℝ) * Real.sqrt p := by
    dsimp only [term]
    rw [norm_mul, AddChar.norm_apply, one_mul]
    apply norm_quadraticLiftSumPrimePow_le p r hp2
    exact primePowerOddQuadraticCoeff_ne_zero p r B hB u
  letI : Fintype (oddPrimePowerStationaryFiber p r A B) := by
    dsimp only [oddPrimePowerStationaryFiber]
    infer_instance
  have hcardEq :
      (Finset.univ.filter P).card =
        Nat.card (oddPrimePowerStationaryFiber p r A B) := by
    rw [Nat.card_eq_fintype_card]
    exact (Fintype.card_of_subtype (Finset.univ.filter P) (by
      intro u
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, P])).symm
  have hcard : (Finset.univ.filter P).card ≤ 2 := by
    rw [hcardEq]
    exact card_oddPrimePowerStationaryFiber_le_two p r A B hp2 hA hB
  rw [kloostermanSumZMod_primePower_odd_fibers p r A B hr]
  change ‖∑ u : (ZMod (p ^ r))ˣ, term u‖ ≤ _
  calc
    ‖∑ u : (ZMod (p ^ r))ˣ, term u‖ =
        ‖∑ u ∈ Finset.univ.filter P, term u‖ := by
      congr 1
      conv_rhs => rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro u _hu
      by_cases hPu : P u
      · rw [if_pos hPu]
      · rw [if_neg hPu, hzero u hPu]
    _ ≤ ∑ u ∈ Finset.univ.filter P, ‖term u‖ := norm_sum_le _ _
    _ ≤ ∑ _u ∈ Finset.univ.filter P,
          ((p ^ r : ℝ) * Real.sqrt p) := by
      apply Finset.sum_le_sum
      intro u _hu
      exact hterm u
    _ = ((Finset.univ.filter P).card : ℝ) *
          ((p ^ r : ℝ) * Real.sqrt p) := by
      rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ 2 * ((p ^ r : ℝ) * Real.sqrt p) := by
      gcongr
      exact_mod_cast hcard

/-- The 2-adic odd-exponent local estimate before square-root
normalization.  The elementary two-term quadratic Gauss bound and the
four-point square kernel are both absorbed by the divisor factor. -/
theorem norm_kloostermanSumZMod_twoPower_odd_coprime_le_raw
    (r A B : ℕ) (hr : 0 < r)
    (hA : A.Coprime 2) (hB : B.Coprime 2) :
    ‖kloostermanSumZMod (2 ^ r * 2 ^ (r + 1)) A B‖ ≤
      (2 * r + 2) * ((2 ^ r : ℝ) * Real.sqrt 2) := by
  let P : (ZMod (2 ^ r))ˣ → Prop := fun u =>
    let L := primePowerUnitLift 2 r (r + 1) u
    let C : ZMod (2 ^ r * 2 ^ (r + 1)) :=
      (A : ZMod (2 ^ r * 2 ^ (r + 1))) *
          (L : ZMod (2 ^ r * 2 ^ (r + 1))) -
        (B : ZMod (2 ^ r * 2 ^ (r + 1))) *
          (↑(L⁻¹) : ZMod (2 ^ r * 2 ^ (r + 1)))
    (((C.cast : ZMod (2 ^ (r + 1))).cast) : ZMod (2 ^ r)) = 0
  let term : (ZMod (2 ^ r))ˣ → ℂ := fun u =>
    let L := primePowerUnitLift 2 r (r + 1) u
    let C : ZMod (2 ^ r * 2 ^ (r + 1)) :=
      (A : ZMod (2 ^ r * 2 ^ (r + 1))) *
          (L : ZMod (2 ^ r * 2 ^ (r + 1))) -
        (B : ZMod (2 ^ r * 2 ^ (r + 1))) *
          (↑(L⁻¹) : ZMod (2 ^ r * 2 ^ (r + 1)))
    let D : ZMod (2 ^ r * 2 ^ (r + 1)) :=
      (B : ZMod (2 ^ r * 2 ^ (r + 1))) *
        (↑(L⁻¹) : ZMod (2 ^ r * 2 ^ (r + 1)))
    ZMod.stdAddChar
        ((A : ZMod (2 ^ r * 2 ^ (r + 1))) *
            (L : ZMod (2 ^ r * 2 ^ (r + 1))) +
          (B : ZMod (2 ^ r * 2 ^ (r + 1))) *
            (↑(L⁻¹) : ZMod (2 ^ r * 2 ^ (r + 1)))) *
      quadraticLiftSumPrimePow 2 r
        (C.cast : ZMod (2 ^ (r + 1)))
        (D.cast : ZMod (2 ^ (r + 1)))
  have hzero (u : (ZMod (2 ^ r))ˣ) (hu : ¬P u) : term u = 0 := by
    dsimp only [P] at hu
    dsimp only [term]
    rw [quadraticLiftSumPrimePow_eq_zero_of_cast_ne 2 r _ _ hu, mul_zero]
  have hterm (u : (ZMod (2 ^ r))ˣ) :
      ‖term u‖ ≤ (2 ^ r : ℝ) * 2 := by
    dsimp only [term]
    rw [norm_mul, AddChar.norm_apply, one_mul]
    exact norm_quadraticLiftSumPrimePow_le_card 2 r _ _
  letI : Fintype (oddPrimePowerStationaryFiber 2 r A B) := by
    dsimp only [oddPrimePowerStationaryFiber]
    infer_instance
  have hcardEq :
      (Finset.univ.filter P).card =
        Nat.card (oddPrimePowerStationaryFiber 2 r A B) := by
    rw [Nat.card_eq_fintype_card]
    exact (Fintype.card_of_subtype (Finset.univ.filter P) (by
      intro u
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, P])).symm
  have hcardCoeff :
      ((Finset.univ.filter P).card : ℝ) * 2 ≤
        (2 * r + 2 : ℕ) * Real.sqrt 2 := by
    have hsqrtSq : Real.sqrt (2 : ℝ) ^ 2 = 2 :=
      Real.sq_sqrt (by norm_num)
    have hsqrtNonneg : 0 ≤ Real.sqrt (2 : ℝ) := Real.sqrt_nonneg _
    by_cases hr1 : r = 1
    · subst r
      have hcard : (Finset.univ.filter P).card ≤ 1 := by
        rw [hcardEq]
        exact card_oddTwoPowerStationaryFiber_one_le_one A B hA hB
      have hcast : ((Finset.univ.filter P).card : ℝ) ≤ 1 := by
        exact_mod_cast hcard
      norm_num only [Nat.reduceMul, Nat.reduceAdd, Nat.cast_ofNat]
      nlinarith
    · have hr2 : 2 ≤ r := by omega
      have hcard : (Finset.univ.filter P).card ≤ 4 := by
        rw [hcardEq]
        exact card_oddTwoPowerStationaryFiber_le_four r A B hr hA hB
      have hcast : ((Finset.univ.filter P).card : ℝ) ≤ 4 := by
        exact_mod_cast hcard
      have hsqrtLower : 4 ≤ 3 * Real.sqrt (2 : ℝ) := by
        nlinarith
      have hcoeff : (8 : ℝ) ≤ (2 * r + 2 : ℕ) * Real.sqrt 2 := by
        have hrCast : (6 : ℝ) ≤ (2 * r + 2 : ℕ) := by
          exact_mod_cast (show 6 ≤ 2 * r + 2 by omega)
        nlinarith
      nlinarith
  rw [kloostermanSumZMod_primePower_odd_fibers 2 r A B hr]
  change ‖∑ u : (ZMod (2 ^ r))ˣ, term u‖ ≤ _
  calc
    ‖∑ u : (ZMod (2 ^ r))ˣ, term u‖ =
        ‖∑ u ∈ Finset.univ.filter P, term u‖ := by
      congr 1
      conv_rhs => rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro u _hu
      by_cases hPu : P u
      · rw [if_pos hPu]
      · rw [if_neg hPu, hzero u hPu]
    _ ≤ ∑ u ∈ Finset.univ.filter P, ‖term u‖ := norm_sum_le _ _
    _ ≤ ∑ _u ∈ Finset.univ.filter P, ((2 ^ r : ℝ) * 2) := by
      apply Finset.sum_le_sum
      intro u _hu
      exact hterm u
    _ = ((Finset.univ.filter P).card : ℝ) * ((2 ^ r : ℝ) * 2) := by
      rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (2 * r + 2) * ((2 ^ r : ℝ) * Real.sqrt 2) := by
      calc
        ((Finset.univ.filter P).card : ℝ) * ((2 ^ r : ℝ) * 2) =
            (2 ^ r : ℝ) * (((Finset.univ.filter P).card : ℝ) * 2) := by
          ring
        _ ≤ (2 ^ r : ℝ) * ((2 * r + 2 : ℕ) * Real.sqrt 2) := by
          gcongr
        _ = (2 * r + 2) * ((2 ^ r : ℝ) * Real.sqrt 2) := by
          push_cast
          ring

theorem primePowerStationaryPhase_expansion
    (p a b A B : ℕ) [Fact p.Prime] (ha : 0 < a) (hba : b ≤ a)
    (u : (ZMod (p ^ a))ˣ) (z : ZMod (p ^ b)) :
    let L := primePowerUnitLift p a b u
    let K := primePowerKernelPerturb p a b ha z
    (A : ZMod (p ^ a * p ^ b)) * (L * K :
        (ZMod (p ^ a * p ^ b))ˣ) +
      (B : ZMod (p ^ a * p ^ b)) *
        (↑((L * K)⁻¹) : ZMod (p ^ a * p ^ b)) =
      ((A : ZMod (p ^ a * p ^ b)) * (L : ZMod (p ^ a * p ^ b)) +
        (B : ZMod (p ^ a * p ^ b)) *
          (↑(L⁻¹) : ZMod (p ^ a * p ^ b))) +
      ((p ^ a : ℕ) : ZMod (p ^ a * p ^ b)) *
        (z.val : ZMod (p ^ a * p ^ b)) *
        ((A : ZMod (p ^ a * p ^ b)) * (L : ZMod (p ^ a * p ^ b)) -
          (B : ZMod (p ^ a * p ^ b)) *
            (↑(L⁻¹) : ZMod (p ^ a * p ^ b))) := by
  dsimp only
  rw [mul_inv_rev]
  push_cast
  rw [coe_primePowerKernelPerturb,
    coe_primePowerKernelPerturb_inv p a b ha hba]
  push_cast
  ring

theorem primePowerStationaryCharacter_expansion
    (p a b A B : ℕ) [Fact p.Prime] (ha : 0 < a) (hba : b ≤ a)
    (u : (ZMod (p ^ a))ˣ) (z : ZMod (p ^ b)) :
    let L := primePowerUnitLift p a b u
    let C : ZMod (p ^ a * p ^ b) :=
      (A : ZMod (p ^ a * p ^ b)) *
          (L : ZMod (p ^ a * p ^ b)) -
        (B : ZMod (p ^ a * p ^ b)) * (↑(L⁻¹) : ZMod (p ^ a * p ^ b))
    ZMod.stdAddChar
        ((A : ZMod (p ^ a * p ^ b)) *
            (↑(primePowerUnitsSigmaEquiv p a b ha ⟨u, z⟩) :
              ZMod (p ^ a * p ^ b)) +
          (B : ZMod (p ^ a * p ^ b)) *
            (↑((primePowerUnitsSigmaEquiv p a b ha ⟨u, z⟩)⁻¹) :
              ZMod (p ^ a * p ^ b))) =
      ZMod.stdAddChar
          ((A : ZMod (p ^ a * p ^ b)) *
              (L : ZMod (p ^ a * p ^ b)) +
            (B : ZMod (p ^ a * p ^ b)) *
              (↑(L⁻¹) : ZMod (p ^ a * p ^ b))) *
        ZMod.stdAddChar
          ((((z.val : ZMod (p ^ a * p ^ b)) * C).cast) : ZMod (p ^ b)) := by
  dsimp only
  rw [primePowerUnitsSigmaEquiv_apply]
  rw [primePowerStationaryPhase_expansion p a b A B ha hba]
  rw [ZMod.stdAddChar.map_add_eq_mul]
  congr 1
  rw [show ((p ^ a : ℕ) : ZMod (p ^ a * p ^ b)) *
      (z.val : ZMod (p ^ a * p ^ b)) *
      ((A : ZMod (p ^ a * p ^ b)) *
          (primePowerUnitLift p a b u : ZMod (p ^ a * p ^ b)) -
        (B : ZMod (p ^ a * p ^ b)) *
          (↑((primePowerUnitLift p a b u)⁻¹) :
            ZMod (p ^ a * p ^ b))) =
      ((p ^ a : ℕ) : ZMod (p ^ a * p ^ b)) *
        ((z.val : ZMod (p ^ a * p ^ b)) *
          ((A : ZMod (p ^ a * p ^ b)) *
              (primePowerUnitLift p a b u : ZMod (p ^ a * p ^ b)) -
            (B : ZMod (p ^ a * p ^ b)) *
              (↑((primePowerUnitLift p a b u)⁻¹) :
                ZMod (p ^ a * p ^ b)))) by ring]
  exact stdAddChar_mul_modulus_factor (p ^ a) (p ^ b) _

/-- Exact orthogonality of the standard additive character after a
multiplicative shift.  This is the finite Fourier cancellation used in the
prime-power stationary-phase decomposition. -/
theorem sum_stdAddChar_mul_eq_ite (q : ℕ) [NeZero q] (C : ZMod q) :
    (∑ z : ZMod q, (ZMod.stdAddChar (z * C) : ℂ)) =
      if C = 0 then (q : ℂ) else 0 := by
  simpa [ZMod.card] using
    (AddChar.sum_mulShift C (ZMod.isPrimitive_stdAddChar q))

/-- Summing over one congruence fiber kills every nonstationary base unit
exactly. -/
theorem primePowerStationaryFiberSum
    (p a b A B : ℕ) [Fact p.Prime] (ha : 0 < a) (hba : b ≤ a)
    (u : (ZMod (p ^ a))ˣ) :
    (∑ z : ZMod (p ^ b),
      ZMod.stdAddChar
        ((A : ZMod (p ^ a * p ^ b)) *
            (↑(primePowerUnitsSigmaEquiv p a b ha ⟨u, z⟩) :
              ZMod (p ^ a * p ^ b)) +
          (B : ZMod (p ^ a * p ^ b)) *
            (↑((primePowerUnitsSigmaEquiv p a b ha ⟨u, z⟩)⁻¹) :
              ZMod (p ^ a * p ^ b)))) =
      ZMod.stdAddChar
          ((A : ZMod (p ^ a * p ^ b)) *
              (primePowerUnitLift p a b u : ZMod (p ^ a * p ^ b)) +
            (B : ZMod (p ^ a * p ^ b)) *
              (↑((primePowerUnitLift p a b u)⁻¹) :
                ZMod (p ^ a * p ^ b))) *
        if (((A : ZMod (p ^ a * p ^ b)) *
                (primePowerUnitLift p a b u : ZMod (p ^ a * p ^ b)) -
              (B : ZMod (p ^ a * p ^ b)) *
                (↑((primePowerUnitLift p a b u)⁻¹) :
                  ZMod (p ^ a * p ^ b))).cast : ZMod (p ^ b)) = 0
        then (p ^ b : ℂ)
        else 0 := by
  let C : ZMod (p ^ a * p ^ b) :=
    (A : ZMod (p ^ a * p ^ b)) *
        (primePowerUnitLift p a b u : ZMod (p ^ a * p ^ b)) -
      (B : ZMod (p ^ a * p ^ b)) *
        (↑((primePowerUnitLift p a b u)⁻¹) : ZMod (p ^ a * p ^ b))
  let C' : ZMod (p ^ b) := C.cast
  have hcast (z : ZMod (p ^ b)) :
      ((((z.val : ZMod (p ^ a * p ^ b)) * C).cast) : ZMod (p ^ b)) =
        z * C' := by
    dsimp only [C']
    rw [ZMod.cast_mul (dvd_mul_left (p ^ b) (p ^ a))]
    rw [ZMod.cast_natCast (dvd_mul_left (p ^ b) (p ^ a))]
    rw [ZMod.natCast_zmod_val]
  calc
    (∑ z : ZMod (p ^ b),
        ZMod.stdAddChar
          ((A : ZMod (p ^ a * p ^ b)) *
              (↑(primePowerUnitsSigmaEquiv p a b ha ⟨u, z⟩) :
                ZMod (p ^ a * p ^ b)) +
            (B : ZMod (p ^ a * p ^ b)) *
              (↑((primePowerUnitsSigmaEquiv p a b ha ⟨u, z⟩)⁻¹) :
                ZMod (p ^ a * p ^ b)))) =
        ∑ z : ZMod (p ^ b),
          ZMod.stdAddChar
              ((A : ZMod (p ^ a * p ^ b)) *
                  (primePowerUnitLift p a b u : ZMod (p ^ a * p ^ b)) +
                (B : ZMod (p ^ a * p ^ b)) *
                  (↑((primePowerUnitLift p a b u)⁻¹) :
                    ZMod (p ^ a * p ^ b))) *
            ZMod.stdAddChar (z * C') := by
          apply Finset.sum_congr rfl
          intro z _hz
          rw [primePowerStationaryCharacter_expansion p a b A B ha hba]
          rw [hcast]
    _ = ZMod.stdAddChar
          ((A : ZMod (p ^ a * p ^ b)) *
              (primePowerUnitLift p a b u : ZMod (p ^ a * p ^ b)) +
            (B : ZMod (p ^ a * p ^ b)) *
              (↑((primePowerUnitLift p a b u)⁻¹) :
                ZMod (p ^ a * p ^ b))) *
          (∑ z : ZMod (p ^ b), ZMod.stdAddChar (z * C')) := by
            rw [Finset.mul_sum]
    _ = _ := by
      rw [sum_stdAddChar_mul_eq_ite]
      simp only [C', C]
      by_cases h :
          (((A : ZMod (p ^ a * p ^ b)) *
                (primePowerUnitLift p a b u : ZMod (p ^ a * p ^ b)) -
              (B : ZMod (p ^ a * p ^ b)) *
                (↑((primePowerUnitLift p a b u)⁻¹) :
                  ZMod (p ^ a * p ^ b))).cast : ZMod (p ^ b)) = 0
      · simp [h]
      · simp

/-- Exact stationary-phase decomposition of a complete Kloosterman sum at a
split prime-power modulus.  The inner lift sum has disappeared: only base
units satisfying the stationary congruence modulo `p ^ b` survive. -/
theorem kloostermanSumZMod_primePower_stationary_decomposition
    (p a b A B : ℕ) [Fact p.Prime] (ha : 0 < a) (hba : b ≤ a) :
    kloostermanSumZMod (p ^ a * p ^ b) A B =
      ∑ u : (ZMod (p ^ a))ˣ,
        ZMod.stdAddChar
            ((A : ZMod (p ^ a * p ^ b)) *
                (primePowerUnitLift p a b u : ZMod (p ^ a * p ^ b)) +
              (B : ZMod (p ^ a * p ^ b)) *
                (↑((primePowerUnitLift p a b u)⁻¹) :
                  ZMod (p ^ a * p ^ b))) *
          if (((A : ZMod (p ^ a * p ^ b)) *
                  (primePowerUnitLift p a b u : ZMod (p ^ a * p ^ b)) -
                (B : ZMod (p ^ a * p ^ b)) *
                  (↑((primePowerUnitLift p a b u)⁻¹) :
                    ZMod (p ^ a * p ^ b))).cast : ZMod (p ^ b)) = 0
          then (p ^ b : ℂ)
          else 0 := by
  unfold kloostermanSumZMod
  calc
    (∑ d : (ZMod (p ^ a * p ^ b))ˣ,
        ZMod.stdAddChar
          ((A : ZMod (p ^ a * p ^ b)) * (d : ZMod (p ^ a * p ^ b)) +
            (B : ZMod (p ^ a * p ^ b)) *
              (↑(d⁻¹) : ZMod (p ^ a * p ^ b)))) =
        ∑ x : Σ _u : (ZMod (p ^ a))ˣ, ZMod (p ^ b),
          ZMod.stdAddChar
            ((A : ZMod (p ^ a * p ^ b)) *
                (↑(primePowerUnitsSigmaEquiv p a b ha x) :
                  ZMod (p ^ a * p ^ b)) +
              (B : ZMod (p ^ a * p ^ b)) *
                (↑((primePowerUnitsSigmaEquiv p a b ha x)⁻¹) :
                  ZMod (p ^ a * p ^ b))) := by
      symm
      apply Fintype.sum_equiv (primePowerUnitsSigmaEquiv p a b ha)
      intro x
      rfl
    _ = ∑ u : (ZMod (p ^ a))ˣ, ∑ z : ZMod (p ^ b),
          ZMod.stdAddChar
            ((A : ZMod (p ^ a * p ^ b)) *
                (↑(primePowerUnitsSigmaEquiv p a b ha ⟨u, z⟩) :
                  ZMod (p ^ a * p ^ b)) +
              (B : ZMod (p ^ a * p ^ b)) *
                (↑((primePowerUnitsSigmaEquiv p a b ha ⟨u, z⟩)⁻¹) :
                  ZMod (p ^ a * p ^ b))) := by
      exact Fintype.sum_sigma' (fun u z =>
        ZMod.stdAddChar
          ((A : ZMod (p ^ a * p ^ b)) *
              (↑(primePowerUnitsSigmaEquiv p a b ha ⟨u, z⟩) :
                ZMod (p ^ a * p ^ b)) +
            (B : ZMod (p ^ a * p ^ b)) *
              (↑((primePowerUnitsSigmaEquiv p a b ha ⟨u, z⟩)⁻¹) :
                ZMod (p ^ a * p ^ b))))
    _ = _ := by
      apply Finset.sum_congr rfl
      intro u _hu
      exact primePowerStationaryFiberSum p a b A B ha hba u

theorem primePowerStationaryResidue_even
    (p r A B : ℕ) [Fact p.Prime] (u : (ZMod (p ^ r))ˣ) :
    (((A : ZMod (p ^ r * p ^ r)) *
              (primePowerUnitLift p r r u : ZMod (p ^ r * p ^ r)) -
            (B : ZMod (p ^ r * p ^ r)) *
              (↑((primePowerUnitLift p r r u)⁻¹) :
                ZMod (p ^ r * p ^ r))).cast : ZMod (p ^ r)) =
      (A : ZMod (p ^ r)) * (u : ZMod (p ^ r)) -
        (B : ZMod (p ^ r)) * (↑(u⁻¹) : ZMod (p ^ r)) := by
  let hdiv : p ^ r ∣ p ^ r * p ^ r := dvd_mul_right _ _
  rw [ZMod.cast_sub hdiv, ZMod.cast_mul hdiv, ZMod.cast_mul hdiv,
    ZMod.cast_natCast hdiv, ZMod.cast_natCast hdiv]
  rw [cast_primePowerUnitLift_val, cast_primePowerUnitLift_inv_val]

/-- The `evenPrimePowerStationaryFiber` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def evenPrimePowerStationaryFiber
    (p r A B : ℕ) [Fact p.Prime] :=
  {u : (ZMod (p ^ r))ˣ //
    (((A : ZMod (p ^ r * p ^ r)) *
          (primePowerUnitLift p r r u : ZMod (p ^ r * p ^ r)) -
        (B : ZMod (p ^ r * p ^ r)) *
          (↑((primePowerUnitLift p r r u)⁻¹) :
            ZMod (p ^ r * p ^ r))).cast : ZMod (p ^ r)) = 0}

/-- The `evenPrimePowerStationaryFiberEquiv` definition used by the source-facing construction in `KloostermanPrimePower`. -/
noncomputable def evenPrimePowerStationaryFiberEquiv
    (p r A B : ℕ) [Fact p.Prime] :
    evenPrimePowerStationaryFiber p r A B ≃
      zmodStationaryFiber (p ^ r) A B where
  toFun u := ⟨u.1, by
    rw [← primePowerStationaryResidue_even p r A B u.1]
    exact u.2⟩
  invFun u := ⟨u.1, by
    rw [primePowerStationaryResidue_even p r A B u.1]
    exact u.2⟩
  left_inv u := by rfl
  right_inv u := by rfl

theorem card_evenPrimePowerStationaryFiber_le_two
    (p r A B : ℕ) [Fact p.Prime] (hp2 : p ≠ 2)
    (hA : A.Coprime p) (hB : B.Coprime p) :
    Nat.card (evenPrimePowerStationaryFiber p r A B) ≤ 2 := by
  letI : IsCyclic (ZMod (p ^ r))ˣ :=
    ZMod.isCyclic_units_of_prime_pow p Fact.out hp2 r
  have hAunit : IsUnit (A : ZMod (p ^ r)) := by
    rw [ZMod.isUnit_iff_coprime]
    exact hA.pow_right r
  have hBunit : IsUnit (B : ZMod (p ^ r)) := by
    rw [ZMod.isUnit_iff_coprime]
    exact hB.pow_right r
  rw [Nat.card_congr (evenPrimePowerStationaryFiberEquiv p r A B)]
  exact card_zmodStationaryFiber_le_two (p ^ r) A B hAunit hBunit

theorem card_evenTwoPowerStationaryFiber_le_four
    (r A B : ℕ) (hr : 0 < r)
    (hA : A.Coprime 2) (hB : B.Coprime 2) :
    Nat.card (evenPrimePowerStationaryFiber 2 r A B) ≤ 4 := by
  have hAunit : IsUnit (A : ZMod (2 ^ r)) := by
    rw [ZMod.isUnit_iff_coprime]
    exact hA.pow_right r
  have hBunit : IsUnit (B : ZMod (2 ^ r)) := by
    rw [ZMod.isUnit_iff_coprime]
    exact hB.pow_right r
  rw [Nat.card_congr (evenPrimePowerStationaryFiberEquiv 2 r A B)]
  exact card_zmodStationaryFiber_two_pow_le_four r hr A B hAunit hBunit

theorem card_evenTwoPowerStationaryFiber_one_le_one
    (A B : ℕ) (hA : A.Coprime 2) (hB : B.Coprime 2) :
    Nat.card (evenPrimePowerStationaryFiber 2 1 A B) ≤ 1 := by
  have hAunit : IsUnit (A : ZMod 2) := by
    rw [ZMod.isUnit_iff_coprime]
    simpa using hA
  have hBunit : IsUnit (B : ZMod 2) := by
    rw [ZMod.isUnit_iff_coprime]
    simpa using hB
  rw [Nat.card_congr (evenPrimePowerStationaryFiberEquiv 2 1 A B)]
  simpa using card_zmodStationaryFiber_two_le_one A B hAunit hBunit

/-- The nondegenerate even-exponent prime-power Kloosterman bound obtained
from exact stationary phase and the two-root theorem. -/
theorem norm_kloostermanSumZMod_primePower_even_le
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r) (hp2 : p ≠ 2)
    (hA : A.Coprime p) (hB : B.Coprime p) :
    ‖kloostermanSumZMod (p ^ r * p ^ r) A B‖ ≤
      2 * (p ^ r : ℝ) := by
  let P : (ZMod (p ^ r))ˣ → Prop := fun u =>
    (((A : ZMod (p ^ r * p ^ r)) *
          (primePowerUnitLift p r r u : ZMod (p ^ r * p ^ r)) -
        (B : ZMod (p ^ r * p ^ r)) *
          (↑((primePowerUnitLift p r r u)⁻¹) :
            ZMod (p ^ r * p ^ r))).cast : ZMod (p ^ r)) = 0
  let phase : (ZMod (p ^ r))ˣ → ZMod (p ^ r * p ^ r) := fun u =>
    (A : ZMod (p ^ r * p ^ r)) *
        (primePowerUnitLift p r r u : ZMod (p ^ r * p ^ r)) +
      (B : ZMod (p ^ r * p ^ r)) *
        (↑((primePowerUnitLift p r r u)⁻¹) : ZMod (p ^ r * p ^ r))
  have hdecomp :=
    kloostermanSumZMod_primePower_stationary_decomposition
      p r r A B hr (le_refl r)
  have hterm (u : (ZMod (p ^ r))ˣ) :
      ‖ZMod.stdAddChar (phase u) *
          if P u then (p ^ r : ℂ) else 0‖ =
        if P u then (p ^ r : ℝ) else 0 := by
    by_cases hu : P u
    · simp [hu, AddChar.norm_apply]
    · simp [hu]
  letI : Fintype (evenPrimePowerStationaryFiber p r A B) := by
    dsimp only [evenPrimePowerStationaryFiber]
    infer_instance
  have hcardEq :
      (Finset.univ.filter P).card =
        Nat.card (evenPrimePowerStationaryFiber p r A B) := by
    rw [Nat.card_eq_fintype_card]
    exact (Fintype.card_of_subtype (Finset.univ.filter P) (by
      intro u
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, P])).symm
  have hcard : (Finset.univ.filter P).card ≤ 2 := by
    rw [hcardEq]
    exact card_evenPrimePowerStationaryFiber_le_two p r A B hp2 hA hB
  rw [hdecomp]
  change ‖∑ u : (ZMod (p ^ r))ˣ,
      ZMod.stdAddChar (phase u) *
        if P u then (p ^ r : ℂ) else 0‖ ≤ _
  calc
    ‖∑ u : (ZMod (p ^ r))ˣ,
        ZMod.stdAddChar (phase u) *
          if P u then (p ^ r : ℂ) else 0‖ ≤
        ∑ u : (ZMod (p ^ r))ˣ,
          ‖ZMod.stdAddChar (phase u) *
            if P u then (p ^ r : ℂ) else 0‖ := norm_sum_le _ _
    _ = ∑ u : (ZMod (p ^ r))ˣ,
          if P u then (p ^ r : ℝ) else 0 := by
      apply Finset.sum_congr rfl
      intro u _hu
      exact hterm u
    _ = ∑ _u ∈ Finset.univ.filter P, (p ^ r : ℝ) := by
      rw [Finset.sum_filter]
    _ = ((Finset.univ.filter P).card : ℝ) * (p ^ r : ℝ) := by
      rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ 2 * (p ^ r : ℝ) := by
      gcongr
      exact_mod_cast hcard

/-- The 2-adic even-exponent local Weil--Estermann bound.  The divisor
factor absorbs the four possible stationary square roots; at exponent two
the unit group modulo two gives the sharper one-point count. -/
theorem norm_kloostermanSumZMod_twoPower_even_coprime_le_raw
    (r A B : ℕ) (hr : 0 < r)
    (hA : A.Coprime 2) (hB : B.Coprime 2) :
    ‖kloostermanSumZMod (2 ^ r * 2 ^ r) A B‖ ≤
      (2 * r + 1) * (2 ^ r : ℝ) := by
  let P : (ZMod (2 ^ r))ˣ → Prop := fun u =>
    (((A : ZMod (2 ^ r * 2 ^ r)) *
          (primePowerUnitLift 2 r r u : ZMod (2 ^ r * 2 ^ r)) -
        (B : ZMod (2 ^ r * 2 ^ r)) *
          (↑((primePowerUnitLift 2 r r u)⁻¹) :
            ZMod (2 ^ r * 2 ^ r))).cast : ZMod (2 ^ r)) = 0
  let phase : (ZMod (2 ^ r))ˣ → ZMod (2 ^ r * 2 ^ r) := fun u =>
    (A : ZMod (2 ^ r * 2 ^ r)) *
        (primePowerUnitLift 2 r r u : ZMod (2 ^ r * 2 ^ r)) +
      (B : ZMod (2 ^ r * 2 ^ r)) *
        (↑((primePowerUnitLift 2 r r u)⁻¹) : ZMod (2 ^ r * 2 ^ r))
  have hdecomp :=
    kloostermanSumZMod_primePower_stationary_decomposition
      2 r r A B hr (le_refl r)
  have hterm (u : (ZMod (2 ^ r))ˣ) :
      ‖ZMod.stdAddChar (phase u) *
          if P u then (2 ^ r : ℂ) else 0‖ =
        if P u then (2 ^ r : ℝ) else 0 := by
    by_cases hu : P u
    · simp [hu, AddChar.norm_apply]
    · simp [hu]
  letI : Fintype (evenPrimePowerStationaryFiber 2 r A B) := by
    dsimp only [evenPrimePowerStationaryFiber]
    infer_instance
  have hcardEq :
      (Finset.univ.filter P).card =
        Nat.card (evenPrimePowerStationaryFiber 2 r A B) := by
    rw [Nat.card_eq_fintype_card]
    exact (Fintype.card_of_subtype (Finset.univ.filter P) (by
      intro u
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, P])).symm
  have hcard : (Finset.univ.filter P).card ≤ 2 * r + 1 := by
    rw [hcardEq]
    by_cases hr1 : r = 1
    · subst r
      exact (card_evenTwoPowerStationaryFiber_one_le_one A B hA hB).trans
        (by norm_num)
    · exact (card_evenTwoPowerStationaryFiber_le_four r A B hr hA hB).trans
        (by omega)
  rw [hdecomp]
  change ‖∑ u : (ZMod (2 ^ r))ˣ,
      ZMod.stdAddChar (phase u) *
        if P u then (2 ^ r : ℂ) else 0‖ ≤ _
  calc
    ‖∑ u : (ZMod (2 ^ r))ˣ,
        ZMod.stdAddChar (phase u) *
          if P u then (2 ^ r : ℂ) else 0‖ ≤
        ∑ u : (ZMod (2 ^ r))ˣ,
          ‖ZMod.stdAddChar (phase u) *
            if P u then (2 ^ r : ℂ) else 0‖ := norm_sum_le _ _
    _ = ∑ u : (ZMod (2 ^ r))ˣ,
          if P u then (2 ^ r : ℝ) else 0 := by
      apply Finset.sum_congr rfl
      intro u _hu
      exact hterm u
    _ = ∑ _u ∈ Finset.univ.filter P, (2 ^ r : ℝ) := by
      rw [Finset.sum_filter]
    _ = ((Finset.univ.filter P).card : ℝ) * (2 ^ r : ℝ) := by
      rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (2 * r + 1) * (2 ^ r : ℝ) := by
      gcongr
      exact_mod_cast hcard

theorem primePowerStationaryResidue_ne_zero_of_coprime_of_dvd
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r)
    (hA : A.Coprime p) (hB : p ∣ B) (u : (ZMod (p ^ r))ˣ) :
    (A : ZMod (p ^ r)) * (u : ZMod (p ^ r)) -
        (B : ZMod (p ^ r)) * (↑(u⁻¹) : ZMod (p ^ r)) ≠ 0 := by
  have hAunit : IsUnit (A : ZMod (p ^ r)) := by
    rw [ZMod.isUnit_iff_coprime]
    exact hA.pow_right r
  have hBnonunit : ¬IsUnit (B : ZMod (p ^ r)) := by
    rw [ZMod.isUnit_iff_coprime]
    intro hcop
    have hpPow : p ∣ p ^ r := dvd_pow_self p hr.ne'
    have hpCopB : p.Coprime B := hcop.symm.coprime_dvd_left hpPow
    exact ((show p.Prime from Fact.out).coprime_iff_not_dvd.mp hpCopB) hB
  have hleft :
      IsUnit ((A : ZMod (p ^ r)) * (u : ZMod (p ^ r))) :=
    hAunit.mul (Units.isUnit u)
  have hright :
      ¬IsUnit ((B : ZMod (p ^ r)) * (↑(u⁻¹) : ZMod (p ^ r))) := by
    intro hunit
    exact hBnonunit ((Commute.all _ _).isUnit_mul_iff.mp hunit).1
  intro hzero
  have heq :
      (A : ZMod (p ^ r)) * (u : ZMod (p ^ r)) =
        (B : ZMod (p ^ r)) * (↑(u⁻¹) : ZMod (p ^ r)) :=
    sub_eq_zero.mp hzero
  exact hright (heq ▸ hleft)

/-- A primitive/nonprimitive frequency mismatch forces exact cancellation at
every even prime-power exponent at least two. -/
theorem kloostermanSumZMod_primePower_even_eq_zero_of_coprime_of_dvd
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r)
    (hA : A.Coprime p) (hB : p ∣ B) :
    kloostermanSumZMod (p ^ r * p ^ r) A B = 0 := by
  rw [kloostermanSumZMod_primePower_stationary_decomposition
    p r r A B hr (le_refl r)]
  apply Finset.sum_eq_zero
  intro u _hu
  have hnonstationary :
      ¬((((A : ZMod (p ^ r * p ^ r)) *
              (primePowerUnitLift p r r u : ZMod (p ^ r * p ^ r)) -
            (B : ZMod (p ^ r * p ^ r)) *
              (↑((primePowerUnitLift p r r u)⁻¹) :
                ZMod (p ^ r * p ^ r))).cast : ZMod (p ^ r)) = 0) := by
    rw [primePowerStationaryResidue_even]
    exact primePowerStationaryResidue_ne_zero_of_coprime_of_dvd
      p r A B hr hA hB u
  rw [if_neg hnonstationary, mul_zero]

/-- The corresponding exact cancellation at every odd exponent at least
three. -/
theorem kloostermanSumZMod_primePower_odd_eq_zero_of_coprime_of_dvd
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r)
    (hA : A.Coprime p) (hB : p ∣ B) :
    kloostermanSumZMod (p ^ r * p ^ (r + 1)) A B = 0 := by
  rw [kloostermanSumZMod_primePower_odd_fibers p r A B hr]
  apply Finset.sum_eq_zero
  intro u _hu
  dsimp only
  rw [quadraticLiftSumPrimePow_eq_zero_of_cast_ne, mul_zero]
  rw [primePowerOddStationaryResidue]
  exact primePowerStationaryResidue_ne_zero_of_coprime_of_dvd
    p r A B hr hA hB u

theorem kloostermanSumZMod_primePower_even_eq_zero_of_dvd_of_coprime
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r)
    (hA : p ∣ A) (hB : B.Coprime p) :
    kloostermanSumZMod (p ^ r * p ^ r) A B = 0 := by
  rw [kloostermanSumZMod_comm]
  exact kloostermanSumZMod_primePower_even_eq_zero_of_coprime_of_dvd
    p r B A hr hB hA

theorem kloostermanSumZMod_primePower_odd_eq_zero_of_dvd_of_coprime
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r)
    (hA : p ∣ A) (hB : B.Coprime p) :
    kloostermanSumZMod (p ^ r * p ^ (r + 1)) A B = 0 := by
  rw [kloostermanSumZMod_comm]
  exact kloostermanSumZMod_primePower_odd_eq_zero_of_coprime_of_dvd
    p r B A hr hB hA

theorem prime_dvd_of_not_coprime_right
    (p A : ℕ) [Fact p.Prime] (hA : ¬A.Coprime p) : p ∣ A := by
  by_contra hdiv
  apply hA
  exact ((show p.Prime from Fact.out).coprime_iff_not_dvd.mpr hdiv).symm

theorem sqrt_real_natPow_mul_self (p r : ℕ) :
    Real.sqrt ((p : ℝ) ^ r * (p : ℝ) ^ r) = (p : ℝ) ^ r := by
  exact Real.sqrt_mul_self (pow_nonneg (Nat.cast_nonneg p) r)

theorem sqrt_natCast_pow_two_mul (p r : ℕ) :
    Real.sqrt ((p ^ r * p ^ r : ℕ) : ℝ) = (p ^ r : ℝ) := by
  simpa only [Nat.cast_mul, Nat.cast_pow] using sqrt_real_natPow_mul_self p r

theorem sqrt_natCast_pow_two_mul_succ (p r : ℕ) :
    Real.sqrt ((p ^ r * p ^ (r + 1) : ℕ) : ℝ) =
      (p ^ r : ℝ) * Real.sqrt p := by
  simp only [pow_succ, Nat.cast_mul, Nat.cast_pow]
  calc
    Real.sqrt ((p : ℝ) ^ r * ((p : ℝ) ^ r * p)) =
        Real.sqrt (((p : ℝ) ^ r * (p : ℝ) ^ r) * p) :=
      congrArg Real.sqrt (mul_assoc _ _ _).symm
    _ = Real.sqrt ((p : ℝ) ^ r * (p : ℝ) ^ r) * Real.sqrt p :=
      Real.sqrt_mul (by positivity) _
    _ = (p : ℝ) ^ r * Real.sqrt p := by
      rw [Real.sqrt_mul_self]
      positivity

theorem sqrt_real_natPow_mul_succ (p r : ℕ) :
    Real.sqrt ((p : ℝ) ^ r * (p : ℝ) ^ (r + 1)) =
      (p : ℝ) ^ r * Real.sqrt p := by
  simpa only [← Nat.cast_pow, ← Nat.cast_mul] using
    sqrt_natCast_pow_two_mul_succ p r

/-- Square-root normalization of the even stationary-phase estimate. -/
theorem norm_kloostermanSumZMod_oddPrimePow_even_coprime_le
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r) (hp2 : p ≠ 2)
    (hA : A.Coprime p) (hB : B.Coprime p) :
    ‖kloostermanSumZMod (p ^ r * p ^ r) A B‖ ≤
      2 * Real.sqrt (p ^ r * p ^ r) := by
  rw [sqrt_real_natPow_mul_self]
  exact norm_kloostermanSumZMod_primePower_even_le p r A B hr hp2 hA hB

/-- Square-root normalization of the odd stationary-phase estimate. -/
theorem norm_kloostermanSumZMod_oddPrimePow_odd_coprime_le
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r) (hp2 : p ≠ 2)
    (hA : A.Coprime p) (hB : B.Coprime p) :
    ‖kloostermanSumZMod (p ^ r * p ^ (r + 1)) A B‖ ≤
      2 * Real.sqrt (p ^ r * p ^ (r + 1)) := by
  rw [sqrt_real_natPow_mul_succ]
  exact norm_kloostermanSumZMod_primePower_odd_le p r A B hr hp2 hA hB

/-- Square-root normalization of the 2-adic even-exponent estimate. -/
theorem norm_kloostermanSumZMod_twoPower_even_coprime_le
    (r A B : ℕ) (hr : 0 < r)
    (hA : A.Coprime 2) (hB : B.Coprime 2) :
    ‖kloostermanSumZMod (2 ^ r * 2 ^ r) A B‖ ≤
      ((2 * r + 1 : ℕ) : ℝ) *
        Real.sqrt (((2 ^ r * 2 ^ r : ℕ) : ℝ)) := by
  rw [sqrt_natCast_pow_two_mul]
  convert norm_kloostermanSumZMod_twoPower_even_coprime_le_raw
    r A B hr hA hB using 1
  norm_num

/-- Square-root normalization of the 2-adic odd-exponent estimate. -/
theorem norm_kloostermanSumZMod_twoPower_odd_coprime_le
    (r A B : ℕ) (hr : 0 < r)
    (hA : A.Coprime 2) (hB : B.Coprime 2) :
    ‖kloostermanSumZMod (2 ^ r * 2 ^ (r + 1)) A B‖ ≤
      ((2 * r + 2 : ℕ) : ℝ) *
        Real.sqrt (((2 ^ r * 2 ^ (r + 1) : ℕ) : ℝ)) := by
  rw [sqrt_natCast_pow_two_mul_succ]
  convert norm_kloostermanSumZMod_twoPower_odd_coprime_le_raw
    r A B hr hA hB using 1
  norm_num

/-- Primitive 2-adic even-exponent local bound, including exact
cancellation if precisely one frequency is odd. -/
theorem norm_kloostermanSumZMod_twoPower_even_primitive_le
    (r A B : ℕ) (hr : 0 < r)
    (hprim : A.Coprime 2 ∨ B.Coprime 2) :
    ‖kloostermanSumZMod (2 ^ r * 2 ^ r) A B‖ ≤
      ((2 * r + 1 : ℕ) : ℝ) *
        Real.sqrt (((2 ^ r * 2 ^ r : ℕ) : ℝ)) := by
  rcases hprim with hA | hB
  · by_cases hBcop : B.Coprime 2
    · exact norm_kloostermanSumZMod_twoPower_even_coprime_le
        r A B hr hA hBcop
    · rw [kloostermanSumZMod_primePower_even_eq_zero_of_coprime_of_dvd
        2 r A B hr hA (prime_dvd_of_not_coprime_right 2 B hBcop), norm_zero]
      positivity
  · by_cases hAcop : A.Coprime 2
    · exact norm_kloostermanSumZMod_twoPower_even_coprime_le
        r A B hr hAcop hB
    · rw [kloostermanSumZMod_primePower_even_eq_zero_of_dvd_of_coprime
        2 r A B hr (prime_dvd_of_not_coprime_right 2 A hAcop) hB, norm_zero]
      positivity

/-- Primitive 2-adic odd-exponent local bound. -/
theorem norm_kloostermanSumZMod_twoPower_odd_primitive_le
    (r A B : ℕ) (hr : 0 < r)
    (hprim : A.Coprime 2 ∨ B.Coprime 2) :
    ‖kloostermanSumZMod (2 ^ r * 2 ^ (r + 1)) A B‖ ≤
      ((2 * r + 2 : ℕ) : ℝ) *
        Real.sqrt (((2 ^ r * 2 ^ (r + 1) : ℕ) : ℝ)) := by
  rcases hprim with hA | hB
  · by_cases hBcop : B.Coprime 2
    · exact norm_kloostermanSumZMod_twoPower_odd_coprime_le
        r A B hr hA hBcop
    · rw [kloostermanSumZMod_primePower_odd_eq_zero_of_coprime_of_dvd
        2 r A B hr hA (prime_dvd_of_not_coprime_right 2 B hBcop), norm_zero]
      positivity
  · by_cases hAcop : A.Coprime 2
    · exact norm_kloostermanSumZMod_twoPower_odd_coprime_le
        r A B hr hAcop hB
    · rw [kloostermanSumZMod_primePower_odd_eq_zero_of_dvd_of_coprime
        2 r A B hr (prime_dvd_of_not_coprime_right 2 A hAcop) hB, norm_zero]
      positivity

/-- Primitive prime-modulus bound, including either degenerate frequency.
The nondegenerate case is the geometric Weil theorem; a single zero
frequency is the exact value `-1`. -/
theorem norm_kloostermanSumZMod_prime_primitive_le
    (p A B : ℕ) [Fact p.Prime]
    (hprim : A.Coprime p ∨ B.Coprime p) :
    ‖kloostermanSumZMod p A B‖ ≤ 2 * Real.sqrt p := by
  have hpPos : (0 : ℝ) ≤ p := Nat.cast_nonneg p
  have hpSqrtSq : Real.sqrt (p : ℝ) ^ 2 = p :=
    Real.sq_sqrt hpPos
  have hpSqrtNonneg : 0 ≤ Real.sqrt (p : ℝ) := Real.sqrt_nonneg _
  have hpTwo : (2 : ℝ) ≤ p := by
    exact_mod_cast (show 2 ≤ p from (show p.Prime from Fact.out).two_le)
  have hone : (1 : ℝ) ≤ 2 * Real.sqrt p := by
    nlinarith
  rcases hprim with hA | hB
  · have hAz : (A : ZMod p) ≠ 0 := by
      intro hAz
      exact ((show p.Prime from Fact.out).coprime_iff_not_dvd.mp hA.symm)
        ((ZMod.natCast_eq_zero_iff A p).mp hAz)
    by_cases hBz : (B : ZMod p) = 0
    · rw [hBz, kloostermanSumZMod_prime_zero_right p A hAz, norm_neg,
        norm_one]
      exact hone
    · exact kloostermanSumZMod_prime_weil p A B hAz hBz
  · have hBz : (B : ZMod p) ≠ 0 := by
      intro hBz
      exact ((show p.Prime from Fact.out).coprime_iff_not_dvd.mp hB.symm)
        ((ZMod.natCast_eq_zero_iff B p).mp hBz)
    by_cases hAz : (A : ZMod p) = 0
    · rw [hAz, kloostermanSumZMod_prime_zero_left p B hBz, norm_neg,
        norm_one]
      exact hone
    · exact kloostermanSumZMod_prime_weil p A B hAz hBz
/-- Primitive even-exponent local bound: only one of the two frequencies
needs to be prime to `p`; if the other is not, the sum cancels exactly. -/
theorem norm_kloostermanSumZMod_oddPrimePow_even_primitive_le
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r) (hp2 : p ≠ 2)
    (hprim : A.Coprime p ∨ B.Coprime p) :
    ‖kloostermanSumZMod (p ^ r * p ^ r) A B‖ ≤
      2 * Real.sqrt (p ^ r * p ^ r) := by
  rcases hprim with hA | hB
  · by_cases hBcop : B.Coprime p
    · exact norm_kloostermanSumZMod_oddPrimePow_even_coprime_le
        p r A B hr hp2 hA hBcop
    · rw [kloostermanSumZMod_primePower_even_eq_zero_of_coprime_of_dvd
        p r A B hr hA (prime_dvd_of_not_coprime_right p B hBcop), norm_zero]
      positivity
  · by_cases hAcop : A.Coprime p
    · exact norm_kloostermanSumZMod_oddPrimePow_even_coprime_le
        p r A B hr hp2 hAcop hB
    · rw [kloostermanSumZMod_primePower_even_eq_zero_of_dvd_of_coprime
        p r A B hr (prime_dvd_of_not_coprime_right p A hAcop) hB, norm_zero]
      positivity

/-- Primitive odd-exponent local bound, with the same exact cancellation in
the one-unit case. -/
theorem norm_kloostermanSumZMod_oddPrimePow_odd_primitive_le
    (p r A B : ℕ) [Fact p.Prime] (hr : 0 < r) (hp2 : p ≠ 2)
    (hprim : A.Coprime p ∨ B.Coprime p) :
    ‖kloostermanSumZMod (p ^ r * p ^ (r + 1)) A B‖ ≤
      2 * Real.sqrt (p ^ r * p ^ (r + 1)) := by
  rcases hprim with hA | hB
  · by_cases hBcop : B.Coprime p
    · exact norm_kloostermanSumZMod_oddPrimePow_odd_coprime_le
        p r A B hr hp2 hA hBcop
    · rw [kloostermanSumZMod_primePower_odd_eq_zero_of_coprime_of_dvd
        p r A B hr hA (prime_dvd_of_not_coprime_right p B hBcop), norm_zero]
      positivity
  · by_cases hAcop : A.Coprime p
    · exact norm_kloostermanSumZMod_oddPrimePow_odd_coprime_le
        p r A B hr hp2 hAcop hB
    · rw [kloostermanSumZMod_primePower_odd_eq_zero_of_dvd_of_coprime
        p r A B hr (prime_dvd_of_not_coprime_right p A hAcop) hB, norm_zero]
      positivity

/-- Changing an arithmetically equal natural modulus does not change the
complete sum.  This explicit transport isolates the proof-irrelevant
`NeZero` instance that otherwise obstructs rewriting under the definition. -/
theorem kloostermanSumZMod_nat_modulus_congr
    (q q' A B : ℕ) [NeZero q] [NeZero q'] (h : q = q') :
    kloostermanSumZMod q A B = kloostermanSumZMod q' A B := by
  subst q'
  rfl

/-- The complete primitive local Weil--Estermann estimate at every prime
power, including powers of two and exponent one. -/
theorem norm_kloostermanSumZMod_primePow_primitive_le
    (p k A B : ℕ) [Fact p.Prime] (hk : 0 < k)
    (hprim : A.Coprime p ∨ B.Coprime p) :
    ‖kloostermanSumZMod (p ^ k) A B‖ ≤
      ((k + 1 : ℕ) : ℝ) * Real.sqrt ((p : ℝ) ^ k) := by
  obtain ⟨r, hkEven | hkOdd⟩ := Nat.even_or_odd' k
  · subst k
    have hr : 0 < r := by omega
    have hpow : p ^ (2 * r) = p ^ r * p ^ r := by
      rw [two_mul, pow_add]
    have htransport :
        ‖kloostermanSumZMod (p ^ (2 * r)) A B‖ =
          ‖kloostermanSumZMod (p ^ r * p ^ r) A B‖ :=
      congrArg norm (kloostermanSumZMod_nat_modulus_congr
        (p ^ (2 * r)) (p ^ r * p ^ r) A B hpow)
    have hsqrt :
        Real.sqrt ((p : ℝ) ^ r * (p : ℝ) ^ r) =
          Real.sqrt ((p : ℝ) ^ (2 * r)) := by
      congr 1
      rw [two_mul, pow_add]
    rw [htransport]
    by_cases hp2 : p = 2
    · subst p
      rw [← hsqrt]
      simpa only [Nat.cast_add, Nat.cast_mul, Nat.cast_pow,
        Nat.cast_ofNat] using
        norm_kloostermanSumZMod_twoPower_even_primitive_le
          r A B hr hprim
    · calc
        ‖kloostermanSumZMod (p ^ r * p ^ r) A B‖ ≤
            2 * Real.sqrt (p ^ r * p ^ r) :=
          norm_kloostermanSumZMod_oddPrimePow_even_primitive_le
            p r A B hr hp2 hprim
        _ ≤ (((2 * r + 1 : ℕ) : ℝ) *
            Real.sqrt ((p : ℝ) ^ (2 * r))) := by
          have hcoeff : (2 : ℝ) ≤ (2 * r + 1 : ℕ) := by
            exact_mod_cast (show 2 ≤ 2 * r + 1 by omega)
          rw [← hsqrt]
          gcongr
  · subst k
    by_cases hr0 : r = 0
    · subst r
      have hpow : p ^ (2 * 0 + 1) = p := by norm_num
      have htransport :
          ‖kloostermanSumZMod (p ^ (2 * 0 + 1)) A B‖ =
            ‖kloostermanSumZMod p A B‖ :=
        congrArg norm (kloostermanSumZMod_nat_modulus_congr
          (p ^ (2 * 0 + 1)) p A B hpow)
      rw [htransport]
      norm_num only [Nat.mul_zero, Nat.zero_add, Nat.cast_ofNat,
        pow_one, Nat.reduceAdd]
      exact norm_kloostermanSumZMod_prime_primitive_le p A B hprim
    · have hr : 0 < r := Nat.pos_of_ne_zero hr0
      have hpow : p ^ (2 * r + 1) = p ^ r * p ^ (r + 1) := by
        rw [show 2 * r + 1 = r + (r + 1) by omega, pow_add]
      have htransport :
          ‖kloostermanSumZMod (p ^ (2 * r + 1)) A B‖ =
            ‖kloostermanSumZMod (p ^ r * p ^ (r + 1)) A B‖ :=
        congrArg norm (kloostermanSumZMod_nat_modulus_congr
          (p ^ (2 * r + 1)) (p ^ r * p ^ (r + 1)) A B hpow)
      have hsqrt :
          Real.sqrt ((p : ℝ) ^ r * (p : ℝ) ^ (r + 1)) =
            Real.sqrt ((p : ℝ) ^ (2 * r + 1)) := by
        apply congrArg Real.sqrt
        calc
          (p : ℝ) ^ r * (p : ℝ) ^ (r + 1) =
              (p : ℝ) ^ (r + (r + 1)) := (pow_add _ _ _).symm
          _ = (p : ℝ) ^ (2 * r + 1) := by
            congr 1
            omega
      rw [htransport]
      by_cases hp2 : p = 2
      · subst p
        rw [← hsqrt]
        have hcoeff :
            (((2 * r + 1 + 1 : ℕ) : ℝ)) =
              (((2 * r + 2 : ℕ) : ℝ)) := by
          norm_cast
        rw [hcoeff]
        simpa only [Nat.cast_add, Nat.cast_mul, Nat.cast_pow,
          Nat.cast_ofNat] using
          norm_kloostermanSumZMod_twoPower_odd_primitive_le
            r A B hr hprim
      · calc
          ‖kloostermanSumZMod (p ^ r * p ^ (r + 1)) A B‖ ≤
              2 * Real.sqrt (p ^ r * p ^ (r + 1)) :=
            norm_kloostermanSumZMod_oddPrimePow_odd_primitive_le
              p r A B hr hp2 hprim
          _ ≤ (((2 * r + 1 + 1 : ℕ) : ℝ) *
              Real.sqrt ((p : ℝ) ^ (2 * r + 1))) := by
            have hcoeff : (2 : ℝ) ≤ (2 * r + 1 + 1 : ℕ) := by
              exact_mod_cast (show 2 ≤ 2 * r + 1 + 1 by omega)
            rw [← hsqrt]
            gcongr

/-- The full local Weil--Estermann estimate at a prime power.  Common
prime factors are removed by the exact lifting identity; the first
primitive level is then handled by `norm_kloostermanSumZMod_primePow_primitive_le`. -/
theorem norm_kloostermanSumZMod_primePow_le
    (p k A B : ℕ) [Fact p.Prime] :
    ‖kloostermanSumZMod (p ^ k) A B‖ ≤
      Real.sqrt (Nat.gcd (Nat.gcd A B) (p ^ k)) *
        Real.sqrt ((p : ℝ) ^ k) * ((k + 1 : ℕ) : ℝ) := by
  induction k generalizing A B with
  | zero =>
      simp only [pow_zero, Nat.gcd_one_right, Nat.cast_one, Real.sqrt_one,
        mul_one, Nat.zero_add]
      unfold kloostermanSumZMod
      calc
        ‖∑ d : (ZMod 1)ˣ,
            ZMod.stdAddChar
              ((A : ZMod 1) * (d : ZMod 1) +
                (B : ZMod 1) * (↑(d⁻¹) : ZMod 1))‖ ≤
            ∑ d : (ZMod 1)ˣ,
              ‖ZMod.stdAddChar
                ((A : ZMod 1) * (d : ZMod 1) +
                  (B : ZMod 1) * (↑(d⁻¹) : ZMod 1))‖ := norm_sum_le _ _
        _ = 1 := by simp
  | succ k ih =>
      by_cases hboth : p ∣ A ∧ p ∣ B
      · rcases hboth.1 with ⟨A', rfl⟩
        rcases hboth.2 with ⟨B', rfl⟩
        by_cases hk0 : k = 0
        · subst k
          have hpow : p ^ (0 + 1) = p := by norm_num
          have htransport :
              ‖kloostermanSumZMod (p ^ (0 + 1))
                  (((p * A' : ℕ) : ZMod (p ^ (0 + 1))))
                  (((p * B' : ℕ) : ZMod (p ^ (0 + 1))))‖ =
                ‖kloostermanSumZMod p
                  (((p * A' : ℕ) : ZMod p))
                  (((p * B' : ℕ) : ZMod p))‖ :=
            congrArg norm (kloostermanSumZMod_nat_modulus_congr
              (p ^ (0 + 1)) p (p * A') (p * B') hpow)
          rw [htransport]
          have hpA : ((p * A' : ℕ) : ZMod p) = 0 := by
            push_cast
            simp
          have hpB : ((p * B' : ℕ) : ZMod p) = 0 := by
            push_cast
            simp
          rw [hpA, hpB, kloostermanSumZMod_prime_zero_zero]
          rw [Complex.norm_natCast]
          have hgcd :
              Nat.gcd (Nat.gcd (p * A') (p * B')) (p ^ (0 + 1)) = p := by
            rw [Nat.gcd_mul_left, pow_one]
            exact Nat.gcd_eq_right_iff_dvd.mpr (dvd_mul_right p (Nat.gcd A' B'))
          rw [hgcd, pow_one]
          have hsqrtSq : Real.sqrt (p : ℝ) ^ 2 = p :=
            Real.sq_sqrt (Nat.cast_nonneg p)
          have hsqrtNonneg : 0 ≤ Real.sqrt (p : ℝ) := Real.sqrt_nonneg _
          have hsub : ((p - 1 : ℕ) : ℝ) ≤ p := by
            exact_mod_cast (show (p - 1 : ℕ) ≤ p from Nat.sub_le p 1)
          calc
            ((p - 1 : ℕ) : ℝ) ≤ (p : ℝ) := hsub
            _ ≤ (p : ℝ) * 2 := by
              have hpNonneg : (0 : ℝ) ≤ p := Nat.cast_nonneg p
              linarith
            _ = Real.sqrt (p : ℝ) * Real.sqrt (p : ℝ) *
                (((0 + 1) + 1 : ℕ) : ℝ) := by
              norm_num
        · have hk : 0 < k := Nat.pos_of_ne_zero hk0
          have hpow : p ^ (k + 1) = p * p ^ k := pow_succ' p k
          have htransport :
              ‖kloostermanSumZMod (p ^ (k + 1))
                  (((p * A' : ℕ) : ZMod (p ^ (k + 1))))
                  (((p * B' : ℕ) : ZMod (p ^ (k + 1))))‖ =
                ‖kloostermanSumZMod (p * p ^ k)
                  (((p * A' : ℕ) : ZMod (p * p ^ k)))
                  (((p * B' : ℕ) : ZMod (p * p ^ k)))‖ :=
            congrArg norm (kloostermanSumZMod_nat_modulus_congr
              (p ^ (k + 1)) (p * p ^ k) (p * A') (p * B') hpow)
          rw [htransport, kloostermanSumZMod_primePower_lift p k A' B' hk,
            norm_mul, Complex.norm_natCast]
          have hih := ih A' B'
          have hpNonneg : (0 : ℝ) ≤ p := Nat.cast_nonneg p
          have hpowNonneg : (0 : ℝ) ≤ (p : ℝ) ^ k := by positivity
          have hsqrtP : 0 ≤ Real.sqrt (p : ℝ) := Real.sqrt_nonneg _
          have hsqrtPow : 0 ≤ Real.sqrt ((p : ℝ) ^ k) := Real.sqrt_nonneg _
          have hsqrtG :
              0 ≤ Real.sqrt (Nat.gcd (Nat.gcd A' B') (p ^ k)) :=
            Real.sqrt_nonneg _
          have hsqrtMulG :
              Real.sqrt
                  ((p : ℝ) * Nat.gcd (Nat.gcd A' B') (p ^ k)) =
                Real.sqrt p *
                  Real.sqrt (Nat.gcd (Nat.gcd A' B') (p ^ k)) := by
            rw [Real.sqrt_mul hpNonneg]
          have hsqrtMulPow :
              Real.sqrt ((p : ℝ) ^ (k + 1)) =
                Real.sqrt p * Real.sqrt ((p : ℝ) ^ k) := by
            rw [pow_succ', Real.sqrt_mul hpNonneg]
          have hgcd :
              Nat.gcd (Nat.gcd (p * A') (p * B')) (p ^ (k + 1)) =
                p * Nat.gcd (Nat.gcd A' B') (p ^ k) := by
            rw [Nat.gcd_mul_left, pow_succ', Nat.gcd_mul_left]
          have hgcdCast :
              ((Nat.gcd (Nat.gcd (p * A') (p * B')) (p ^ (k + 1)) : ℕ) : ℝ) =
                (p : ℝ) * Nat.gcd (Nat.gcd A' B') (p ^ k) := by
            exact_mod_cast hgcd
          rw [hgcdCast, hsqrtMulG, hsqrtMulPow]
          calc
            (p : ℝ) * ‖kloostermanSumZMod (p ^ k) A' B'‖ ≤
                (p : ℝ) *
                  (Real.sqrt (Nat.gcd (Nat.gcd A' B') (p ^ k)) *
                    Real.sqrt ((p : ℝ) ^ k) * ((k + 1 : ℕ) : ℝ)) := by
              gcongr
            _ ≤ (Real.sqrt p *
                  Real.sqrt (Nat.gcd (Nat.gcd A' B') (p ^ k))) *
                (Real.sqrt p * Real.sqrt ((p : ℝ) ^ k)) *
                  (((k + 1) + 1 : ℕ) : ℝ) := by
              have hsqrtPSq : Real.sqrt (p : ℝ) ^ 2 = p :=
                Real.sq_sqrt hpNonneg
              have hcoeff : (((k + 1 : ℕ) : ℝ)) ≤ (((k + 1) + 1 : ℕ) : ℝ) := by
                exact_mod_cast Nat.le_succ (k + 1)
              have hpEq :
                  (p : ℝ) = Real.sqrt (p : ℝ) * Real.sqrt (p : ℝ) := by
                nlinarith [hsqrtPSq]
              calc
                (p : ℝ) *
                    (Real.sqrt (Nat.gcd (Nat.gcd A' B') (p ^ k)) *
                      Real.sqrt ((p : ℝ) ^ k) * ((k + 1 : ℕ) : ℝ)) ≤
                    (p : ℝ) *
                      (Real.sqrt (Nat.gcd (Nat.gcd A' B') (p ^ k)) *
                        Real.sqrt ((p : ℝ) ^ k) *
                          (((k + 1) + 1 : ℕ) : ℝ)) := by
                  gcongr
                _ = (Real.sqrt p * Real.sqrt p) *
                      (Real.sqrt (Nat.gcd (Nat.gcd A' B') (p ^ k)) *
                        Real.sqrt ((p : ℝ) ^ k) *
                          (((k + 1) + 1 : ℕ) : ℝ)) := by
                  exact congrArg
                    (fun x : ℝ => x *
                      (Real.sqrt (Nat.gcd (Nat.gcd A' B') (p ^ k)) *
                        Real.sqrt ((p : ℝ) ^ k) *
                          (((k + 1) + 1 : ℕ) : ℝ))) hpEq
                _ = (Real.sqrt p *
                      Real.sqrt (Nat.gcd (Nat.gcd A' B') (p ^ k))) *
                    (Real.sqrt p * Real.sqrt ((p : ℝ) ^ k)) *
                      (((k + 1) + 1 : ℕ) : ℝ) := by
                  ring
      · have hprim : A.Coprime p ∨ B.Coprime p := by
          by_cases hpa : p ∣ A
          · right
            exact ((show p.Prime from Fact.out).coprime_iff_not_dvd.mpr
              (fun hpb => hboth ⟨hpa, hpb⟩)).symm
          · left
            exact ((show p.Prime from Fact.out).coprime_iff_not_dvd.mpr hpa).symm
        have hlocal := norm_kloostermanSumZMod_primePow_primitive_le
          p (k + 1) A B (by omega) hprim
        have hgPos : 0 < Nat.gcd (Nat.gcd A B) (p ^ (k + 1)) :=
          Nat.gcd_pos_of_pos_right _
            (pow_pos (show 0 < p from (show p.Prime from Fact.out).pos) _)
        have hgOne :
            (1 : ℝ) ≤ Real.sqrt (Nat.gcd (Nat.gcd A B) (p ^ (k + 1))) := by
          rw [← Real.sqrt_one]
          exact Real.sqrt_le_sqrt (by exact_mod_cast hgPos)
        have hsqrtNonneg : 0 ≤ Real.sqrt ((p : ℝ) ^ (k + 1)) :=
          Real.sqrt_nonneg _
        have hcoeffNonneg :
            0 ≤ ((((k + 1) + 1 : ℕ) : ℝ)) := Nat.cast_nonneg _
        calc
          ‖kloostermanSumZMod (p ^ (k + 1)) A B‖ ≤
              (((k + 1) + 1 : ℕ) : ℝ) *
                Real.sqrt ((p : ℝ) ^ (k + 1)) := hlocal
          _ ≤ Real.sqrt (Nat.gcd (Nat.gcd A B) (p ^ (k + 1))) *
                Real.sqrt ((p : ℝ) ^ (k + 1)) *
                  ((((k + 1) + 1 : ℕ) : ℝ)) := by
            calc
              ((((k + 1) + 1 : ℕ) : ℝ)) *
                    Real.sqrt ((p : ℝ) ^ (k + 1)) =
                  1 * (Real.sqrt ((p : ℝ) ^ (k + 1)) *
                    ((((k + 1) + 1 : ℕ) : ℝ))) := by ring
              _ ≤ Real.sqrt (Nat.gcd (Nat.gcd A B) (p ^ (k + 1))) *
                    (Real.sqrt ((p : ℝ) ^ (k + 1)) *
                      ((((k + 1) + 1 : ℕ) : ℝ))) := by
                gcongr
              _ = _ := by ring

end RiemannZeta.GuthMaynard
