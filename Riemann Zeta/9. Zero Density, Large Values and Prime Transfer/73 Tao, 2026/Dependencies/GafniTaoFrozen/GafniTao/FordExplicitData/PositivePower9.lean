    (f := fun i : Fin 55 => (i : ℚ))
  · intro i j hij
    change (i.val : ℚ) = j.val at hij
    apply Fin.ext
    exact_mod_cast hij
  · intro i
    fin_cases i <;>
      norm_num [fordPositiveTaylorPower9,
        fordPositiveTaylorPower8, fordPositiveTaylorPower1]
  · simp only [Fintype.card_fin]
    have hleft : fordPositiveTaylorPower9.natDegree ≤ 54 := by
      unfold fordPositiveTaylorPower9
      compute_degree
