import Dubon2026.RationalPrimeCyclotomicResidualReduction

/-! # The ramified arithmetic cyclotomic stage bridge

The local field generated by an actual rational cyclotomic stage is proved
cyclotomic of the same conductor.  Restriction, equality of the two literal
finite stages, and transport of finite reciprocity then identify its power
character with the independently constructed ramified closure-stage
character.  This is the exact bridge needed to turn the normalized residual
character cancellation into a principal automorphism product on the global
stage.
-/

namespace Dubon2026
noncomputable section

open IsCyclotomicExtension
open scoped NumberField ValuativeRel

set_option maxHeartbeats 1200000
set_option synthInstance.maxHeartbeats 200000

attribute [local instance] arithmeticFiniteLocalStageAlgebra
  arithmeticFiniteLocalStageGalois arithmeticFiniteLocalStageRationalAlgebra
  rationalPrimeWittPrime wittCyclotomicRootDomain wittCyclotomicRootFaithful
  wittCyclotomicFieldAlgebra wittCyclotomicFieldTower
  rationalPrimeWittOriginalAlgebra rationalPrimeWittCyclotomicAlgebra
  rationalPrimeWittCyclotomicTower rationalPrimeWittCyclotomicModule
  rationalPrimeWittCyclotomicMulAction

/-- Adjoining the image of a cyclotomic field to a larger base inside one
ambient field remains cyclotomic of the same order. -/
theorem embeddedFiniteGaloisCompositum_isCyclotomic_of_primitiveRoot
    {R K L Ω : Type} [Field R] [Field K] [Field L] [Field Ω]
    [Algebra R K] [Algebra R L] [Algebra K Ω] [Algebra R Ω]
    [IsScalarTower R K Ω] [FiniteDimensional R L] [IsGalois R L]
    (i : L →ₐ[R] Ω) (n : ℕ) [NeZero n]
    [IsCyclotomicExtension {n} R L]
    {ζ : L} (hζ : IsPrimitiveRoot ζ n) :
    IsCyclotomicExtension {n} K (embeddedFiniteGaloisCompositum (K := K) i) := by
  let M := embeddedFiniteGaloisCompositum (K := K) i
  have hμ : IsPrimitiveRoot (i ζ) n := hζ.map_of_injective i.injective
  apply (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin
    n K Ω M.toIntermediateField hμ).mpr
  change IntermediateField.adjoin K (Set.range i) =
    IntermediateField.adjoin K {i ζ}
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨x, rfl⟩
    have hx : x ∈ Algebra.adjoin R ({ζ} : Set L) := by
      rw [IsCyclotomicExtension.adjoin_primitive_root_eq_top hζ]
      trivial
    induction hx using Algebra.adjoin_induction with
    | mem y hy =>
        rw [Set.mem_singleton_iff.mp hy]
        exact IntermediateField.subset_adjoin K {i ζ} (Set.mem_singleton (i ζ))
    | algebraMap r =>
        rw [i.commutes, IsScalarTower.algebraMap_apply R K Ω]
        exact (IntermediateField.adjoin K {i ζ}).algebraMap_mem _
    | add x y _ _ hx hy =>
        simpa only [map_add] using (IntermediateField.adjoin K {i ζ}).add_mem hx hy
    | mul x y _ _ hx hy =>
        simpa only [map_mul] using (IntermediateField.adjoin K {i ζ}).mul_mem hx hy
  · apply IntermediateField.adjoin_le_iff.mpr
    intro y hy
    rw [Set.mem_singleton_iff.mp hy]
    exact IntermediateField.subset_adjoin K (Set.range i) ⟨ζ, rfl⟩

/-- Restricting a local automorphism through the exact embedded compositum
does not change its cyclotomic power character. -/
theorem embeddedFiniteGaloisCompositum_restriction_autToPow
    {R K L Ω : Type} [Field R] [Field K] [Field L] [Field Ω]
    [Algebra R K] [Algebra R L] [Algebra K Ω] [Algebra R Ω]
    [IsScalarTower R K Ω] [FiniteDimensional R L] [IsGalois R L]
    (i : L →ₐ[R] Ω) (n : ℕ) [NeZero n]
    {ζ : L} (hζ : IsPrimitiveRoot ζ n)
    (g : Gal(embeddedFiniteGaloisCompositum (K := K) i / K)) :
    let j := embeddedFiniteGaloisCompositumInclusion (K := K) i
    hζ.autToPow R (embeddedNormalGaloisRestriction j g) =
      (hζ.map_of_injective j.injective).autToPow K g := by
  dsimp only
  let M := embeddedFiniteGaloisCompositum (K := K) i
  let j := embeddedFiniteGaloisCompositumInclusion (K := K) i
  let hμ : IsPrimitiveRoot (j ζ) n := hζ.map_of_injective j.injective
  apply Units.ext
  apply ZMod.val_injective n
  apply hμ.pow_inj (ZMod.val_lt _) (ZMod.val_lt _)
  calc
    (j ζ) ^ (hζ.autToPow R (embeddedNormalGaloisRestriction j g) : ZMod n).val =
        j (ζ ^ (hζ.autToPow R (embeddedNormalGaloisRestriction j g) : ZMod n).val) :=
      (map_pow j ζ _).symm
    _ = j (embeddedNormalGaloisRestriction j g ζ) := by
      rw [hζ.autToPow_spec R]
    _ = g (j ζ) := embeddedNormalGaloisRestriction_commutes j g ζ
    _ = (j ζ) ^ (hμ.autToPow K g : ZMod n).val :=
      (hμ.autToPow_spec K g).symm

/-- Transporting a finite Galois stage and its automorphism along literal
stage equality preserves the primitive-root power character. -/
theorem finiteGaloisStageAutCast_autToPow
    {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω]
    {L M : FiniteGaloisIntermediateField K Ω} (h : L = M)
    (n : ℕ) [NeZero n] {ζ : L} (hζ : IsPrimitiveRoot ζ n)
    (hζM : IsPrimitiveRoot (h ▸ ζ) n) (g : Gal(L/K)) :
    hζ.autToPow K g =
      hζM.autToPow K (finiteGaloisStageAutCast h g) := by
  subst M
  rfl

/-- The finite local reciprocity value on the exact arithmetic compositum,
restricted to the original rational Galois stage. -/
def rationalArithmeticFiniteLocalReciprocityAut
    (a : 𝓞 ℚ)
    (F : FiniteGaloisIntermediateField ℚ (rationalUnramifiedExtension a))
    [IsCyclic Gal(F/ℚ)] (p : ℕ) (hp : p.Prime) (q : ℚˣ) : Gal(F/ℚ) := by
  let K := rationalPrimeLocalField p hp
  let Ω := rationalPrimeLocalClosure p hp
  let M := rationalArithmeticFiniteLocalStage a F p hp
  letI : TopologicalSpace (Rep.ofAlgebraAutOnUnits K Ω) := ⊥
  letI : DiscreteTopology (Rep.ofAlgebraAutOnUnits K Ω) := ⟨rfl⟩
  letI : IsCyclic Gal(M/K) := arithmeticCyclotomicLocalCyclic a F p hp
  exact rationalArithmeticFiniteLocalRestriction a F p hp
    (localFieldFiniteCyclicReciprocity K Ω M
      (Additive.ofMul (rationalPrimeRationalUnit p hp q))).toMul

/-- The original finite local reciprocity value on the actual prime-power
cyclotomic closure stage, with all canonical discrete structures packaged. -/
def rationalPrimeOriginalCyclotomicReciprocityAut
    (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) (m c : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ)
    (hu : u.val = c) (hc : ¬p ∣ c) (q : ℚˣ) :
    Gal(rationalPrimeOriginalCyclotomicClosureStage p hp m c u hu hc /
      rationalPrimeLocalField p hp) := by
  let K := rationalPrimeLocalField p hp
  let Ω := rationalPrimeLocalClosure p hp
  let L := rationalPrimeOriginalCyclotomicClosureStage p hp m c u hu hc
  letI : TopologicalSpace (Rep.ofAlgebraAutOnUnits K Ω) := ⊥
  letI : DiscreteTopology (Rep.ofAlgebraAutOnUnits K Ω) := ⟨rfl⟩
  letI : IsCyclic Gal(L/K) :=
    rationalPrimeOriginalCyclotomicClosureStage_isCyclic p hp hp2 m c u hu hc
  exact (localFieldFiniteCyclicReciprocity K Ω L
    (Additive.ofMul (rationalPrimeRationalUnit p hp q))).toMul

/-- At the conductor prime, the power character of the actual arithmetic
local restriction is the power character computed on the original
prime-power cyclotomic closure stage. -/
theorem rationalArithmeticFiniteLocalRestriction_ramified_autToPow
    (a : 𝓞 ℚ)
    (F : FiniteGaloisIntermediateField ℚ (rationalUnramifiedExtension a))
    [IsCyclic Gal(F/ℚ)]
    (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) (m : ℕ)
    [IsCyclotomicExtension {p ^ (m + 1)} ℚ F]
    {ζ : F} (hζ : IsPrimitiveRoot ζ (p ^ (m + 1)))
    (c : ℕ) (u : 𝒪[rationalPrimeLocalField p hp]ˣ)
    (hu : u.val = c) (hc : ¬p ∣ c) (q : ℚˣ) :
    letI : NeZero (p ^ (m + 1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
    hζ.autToPow ℚ (rationalArithmeticFiniteLocalReciprocityAut a F p hp q) =
      (rationalPrimeOriginalCyclotomicClosureRoot_isPrimitive p hp m c u hu hc).autToPow
        (rationalPrimeLocalField p hp)
        (rationalPrimeOriginalCyclotomicReciprocityAut
          p hp hp2 m c u hu hc q) := by
  let K := rationalPrimeLocalField p hp
  let Ω := rationalPrimeLocalClosure p hp
  let N := p ^ (m + 1)
  let M := rationalArithmeticFiniteLocalStage a F p hp
  let L := rationalPrimeOriginalCyclotomicClosureStage p hp m c u hu hc
  let i : F →ₐ[ℚ] Ω := rationalArithmeticFiniteLocalEmbedding a F p hp
  let j : F →ₐ[ℚ] M := rationalArithmeticFiniteLocalStageInclusion a F p hp
  let L₀ := rationalPrimeOriginalCyclotomicStage p hp m
  let k : L₀ →ₐ[K] Ω :=
    rationalPrimeOriginalCyclotomicClosureEmbedding p hp m c u hu hc
  letI : NeZero N := ⟨pow_ne_zero _ hp.ne_zero⟩
  letI : TopologicalSpace (Rep.ofAlgebraAutOnUnits K Ω) := ⊥
  letI : DiscreteTopology (Rep.ofAlgebraAutOnUnits K Ω) := ⟨rfl⟩
  letI : IsCyclic Gal(M/K) := arithmeticCyclotomicLocalCyclic a F p hp
  letI : IsCyclic Gal(L/K) :=
    rationalPrimeOriginalCyclotomicClosureStage_isCyclic p hp hp2 m c u hu hc
  let v := rationalPrimeRationalUnit p hp q
  let gM := (localFieldFiniteCyclicReciprocity K Ω M (Additive.ofMul v)).toMul
  let gL := rationalPrimeOriginalCyclotomicReciprocityAut
    p hp hp2 m c u hu hc q
  let μM : M := j ζ
  let hμM : IsPrimitiveRoot μM N := hζ.map_of_injective j.injective
  have hrestrict :
      hζ.autToPow ℚ (rationalArithmeticFiniteLocalReciprocityAut a F p hp q) =
        hμM.autToPow K gM := by
    simpa only [rationalArithmeticFiniteLocalReciprocityAut,
      i, j, M, μM, hμM, v, gM,
      rationalArithmeticFiniteLocalRestriction,
      rationalArithmeticFiniteLocalStageInclusion] using
        (embeddedFiniteGaloisCompositum_restriction_autToPow i N hζ gM)
  have hMcyc : IsCyclotomicExtension {N} K M := by
    exact embeddedFiniteGaloisCompositum_isCyclotomic_of_primitiveRoot i N hζ
  have hroot : IsPrimitiveRoot
      (rationalPrimeWittCyclotomicFieldPrimitiveRoot p hp m) N := by
    simpa only [N, rationalPrimePlace_natGenerator] using
      rationalPrimeWittCyclotomicFieldPrimitiveRoot_isPrimitive p hp m
  have hL₀cyc : IsCyclotomicExtension {N} K L₀ := by
    simpa only [L₀, N, rationalPrimeOriginalCyclotomicStage,
      rationalPrimePlace_natGenerator] using
        (originalPrimitiveRootStage_isCyclotomic K
          (wittCyclotomicField
            (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) m) hroot)
  have hLcyc : IsCyclotomicExtension {N} K L := by
    letI := hL₀cyc
    exact IsCyclotomicExtension.equiv {N} K L₀
      (finiteGaloisEmbeddingStageEquiv k)
  have hstage : M = L := by
    apply FiniteGaloisIntermediateField.val_injective
    letI := hMcyc
    letI := hLcyc
    exact IntermediateField.isCyclotomicExtension_eq {N} K Ω
      M.toIntermediateField L.toIntermediateField
  have hg : finiteGaloisStageAutCast hstage gM = gL := by
    simpa only [gL, rationalPrimeOriginalCyclotomicReciprocityAut] using
      (localFieldFiniteCyclicReciprocity_stage_cast hstage v)
  let μL : L := hstage ▸ μM
  have hμL : IsPrimitiveRoot μL N := by
    have hμΩ : IsPrimitiveRoot (L.toIntermediateField.val μL) N := by
      have heq : L.toIntermediateField.val μL =
          M.toIntermediateField.val μM := by
        exact finiteGaloisStage_cast_coe hstage μM
      rw [heq]
      exact hμM.map_of_injective M.toIntermediateField.val.injective
    exact hμΩ.of_map_of_injective L.toIntermediateField.val.injective
  have hcast : hμM.autToPow K gM =
      hμL.autToPow K (finiteGaloisStageAutCast hstage gM) := by
    exact finiteGaloisStageAutCast_autToPow hstage N hμM hμL gM
  have hindependent : hμL.autToPow K gL =
      (rationalPrimeOriginalCyclotomicClosureRoot_isPrimitive
        p hp m c u hu hc).autToPow K gL := by
    rw [hμL.autToPow_eq_modularCyclotomicCharacter N K gL,
      (rationalPrimeOriginalCyclotomicClosureRoot_isPrimitive
        p hp m c u hu hc).autToPow_eq_modularCyclotomicCharacter N K gL]
  exact hrestrict.trans (hcast.trans ((congrArg (hμL.autToPow K) hg).trans hindependent))

end
end Dubon2026
