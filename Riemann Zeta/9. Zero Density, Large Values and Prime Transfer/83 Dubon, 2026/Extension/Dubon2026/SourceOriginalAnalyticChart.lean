import Dubon2026.SourceOriginalBoundedIntegral

/-! DUB-17/18 -> finite analytic-place exhaustion. Use the existing
original finite extension and Dedekind-center theory on the actual
integral closure of C[j]. The earlier local chart containment theorem
supplies inclusion in every place where j is regular. No abstract
place dictionary, affine-model existence or integral-closure premise
is introduced.
Adapted from anthropics/fermats-last-theorem, Apache-2.0, commit
6e837e75355538c7f80bab5b956861e86c4eacc2,
S_ModularCurve_ComplexPlaceDictionary_exists_pt_eq_of_mem.
-/
namespace Dubon2026.SourceFunctionField.AnalyticChart
noncomputable section
open SourceCurve Polynomial
open scoped IntermediateField.algebraAdjoinAdjoin
variable (N : ℕ) [NeZero N]

/-- The actual original function field over complex coefficients. -/
abbrev F := modularFunctionFieldOver N ℂ

/-- The polynomial coordinate ring generated by the original j-coordinate. -/
abbrev A := Algebra.adjoin ℂ ({jOver N ℂ} : Set (F N))

/-- The actual rational subfield generated by j. -/
abbrev Kj := IntermediateField.adjoin ℂ ({jOver N ℂ} : Set (F N))

scoped instance chartPrincipalIdealRing : IsPrincipalIdealRing (A N) := by
  let e := Polynomial.algEquivOfTranscendental ℂ (jOver N ℂ) (transcendental_jOver N ℂ)
  exact IsPrincipalIdealRing.of_surjective e.toRingEquiv.toRingHom e.surjective

/-- The actual inclusion algebra from C[j] into C(j). -/
scoped instance chartAlgebraAKj : Algebra (A N) (Kj N) :=
  (Subalgebra.inclusion
    (IntermediateField.algebra_adjoin_le_adjoin ℂ ({jOver N ℂ} : Set (F N)))).toRingHom.toAlgebra

/-- The scalar action associated with the coordinate-ring inclusion. -/
scoped instance chartSMulAKj : SMul (A N) (Kj N) := Algebra.toSMul

scoped instance chartScalarTower : IsScalarTower (A N) (Kj N) (F N) :=
  Subalgebra.inclusion.isScalarTower_right
    (IntermediateField.algebra_adjoin_le_adjoin ℂ ({jOver N ℂ} : Set (F N))) _

scoped instance chartFieldFinite : FiniteDimensional (Kj N) (F N) := finiteDimensional_original N ℂ

/-- The integral closure of the original polynomial j-coordinate ring. -/
abbrev B := integralClosure (A N) (F N)

/-- The inherited ring operations on the actual integral closure. -/
scoped instance chartCommRing : CommRing (B N) := (B N).toCommRing

scoped instance chartDomain : IsDomain (B N) := Subalgebra.isDomain (B N)

/-- The coordinate ring acts on its actual integral closure by multiplication. -/
scoped instance chartAlgebraAB : Algebra (A N) (B N) := (B N).algebra

/-- The scalar action associated with the integral-closure algebra. -/
scoped instance chartSMulAB : SMul (A N) (B N) := Algebra.toSMul

/-- The actual integral closure embeds in the original function field. -/
scoped instance chartAlgebraBF : Algebra (B N) (F N) := (B N).toAlgebra

/-- The scalar action of the integral closure on its fraction field. -/
scoped instance chartSMulBF : SMul (B N) (F N) := Algebra.toSMul

scoped instance chartScalarTowerABF : IsScalarTower (A N) (B N) (F N) :=
  IsScalarTower.subalgebra' (A N) (F N) (F N) (B N)

scoped instance chartDedekindDomain : IsDedekindDomain (B N) :=
  integralClosure.isDedekindDomain (A N) (Kj N) (F N)

scoped instance chartFractionRing : IsFractionRing (B N) (F N) :=
  integralClosure.isFractionRing_of_finite_extension (Kj N) (F N)

omit [NeZero N] in
theorem base_mem {P : Place ℂ (F N)} (hP : jOver N ℂ ∈ P.toValuationSubring) (a : A N) :
    (a : F N) ∈ P.toValuationSubring := by
  let V : Subalgebra ℂ (F N) :=
    { carrier := P.toValuationSubring
      mul_mem' := fun ha hb => mul_mem ha hb
      one_mem' := one_mem _
      add_mem' := fun ha hb => add_mem ha hb
      zero_mem' := zero_mem _
      algebraMap_mem' := P.algebraMap_mem' }
  have hle : A N ≤ V := Algebra.adjoin_le (Set.singleton_subset_iff.mpr hP)
  exact hle a.2

omit [NeZero N] in
theorem chart_mem {P : Place ℂ (F N)} (hP : jOver N ℂ ∈ P.toValuationSubring) :
    ∀ b : B N, algebraMap (B N) (F N) b ∈ P.toValuationSubring := by
  intro b
  exact SourceCurve.integralClosure_mem_of_base_mem P (base_mem N hP) b

end
end Dubon2026.SourceFunctionField.AnalyticChart
