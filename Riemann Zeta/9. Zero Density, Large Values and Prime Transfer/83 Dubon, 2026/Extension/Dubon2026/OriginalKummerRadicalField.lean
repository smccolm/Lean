import Dubon2026.AlgebraicallyClosedUnitPowerSequence
import Mathlib.FieldTheory.Galois.Infinite

/-! # The original field generated by prescribed Kummer radicals

The root equations, generated field and Galois structure are constructed
from the original subgroup of base-field units. For the original S-unit
radical subgroup, this is the field used by global Kummer preparation in
the cyclic norm-index and reciprocity dependency of DUB-17.
-/

namespace Dubon2026
noncomputable section
variable {K Ω : Type} [Field K] [Field Ω] [Algebra K Ω]

/-- All actual roots in the original ambient field of the prescribed unit equations. -/
def originalKummerRootSet (n : ℕ) (Δ : Subgroup Kˣ) : Set Ω :=
  {β | ∃ a : Δ, β ^ n = algebraMap K Ω a.val.val}

/-- The actual intermediate field generated by every prescribed Kummer root. -/
def originalKummerRadicalField (n : ℕ) (Δ : Subgroup Kˣ) : IntermediateField K Ω :=
  IntermediateField.adjoin K (originalKummerRootSet (Ω := Ω) n Δ)

/-- Every prescribed original unit has an actual root in the constructed field. -/
theorem originalKummerRadicalField_exists_root [IsAlgClosed Ω]
    (n : ℕ) (hn : 0 < n) (Δ : Subgroup Kˣ) (a : Δ) :
    ∃ β : (originalKummerRadicalField (Ω := Ω) n Δ)ˣ,
      β ^ n = Units.map (algebraMap K (originalKummerRadicalField (Ω := Ω) n Δ)).toMonoidHom a.val := by
  obtain ⟨β, hβ⟩ := algebraicallyClosedUnitPower_surjective n hn
    (Units.map (algebraMap K Ω).toMonoidHom a.val)
  have hp : β.val ^ n = algebraMap K Ω a.val.val := congrArg Units.val hβ
  let b : originalKummerRadicalField (Ω := Ω) n Δ :=
    ⟨β.val, IntermediateField.subset_adjoin K _ ⟨a, hp⟩⟩
  have hb : b ≠ 0 := fun h => β.ne_zero (congrArg Subtype.val h)
  refine ⟨Units.mk0 b hb, ?_⟩
  apply Units.ext
  apply Subtype.ext
  exact hp

/-- Original ambient Galois automorphisms preserve precisely the prescribed root equations. -/
theorem originalKummerRootSet_image (n : ℕ) (Δ : Subgroup Kˣ) (σ : Gal(Ω/K)) :
    σ '' originalKummerRootSet (Ω := Ω) n Δ = originalKummerRootSet (Ω := Ω) n Δ := by
  have hm (τ : Gal(Ω/K)) : Set.MapsTo τ
      (originalKummerRootSet (Ω := Ω) n Δ) (originalKummerRootSet (Ω := Ω) n Δ) := by
    rintro β ⟨a, ha⟩
    exact ⟨a, (map_pow τ β n).symm.trans ((congrArg τ ha).trans (τ.commutes _))⟩
  apply Set.Subset.antisymm
  · rintro _ ⟨β, hβ, rfl⟩
    exact hm σ hβ
  · intro β hβ
    exact ⟨σ.symm β, hm σ.symm hβ, σ.apply_symm_apply β⟩

/-- Stability of the actual full root set proves normality, and original separability
then proves the constructed radical extension is Galois. -/
theorem originalKummerRadicalField_isGalois [IsGalois K Ω]
    (n : ℕ) (Δ : Subgroup Kˣ) :
    IsGalois K (originalKummerRadicalField (Ω := Ω) n Δ) := by
  haveI : Normal K (originalKummerRadicalField (Ω := Ω) n Δ) := by
    rw [IntermediateField.normal_iff_forall_map_eq']
    intro σ
    rw [originalKummerRadicalField, IntermediateField.adjoin_map]
    exact congrArg (IntermediateField.adjoin K) (originalKummerRootSet_image n Δ σ)
  exact {}

end
end Dubon2026
