import Dubon2026.SourcePrimeHeckeGeneration
import Dubon2026.HeckeCommutativity
import Dubon2026.SourceOriginalCuspDimension

/-! DUB-17/18 -> rank-two original Tate Hecke realization -> full
weight-two operator algebra. Reuse all-index coefficient formulas and
integral prime generation already proved in this repository. This avoids
repeating the prime-by-prime Fourier induction in the external rank-two
route. Bad-prime operators are included throughout.
-/
namespace Dubon2026
noncomputable section
open Matrix.SpecialLinearGroup CongruenceSubgroup
open scoped MatrixGroups
variable (N : ℕ) [NeZero N]
local notation "S" => CuspForm (Gamma0 N) 2

/-- The complex algebra generated by the actual positive-index weight-two Hecke operators. -/
def sourceWeightTwoFullHeckeAlgebra : Subalgebra ℂ (Module.End ℂ S) :=
  Algebra.adjoin ℂ (Set.range fun n : ℕ+ => cuspHeckeLinear N 2 (n : ℕ))

theorem sourceWeightTwoFullHeckeAlgebra_commutative :
    IsMulCommutative (sourceWeightTwoFullHeckeAlgebra N) :=
  Algebra.isMulCommutative_adjoin ℂ (by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
    exact (cuspHeckeLinear_commute N 2 i j).eq)

theorem sourceWeightTwoFullHeckeAlgebra_finite :
    Module.Finite ℂ (sourceWeightTwoFullHeckeAlgebra N) := by
  letI := SourceFunctionField.original_weight_two_cusp_finite N
  exact Module.Finite.of_injective (sourceWeightTwoFullHeckeAlgebra N).val.toLinearMap
    Subtype.val_injective

theorem sourceWeightTwoFullHeckeAlgebra_eq_prime_adjoin :
    sourceWeightTwoFullHeckeAlgebra N =
      Algebra.adjoin ℂ (Set.range fun q : Nat.Primes => cuspHeckeLinear N 2 q.val) := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨n, rfl⟩
    have hle : Algebra.adjoin ℤ
        (Set.range fun q : Nat.Primes => cuspHeckeLinear N 2 q.val) ≤
        (Algebra.adjoin ℂ (Set.range fun q : Nat.Primes => cuspHeckeLinear N 2 q.val)).restrictScalars ℤ := by
      apply Algebra.adjoin_le
      intro x hx
      change x ∈ Algebra.adjoin ℂ (Set.range fun q : Nat.Primes => cuspHeckeLinear N 2 q.val)
      exact Algebra.subset_adjoin hx
    exact hle (sourceHecke_mem_primeAlgebra N 2 (by norm_num) n n.ne_zero)
  · apply Algebra.adjoin_le
    rintro _ ⟨q, rfl⟩
    exact Algebra.subset_adjoin ⟨⟨q.val, q.property.pos⟩, rfl⟩

theorem sourceWeightTwoFullHecke_form_separated (f : S)
    (hf : ∀ T ∈ sourceWeightTwoFullHeckeAlgebra N, cuspCoefficients (T f) 1 = 0) :
    f = 0 := by
  apply cuspCoefficients_injective N 2
  funext n
  change cuspCoefficients f n = cuspCoefficientLinear N 2 n 0
  rw [map_zero]
  by_cases hn : n = 0
  · subst n
    exact cuspCoefficients_zero f
  · have h := hf (cuspHeckeLinear N 2 n)
      (Algebra.subset_adjoin ⟨⟨n, Nat.pos_of_ne_zero hn⟩, rfl⟩)
    change cuspCoefficients (cuspHecke n f) 1 = 0 at h
    rwa [cuspHecke_coeff, classicalHeckeCoefficient_one N 2 hn] at h

open scoped IsMulCommutative in
theorem sourceWeightTwoFullHecke_operator_separated (T : Module.End ℂ S)
    (hT : T ∈ sourceWeightTwoFullHeckeAlgebra N)
    (h : ∀ f : S, cuspCoefficients (T f) 1 = 0) : T = 0 := by
  letI := sourceWeightTwoFullHeckeAlgebra_commutative N
  letI : CommRing (sourceWeightTwoFullHeckeAlgebra N) := inferInstance
  apply LinearMap.ext
  intro f
  apply sourceWeightTwoFullHecke_form_separated N
  intro U hU
  have hc : U * T = T * U := congrArg Subtype.val
    (mul_comm (⟨U, hU⟩ : sourceWeightTwoFullHeckeAlgebra N) ⟨T, hT⟩)
  have he : U (T f) = T (U f) := congrArg (fun A : Module.End ℂ S => A f) hc
  rw [he]
  exact h (U f)

end
end Dubon2026
