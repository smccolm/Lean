import Dubon2026.SourceLaurentIntegralDescent

/-! DUB-17/18 -> rational Fourier spanning -> Fricke integral base change.
Transport integral equations through the literal coefficient embedding. The
base coordinate algebra is mapped to the algebra generated by the mapped
coordinate, using native adjoin image and integral-equation transport. -/
namespace Dubon2026.SourceFunctionField
noncomputable section
open scoped IntermediateField

theorem isIntegral_adjoin_coeffMap_of_isIntegral
    (F : IntermediateField ℚ ℂ) (j x : LaurentSeries F)
    (hx : IsIntegral (Algebra.adjoin F ({j} : Set (LaurentSeries F))) x) :
    IsIntegral (Algebra.adjoin F ({coeffMap (algebraMap F ℂ) j} : Set (LaurentSeries ℂ)))
      (coeffMap (algebraMap F ℂ) x) := by
  let e : LaurentSeries F →ₐ[F] LaurentSeries ℂ :=
    { coeffMap (algebraMap F ℂ) with
      commutes' := by
        intro a
        change coeffMap (algebraMap F ℂ) (algebraMap F (LaurentSeries F) a) =
          algebraMap F (LaurentSeries ℂ) a
        rw [SourceDifferential.algebraMap_laurentSeries_apply_alt, coeffMap_single]
        change HahnSeries.single 0 (a : ℂ) = algebraMap ℂ (LaurentSeries ℂ) (a : ℂ)
        exact (SourceDifferential.algebraMap_laurentSeries_apply_alt ℂ (a : ℂ)).symm }
  let R := Algebra.adjoin F ({j} : Set (LaurentSeries F))
  let T := Algebra.adjoin F ({e j} : Set (LaurentSeries ℂ))
  have hmap : R.map e = T := by
    dsimp only [R, T]
    rw [AlgHom.map_adjoin, Set.image_singleton]
  let φ : R →ₐ[F] T := (e.comp R.val).codRestrict T fun a => by
    have ha : e a ∈ R.map e := ⟨a, a.property, rfl⟩
    rwa [hmap] at ha
  exact IsIntegral.map_of_comp_eq φ.toRingHom e.toRingHom (by ext a; rfl) hx

end
end Dubon2026.SourceFunctionField