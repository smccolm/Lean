import Dubon2026.SourceRationalShiftPowerSpan

/-! DUB-17/18 -> reverse genus -> finite elliptic fibers -> original
Gamma1 marked-point chart. Embed the actual field generated by a
transcendental j coordinate into the Laurent field at its original j
series. Native rationalCoordinateEmbedding and the proved rational
function/adjoined-coordinate equivalence supply the map directly. -/
namespace Dubon2026.SourceFunctionField.MarkedChart
noncomputable section
open Dubon2026.SourceCurve

theorem exists_coordinate_embedding {K k F : Type*} [Field K] [Field k] [Field F]
    [Algebra K k] [Algebra K F] (t : k) (ht : Transcendental K t)
    (hgen : IntermediateField.adjoin K ({t} : Set k) = ⊤)
    (y : F) (hy : Transcendental K y) :
    ∃ ι : k →ₐ[K] F, ι t = y := by
  let e : RatFunc K ≃ₐ[K] k := (RatFunc.algEquivOfTranscendental t ht).trans
    ((IntermediateField.equivOfEq hgen).trans IntermediateField.topEquiv)
  have he : e RatFunc.X = t := by
    change ((RatFunc.algEquivOfTranscendental t ht RatFunc.X :
      IntermediateField.adjoin K {t}) : k) = t
    exact RatFunc.algEquivOfTranscendental_X t ht
  refine ⟨(rationalCoordinateEmbedding K y hy).comp e.symm.toAlgHom, ?_⟩
  change rationalCoordinateEmbedding K y hy (e.symm t) = y
  rw [← he, e.symm_apply_apply, rationalCoordinateEmbedding_X]

end
end Dubon2026.SourceFunctionField.MarkedChart
