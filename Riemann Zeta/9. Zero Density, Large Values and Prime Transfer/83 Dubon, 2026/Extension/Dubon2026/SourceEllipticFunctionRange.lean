import Dubon2026.SourceEllipticFunctionLift
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-! The actual image of a coordinate pullback is generated by its two coordinates.
The pinned native fraction-ring range theorem gives this directly; no new abstract
function-field presentation API is needed. This removes the image-identification
premise for the odd quotient embedding on the DUB-17/18 dependency chain. -/

open Polynomial WeierstrassCurve WeierstrassCurve.Affine
open scoped Polynomial.Bivariate IntermediateField

namespace Dubon2026.SourceEllipticFunctionField

variable {F L : Type*} [Field F] [Field L] [Algebra F L] {W : Affine F}

/-- The image of a coordinate-ring homomorphism is generated by its two coordinate values. -/
theorem coordinateAlgHom_range (f : W.CoordinateRing →ₐ[F] L) :
    f.range = Algebra.adjoin F
      ({f (AdjoinRoot.of W.polynomial X), f (AdjoinRoot.root W.polynomial)} : Set L) := by
  let S := Algebra.adjoin F
    ({f (AdjoinRoot.of W.polynomial X), f (AdjoinRoot.root W.polynomial)} : Set L)
  have hp (p : F[X]) : f (CoordinateRing.mk W (C p)) ∈ S := by
    have h : f.comp (AdjoinRoot.ofAlgHom F W.polynomial) =
        aeval (f (AdjoinRoot.of W.polynomial X)) :=
      Polynomial.algHom_ext (by simp)
    change (f.comp (AdjoinRoot.ofAlgHom F W.polynomial)) p ∈ S
    rw [h]
    exact Algebra.adjoin_mono (by simp)
      (Polynomial.aeval_mem_adjoin_singleton F (f (AdjoinRoot.of W.polynomial X)))
  apply le_antisymm
  · rintro z ⟨w, rfl⟩
    obtain ⟨p, q, rfl⟩ := CoordinateRing.exists_smul_basis_eq w
    rw [map_add, CoordinateRing.smul, CoordinateRing.smul, map_mul, map_mul, map_one, mul_one]
    exact S.add_mem (hp p) (S.mul_mem (hp q)
      (Algebra.subset_adjoin (Set.mem_insert_of_mem _ rfl)))
  · apply Algebra.adjoin_le
    rintro z (rfl | rfl)
    · exact ⟨_, rfl⟩
    · exact ⟨_, rfl⟩

/-- Every actual function-field embedding has image generated by the generic coordinate images. -/
theorem functionFieldAlgHom_range (f : W.FunctionField →ₐ[F] L) :
    f.fieldRange = F⟮f (genericX W), f (genericY W)⟯ := by
  exact IsFractionRing.algHom_fieldRange_eq_of_comp_eq_of_range_eq
    (g := f.comp (IsScalarTower.toAlgHom F W.CoordinateRing W.FunctionField))
    rfl (coordinateAlgHom_range _)

/-- The lift at a transcendental solution has precisely the field generated by that solution. -/
theorem functionFieldLift_range {x y : L} (h : (W⁄L).toAffine.Equation x y)
    (hx : Transcendental F x) : (functionFieldLift h hx).fieldRange = F⟮x, y⟯ := by
  rw [functionFieldAlgHom_range, functionFieldLift_genericX, functionFieldLift_genericY]

/-- Applying the lift to the actual generic solution recovers the identity embedding. -/
theorem functionFieldLift_generic_eq_id :
    functionFieldLift (equation_genericX_genericY W) (transcendental_genericX W) =
      AlgHom.id F W.FunctionField :=
  (eq_functionFieldLift _ _ (AlgHom.id F W.FunctionField) rfl rfl).symm

end Dubon2026.SourceEllipticFunctionField
