import Dubon2026.ArithmeticOrbitLocalField

/-! # The literal field maps into the arithmetic orbit's local field

The coset representative twists the actual arithmetic embedding. Its
restriction to the original finite global field lands in, and generates
with the original prime completion, the local field whose fixing subgroup
is the Mackey stabilizer. These maps are the inputs to the required
coefficient/base-change comparison on DUB-17's global reciprocity route.
-/
namespace Dubon2026
noncomputable section
open scoped NumberField
attribute [local instance] arithmeticOrbitLocalUnionAlgebra

variable (a : 𝓞 ℚ) (p : ℕ) (hp : p.Prime)
  (F : IntermediateField ℚ (rationalUnramifiedExtension a))
  (c : rationalArithmeticGaloisGroup a ⧸ rationalArithmeticOrbitFixingSubgroup a F)

/-- The original arithmetic embedding composed with the literal coset automorphism. -/
def rationalArithmeticOrbitEmbedding :
    rationalUnramifiedExtension a →ₐ[ℚ] rationalPrimeLocalClosure p hp :=
  (rationalArithmeticLocalEmbedding a).comp (rationalArithmeticOrbitRepresentative a F c).toAlgHom

/-- Retain the rational algebra inherited from the actual orbit local field. -/
local instance arithmeticOrbitFieldRationalAlgebra : Algebra ℚ (rationalArithmeticOrbitLocalField a p hp F c) :=
  ((rationalArithmeticOrbitLocalField a p hp F c).restrictScalars ℚ).algebra'

/-- Each literal global generator belongs to the local field it generates. -/
theorem rationalArithmeticOrbitEmbedding_mem (x : F) :
    rationalArithmeticOrbitEmbedding a p hp F c (x : rationalUnramifiedExtension a) ∈
      rationalArithmeticOrbitLocalField a p hp F c := by
  exact IntermediateField.subset_adjoin (rationalPrimeLocalField p hp)
    (Set.range fun y : F => rationalArithmeticLocalEmbedding (K := rationalPrimeLocalClosure p hp) a
      (rationalArithmeticOrbitRepresentative a F c (y : rationalUnramifiedExtension a))) ⟨x, rfl⟩

/-- The original finite global field embeds in the actual local field generated by its coset image. -/
def rationalArithmeticOrbitFieldInclusion : F →ₐ[ℚ] rationalArithmeticOrbitLocalField a p hp F c :=
  ((rationalArithmeticOrbitEmbedding a p hp F c).comp F.val).codRestrict
    ((rationalArithmeticOrbitLocalField a p hp F c).restrictScalars ℚ).toSubalgebra
    (fun x => rationalArithmeticOrbitEmbedding_mem a p hp F c x)

/-- The codomain restriction preserves the same original field element. -/
theorem rationalArithmeticOrbitFieldInclusion_coe (x : F) :
    (rationalArithmeticOrbitFieldInclusion a p hp F c x : rationalPrimeLocalClosure p hp) =
      rationalArithmeticOrbitEmbedding a p hp F c (x : rationalUnramifiedExtension a) := rfl

/-- The literal local base and the actual embedded global field generate the entire orbit local field. -/
theorem rationalArithmeticOrbitField_ranges :
    (algebraMap (rationalPrimeLocalField p hp) (rationalArithmeticOrbitLocalField a p hp F c)).fieldRange ⊔
      (rationalArithmeticOrbitFieldInclusion a p hp F c).toRingHom.fieldRange = ⊤ := by
  let M := rationalArithmeticOrbitLocalField a p hp F c
  let j := rationalArithmeticOrbitFieldInclusion a p hp F c
  let S : Subfield M := (algebraMap (rationalPrimeLocalField p hp) M).fieldRange ⊔ j.toRingHom.fieldRange
  have hle : M.toSubfield ≤ S.map M.val.toRingHom := by
    apply IntermediateField.adjoin_le_subfield
    · rintro _ ⟨x, rfl⟩
      exact ⟨algebraMap (rationalPrimeLocalField p hp) M x,
        (show (algebraMap (rationalPrimeLocalField p hp) M).fieldRange ≤ S from le_sup_left) ⟨x, rfl⟩, rfl⟩
    · rintro _ ⟨x, rfl⟩
      exact ⟨j x, (show j.toRingHom.fieldRange ≤ S from le_sup_right) ⟨x, rfl⟩, rfl⟩
  change S = ⊤
  apply top_unique
  intro x _
  obtain ⟨y, hy, he⟩ := hle x.property
  have hyx : y = x := Subtype.ext he
  exact hyx ▸ hy

end
end Dubon2026
