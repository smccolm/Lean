import Dubon2026.RationalPrimeChangedPrimitiveEquation
import Dubon2026.PowerBasisNegativeGeneratorNorm

/-! # The actual finite auxiliary field over the original completion

Adjoin the already constructed algebraic changed point to the literal
original completion inside the same cyclotomic Witt fraction field. Its
proved original minimal polynomial derives finite degree and the exact
original field norm. No auxiliary field or norm identity is assumed.
Local valuation structure and the unramified compositum remain the next
necessary steps toward DUB-17's ramified reciprocity formula.
-/
namespace Dubon2026
noncomputable section
open Polynomial
open scoped ValuativeRel
attribute [local instance] rationalPrimeWittPrime wittCyclotomicRootDomain
  wittCyclotomicRootFaithful wittCyclotomicFieldAlgebra wittCyclotomicFieldTower
  rationalPrimeWittOriginalAlgebra rationalPrimeWittCyclotomicAlgebra rationalPrimeWittCyclotomicTower

/-- The original coefficient module is supplied directly for this actual fraction field. -/
local instance rationalPrimeWittCyclotomicModule (p : ℕ) (hp : p.Prime) (n : ℕ) :
    Module (rationalPrimeLocalField p hp)
      (wittCyclotomicField (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n) :=
  Algebra.toModule

/-- The original scalar action is supplied directly, avoiding unrelated fraction-scalar searches. -/
local instance rationalPrimeWittCyclotomicMulAction (p : ℕ) (hp : p.Prime) (n : ℕ) :
    MulAction (rationalPrimeLocalField p hp)
      (wittCyclotomicField (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n) :=
  (rationalPrimeWittCyclotomicModule p hp n).toMulAction

/-- The genuine auxiliary field generated by the actual changed point over the original completion. -/
abbrev rationalPrimeChangedAuxiliaryField (p : ℕ) (hp : p.Prime) (n : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) :
    IntermediateField (rationalPrimeLocalField p hp)
      (wittCyclotomicField (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n) :=
  IntermediateField.adjoin (rationalPrimeLocalField p hp)
    {wittCyclotomicChangedFieldPoint (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp))
      (Units.map (rationalPrimeIntegerWittMap p hp).toMonoidHom u) n}

/-- Its original generating point is the literal already evaluated changed point. -/
def rationalPrimeChangedAuxiliaryPoint (p : ℕ) (hp : p.Prime) (n : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) : rationalPrimeChangedAuxiliaryField p hp n u :=
  IntermediateField.AdjoinSimple.gen _ _

/-- Algebraicity over the original completion is derived from the actual primitive equation. -/
theorem rationalPrimeChangedFieldPoint_isIntegral (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    IsIntegral (rationalPrimeLocalField p hp)
      (wittCyclotomicChangedFieldPoint (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp))
        (Units.map (rationalPrimeIntegerWittMap p hp).toMonoidHom u) n) :=
  ⟨_, primeChangedPrimitivePolynomial_monic _ _ _, rationalPrimeChangedFieldPoint_aeval p hp n a u hu ha⟩

/-- The genuine original auxiliary field is finite and has the exact required prime-power degree. -/
theorem rationalPrimeChangedAuxiliaryField_finrank_and_finite (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    Module.finrank (rationalPrimeLocalField p hp) (rationalPrimeChangedAuxiliaryField p hp n u) =
      (p - 1) * p ^ n ∧
    FiniteDimensional (rationalPrimeLocalField p hp) (rationalPrimeChangedAuxiliaryField p hp n u) := by
  have hi := rationalPrimeChangedFieldPoint_isIntegral p hp n a u hu ha
  refine ⟨?_, IntermediateField.adjoin.finiteDimensional hi⟩
  change Module.finrank (rationalPrimeLocalField p hp) (IntermediateField.adjoin _ _) = _
  rw [IntermediateField.adjoin.finrank hi, rationalPrimeChangedFieldPoint_minpoly p hp n a u hu ha,
    primeChangedPrimitivePolynomial_natDegree]
  exact congrArg (fun t : ℕ => (t - 1) * t ^ n) (rationalPrimePlace_natGenerator p hp)

/-- The actual auxiliary generator has the same original minimal polynomial as its ambient image. -/
theorem rationalPrimeChangedAuxiliaryPoint_minpoly (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    let q := Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)
    minpoly (rationalPrimeLocalField p hp) (rationalPrimeChangedAuxiliaryPoint p hp n u) =
      primeChangedPrimitivePolynomial q ((a : rationalPrimeLocalField p hp) * q) n := by
  rw [rationalPrimeChangedAuxiliaryPoint, IntermediateField.minpoly_gen]
  exact rationalPrimeChangedFieldPoint_minpoly p hp n a u hu ha

/-- The negative actual auxiliary generator has norm ap in the literal original completion. -/
theorem rationalPrimeChangedAuxiliaryPoint_norm_neg (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    Algebra.norm (rationalPrimeLocalField p hp) (-rationalPrimeChangedAuxiliaryPoint p hp n u) =
      (a : rationalPrimeLocalField p hp) * p := by
  let b := IntermediateField.adjoin.powerBasis (rationalPrimeChangedFieldPoint_isIntegral p hp n a u hu ha)
  have hb : b.gen = rationalPrimeChangedAuxiliaryPoint p hp n u := rfl
  have h := powerBasis_norm_neg_gen b
  rw [hb, rationalPrimeChangedAuxiliaryPoint_minpoly p hp n a u hu ha,
    primeChangedPrimitivePolynomial_coeff_zero] at h
  exact h.trans (congrArg (fun t : ℕ => (a : rationalPrimeLocalField p hp) * t)
    (rationalPrimePlace_natGenerator p hp))

end
end Dubon2026
