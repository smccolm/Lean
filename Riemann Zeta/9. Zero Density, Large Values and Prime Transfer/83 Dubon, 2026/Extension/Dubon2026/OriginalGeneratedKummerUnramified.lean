import Dubon2026.OriginalInertiaValuation
import Dubon2026.LocalUnitPowerResidueInjectivity
import Dubon2026.NumberFieldInertiaRamification
import Dubon2026.NumberFieldRamificationUnramified
import Dubon2026.OriginalAdicFieldRestriction
import Mathlib.RingTheory.Unramified.Locus

/-! # Original unit Kummer generators are unramified away from the exponent

The inertia ratio of an original unit Kummer generator is a root of unity
reducing to one. The proved unit-exponent residue injectivity makes that
ratio one; generation kills the full original inertia subgroup. Existing
original inertia cardinality and ramification comparison then give relative
unramifiedness, and the pinned tower theorem gives absolute unramifiedness
over an unramified base prime. This is the outside-support input required
for DUB-17's simple Kummer norm correction and principal localization.
-/
namespace Dubon2026
noncomputable section
open NumberField IsDedekindDomain
open scoped NumberField
variable (K L : Type) [Field K] [NumberField K] [Field L] [NumberField L]
  [Algebra K L] [FiniteDimensional K L] [IsGalois K L]

omit [NumberField K] [IsGalois K L] in
/-- Actual inertia is trivial when the original extension is generated by
a valuation-unit Kummer root whose exponent is a valuation unit. -/
theorem originalGeneratedKummer_inertia_eq_bot
    (w : HeightOneSpectrum (𝓞 L)) (n : ℕ) (hn : w.valuation L (n : L) = 1)
    (a : Kˣ) (β : Lˣ) (hβ : (β : L) ^ n = algebraMap K L (a : K))
    (hUnit : w.valuation L (β : L) = 1)
    (hGen : IntermediateField.adjoin K {(β : L)} = ⊤) :
    w.asIdeal.inertia Gal(L/K) = ⊥ := by
  let H := w.asIdeal.inertia Gal(L/K)
  have hFixed : (β : L) ∈ IntermediateField.fixedField H := by
    rw [IntermediateField.mem_fixedField_iff]
    intro σ hσ
    have hVal : w.valuation L (σ (β : L)) = w.valuation L (β : L) := by
      have h := numberFieldGaloisPlace_valuation K L σ w (β : L)
      rw [originalInertia_fixes_prime K L w σ hσ] at h
      exact h
    have hRatioUnit : w.valuation L (σ (β : L) / (β : L)) = 1 := by
      rw [map_div₀, hVal, hUnit, div_one]
    have hClose : w.valuation L (σ (β : L) / (β : L) - 1) < 1 := by
      rw [div_sub_one β.ne_zero, map_div₀, hUnit, div_one]
      exact originalInertia_valuation_sub_lt_one K L w σ hσ (β : L) hUnit.le
    have hPower : (σ (β : L) / (β : L)) ^ n = 1 := by
      rw [div_pow, ← map_pow, hβ, σ.commutes, div_self]
      exact (map_ne_zero (algebraMap K L)).mpr a.ne_zero
    exact (div_eq_one_iff_eq β.ne_zero).mp (valuation_unitExponent_root_eq_one
      (w.valuation L) n hn _ hRatioUnit hClose hPower)
  have hTop : IntermediateField.fixedField H = ⊤ := by
    apply top_unique
    rw [← hGen]
    exact IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hFixed)
  change H = ⊥
  rw [← IntermediateField.fixingSubgroup_fixedField H, hTop,
    IntermediateField.fixingSubgroup_top]

/-- At an actual unramified base prime, a generating original unit Kummer
root with unit exponent gives actual absolute upper-prime unramifiedness. -/
theorem originalGeneratedKummer_unramified
    (v : HeightOneSpectrum (𝓞 K)) (w : HeightOneSpectrum (𝓞 L))
    [w.asIdeal.LiesOver v.asIdeal] (hBase : Algebra.IsUnramifiedAt ℤ v.asIdeal)
    (n : ℕ) (hn : w.valuation L (n : L) = 1)
    (a : Kˣ) (β : Lˣ) (hβ : (β : L) ^ n = algebraMap K L (a : K))
    (hUnit : w.valuation L (β : L) = 1)
    (hGen : IntermediateField.adjoin K {(β : L)} = ⊤) :
    Algebra.IsUnramifiedAt ℤ w.asIdeal := by
  have hInertia := originalGeneratedKummer_inertia_eq_bot K L w n hn a β hβ hUnit hGen
  have hIndex : v.asIdeal.ramificationIdx w.asIdeal = 1 := by
    rw [← numberField_card_inertia_eq_ramificationIdx v w, hInertia]
    exact Nat.card_unique
  letI : Algebra.IsUnramifiedAt (𝓞 K) w.asIdeal :=
    (numberField_isUnramifiedAt_iff_ramificationIdx_one v w).mpr hIndex
  letI : Algebra.IsUnramifiedAt ℤ v.asIdeal := hBase
  exact Algebra.IsUnramifiedAt.comp (R := ℤ) v.asIdeal w.asIdeal

/-- The actual base radicand and exponent unit conditions imply all upper
valuation-unit premises of the proved Kummer unramifiedness theorem. -/
theorem originalGeneratedKummer_unramified_of_base_units
    (v : HeightOneSpectrum (𝓞 K)) (w : HeightOneSpectrum (𝓞 L))
    [w.asIdeal.LiesOver v.asIdeal] (hBase : Algebra.IsUnramifiedAt ℤ v.asIdeal)
    (n : ℕ) (hn : 0 < n) (hAway : (n : 𝓞 K) ∉ v.asIdeal)
    (a : Kˣ) (ha : v.valuation K (a : K) = 1)
    (β : Lˣ) (hβ : (β : L) ^ n = algebraMap K L (a : K))
    (hGen : IntermediateField.adjoin K {(β : L)} = ⊤) :
    Algebra.IsUnramifiedAt ℤ w.asIdeal := by
  have hnBase : v.valuation K (n : K) = 1 := by
    simpa only [map_natCast] using (v.valuation_eq_one_iff_notMem (K := K)).mpr hAway
  have hnUpper : w.valuation L (n : L) = 1 := by
    rw [← map_natCast (algebraMap K L), original_valuation_algebraMap_pow K L v w,
      hnBase, one_pow]
  have hRootPower : w.valuation L (β : L) ^ n = 1 := by
    rw [← map_pow, hβ, original_valuation_algebraMap_pow K L v w, ha, one_pow]
  have hRootUnit : w.valuation L (β : L) = 1 :=
    (pow_eq_one_iff_of_nonneg zero_le hn.ne').mp hRootPower
  exact originalGeneratedKummer_unramified K L v w hBase n hnUpper a β hβ hRootUnit hGen

end
end Dubon2026
