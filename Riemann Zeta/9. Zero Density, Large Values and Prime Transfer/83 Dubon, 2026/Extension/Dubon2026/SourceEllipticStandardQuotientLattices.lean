import Dubon2026.SourceEllipticPeriodCyclicPreimage
import Dubon2026.SourceEllipticPeriodLatticeJ
import Dubon2026.HeckeTriangular

/-! Explicit lattices of the standard cyclic quotients. The point 1/p
gives the lattice generated by tau and 1/p; the point (tau+b)/p gives the
lattice generated by that point and 1. These calculations use the actual
period-model kernel and avoid a general sublattice normal-form theorem.
They identify the prime quotient j-values needed in DUB-17/18. -/

namespace Dubon2026.SourceEllipticPeriod
open WeierstrassCurve UpperHalfPlane SourceFunctionField SourceFunctionField.JOrbitSeparation

theorem standard_diagonal_quotient_lattice (τ : ℍ) (C : VariableChange ℂ)
    (p : ℕ) [NeZero p] (z : ℂ) :
    periodModelHom (PeriodLattice.ofTau τ) C z ∈
      AddSubgroup.zmultiples (periodModelHom (PeriodLattice.ofTau τ) C (1 / p)) ↔
      z ∈ (PeriodLattice.scale (PeriodLattice.ofTau (levelRaiseMatrix p • τ))
        (Units.mk0 (p : ℂ) (Nat.cast_ne_zero.mpr (NeZero.ne p)))⁻¹).lattice := by
  have hp : (p : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne p)
  rw [periodModelHom_mem_zmultiples_iff, mem_scale_lattice]
  simp only [PeriodLattice.ofTau_ω₁, PeriodLattice.ofTau_ω₂, coe_levelRaiseMatrix_smul,
    Units.val_inv_eq_inv_val, Units.val_mk0, mul_one]
  constructor
  · rintro ⟨m, hm⟩
    obtain ⟨a, b, hab⟩ := PeriodPair.mem_lattice.mp hm
    simp only [PeriodLattice.ofTau_ω₁, PeriodLattice.ofTau_ω₂, mul_one] at hab
    refine ⟨a, p * b + m, ?_⟩
    push_cast
    field_simp at hab ⊢
    linear_combination hab
  · rintro ⟨a, b, hab⟩
    refine ⟨b, PeriodPair.mem_lattice.mpr ⟨a, 0, ?_⟩⟩
    simp only [PeriodLattice.ofTau_ω₁, PeriodLattice.ofTau_ω₂, Int.cast_zero, zero_mul, add_zero]
    field_simp at hab ⊢
    linear_combination hab

theorem standard_upper_quotient_lattice (τ : ℍ) (C : VariableChange ℂ)
    (p : ℕ) [NeZero p] (b : ℕ) (z : ℂ) :
    periodModelHom (PeriodLattice.ofTau τ) C z ∈
      AddSubgroup.zmultiples (periodModelHom (PeriodLattice.ofTau τ) C (((τ : ℂ) + b) / p)) ↔
      z ∈ (PeriodLattice.ofTau (heckeUpperPoint p b τ)).lattice := by
  have hp : (p : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne p)
  rw [periodModelHom_mem_zmultiples_iff, PeriodPair.mem_lattice]
  change (∃ m : ℤ, z - m * (((τ : ℂ) + b) / p) ∈ (PeriodLattice.ofTau τ).lattice) ↔
    ∃ a c : ℤ, (a : ℂ) * (((τ : ℂ) + b) / p) + c * 1 = z
  constructor
  · rintro ⟨m, hm⟩
    obtain ⟨a, c, hac⟩ := PeriodPair.mem_lattice.mp hm
    simp only [PeriodLattice.ofTau_ω₁, PeriodLattice.ofTau_ω₂, mul_one] at hac
    refine ⟨p * a + m, c - a * b, ?_⟩
    push_cast
    field_simp at hac ⊢
    linear_combination hac
  · rintro ⟨a, c, hac⟩
    refine ⟨a, PeriodPair.mem_lattice.mpr ⟨0, c, ?_⟩⟩
    simp only [PeriodLattice.ofTau_ω₁, PeriodLattice.ofTau_ω₂, Int.cast_zero, zero_mul, zero_add,
      mul_one]
    linear_combination hac

end Dubon2026.SourceEllipticPeriod
