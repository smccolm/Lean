import Dubon2026.SourcePrimitiveHeckeCharacter
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.NumberTheory.NumberField.Basic

/-! The actual primitive coefficient ring and number field.
DUB-17/18 -> modular Galois association -> arithmetic of the original Fourier
coefficients. Finite original Hecke algebra and its actual eigencharacter supply
finite integral coefficients. Finite integral generators bound the literal
intermediate field generated by all original coefficients.
-/

namespace Dubon2026
noncomputable section
open Matrix.SpecialLinearGroup CongruenceSubgroup
open scoped MatrixGroups
variable {Q : ℕ} [NeZero Q] {k : ℤ}

/-- The literal integral ring generated by the original primitive Fourier coefficients. -/
def sourcePrimitiveCoefficientRing (f : PrimitiveCuspForm Q k) : Subalgebra ℤ ℂ :=
  Algebra.adjoin ℤ (Set.range (cuspCoefficients f.toCuspForm))

/-- Every original coefficient occurs in the original Hecke eigencharacter range. -/
theorem sourcePrimitiveCoefficient_mem_characterRange (f : PrimitiveCuspForm Q k) (n : ℕ) :
    cuspCoefficients f.toCuspForm n ∈ (sourcePrimitiveHeckeCharacter f).range := by
  by_cases hn : n = 0
  · rw [hn, cuspCoefficients_zero]
    exact (sourcePrimitiveHeckeCharacter f).range.zero_mem
  let n' : ℕ+ := ⟨n, Nat.pos_of_ne_zero hn⟩
  exact ⟨⟨cuspHeckeLinear Q k n, Algebra.subset_adjoin ⟨n', rfl⟩⟩,
    sourcePrimitiveHeckeCharacter_hecke f n'⟩

/-- The literal coefficient ring embeds into the finite original eigencharacter range. -/
theorem sourcePrimitiveCoefficientRing_le_characterRange (f : PrimitiveCuspForm Q k) :
    sourcePrimitiveCoefficientRing f ≤ (sourcePrimitiveHeckeCharacter f).range := by
  apply Algebra.adjoin_le
  rintro _ ⟨n, rfl⟩
  exact sourcePrimitiveCoefficient_mem_characterRange f n

/-- The actual original primitive Hecke eigencharacter has finite integral image. -/
theorem sourcePrimitiveHeckeCharacter_range_finite (f : PrimitiveCuspForm Q k) (hk : 2 ≤ k) :
    Module.Finite ℤ (sourcePrimitiveHeckeCharacter f).range := by
  letI := sourceOriginalIntegralHeckeAlgebra_finite Q k hk
  exact Module.Finite.of_surjective (sourcePrimitiveHeckeCharacter f).rangeRestrict.toLinearMap
    (sourcePrimitiveHeckeCharacter f).rangeRestrict_surjective

/-- All original Fourier coefficients generate a finite integral ring, without supplied arithmetic data. -/
theorem sourcePrimitiveCoefficientRing_finite (f : PrimitiveCuspForm Q k) (hk : 2 ≤ k) :
    Module.Finite ℤ (sourcePrimitiveCoefficientRing f) := by
  letI := sourcePrimitiveHeckeCharacter_range_finite f hk
  exact Module.Finite.of_injective
    (Subalgebra.inclusion (sourcePrimitiveCoefficientRing_le_characterRange f)).toLinearMap
    (Subalgebra.inclusion_injective (sourcePrimitiveCoefficientRing_le_characterRange f))

/-- The literal intermediate field generated by every original primitive Fourier coefficient. -/
def sourcePrimitiveCoefficientField (f : PrimitiveCuspForm Q k) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ (Set.range (cuspCoefficients f.toCuspForm))

/-- The actual field of all original primitive coefficients is finite dimensional over the rationals. -/
theorem sourcePrimitiveCoefficientField_finite (f : PrimitiveCuspForm Q k) (hk : 2 ≤ k) :
    FiniteDimensional ℚ (sourcePrimitiveCoefficientField f) := by
  let A := sourcePrimitiveCoefficientRing f
  letI : Module.Finite ℤ A := sourcePrimitiveCoefficientRing_finite f hk
  obtain ⟨n, b, hb⟩ := Module.Finite.exists_fin (R := ℤ) (M := A)
  let s : Set ℂ := Set.range fun i : Fin n => (b i : ℂ)
  let E := IntermediateField.adjoin ℚ s
  haveI : Finite s := (Set.finite_range _).to_subtype
  haveI : FiniteDimensional ℚ E := IntermediateField.finiteDimensional_adjoin (fun x hx => by
    obtain ⟨i, rfl⟩ := hx
    exact ((IsIntegral.of_finite ℤ (b i)).map A.val).tower_top)
  let U : Submodule ℤ A :=
    ((E.toSubalgebra.restrictScalars ℤ).toSubmodule).comap A.val.toLinearMap
  have hbU : Submodule.span ℤ (Set.range b) ≤ U := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact IntermediateField.subset_adjoin ℚ s ⟨i, rfl⟩
  rw [hb] at hbU
  have hAE (x : A) : (x : ℂ) ∈ E := hbU (Submodule.mem_top)
  have hFE : sourcePrimitiveCoefficientField f ≤ E := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨j, rfl⟩
    exact hAE ⟨cuspCoefficients f.toCuspForm j, Algebra.subset_adjoin ⟨j, rfl⟩⟩
  exact FiniteDimensional.of_injective (IntermediateField.inclusion hFE).toLinearMap
    (IntermediateField.inclusion_injective hFE)

/-- The original primitive coefficient field is a number field. -/
theorem sourcePrimitiveCoefficientField_numberField (f : PrimitiveCuspForm Q k) (hk : 2 ≤ k) :
    NumberField (sourcePrimitiveCoefficientField f) := by
  letI := sourcePrimitiveCoefficientField_finite f hk
  exact NumberField.of_module_finite ℚ _

end
end Dubon2026
