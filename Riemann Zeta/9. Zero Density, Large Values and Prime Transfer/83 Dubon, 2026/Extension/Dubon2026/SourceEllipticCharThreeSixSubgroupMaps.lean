import Dubon2026.SourceEllipticCharThreeSubgroupFactor
import Dubon2026.SourceEllipticExceptionalStabilizers
import Dubon2026.SourceEllipticScalingComposition

/-! Every actual characteristic-three stabilizer acts on subgroups by
one of the six maps generated by the quartic and cubic automorphisms.
Existing fourth-root and cube-root classifications, rather than a new
abstract group classification, give the exact DUB-17/18 census relation. -/
namespace Dubon2026.SourceEllipticExceptional
open WeierstrassCurve SourceEllipticStabilizer
noncomputable section
variable {K : Type*} [Field K] [DecidableEq K] [CharP K 3]

theorem char_three_stabilizer_subgroup_six (u : Kˣ) (hu : (u : K) ^ 2 = -1)
    (γ : VariableChange K) (hγ : γ • EA (-1 : K) = EA (-1 : K))
    (H : AddSubgroup (EA (-1 : K)).toAffine.Point) :
    let α := (stabilizerPointEquiv (EA (-1 : K)) ⟨u, 0, 0, 0⟩
      (quartic_change_fixes u hu (-1))).toAddMonoidHom
    let β := (charThreeTranslation (K := K)).toAddMonoidHom
    H.map (stabilizerPointEquiv (EA (-1 : K)) γ hγ).toAddMonoidHom = H ∨
      H.map (stabilizerPointEquiv (EA (-1 : K)) γ hγ).toAddMonoidHom = H.map α ∨
      H.map (stabilizerPointEquiv (EA (-1 : K)) γ hγ).toAddMonoidHom = H.map β ∨
      H.map (stabilizerPointEquiv (EA (-1 : K)) γ hγ).toAddMonoidHom = (H.map β).map β ∨
      H.map (stabilizerPointEquiv (EA (-1 : K)) γ hγ).toAddMonoidHom = (H.map β).map α ∨
      H.map (stabilizerPointEquiv (EA (-1 : K)) γ hγ).toAddMonoidHom = ((H.map β).map β).map α := by
  dsimp only
  obtain ⟨hs, ht, hγu, hγr⟩ := char_three_stabilizer_coordinates hγ
  have hnorm := char_three_affine_fixes γ.u γ.r hγu hγr
  have he : γ = ⟨γ.u, γ.r, 0, 0⟩ := VariableChange.ext rfl rfl hs ht
  rw [stabilizerPointEquiv_congr (EA (-1 : K)) he hγ hnorm]
  have htrans := char_three_affine_fixes (1 : Kˣ) γ.r (by simp) hγr
  have hcases := char_three_translation_subgroup_cases γ.r hγr htrans H
  rcases fourth_roots_mod_sign hu hγu with hsign | hsign
  · rw [char_three_affine_subgroup_map_eq_of_sign γ.u 1 γ.r hnorm htrans
      (by simpa only [Units.val_one] using hsign) H]
    rcases hcases with h | h | h
    · exact Or.inl h
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
  · have hu4 : (u : K) ^ 4 = 1 := by
      calc (u : K) ^ 4 = ((u : K) ^ 2) ^ 2 := by ring
        _ = 1 := by rw [hu]; ring
    have hur := char_three_affine_fixes u γ.r hu4 hγr
    rw [char_three_affine_subgroup_map_eq_of_sign γ.u u γ.r hnorm hur hsign H,
      char_three_affine_subgroup_factor u γ.r (quartic_change_fixes u hu (-1)) htrans hur H]
    rcases hcases with h | h | h
    · rw [h]
      exact Or.inr (Or.inl rfl)
    · rw [h]
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
    · rw [h]
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl))))

end
end Dubon2026.SourceEllipticExceptional
