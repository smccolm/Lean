import Dubon2026.SourceUpperTransvection

/-! Every original upper-unitriangular matrix is generated by its actual
elementary root matrices. This is the necessary all-algebra bridge from
the proved infinitesimal invariant to the actual highest line.
-/

namespace Dubon2026
noncomputable section
open Matrix
variable {K : Type*} [CommRing K] {n : ℕ}

/-- The positions above the diagonal where `M` is nonzero. -/
def sourceUpperSupport (M : Matrix (Fin n) (Fin n) K) : Finset (Fin n × Fin n) := by
  classical exact Finset.univ.filter fun p => p.1 < p.2 ∧ M p.1 p.2 ≠ 0

/-- Membership records an actual nonzero entry above the diagonal. -/
theorem sourceUpperSupport_mem {M : Matrix (Fin n) (Fin n) K} {p : Fin n × Fin n} :
    p ∈ sourceUpperSupport M ↔ p.1 < p.2 ∧ M p.1 p.2 ≠ 0 := by
  classical
  simp [sourceUpperSupport]

/-- A unipotent upper triangular matrix with no entries above the diagonal is `1`. -/
theorem sourceUnipotent_eq_one_of_support_empty {u : GL (Fin n) K} (hu : u ∈ generalLinearBorel K n)
    (hdiag : ∀ i, (u : Matrix (Fin n) (Fin n) K) i i = 1)
    (h : sourceUpperSupport (u : Matrix (Fin n) (Fin n) K) = ∅) : u = 1 := by
  refine Units.ext (Matrix.ext fun a b => ?_)
  rw [Units.val_one]
  rcases lt_trichotomy a b with hab | rfl | hab
  · rw [Matrix.one_apply_ne hab.ne]
    by_contra hne
    have : (a, b) ∈ sourceUpperSupport (u : Matrix (Fin n) (Fin n) K) := sourceUpperSupport_mem.mpr ⟨hab, hne⟩
    rw [h] at this
    exact Finset.notMem_empty _ this
  · rw [Matrix.one_apply_eq, hdiag]
  · rw [Matrix.one_apply_ne hab.ne']
    exact hu hab

/-- Right multiplication by an original transvection performs the exact column operation. -/
theorem sourceUnipotent_mul_transvection_apply (M : Matrix (Fin n) (Fin n) K) (i j : Fin n) (c : K)
    (a b : Fin n) :
    (M * transvection i j c) a b = M a b + if b = j then M a i * c else 0 := by
  rw [transvection, Matrix.mul_add, Matrix.mul_one, Matrix.add_apply]
  congr 1
  split_ifs with hb
  · subst hb
    simp
  · simp [hb]

/-- **The unipotent elements of `B` are products of upper transvections.** -/
theorem sourceUnipotent_induction {P : GL (Fin n) K → Prop} (hmul : ∀ g h, P g → P h → P (g * h))
    (htv : ∀ {a b : Fin n} (hab : a < b) (t : K), P (sourceUpperTransvection hab.ne t)) (hone : P 1) :
    ∀ (N : ℕ) (u : GL (Fin n) K), u ∈ generalLinearBorel K n → (∀ i, (u : Matrix (Fin n) (Fin n) K) i i = 1) →
      (sourceUpperSupport (u : Matrix (Fin n) (Fin n) K)).card = N → P u := by
  intro N
  induction N with
  | zero =>
    intro u hu hdiag hN
    rw [sourceUnipotent_eq_one_of_support_empty hu hdiag (Finset.card_eq_zero.mp hN)]
    exact hone
  | succ N ih =>
    intro u hu hdiag hN
    -- the first column with a nonzero entry above the diagonal
    have hne : (sourceUpperSupport (u : Matrix (Fin n) (Fin n) K)).Nonempty :=
      Finset.card_pos.mp (by omega)
    let cols : Finset (Fin n) := (sourceUpperSupport (u : Matrix (Fin n) (Fin n) K)).image Prod.snd
    have hcols : cols.Nonempty := hne.image _
    obtain ⟨⟨i, j⟩, hij, hjmin⟩ := Finset.mem_image.mp (cols.min'_mem hcols)
    have hjmin' : j = cols.min' hcols := hjmin
    obtain ⟨hlt', hMij⟩ := sourceUpperSupport_mem.mp hij
    have hlt : i < j := hlt'
    -- column `i` of `u` is `e_i`
    have hcol : ∀ a, (u : Matrix (Fin n) (Fin n) K) a i = if a = i then 1 else 0 := by
      intro a
      split_ifs with ha
      · rw [ha]
        exact hdiag i
      · rcases lt_or_gt_of_ne ha with h | h
        · by_contra hM
          have hmem : i ∈ cols :=
            Finset.mem_image.mpr ⟨(a, i), sourceUpperSupport_mem.mpr ⟨h, hM⟩, rfl⟩
          have := cols.min'_le i hmem
          rw [← hjmin'] at this
          exact absurd hlt (not_lt.mpr this)
        · exact hu h
    set c := (u : Matrix (Fin n) (Fin n) K) i j with hc
    let u' : GL (Fin n) K := u * sourceUpperTransvection hlt.ne (-c)
    have hM' : ∀ a b, (u' : Matrix (Fin n) (Fin n) K) a b =
        if a = i ∧ b = j then 0 else (u : Matrix (Fin n) (Fin n) K) a b := by
      intro a b
      change ((u : Matrix (Fin n) (Fin n) K) * (sourceUpperTransvection hlt.ne (-c) : GL (Fin n) K)) a b = _
      rw [sourceUpperTransvection_coe, sourceUnipotent_mul_transvection_apply, hcol]
      by_cases hb : b = j
      · by_cases ha : a = i
        · subst ha
          subst hb
          simp [hc]
        · simp [ha]
      · simp [hb]
    have hu' : u' ∈ generalLinearBorel K n := mul_mem hu (sourceUpperTransvection_mem_borel hlt _)
    have hdiag' : ∀ k, (u' : Matrix (Fin n) (Fin n) K) k k = 1 := by
      intro k
      rw [hM', ite_eq_right_iff.mpr fun h => absurd (h.1.symm.trans h.2) hlt.ne, hdiag]
    have hsupp : sourceUpperSupport (u' : Matrix (Fin n) (Fin n) K) =
        (sourceUpperSupport (u : Matrix (Fin n) (Fin n) K)).erase (i, j) := by
      ext ⟨a, b⟩
      rw [Finset.mem_erase, sourceUpperSupport_mem, sourceUpperSupport_mem, hM']
      by_cases h : a = i ∧ b = j
      · obtain ⟨rfl, rfl⟩ := h
        simp
      · rw [ite_eq_right_iff.mpr fun h' => absurd h' h]
        simp only [ne_eq, Prod.mk.injEq]
        tauto
    have hcard : (sourceUpperSupport (u' : Matrix (Fin n) (Fin n) K)).card = N := by
      rw [hsupp, Finset.card_erase_of_mem hij]
      omega
    have hu'P := ih u' hu' hdiag' hcard
    have : u = u' * sourceUpperTransvection hlt.ne c := by
      refine Units.ext ?_
      rw [Units.val_mul, Units.val_mul, mul_assoc, sourceUpperTransvection_coe, sourceUpperTransvection_coe,
        transvection_mul_transvection_same (h := hlt.ne), neg_add_cancel, transvection_zero,
        mul_one]
    rw [this]
    exact hmul _ _ hu'P (htv hlt c)


end
end Dubon2026
