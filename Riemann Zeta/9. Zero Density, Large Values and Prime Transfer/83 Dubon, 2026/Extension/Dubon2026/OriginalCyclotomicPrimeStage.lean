import Mathlib.NumberTheory.Cyclotomic.Gal
import Mathlib.FieldTheory.Galois.Infinite
import Mathlib.FieldTheory.Finite.Basic
import Mathlib.GroupTheory.Coset.Card

/-! # The actual finite cyclotomic subfield has degree coprime to its prime

This provides the original field and exact degree condition needed to descend
the proved primitive-root Kummer perfect pairing. It uses the actual adjoined
root inside the original extension, not an unrelated abstract cyclotomic field.
-/

namespace Dubon2026
noncomputable section

variable (K Ω : Type) [Field K] [Field Ω] [Algebra K Ω]
  {n : ℕ} [NeZero n] {μ : Ω} (hμ : IsPrimitiveRoot μ n)

/-- The original subfield generated by the actual primitive root, with
finiteness and Galoisness derived from the pinned cyclotomic extension results. -/
def originalPrimitiveRootStage : FiniteGaloisIntermediateField K Ω := by
  let F := IntermediateField.adjoin K ({μ} : Set Ω)
  haveI : IsCyclotomicExtension {n} K F :=
    (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin n K Ω F hμ).mpr rfl
  exact { toIntermediateField := F
          finiteDimensional := IsCyclotomicExtension.finite_of_singleton n K F
          isGalois := IsCyclotomicExtension.isGalois {n} K F }

instance originalPrimitiveRootStage_isCyclotomic :
    IsCyclotomicExtension {n} K (originalPrimitiveRootStage K Ω hμ) :=
  (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin n K Ω
    (originalPrimitiveRootStage K Ω hμ).toIntermediateField hμ).mpr rfl

/-- The very same original primitive root belongs to its original adjoined field. -/
def originalPrimitiveRootStageRoot : originalPrimitiveRootStage K Ω hμ :=
  ⟨μ, IntermediateField.subset_adjoin K ({μ} : Set Ω) (Set.mem_singleton μ)⟩

/-- The actual root remains primitive in the original cyclotomic subfield. -/
theorem originalPrimitiveRootStageRoot_isPrimitive :
    IsPrimitiveRoot (originalPrimitiveRootStageRoot K Ω hμ) n :=
  hμ.of_map_of_injective (f := (originalPrimitiveRootStage K Ω hμ).toIntermediateField.val)
    (originalPrimitiveRootStage K Ω hμ).toIntermediateField.val.injective

/-- At a prime modulus the exact degree of the original cyclotomic subfield
divides q minus one, by the genuine faithful cyclotomic Galois character. -/
theorem originalPrimitiveRootStage_finrank_dvd [Fact n.Prime] :
    Module.finrank K (originalPrimitiveRootStage K Ω hμ) ∣ n - 1 := by
  let F := originalPrimitiveRootStage K Ω hμ
  have hr := originalPrimitiveRootStageRoot_isPrimitive K Ω hμ
  have hd := Subgroup.card_dvd_of_injective (hr.autToPow K) (hr.autToPow_injective K)
  rwa [IsGalois.card_aut_eq_finrank, Nat.card_eq_fintype_card, ZMod.card_units] at hd

/-- The actual cyclotomic field degree is coprime to the coefficient prime,
discharging the exact index premise of continuous H1 restriction detection. -/
theorem originalPrimitiveRootStage_finrank_coprime [Fact n.Prime] :
    n.Coprime (Module.finrank K (originalPrimitiveRootStage K Ω hμ)) := by
  apply (Fact.out : n.Prime).coprime_iff_not_dvd.mpr
  intro h
  have hd : n ∣ n - 1 := h.trans (originalPrimitiveRootStage_finrank_dvd K Ω hμ)
  have hp := (Fact.out : n.Prime).two_le
  have he := Nat.le_of_dvd (show 0 < n - 1 by omega) hd
  omega

end
end Dubon2026
