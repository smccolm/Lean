import Mathlib.FieldTheory.IsAlgClosed.Classification
import Mathlib.Analysis.Complex.Polynomial.Basic
import Mathlib.Analysis.Complex.Cardinality

/-! Embed a countable rational coefficient field into the complex numbers.
This is needed for the field generated by the finitely many curve and torsion
coordinates in the general characteristic-zero odd quotient product. Native
transcendence-basis cardinality and algebraically closed lifting suffice;
no new classification of algebraically closed fields is developed here. -/

namespace Dubon2026.SourceFunctionField.IntegralJCoordinate
open Cardinal
universe u

/-- A countable rational coefficient field embeds into the complex numbers. -/
theorem exists_complex_embedding_of_countable (F : Type u) [Field F] [Algebra ℚ F]
    [Countable F] : Nonempty (F →+* ℂ) := by
  classical
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis ℚ F
  obtain ⟨t, ht⟩ := exists_isTranscendenceBasis ℚ ℂ
  have htcard : #ℂ = #t :=
    IsAlgClosed.cardinal_eq_cardinal_transcendence_basis_of_aleph0_lt'
      (fun z : t => (z : ℂ)) ht (mk_le_aleph0 (α := ℚ)) (by
        rw [Cardinal.mk_complex]; exact Cardinal.aleph0_lt_continuum)
  have hst : lift.{0} #s ≤ lift.{u} #t := by
    calc
      _ ≤ ℵ₀ := by simp
      _ ≤ _ := by simpa only [← htcard, lift_aleph0] using
        (lift_le.mpr (by rw [Cardinal.mk_complex]; exact Cardinal.aleph0_lt_continuum.le) :
          lift.{u} ℵ₀ ≤ lift.{u} #ℂ)
  obtain ⟨e⟩ := lift_mk_le'.mp hst
  have hy : AlgebraicIndependent ℚ (fun z : s => ((e z : t) : ℂ)) :=
    ht.1.comp e e.injective
  let A := Algebra.adjoin ℚ (Set.range (fun z : s => (z : F)))
  let f : A →ₐ[ℚ] ℂ := (MvPolynomial.aeval (fun z : s => ((e z : t) : ℂ))).comp
    hs.1.aevalEquiv.symm.toAlgHom
  have hf : Function.Injective f :=
    (algebraicIndependent_iff_injective_aeval.mp hy).comp hs.1.aevalEquiv.symm.injective
  letI : Algebra A ℂ := f.toRingHom.toAlgebra
  letI : Module.IsTorsionFree A ℂ := Module.isTorsionFree_iff_algebraMap_injective.mpr hf
  letI : Algebra.IsAlgebraic A F := hs.isAlgebraic
  exact ⟨(IsAlgClosed.lift : F →ₐ[A] ℂ).toRingHom⟩

end Dubon2026.SourceFunctionField.IntegralJCoordinate
