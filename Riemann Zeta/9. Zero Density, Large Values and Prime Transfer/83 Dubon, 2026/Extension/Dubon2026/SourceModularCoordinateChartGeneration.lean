import Dubon2026.SourceSeparableCoordinateChartGeneration
import Dubon2026.SourceModularReductionPoleSpace

/-! DUB-17/18 -> Kummer genus inequality -> residue chart generation.
The literal modular j and inverse-j charts are generated by polynomial
multiples of one finite pole space over every perfect coefficient field.
The existing modular finiteness, separability and finite-support theorems
discharge every input of the finite integral-closure argument. -/
namespace Dubon2026.SourceFunctionField.GaussReduction
noncomputable section
open SourceCurve IntermediateField

theorem modular_j_chart_generating_window (N : ℕ) [NeZero N]
    (K : Type*) [Field K] [PerfectField K] :
    ∃ M : ℕ, ∀ h : modularFunctionFieldCoeff N K,
      (∀ v : Place K (modularFunctionFieldCoeff N K),
        0 ≤ v.ord (jCoeff N K) → 0 ≤ v.ord h) →
      h ∈ Submodule.span K {g : modularFunctionFieldCoeff N K | ∃ j : ℕ,
        ∃ y ∈ LSpace (M • modularJPole N K), g = (jCoeff N K) ^ j * y} := by
  letI := finiteDimensional_coeff_field N K
  letI := isSeparable_coeff_field N K
  exact exists_pole_space_generating_window_of_separating_coordinate (jCoeff N K)
    (transcendental_jCoeff N K) (finite_coeff_divisor_support N K (jCoeff N K))

theorem modular_inverse_j_chart_generating_window (N : ℕ) [NeZero N]
    (K : Type*) [Field K] [PerfectField K] :
    ∃ M : ℕ, ∀ h : modularFunctionFieldCoeff N K,
      (∀ v : Place K (modularFunctionFieldCoeff N K),
        0 ≤ v.ord (jCoeff N K)⁻¹ → 0 ≤ v.ord h) →
      h ∈ Submodule.span K {g : modularFunctionFieldCoeff N K | ∃ j : ℕ,
        ∃ y ∈ LSpace (M • poleDivisor (jCoeff N K)⁻¹
          (finite_coeff_divisor_support N K (jCoeff N K)⁻¹)),
          g = ((jCoeff N K)⁻¹) ^ j * y} := by
  letI := finiteDimensional_coeff_field N K
  letI := isSeparable_coeff_field N K
  letI : FiniteDimensional K⟮(jCoeff N K)⁻¹⟯ (modularFunctionFieldCoeff N K) := by
    rw [adjoin_singleton_inv_eq]
    infer_instance
  letI : Algebra.IsSeparable K⟮(jCoeff N K)⁻¹⟯ (modularFunctionFieldCoeff N K) := by
    rw [adjoin_singleton_inv_eq]
    infer_instance
  have ht : Transcendental K (jCoeff N K)⁻¹ :=
    fun h => transcendental_jCoeff N K (IsAlgebraic.inv_iff.mp h)
  exact exists_pole_space_generating_window_of_separating_coordinate (jCoeff N K)⁻¹ ht
    (finite_coeff_divisor_support N K (jCoeff N K)⁻¹)

end
end Dubon2026.SourceFunctionField.GaussReduction
