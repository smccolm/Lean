import Mathlib.FieldTheory.AlgebraicClosure
import Mathlib.FieldTheory.Finiteness
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.LinearAlgebra.FreeModule.Finite.Basic
import Mathlib.NumberTheory.NumberField.Basic

/-! A genuine finite common coefficient field containing every original
number-field embedding in the algebraic closure of the local base field.
Adjoin only the images of a finite rational basis under the finitely many
original embeddings. Native finite algebraic adjoining supplies finite
degree; basis expansion proves that every entire embedding lands in it.
This is the common-field adequacy obligation in BLGG Section 3.2, on the
automorphy dependency chain for Dubon's Theorem 2.6.
-/

namespace Dubon2026
noncomputable section
open NumberField

variable (K F : Type) [Field K] [NumberField K] [Field F] [CharZero F]

/-- The actual common field is generated by the images of a rational basis under every original embedding in the local algebraic closure. -/
def commonCoefficientField : IntermediateField F (AlgebraicClosure F) :=
  IntermediateField.adjoin F (Set.range (fun j :
    (K →ₐ[ℚ] AlgebraicClosure F) × Module.Free.ChooseBasisIndex ℚ K =>
    j.1 (Module.Free.chooseBasis ℚ K j.2)))

/-- The constructed common field has finite degree over the original local base field. -/
instance commonCoefficientFieldFinite : FiniteDimensional F (commonCoefficientField K F) := by
  unfold commonCoefficientField
  apply IntermediateField.finiteDimensional_adjoin
  intro x _
  exact Algebra.IsIntegral.isIntegral x

/-- Every original number-field embedding lands in the constructed common field, not merely its chosen generators. -/
theorem commonCoefficientField_contains (tau : K →ₐ[ℚ] AlgebraicClosure F) (x : K) :
    tau x ∈ commonCoefficientField K F := by
  classical
  let b := Module.Free.chooseBasis ℚ K
  have hb (j : Module.Free.ChooseBasisIndex ℚ K) : tau (b j) ∈ commonCoefficientField K F :=
    IntermediateField.subset_adjoin F _ ⟨(tau, j), rfl⟩
  rw [← b.sum_repr x, map_sum]
  apply sum_mem
  intro j _
  change tau.toLinearMap (b.repr x j • b j) ∈ commonCoefficientField K F
  rw [tau.toLinearMap.map_smul]
  exact ((commonCoefficientField K F).restrictScalars ℚ).smul_mem (hb j)

/-- Every original ambient embedding has its actual factorization into the constructed finite common field. -/
def commonCoefficientEmbedding (tau : K →ₐ[ℚ] AlgebraicClosure F) :
    K →ₐ[ℚ] commonCoefficientField K F :=
  tau.codRestrict ((commonCoefficientField K F).restrictScalars ℚ).toSubalgebra
    (commonCoefficientField_contains K F tau)

/-- The constructed common-field embedding has exactly the original ambient values. -/
theorem commonCoefficientEmbedding_coe (tau : K →ₐ[ℚ] AlgebraicClosure F) (x : K) :
    (commonCoefficientEmbedding K F tau x : AlgebraicClosure F) = tau x := rfl

/-- The finite common field retains all original embeddings into the algebraic closure, with no adequacy hypothesis. -/
def commonCoefficientEmbeddingEquiv :
    (K →ₐ[ℚ] commonCoefficientField K F) ≃ (K →ₐ[ℚ] AlgebraicClosure F) where
  toFun tau := ((commonCoefficientField K F).restrictScalars ℚ).val.comp tau
  invFun := commonCoefficientEmbedding K F
  left_inv tau := by ext x; rfl
  right_inv tau := by ext x; rfl

end
end Dubon2026
