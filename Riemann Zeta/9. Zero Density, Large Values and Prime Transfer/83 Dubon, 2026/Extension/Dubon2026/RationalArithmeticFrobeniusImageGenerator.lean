/-! Every original local representative of the selected finite Frobenius
class generates the image of the same prime-local restriction in that
finite field. This directly consumes DUB-17's auxiliary-prime output. -/

namespace Dubon2026
noncomputable section
open scoped NumberField
attribute [-instance] SubfieldClass.instSMulRat AlgebraicClosure.instSMulOfIsScalarTower
  UniformSpace.Completion.instSMul
attribute [local instance] arithmeticOrbitLocalUnionAlgebra arithmeticOrbitFieldRationalAlgebra
  arithmeticOrbitCompletionNumberField arithmeticOrbitCompletionBaseAlgebra
  arithmeticOrbitCompletionValuation arithmeticOrbitCompletionTopology arithmeticOrbitCompletionLocalField
  arithmeticOrbitCompletionValuationExtension arithmeticOrbitCompletionUniformity arithmeticOrbitCompletionUniformAdd
  arithmeticOrbitCompletionTargetAlgebra arithmeticOrbitCompletionClosureAlgebra
  arithmeticOrbitCompletionGlobalAlgebra
  rationalOriginalCompletionTargetAlgebra rationalOriginalCompletionClosureAlgebra
  rationalOriginalCompletionClosureTower rationalArithmeticOriginalPrimeLiesOver
  originalAdicRelationCompletionAlgebra originalAdicLocalRelationGalois originalAdicLocalRelationCupFinite
  rationalArithmeticOriginalCompletion_closureTower rationalOriginalCompletionGalois
  rationalArithmeticOriginalFiniteGalois

/-- The very same local Frobenius witness returned for the auxiliary prime
generates every original local image in its original finite Galois factor. -/
theorem rationalArithmetic_local_frobenius_generates_finite_image
    (a : 𝓞 ℚ) (p : ℕ) (hp : p.Prime)
    (F : FiniteGaloisIntermediateField ℚ (rationalUnramifiedExtension a))
    (hunr : Chebotarev.UnramifiedIn ℚ F (Ideal.span {(p : 𝓞 ℚ)}))
    (γ : Gal(rationalPrimeLocalClosure p hp / rationalPrimeLocalField p hp))
    (hγ : Chebotarev.frobeniusClass ℚ F (Ideal.span {(p : 𝓞 ℚ)}) =
      ConjClasses.mk (AlgEquiv.restrictNormalHom F (rationalPrimeArithmeticRestriction a p hp γ)))
    (g : Gal(rationalPrimeLocalClosure p hp / rationalPrimeLocalField p hp)) :
    AlgEquiv.restrictNormalHom F (rationalPrimeArithmeticRestriction a p hp g) ∈
      Subgroup.zpowers (AlgEquiv.restrictNormalHom F (rationalPrimeArithmeticRestriction a p hp γ)) := by
  let v := rationalOriginalPrimePlace p hp
  let w := rationalArithmeticOriginalPrime a p hp F
  let V := v.adicCompletion ℚ
  let W := w.adicCompletion F
  let Ω := rationalPrimeLocalClosure p hp
  let r : Gal(Ω/rationalPrimeLocalField p hp) →* Gal(W/V) :=
    galoisBaseChangeRestriction V (rationalPrimeLocalField p hp) W Ω
  let f : Gal(W/V) →* Gal(F/ℚ) := originalCompletionGaloisRestriction ℚ F v w
  have hres (δ : Gal(Ω/rationalPrimeLocalField p hp)) :
      f (r δ) = AlgEquiv.restrictNormalHom F (rationalPrimeArithmeticRestriction a p hp δ) :=
    rationalArithmeticOriginalCompletion_galois_restriction a p hp F δ
  have hunr' : Chebotarev.UnramifiedIn ℚ F v.asIdeal := by
    simpa only [v, rationalOriginalPrimePlace_eq_span] using hunr
  have hc : Chebotarev.frobeniusClass ℚ F v.asIdeal = ConjClasses.mk (f (r γ)) := by
    rw [hres]
    simpa only [v, rationalOriginalPrimePlace_eq_span] using hγ
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp
    (originalCompletion_frobenius_class_generates ℚ F v w hunr' (r γ) hc (r g))
  have he := congrArg f hn
  rw [map_zpow, hres, hres] at he
  exact Subgroup.mem_zpowers_iff.mpr ⟨n, he⟩

/-- Factoring the original residual representation through the selected
unramified finite field makes its actual local image generated by the
same selected local Frobenius. -/
theorem rationalArithmetic_local_frobenius_generates_representation_image
    (a : 𝓞 ℚ) (p : ℕ) (hp : p.Prime)
    {T : Type} [Group T] (ρ : rationalArithmeticGaloisGroup a →* T)
    (F : FiniteGaloisIntermediateField ℚ (rationalUnramifiedExtension a))
    (ψ : Gal(F/ℚ) →* T)
    (hψ : ∀ w : rationalArithmeticGaloisGroup a,
      ψ (AlgEquiv.restrictNormalHom F w) = ρ w)
    (hunr : Chebotarev.UnramifiedIn ℚ F (Ideal.span {(p : 𝓞 ℚ)}))
    (γ : Gal(rationalPrimeLocalClosure p hp / rationalPrimeLocalField p hp))
    (hγ : Chebotarev.frobeniusClass ℚ F (Ideal.span {(p : 𝓞 ℚ)}) =
      ConjClasses.mk (AlgEquiv.restrictNormalHom F (rationalPrimeArithmeticRestriction a p hp γ)))
    (g : Gal(rationalPrimeLocalClosure p hp / rationalPrimeLocalField p hp)) :
    ρ (rationalPrimeArithmeticRestriction a p hp g) ∈
      Subgroup.zpowers (ρ (rationalPrimeArithmeticRestriction a p hp γ)) := by
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp
    (rationalArithmetic_local_frobenius_generates_finite_image a p hp F hunr γ hγ g)
  have he := congrArg ψ hk
  rw [map_zpow] at he
  have hleft := hψ (rationalPrimeArithmeticRestriction a p hp γ)
  have hright := hψ (rationalPrimeArithmeticRestriction a p hp g)
  exact Subgroup.mem_zpowers_iff.mpr ⟨k, (congrArg (fun z => z ^ k) hleft.symm).trans
    (he.trans hright)⟩

end
end Dubon2026
