import Dubon2026.EmbeddedFiniteGaloisCompositumMaps
import Dubon2026.RationalPrimeRootH2Invariant

/-! # The finite local stage generated by the exact arithmetic embedding

The original completion and original global-to-local embedding determine this
actual finite Galois compositum. It is the local field required to connect the
proved arithmetic finite descent to unramified H2 vanishing for DUB-17 support.
-/

namespace Dubon2026
noncomputable section
open scoped NumberField

variable (a : 𝓞 ℚ)

/-- Retain the original rational algebra of the original arithmetic extension. -/
local instance arithmeticFiniteLocalStageAlgebra : Algebra ℚ (rationalUnramifiedExtension a) :=
  (rationalUnramifiedExtension a).algebra'

variable (F : FiniteGaloisIntermediateField ℚ (rationalUnramifiedExtension a))
  (p : ℕ) (hp : p.Prime)

/-- Use the original finite arithmetic stage's proved Galois structure. -/
local instance arithmeticFiniteLocalStageGalois : IsGalois ℚ F := F.isGalois

/-- The original arithmetic embedding restricted to the same finite stage. -/
def rationalArithmeticFiniteLocalEmbedding : F →ₐ[ℚ] rationalPrimeLocalClosure p hp :=
  (rationalArithmeticLocalEmbedding a).comp F.toIntermediateField.val

/-- The literal finite Galois field generated by the same original finite
arithmetic stage inside the original prime-local algebraic closure. -/
def rationalArithmeticFiniteLocalStage :
    FiniteGaloisIntermediateField (rationalPrimeLocalField p hp) (rationalPrimeLocalClosure p hp) :=
  embeddedFiniteGaloisCompositum (K := rationalPrimeLocalField p hp)
    (rationalArithmeticFiniteLocalEmbedding a F p hp)

/-- Retain the original rational algebra induced by the local compositum inclusion. -/
local instance arithmeticFiniteLocalStageRationalAlgebra :
    Algebra ℚ (rationalArithmeticFiniteLocalStage a F p hp) :=
  ((rationalArithmeticFiniteLocalStage a F p hp).toIntermediateField.restrictScalars ℚ).algebra'

/-- The exact finite arithmetic embedding with codomain in its actual local compositum. -/
def rationalArithmeticFiniteLocalStageInclusion : F →ₐ[ℚ] rationalArithmeticFiniteLocalStage a F p hp :=
  embeddedFiniteGaloisCompositumInclusion (K := rationalPrimeLocalField p hp)
    (rationalArithmeticFiniteLocalEmbedding a F p hp)

/-- The constructed local-stage inclusion has the exact value of the same
arithmetic embedding used to define the original global-to-local restriction. -/
theorem rationalArithmeticFiniteLocalStageInclusion_coe (x : F) :
    (rationalArithmeticFiniteLocalStageInclusion a F p hp x : rationalPrimeLocalClosure p hp) =
      rationalArithmeticLocalEmbedding a (x : rationalUnramifiedExtension a) := by
  rfl

/-- Those exact two field images generate the actual finite local stage. -/
theorem rationalArithmeticFiniteLocalStage_ranges :
    (algebraMap (rationalPrimeLocalField p hp) (rationalArithmeticFiniteLocalStage a F p hp)).fieldRange ⊔
      (rationalArithmeticFiniteLocalStageInclusion a F p hp).toRingHom.fieldRange = ⊤ :=
  embeddedFiniteGaloisCompositum_ranges (K := rationalPrimeLocalField p hp)
    (rationalArithmeticFiniteLocalEmbedding a F p hp)

end
end Dubon2026
