import Mathlib.RingTheory.Finiteness.Basic

/-! DUB-17/18 -> residual primitive Galois representation -> the finite
invariant integer lattice generated by the actual integral Tate image.
Native finite-generation under scalar extension supplies finiteness;
intertwining on original integral vectors proves invariance of their span. -/
namespace Dubon2026
noncomputable section
variable {R S M V : Type*} [CommRing R] [CommRing S]
variable [AddCommGroup M] [Module R M] [AddCommGroup V] [Module R V]
variable [Module S V]

/-- The coefficient-integer span of the actual original integral image. -/
def integralImageLattice (j : M →ₗ[R] V) : Submodule S V :=
  Submodule.span S (Set.range j)

theorem integralImageLattice_fg [Algebra R S] [IsScalarTower R S V]
    [Module.Finite R M] (j : M →ₗ[R] V) :
    (integralImageLattice (S := S) j).FG :=
  (Submodule.fg_range j).span

theorem integralImageLattice_map_mem (j : M →ₗ[R] V) (u : V →ₗ[S] V)
    (r : M → M) (he : ∀ x, u (j x) = j (r x))
    (v : V) (hv : v ∈ integralImageLattice (S := S) j) :
    u v ∈ integralImageLattice (S := S) j := by
  have h : integralImageLattice (S := S) j ≤
      (integralImageLattice (S := S) j).comap u := by
    apply Submodule.span_le.mpr
    rintro _ ⟨x, rfl⟩
    change u (j x) ∈ integralImageLattice (S := S) j
    rw [he]
    exact Submodule.subset_span ⟨r x, rfl⟩
  exact h hv

theorem integralImageLattice_span {K : Type*} [CommRing K] [Algebra S K]
    [Module K V] [IsScalarTower S K V] (j : M →ₗ[R] V) :
    Submodule.span K (integralImageLattice (S := S) j : Set V) =
      Submodule.span K (Set.range j) :=
  Submodule.span_span_of_tower S K (Set.range j)

end
end Dubon2026
