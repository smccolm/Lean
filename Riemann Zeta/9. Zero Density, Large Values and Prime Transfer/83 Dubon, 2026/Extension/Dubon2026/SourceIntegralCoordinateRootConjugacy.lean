import Dubon2026.SourceIntegralGenericRootConjugacy
import Dubon2026.SourceCurveCoordinateExchange

/-! Transfer the existing generic irreducibility to the actual subfield
generated by a transcendental j. Native normal-extension conjugacy then
supplies transitivity in a fixed algebraically closed field. The existing
coordinate-exchange theorem permits this same field in the prime-step
induction, avoiding repeated closure embeddings in the cyclic-root census. -/

namespace Dubon2026.SourceFunctionField.IntegralJCoordinate
open Polynomial IntermediateField
open scoped IntermediateField
noncomputable section
variable {K L : Type*} [Field K] [IsAlgClosed K] [Field L] [Algebra K L]

/-- The original modular polynomial is irreducible over the actual field generated by j. -/
theorem modularPolynomial_irreducible_adjoin (N : ℕ) [NeZero N] (hN : (N : K) ≠ 0)
    (j : L) (hj : Transcendental K j) :
    Irreducible (relationAtSeed (modularPolynomial N) (AdjoinSimple.gen K j)) := by
  let e := RatFunc.algEquivOfTranscendental j hj
  have he : (relationAtSeed (modularPolynomial N) (RatFunc.X : RatFunc K)).map e.toRingEquiv.toRingHom =
      relationAtSeed (modularPolynomial N) (AdjoinSimple.gen K j) := by
    rw [relationAtSeed_map]
    exact congrArg (relationAtSeed (modularPolynomial N))
      (Subtype.ext (RatFunc.algEquivOfTranscendental_X j hj))
  rw [← he]
  exact (modularPolynomial_irreducible_ratFunc N K hN).map (Polynomial.mapEquiv e.toRingEquiv)

/-- Actual modular roots are conjugate over the original transcendental coordinate field. -/
theorem modularPolynomial_coordinate_roots_conjugate [IsAlgClosed L]
    (N : ℕ) [NeZero N] (hN : (N : K) ≠ 0)
    (j : L) (hj : Transcendental K j) [Algebra.IsAlgebraic K⟮j⟯ L]
    {r s : L} (hr : (relationAtSeed (modularPolynomial N) j).IsRoot r)
    (hs : (relationAtSeed (modularPolynomial N) j).IsRoot s) :
    ∃ σ : L ≃ₐ[K⟮j⟯] L, σ r = s := by
  letI : Normal K⟮j⟯ L := ⟨fun _ => IsAlgClosed.splits _⟩
  let P := relationAtSeed (modularPolynomial N) (AdjoinSimple.gen K j)
  have hm : P.Monic := (modularPolynomial_monic N).map _
  have hir : Irreducible P := modularPolynomial_irreducible_adjoin N hN j hj
  have hr0 : aeval r P = 0 := by
    rw [aeval_def, ← eval_map, relationAtSeed_map, AdjoinSimple.algebraMap_gen]
    exact hr.eq_zero
  have hs0 : aeval s P = 0 := by
    rw [aeval_def, ← eval_map, relationAtSeed_map, AdjoinSimple.algebraMap_gen]
    exact hs.eq_zero
  have hi : IsIntegral K⟮j⟯ r := ⟨P, hm, hr0⟩
  have hmin : minpoly K⟮j⟯ r = P := (minpoly.eq_of_irreducible_of_monic hir hr0 hm).symm
  apply minpoly.exists_algEquiv_of_root' hi.isAlgebraic
  rw [hmin]
  exact hs0

end
end Dubon2026.SourceFunctionField.IntegralJCoordinate
