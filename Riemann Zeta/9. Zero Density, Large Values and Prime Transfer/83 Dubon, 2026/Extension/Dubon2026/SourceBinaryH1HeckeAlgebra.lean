import Dubon2026.SourceOriginalBinaryHeckeComparison
import Mathlib.Algebra.FreeAlgebra
import Mathlib.RingTheory.Noetherian.Basic

/-! The actual integral Hecke algebra on the full original binary H1.
DUB-17/18 -> residual modular Galois association -> residual H1 eigensystem
-> integral H1 Hecke character. The algebra is generated by the genuine
good-prime correspondences on finite integral H1, not by separately supplied
operators or by a character specification.
-/

namespace Dubon2026
noncomputable section

/-- The original good primes at the actual source level. -/
abbrev sourceBinaryHeckePrime (Q : ℕ) :=
  {p : ℕ // p.Prime ∧ Nat.Coprime p Q}

private local instance sourceBinaryHeckePrimeNeZero {Q : ℕ}
    (p : sourceBinaryHeckePrime Q) : NeZero p.val :=
  ⟨p.property.1.ne_zero⟩

/-- The family of genuine full good-prime binary H1 correspondences over the chosen coefficient ring. -/
def sourceBinaryH1PrimeOperators (R : Type) [CommRing R] (Q w : ℕ) :
    sourceBinaryHeckePrime Q → Module.End R (groupCohomology.H1 (sourceBinaryCoefficientRep R Q w)) :=
  fun p => sourceBinaryHeckeH1 R p.property.1 w

/-- The actual algebra generated over Z by every original good-prime H1 Hecke correspondence. -/
def sourceBinaryH1HeckeAlgebra (Q w : ℕ) :
    Subalgebra ℤ (Module.End ℤ (groupCohomology.H1 (sourceBinaryCoefficientRep ℤ Q w))) :=
  Algebra.adjoin ℤ (Set.range (sourceBinaryH1PrimeOperators ℤ Q w))

/-- The actual integral H1 Hecke algebra is finite over Z; commutativity is not required for this step. -/
theorem sourceBinaryH1HeckeAlgebra_finite (Q w : ℕ) [NeZero Q] :
    Module.Finite ℤ (sourceBinaryH1HeckeAlgebra Q w) := by
  letI : Module.Finite ℤ (groupCohomology.H1 (sourceBinaryCoefficientRep ℤ Q w)) :=
    sourceIntegralBinaryH1Finite Q w
  letI : IsNoetherian ℤ (groupCohomology.H1 (sourceBinaryCoefficientRep ℤ Q w)) :=
    @isNoetherian_of_isNoetherianRing_of_finite ℤ
      (groupCohomology.H1 (sourceBinaryCoefficientRep ℤ Q w)) _ _ _ _
        (sourceIntegralBinaryH1Finite Q w)
  letI : IsNoetherian ℤ
      (Module.End ℤ (groupCohomology.H1 (sourceBinaryCoefficientRep ℤ Q w))) := by
    convert isNoetherian_linearMap ℤ
      (groupCohomology.H1 (sourceBinaryCoefficientRep ℤ Q w))
      (groupCohomology.H1 (sourceBinaryCoefficientRep ℤ Q w)) using 1
    exact Subsingleton.elim _ _
  exact Module.Finite.of_injective (sourceBinaryH1HeckeAlgebra Q w).val.toLinearMap
    Subtype.val_injective

/-- Actual integral-to-complex coefficient change intertwines every original good-prime generator. -/
theorem sourceBinaryH1PrimeOperators_change (Q w : ℕ) (p : sourceBinaryHeckePrime Q)
    (x : groupCohomology.H1 (sourceBinaryCoefficientRep ℤ Q w)) :
    sourceBinaryH1Change (Int.castRingHom ℂ) Q w (sourceBinaryH1PrimeOperators ℤ Q w p x) =
      sourceBinaryH1PrimeOperators ℂ Q w p (sourceBinaryH1Change (Int.castRingHom ℂ) Q w x) :=
  sourceBinaryH1Change_hecke (Int.castRingHom ℂ) p.property.1 w x

end
end Dubon2026
