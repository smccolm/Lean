import Dubon2026.NumberFieldSUnitRadicalQuotient
import Dubon2026.OriginalKummerGaloisFinite

/-! # The finite Galois extension generated by the original S-unit radicals

The actual finite power quotient controls the actual generated field. No
finite ambient stage or finite Kummer extension is assumed. This supplies
the S-unit extension used by the global norm-index dependency of DUB-17;
the precise degree and global reciprocity law remain separate obligations.
-/

namespace Dubon2026
noncomputable section
open IsDedekindDomain
open scoped NumberField

variable (K Ω : Type) [Field K] [NumberField K] [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [IsGalois K Ω]

/-- Original S-unit power classes identify with the actual classes of the full S-unit radical subgroup. -/
def numberFieldSUnitPowerQuotientEquivClasses
    (S : Set (HeightOneSpectrum (𝓞 K))) (n : ℕ) (hn : n ≠ 0) :
    S.unit K ⧸ (powMonoidHom (α := S.unit K) n).range ≃*
      originalKummerClassSubgroup n (S.unit K ⊔ (powMonoidHom (α := Kˣ) n).range) :=
  (sUnitPowerQuotientEquivRadical S n hn).trans
    (originalKummerRadicalQuotientEquivClasses n _)

/-- Finiteness of the actual original S-unit power quotient gives finitely many radical classes. -/
theorem numberField_sUnit_kummerClasses_finite
    (S : Set (HeightOneSpectrum (𝓞 K))) (hS : S.Finite) (n : ℕ) (hn : n ≠ 0) :
    Finite (originalKummerClassSubgroup n
      (S.unit K ⊔ (powMonoidHom (α := Kˣ) n).range)) := by
  letI := numberField_sUnit_powerQuotient_finite K S hS n hn
  exact Finite.of_equiv _ (numberFieldSUnitPowerQuotientEquivClasses K S n hn).toEquiv

/-- The original full S-unit radical classes have the proved S-unit power cardinality. -/
theorem numberField_sUnit_kummerClasses_card
    (S : Set (HeightOneSpectrum (𝓞 K))) (hS : S.Finite)
    (n : ℕ) (hn : n ≠ 0) (ζ : K) (hζ : IsPrimitiveRoot ζ n) :
    Nat.card (originalKummerClassSubgroup n
      (S.unit K ⊔ (powMonoidHom (α := Kˣ) n).range)) =
      n ^ (Fintype.card (NumberField.InfinitePlace K) + S.ncard) := by
  rw [← Nat.card_congr (numberFieldSUnitPowerQuotientEquivClasses K S n hn).toEquiv]
  exact numberField_sUnit_powerQuotient_card K S hS n hn ζ hζ

/-- The field generated by the actual original full S-unit radicals is a finite extension. -/
theorem numberField_sUnit_kummerField_finiteDimensional
    (S : Set (HeightOneSpectrum (𝓞 K))) (hS : S.Finite)
    (n : ℕ) (hn : 0 < n) (hζ : (primitiveRoots n K).Nonempty) :
    FiniteDimensional K (originalKummerRadicalField (Ω := Ω) n
      (S.unit K ⊔ (powMonoidHom (α := Kˣ) n).range)) := by
  letI := numberField_sUnit_kummerClasses_finite K S hS n hn.ne'
  exact originalKummerRadicalField_finiteDimensional n hn hζ _

end
end Dubon2026
