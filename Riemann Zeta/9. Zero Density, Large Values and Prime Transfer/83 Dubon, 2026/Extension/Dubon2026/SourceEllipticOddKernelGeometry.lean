import Dubon2026.SourceEllipticOddKernelNorm
import Dubon2026.SourceEllipticOddReindex

/-! The zero set of the actual half-orbit kernel polynomial is exactly the
nonzero part of the actual odd cyclic subgroup. Native finite-order indexing
and the retained x-coordinate sign criterion give the comparison in every
characteristic. With the norm map's proved polynomial kernel, this identifies
its exact cyclic kernel for the DUB-17/18 prime-quotient dependency. -/

open Polynomial WeierstrassCurve WeierstrassCurve.Affine
open Dubon2026.SourceEllipticVelu Dubon2026.SourceEllipticVelu.OddDiscriminant
open Dubon2026.SourceEllipticVelu.OddDiscriminant.Algebra

namespace Dubon2026.SourceEllipticFunctionField

variable {F : Type*} [Field F] [DecidableEq F]

omit [DecidableEq F] in
/-- The roots of the actual finite denominator polynomial are exactly the summand abscissae. -/
theorem eval_kernelPolynomial_eq_zero_iff (S : Finset (F × F)) (x : F) :
    (hP S Prod.fst).eval x = 0 ↔ ∃ P ∈ S, x = P.1 := by
  simp only [hP, eval_prod, eval_sub, eval_X, eval_C, Finset.prod_eq_zero_iff, sub_eq_zero]

variable (W : WeierstrassCurve F) [W.IsElliptic] {Q : W.toAffine.Point} {n : ℕ}

omit [W.IsElliptic] in
/-- For an actual affine point, vanishing of the odd denominator is equivalent to membership in the cyclic subgroup. -/
theorem eval_oddKernel_eq_zero_iff_mem_zmultiples {x y : F} (h : W.toAffine.Nonsingular x y)
    (hQ : addOrderOf Q = 2 * n + 1) :
    (hP (oddOrderSummingSet W Q n) Prod.fst).eval x = 0 ↔
      Point.some x y h ∈ AddSubgroup.zmultiples Q := by
  classical
  rw [eval_kernelPolynomial_eq_zero_iff]
  constructor
  · rintro ⟨P, hPmem, hx⟩
    obtain ⟨k, hk1, hkn, rfl⟩ := mem_oddOrderSummingSet.mp hPmem
    have hk0 := kernel_ne_zero hQ hk1 (show k ≤ 2 * n by omega)
    have he : xco (Point.some x y h) = xco (k • Q) := hx
    have hmem : k • Q ∈ AddSubgroup.zmultiples Q :=
      (AddSubgroup.zmultiples Q).nsmul_mem (AddSubgroup.mem_zmultiples Q) k
    rcases eq_or_eq_neg_of_xco_eq (Point.some_ne_zero h) hk0 he with hp | hp
    · exact hp ▸ hmem
    · rw [hp]
      exact (AddSubgroup.zmultiples Q).neg_mem hmem
  · intro hmem
    have hf : IsOfFinAddOrder Q := by
      by_contra hn
      have hz := addOrderOf_eq_zero hn
      rw [hQ] at hz
      omega
    rw [hf.mem_zmultiples_iff_mem_range_addOrderOf, Finset.mem_image] at hmem
    obtain ⟨k, hk, he⟩ := hmem
    rw [Finset.mem_range, hQ] at hk
    have hk1 : 1 ≤ k := by
      by_contra hz
      have hk0 : k = 0 := by omega
      rw [hk0, zero_nsmul] at he
      exact Point.some_ne_zero h he.symm
    by_cases hkn : k ≤ n
    · refine ⟨coordsOrZero (k • Q), mem_oddOrderSummingSet.mpr ⟨k, hk1, hkn, rfl⟩, ?_⟩
      rw [he]
      rfl
    · refine ⟨coordsOrZero ((2 * n + 1 - k) • Q),
        mem_oddOrderSummingSet.mpr ⟨2 * n + 1 - k, by omega, by omega, rfl⟩, ?_⟩
      rw [coordsOrZero_sub_smul_fst hQ (by omega), he]
      rfl

variable [IsAlgClosed F]

/-- The kernel of the actual additive odd quotient map is precisely the cyclic subgroup generated by Q. -/
theorem ker_oddPointNorm (hQ : addOrderOf Q = 2 * n + 1) :
    (oddPointNorm W hQ).ker = AddSubgroup.zmultiples Q := by
  ext P
  rw [AddMonoidHom.mem_ker]
  cases P with
  | zero => exact ⟨fun _ => (AddSubgroup.zmultiples Q).zero_mem, fun _ => (oddPointNorm W hQ).map_zero⟩
  | some x y h =>
    rw [oddPointNorm_some_eq_zero_iff, eval_oddKernel_eq_zero_iff_mem_zmultiples W h hQ]

end Dubon2026.SourceEllipticFunctionField
