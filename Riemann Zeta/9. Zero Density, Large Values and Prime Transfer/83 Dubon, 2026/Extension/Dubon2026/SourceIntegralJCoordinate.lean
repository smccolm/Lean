import Dubon2026.SourceAllDivisorMonicRelations
import Dubon2026.SourceModularJTranscendence
import Mathlib.RingTheory.Polynomial.GaussLemma

/-! DUB-17/18 -> finite exceptional-fiber orbit census -> the integral
modular polynomial. The actual rational j-field is the fraction field of
the integral polynomial coordinate. Clearing the two rational polynomial
denominators uses native integer normalization. Adapted from the selected
nonempty_modularPolynomialData proof in anthropics/fermats-last-theorem,
commit 6e837e75355538c7f80bab5b956861e86c4eacc2, Apache-2.0. -/
namespace Dubon2026.SourceFunctionField.IntegralJCoordinate
noncomputable section
open IntermediateField Polynomial
open scoped IntermediateField nonZeroDivisors

/-- The literal rational field generated by the original j series. -/
abbrev J := ℚ⟮jq⟯

/-- Evaluate the integral polynomial coordinate at the actual internal j. -/
def evaluate : ℤ[X] →+* J :=
  eval₂RingHom (Int.castRingHom J) (AdjoinSimple.gen ℚ jq)

/-- The integral polynomial scalar action on the actual rational j-field. -/
scoped instance coordinateAlgebra : Algebra ℤ[X] J := evaluate.toAlgebra
/-- The same integral polynomial action on the original Laurent series. -/
scoped instance laurentAlgebra : Algebra ℤ[X] (LaurentSeries ℚ) := evalAtJ.toAlgebra

theorem algebraMap_evaluate (p : ℤ[X]) :
    algebraMap J (LaurentSeries ℚ) (evaluate p) = aeval jq p := by
  have he : (algebraMap J (LaurentSeries ℚ)).comp evaluate = evalAtJ :=
    Polynomial.ringHom_ext' (RingHom.ext_int _ _) (by simp [evaluate])
  exact DFunLike.congr_fun he p

scoped instance coordinateTower : IsScalarTower ℤ[X] J (LaurentSeries ℚ) :=
  IsScalarTower.of_algebraMap_eq fun p => (algebraMap_evaluate p).symm

theorem evaluate_injective : Function.Injective evaluate := by
  intro p q hpq
  apply Polynomial.map_injective (Int.castRingHom ℚ) Int.cast_injective
  apply transcendental_iff_injective.mp (transcendental_jqModC ℚ)
  have he (r : ℤ[X]) : aeval jq (r.map (Int.castRingHom ℚ)) = aeval jq r := by
    rw [aeval_def, eval₂_map, aeval_def]
    congr 1
    exact Subsingleton.elim _ _
  rw [jqModC_rat, he, he]
  exact (algebraMap_evaluate p).symm.trans
    ((congrArg (algebraMap J (LaurentSeries ℚ)) hpq).trans (algebraMap_evaluate q))

theorem aeval_of_map_eq {p : ℤ[X]} {g : ℚ[X]} {d : ℤ}
    (h : p.map (Int.castRingHom ℚ) = d • g) :
    aeval jq p = (d : LaurentSeries ℚ) * aeval jq g := by
  have he : aeval jq (p.map (Int.castRingHom ℚ)) = aeval jq p := by
    rw [aeval_def, eval₂_map, aeval_def]
    congr 1
    exact Subsingleton.elim _ _
  rw [← he, h, zsmul_eq_mul, map_mul, map_intCast]

theorem exists_eq_div (z : J) :
    ∃ x y : ℤ[X], z = evaluate x / evaluate y := by
  obtain ⟨r, s, hrs⟩ := (mem_adjoin_simple_iff ℚ (α := jq) z.1).mp z.2
  obtain ⟨dR, hdR0, hR⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors ℤ) r
  obtain ⟨dS, hdS0, hS⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors ℤ) s
  let R : ℤ[X] := IsLocalization.integerNormalization (nonZeroDivisors ℤ) r
  let S : ℤ[X] := IsLocalization.integerNormalization (nonZeroDivisors ℤ) s
  have hR' : R.map (Int.castRingHom ℚ) = dR • r := hR
  have hS' : S.map (Int.castRingHom ℚ) = dS • s := hS
  refine ⟨C dS * R, C dR * S, ?_⟩
  apply Subtype.ext
  change z.1 = algebraMap J (LaurentSeries ℚ) (evaluate (C dS * R) / evaluate (C dR * S))
  rw [map_div₀, algebraMap_evaluate, algebraMap_evaluate, map_mul, map_mul,
    aeval_C, aeval_C, aeval_of_map_eq hR', aeval_of_map_eq hS', hrs]
  have hdS : (dS : LaurentSeries ℚ) ≠ 0 := by
    rw [← map_intCast (algebraMap ℚ (LaurentSeries ℚ)),
      map_ne_zero_iff _ (algebraMap ℚ (LaurentSeries ℚ)).injective]
    exact_mod_cast nonZeroDivisors.ne_zero hdS0
  have hdR : (dR : LaurentSeries ℚ) ≠ 0 := by
    rw [← map_intCast (algebraMap ℚ (LaurentSeries ℚ)),
      map_ne_zero_iff _ (algebraMap ℚ (LaurentSeries ℚ)).injective]
    exact_mod_cast nonZeroDivisors.ne_zero hdR0
  rw [eq_intCast, eq_intCast, ← mul_assoc, ← mul_assoc,
    mul_comm (dR : LaurentSeries ℚ) (dS : LaurentSeries ℚ),
    mul_div_mul_left _ _ (mul_ne_zero hdS hdR)]

theorem isFractionRing_coordinate : IsFractionRing ℤ[X] J := by
  haveI : FaithfulSMul ℤ[X] J :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr evaluate_injective
  exact IsFractionRing.of_field ℤ[X] J exists_eq_div

end
end Dubon2026.SourceFunctionField.IntegralJCoordinate
