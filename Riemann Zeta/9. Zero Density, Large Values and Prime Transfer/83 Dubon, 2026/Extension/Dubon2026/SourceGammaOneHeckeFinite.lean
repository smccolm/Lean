import Dubon2026.SourceGammaOneHeckeWords

/-! DUB-17/18 -> original all-weight adic association -> actual finite Gamma1
Hecke characters. Native finite generation of the congruence subgroup and
the existing finite H1 theorem prove finiteness of the actual constant
coefficient H1 and its literal Hecke operator image. -/
namespace Dubon2026
noncomputable section
open CongruenceSubgroup
open scoped MatrixGroups

/-- The actual Gamma1 H1 with the original finite binary coefficient
vectors is finite; neither group nor cohomology finiteness is assumed. -/
theorem sourceGammaOneConstantH1_finite
    (Q N w : ℕ) [NeZero Q] [NeZero N] :
    Finite (groupCohomology.H1 (Rep.trivial (ZMod N) (Gamma1 (Q * N ^ 2))
      (sourceBinaryCoefficientRep (ZMod N) Q w))) := by
  letI : Group.FG SL(2, ℤ) :=
    Group.fg_iff.mpr ⟨{ModularGroup.S, ModularGroup.T},
      SpecialLinearGroup.SL2Z_generators, Set.toFinite _⟩
  let A := Rep.trivial (ZMod N) (Gamma1 (Q * N ^ 2))
    (sourceBinaryCoefficientRep (ZMod N) Q w)
  letI : Module.Finite (ZMod N) A :=
    Module.Finite.of_basis (binaryHomogeneousMonomialBasis w)
  letI := sourceH1Finite A
  exact Module.finite_of_finite (ZMod N)

/-- The actual ring generated by Gamma1 Hecke operators away from level
and modulus is finite, since it acts on the proved finite native H1. -/
theorem sourceGammaOneHeckeAlgebra_finite
    (Q N w : ℕ) [NeZero Q] [NeZero N] :
    Finite (sourceGammaOneHeckeAlgebra Q N w) := by
  let M := groupCohomology.H1 (Rep.trivial (ZMod N) (Gamma1 (Q * N ^ 2))
    (sourceBinaryCoefficientRep (ZMod N) Q w))
  letI : Finite M := sourceGammaOneConstantH1_finite Q N w
  letI : Finite (Module.End (ZMod N) M) :=
    Finite.of_injective (fun T : Module.End (ZMod N) M => (T : M → M)) DFunLike.coe_injective
  exact Finite.of_injective (fun T : sourceGammaOneHeckeAlgebra Q N w => T.val)
    Subtype.val_injective

end
end Dubon2026
