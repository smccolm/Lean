import Dubon2026.ContinuousCosetOrbitCocycles
import Dubon2026.RationalPrimeRootH2Invariant
import Mathlib.FieldTheory.Galois.Infinite

/-! # The actual finite local field attached to an arithmetic coset orbit

The field is generated over the original prime completion by the literal
image of the global finite subfield under its coset representative. Its
fixing subgroup is proved equal to the stabilizer used in the continuous
Mackey formula. Openness and the pinned infinite Galois correspondence
give finiteness. This is the field identification step toward applying
the proved local corestriction invariant to DUB-17's orbit summands.
-/
namespace Dubon2026
noncomputable section
open scoped NumberField

variable (a : 𝓞 ℚ) (p : ℕ) (hp : p.Prime)

/-- Retain the original arithmetic union's rational algebra. -/
local instance arithmeticOrbitLocalUnionAlgebra : Algebra ℚ (rationalUnramifiedExtension a) :=
  (rationalUnramifiedExtension a).algebra'

variable (F : IntermediateField ℚ (rationalUnramifiedExtension a))

/-- The original finite field's actual fixing subgroup, on the arithmetic Galois group. -/
def rationalArithmeticOrbitFixingSubgroup : Subgroup (rationalArithmeticGaloisGroup a) := F.fixingSubgroup

/-- The chosen arithmetic coset representative as its literal field automorphism. -/
def rationalArithmeticOrbitRepresentative
    (c : rationalArithmeticGaloisGroup a ⧸ rationalArithmeticOrbitFixingSubgroup a F) :
    Gal(rationalUnramifiedExtension a / ℚ) := c.out

/-- The actual local field generated by the coset image of the original global subfield. -/
def rationalArithmeticOrbitLocalField
    (c : rationalArithmeticGaloisGroup a ⧸ rationalArithmeticOrbitFixingSubgroup a F) :
    IntermediateField (rationalPrimeLocalField p hp) (rationalPrimeLocalClosure p hp) :=
  IntermediateField.adjoin (rationalPrimeLocalField p hp)
    (Set.range fun x : F => rationalArithmeticLocalEmbedding (K := rationalPrimeLocalClosure p hp) a
      (rationalArithmeticOrbitRepresentative a F c (x : rationalUnramifiedExtension a)))

/-- The exact arithmetic coset stabilizer fixes precisely the actual embedded generators. -/
theorem rationalArithmeticOrbitStabilizer_mem_iff
    (c : rationalArithmeticGaloisGroup a ⧸ rationalArithmeticOrbitFixingSubgroup a F)
    (d : Gal(rationalPrimeLocalClosure p hp / rationalPrimeLocalField p hp)) :
    d ∈ cosetOrbitStabilizer (rationalPrimeArithmeticRestriction a p hp).toMonoidHom
      (rationalArithmeticOrbitFixingSubgroup a F) c ↔
    ∀ x : F, d (rationalArithmeticLocalEmbedding (K := rationalPrimeLocalClosure p hp) a
      (rationalArithmeticOrbitRepresentative a F c (x : rationalUnramifiedExtension a))) =
      rationalArithmeticLocalEmbedding (K := rationalPrimeLocalClosure p hp) a
        (rationalArithmeticOrbitRepresentative a F c (x : rationalUnramifiedExtension a)) := by
  let σ := rationalArithmeticOrbitRepresentative a F c
  let τ : Gal(rationalUnramifiedExtension a / ℚ) := rationalPrimeArithmeticRestriction a p hp d
  rw [cosetOrbitStabilizer_mem]
  change σ⁻¹ * (τ * σ) ∈ F.fixingSubgroup ↔ _
  rw [IntermediateField.mem_fixingSubgroup_iff]
  constructor
  · intro h x
    have he := congrArg σ (h x x.property)
    change σ (σ.symm (τ (σ x))) = σ x at he
    rw [σ.apply_symm_apply] at he
    exact (rationalPrimeArithmeticRestriction_commutes a p hp d (σ x)).symm.trans
      (congrArg (rationalArithmeticLocalEmbedding (K := rationalPrimeLocalClosure p hp) a) he)
  · intro h x hx
    have he := (rationalArithmeticLocalEmbedding (K := rationalPrimeLocalClosure p hp) a).injective
      ((rationalPrimeArithmeticRestriction_commutes a p hp d (σ x)).trans (h ⟨x, hx⟩))
    change σ.symm (τ (σ x)) = x
    rw [he, σ.symm_apply_apply]

/-- The actual Mackey stabilizer equals the fixing subgroup of the generated local field. -/
theorem rationalArithmeticOrbitLocalField_fixingSubgroup
    (c : rationalArithmeticGaloisGroup a ⧸ rationalArithmeticOrbitFixingSubgroup a F) :
    (rationalArithmeticOrbitLocalField a p hp F c).fixingSubgroup =
      cosetOrbitStabilizer (rationalPrimeArithmeticRestriction a p hp).toMonoidHom
        (rationalArithmeticOrbitFixingSubgroup a F) c := by
  ext d
  rw [rationalArithmeticOrbitStabilizer_mem_iff, IntermediateField.mem_fixingSubgroup_iff]
  constructor
  · intro h x
    exact h _ (IntermediateField.subset_adjoin _ _ ⟨x, rfl⟩)
  · intro h z hz
    apply IntermediateField.adjoin_induction (rationalPrimeLocalField p hp)
      (p := fun z _ => d z = z) ?_ ?_ ?_ ?_ ?_ hz
    · rintro _ ⟨x, rfl⟩
      exact h x
    · exact d.commutes
    · intro x y _ _ hx hy
      rw [map_add, hx, hy]
    · intro x _ hx
      rw [map_inv₀, hx]
    · intro x y _ _ hx hy
      rw [map_mul, hx, hy]

/-- The actual field associated to each orbit is finite over the original prime completion. -/
theorem rationalArithmeticOrbitLocalField_finiteDimensional [FiniteDimensional ℚ F]
    (c : rationalArithmeticGaloisGroup a ⧸ rationalArithmeticOrbitFixingSubgroup a F) :
    FiniteDimensional (rationalPrimeLocalField p hp) (rationalArithmeticOrbitLocalField a p hp F c) := by
  apply (InfiniteGalois.isOpen_iff_finite _).mp
  rw [rationalArithmeticOrbitLocalField_fixingSubgroup]
  exact cosetOrbitStabilizer_isOpen (rationalPrimeArithmeticRestriction a p hp).toMonoidHom
    (rationalPrimeArithmeticRestriction a p hp).continuous
    (rationalArithmeticOrbitFixingSubgroup a F) F.fixingSubgroup_isOpen c

end
end Dubon2026
