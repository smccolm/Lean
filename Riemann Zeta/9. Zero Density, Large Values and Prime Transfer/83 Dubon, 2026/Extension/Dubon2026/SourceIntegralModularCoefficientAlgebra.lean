import Dubon2026.SourceModularFunctionFieldCoefficients
import Dubon2026.SourceLaurentEuler

/-! DUB-17/18 -> original Frobenius/inertia -> curve reduction ->
integral coefficient model. The algebra generated by the actual integral
divisor j expansions specializes into the actual coefficient function
field and generates that field. This is the precise algebraic entry for
the later valuation-ring and place-reduction argument. It does not yet
assert good reduction or preservation of arbitrary rational functions. -/
namespace Dubon2026.SourceFunctionField
noncomputable section
open IntermediateField

/-- The algebra generated by the literal divisor j expansions over the coefficient ring. -/
def integralModularCoefficientAlgebra (N : ℕ) (R : Type*) [CommRing R] :
    Subalgebra R (LaurentSeries R) :=
  Algebra.adjoin R (divisorExpansionsCoeff N R)

variable (N : ℕ) {R K : Type*} [CommRing R] [Field K] (f : R →+* K)

theorem coeffMap_integralModular_mem_field {x : LaurentSeries R}
    (hx : x ∈ integralModularCoefficientAlgebra N R) :
    coeffMap f x ∈ modularFunctionFieldCoeff N K := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨d, hd0, hd, rfl⟩ := hx
    letI := hd0
    rw [coeffMap_qExpand]
    have hj : coeffMap f (jqModC R) = jqModC K := map_jqModC f
    rw [hj]
    exact jqd_mem_coeff_field N K hd
  | algebraMap r =>
    have h := (modularFunctionFieldCoeff N K).algebraMap_mem (f r)
    simpa only [SourceDifferential.algebraMap_laurentSeries_apply_alt,
      coeffMap_single] using h
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy

/-- Actual coefficient specialization of the integral divisor-expansion algebra. -/
def integralModularCoefficientMap : integralModularCoefficientAlgebra N R →+*
    modularFunctionFieldCoeff N K :=
  ((coeffMap f).comp (integralModularCoefficientAlgebra N R).val).codRestrict
    (modularFunctionFieldCoeff N K).toSubring (fun x => coeffMap_integralModular_mem_field N f x.property)

theorem integralModularCoefficientMap_coe (x : integralModularCoefficientAlgebra N R) :
    (integralModularCoefficientMap N f x : LaurentSeries K) = coeffMap f x.val := rfl

theorem integralModularCoefficientMap_generates :
    IntermediateField.adjoin K (Set.range (integralModularCoefficientMap N f)) = ⊤ := by
  apply IntermediateField.lift_injective
  erw [IntermediateField.lift_adjoin, IntermediateField.lift_top]
  apply le_antisymm
  · rw [adjoin_le_iff]
    rintro _ ⟨x, _, rfl⟩
    exact x.property
  · change IntermediateField.adjoin K (divisorExpansionsCoeff N K) ≤ _
    rw [adjoin_le_iff]
    rintro _ ⟨d, hd0, hd, rfl⟩
    letI := hd0
    have hy : qExpand R d (jqModC R) ∈ integralModularCoefficientAlgebra N R :=
      Algebra.subset_adjoin ⟨d, hd0, hd, rfl⟩
    apply IntermediateField.subset_adjoin
    refine ⟨integralModularCoefficientMap N f ⟨qExpand R d (jqModC R), hy⟩,
      ⟨⟨qExpand R d (jqModC R), hy⟩, rfl⟩, ?_⟩
    change coeffMap f (qExpand R d (jqModC R)) = qExpand K d (jqModC K)
    rw [coeffMap_qExpand]
    exact congrArg (qExpand K d) (map_jqModC f)

end
end Dubon2026.SourceFunctionField
