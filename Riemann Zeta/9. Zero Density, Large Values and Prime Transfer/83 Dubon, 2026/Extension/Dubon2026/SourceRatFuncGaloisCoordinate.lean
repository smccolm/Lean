import Dubon2026.SourceConstantFieldCoordinateMap
import Mathlib.FieldTheory.RatFunc.IntermediateField
import Mathlib.FieldTheory.Galois.Basic

/-! Relate a literal rational-function extension to the simple field
generated by the image of X. This lets the proved finite Galois model
field use the existing place and degree formulas in the exact DUB-17/18
specialization chain. The existing constant-field coordinate map replaces
a second numerator/denominator membership proof. -/
namespace Dubon2026.SourceCurve
open IntermediateField
noncomputable section
variable (K : Type*) [Field K] {M : Type*} [Field M]
variable [Algebra (RatFunc K) M] [Algebra K M] [IsScalarTower K (RatFunc K) M]

theorem rationalCoordinate_transcendental :
    Transcendental K (algebraMap (RatFunc K) M RatFunc.X) :=
  (transcendental_algebraMap_iff (algebraMap (RatFunc K) M).injective).mpr
    RatFunc.transcendental_X

theorem rationalFunction_mem_coordinateField (f : RatFunc K) :
    algebraMap (RatFunc K) M f ∈ K⟮algebraMap (RatFunc K) M RatFunc.X⟯ := by
  apply ConstantField.algebraMap_mem_adjoin_simple (K := K) (K' := K)
  rw [RatFunc.adjoin_X]
  exact mem_top

/-- The original rational-function embedding with its actual simple-field codomain. -/
def rationalCoordinateMap : RatFunc K →+* K⟮algebraMap (RatFunc K) M RatFunc.X⟯ where
  toFun f := ⟨algebraMap (RatFunc K) M f, rationalFunction_mem_coordinateField K f⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' f g := Subtype.ext (map_mul _ f g)
  map_zero' := Subtype.ext (map_zero _)
  map_add' f g := Subtype.ext (map_add _ f g)

theorem finite_galois_coordinateField
    [FiniteDimensional (RatFunc K) M] [IsGalois (RatFunc K) M] :
    FiniteDimensional K⟮algebraMap (RatFunc K) M RatFunc.X⟯ M ∧
      IsGalois K⟮algebraMap (RatFunc K) M RatFunc.X⟯ M := by
  letI : Algebra (RatFunc K) K⟮algebraMap (RatFunc K) M RatFunc.X⟯ :=
    (rationalCoordinateMap K).toAlgebra
  haveI : IsScalarTower (RatFunc K) K⟮algebraMap (RatFunc K) M RatFunc.X⟯ M :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  exact ⟨Module.Finite.of_restrictScalars_finite (RatFunc K) _ M,
    IsGalois.tower_top_of_isGalois (RatFunc K) _ M⟩

end
end Dubon2026.SourceCurve
