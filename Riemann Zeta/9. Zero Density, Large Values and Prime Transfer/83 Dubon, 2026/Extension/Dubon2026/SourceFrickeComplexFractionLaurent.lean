import Dubon2026.SourceFrickeLaurentGeneratorIntegrality
import Dubon2026.SourceFrickeCyclotomicFractionGerm

/-! DUB-17/18 -> rational Fourier spanning -> Fricke integral base change.
The actual complex algebra generated by j and Fricke functions is represented
inside the Laurent algebra generated by their literal original series. The
nonzero denominator is nonzero as a germ by the proved analytic identity
principle. Thus an actual numerator/denominator identity yields membership
in the actual generated Laurent field, with no representation premise. -/
namespace Dubon2026.SourceFricke
noncomputable section
open UpperHalfPlane SourceFunctionField
open scoped Manifold MatrixGroups ModularForm

theorem levelRing_periodic {N : ℕ} [NeZero N] {f : ℍ → ℂ}
    (hf : f ∈ levelRing N) : Function.Periodic (f ∘ ofComplex) N := by
  induction hf using Algebra.adjoin_induction with
  | mem f hf =>
    rcases hf with rfl | ⟨i, rfl⟩
    · exact periodic_jf_width N
    · exact periodic_frickeF i
  | algebraMap c => intro z; rfl
  | add x y _ _ hx hy => exact hx.add hy
  | mul x y _ _ hx hy => exact hx.mul hy

theorem exists_complex_fricke_cusp_represents {N : ℕ} [NeZero N] {f : ℍ → ℂ}
    (hf : f ∈ levelRing N) :
    ∃ A ∈ Algebra.adjoin ℂ (frickeLaurentGenerators N),
      CuspTaylor.Represents A (cuspFunction N f) := by
  induction hf using Algebra.adjoin_induction with
  | mem f hf =>
    rcases hf with rfl | ⟨i, rfl⟩
    · exact ⟨jqNModC ℂ N, Algebra.subset_adjoin (Set.mem_insert _ _), represents_jqNModC N⟩
    · exact ⟨coeffMap (algebraMap (kN N) ℂ) (frickeLaurentK N i),
        Algebra.subset_adjoin (Set.mem_insert_of_mem _ ⟨i, rfl⟩), represents_frickeLaurentK N i⟩
  | algebraMap c =>
    exact ⟨algebraMap ℂ (LaurentSeries ℂ) c, Subalgebra.algebraMap_mem _ c,
      CuspTaylor.represents_cusp_const N c⟩
  | add x y _ _ hx hy =>
    obtain ⟨A, hAm, hAr⟩ := hx
    obtain ⟨B, hBm, hBr⟩ := hy
    exact ⟨A + B, Subalgebra.add_mem _ hAm hBm, hAr.cusp_add hBr⟩
  | mul x y _ _ hx hy =>
    obtain ⟨A, hAm, hAr⟩ := hx
    obtain ⟨B, hBm, hBr⟩ := hy
    exact ⟨A * B, Subalgebra.mul_mem _ hAm hBm, hAr.cusp_mul hBr⟩

theorem exists_complex_fricke_fraction_represents {N : ℕ} [NeZero N]
    {a b f : ℍ → ℂ} (ha : a ∈ levelRing N) (hb : b ∈ levelRing N)
    (hb0 : b ≠ 0) (hrel : f * b = a) :
    ∃ X ∈ IntermediateField.adjoin ℂ (frickeLaurentGenerators N),
      CuspTaylor.Represents X (cuspFunction N f) := by
  obtain ⟨A, hAm, hAr⟩ := exists_complex_fricke_cusp_represents ha
  obtain ⟨B, hBm, hBr⟩ := exists_complex_fricke_cusp_represents hb
  have hB0 := hBr.ne_zero_of_function_ne_zero (by exact_mod_cast NeZero.pos N)
    (levelRing_le_HolFn N hb) (levelRing_periodic hb) hb0
  have hinc : Algebra.adjoin ℂ (frickeLaurentGenerators N) ≤
      (IntermediateField.adjoin ℂ (frickeLaurentGenerators N)).toSubalgebra :=
    Algebra.adjoin_le (IntermediateField.subset_adjoin _ _)
  exact ⟨A / B, div_mem (hinc hAm) (hinc hBm), hAr.cusp_of_mul_eq hBr hB0 hrel⟩

end
end Dubon2026.SourceFricke