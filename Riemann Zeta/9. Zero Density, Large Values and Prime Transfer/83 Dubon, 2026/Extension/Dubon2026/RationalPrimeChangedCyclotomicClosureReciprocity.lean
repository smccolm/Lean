/-! # The changed cyclotomic reciprocity diagram in the original local closure

Only the finite compositum generated by the changed auxiliary field and the
prime-power cyclotomic stage is embedded into the original algebraic closure.
The resulting field equivalences transport the proved integer uniformizer,
its exact norm and upstairs irreducibility.  Spectral local structures then
make the closure compositum unramified over the auxiliary stage, and the
normalized local reciprocity theorem identifies the norm of that uniformizer
with restricted positive arithmetic Frobenius.
-/
namespace Dubon2026
noncomputable section
open scoped ValuativeRel

set_option maxHeartbeats 800000

attribute [local instance] rationalPrimeWittPrime wittCyclotomicRootDomain
  wittCyclotomicRootFaithful wittCyclotomicFieldAlgebra wittCyclotomicFieldTower
  rationalPrimeWittOriginalAlgebra rationalPrimeWittCyclotomicAlgebra
  rationalPrimeWittCyclotomicTower rationalPrimeWittCyclotomicModule
  rationalPrimeWittCyclotomicMulAction

/-- The exact finite compositum to be embedded, inside the Witt cyclotomic field. -/
def rationalPrimeChangedCyclotomicFiniteAmbient
    (p : ℕ) (hp : p.Prime) (n : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) :
    IntermediateField (rationalPrimeLocalField p hp)
      (wittCyclotomicField
        (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n) :=
  rationalPrimeChangedAuxiliaryField p hp n u ⊔
    (rationalPrimeOriginalCyclotomicStage p hp n).toIntermediateField

/-- An original-base embedding of the exact finite compositum into the original local closure. -/
def rationalPrimeChangedCyclotomicFiniteAmbientEmbedding
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    rationalPrimeChangedCyclotomicFiniteAmbient p hp n u →ₐ[rationalPrimeLocalField p hp]
      rationalPrimeLocalClosure p hp := by
  let K := rationalPrimeLocalField p hp
  let E := rationalPrimeChangedAuxiliaryField p hp n u
  let L := rationalPrimeOriginalCyclotomicStage p hp n
  let S := rationalPrimeChangedCyclotomicFiniteAmbient p hp n u
  letI : FiniteDimensional K E :=
    (rationalPrimeChangedAuxiliaryField_finrank_and_finite p hp n a u hu ha).2
  haveI : FiniteDimensional K S := by
    dsimp only [S, rationalPrimeChangedCyclotomicFiniteAmbient]
    exact IntermediateField.finiteDimensional_sup E L.toIntermediateField
  haveI : Algebra.IsAlgebraic K S := Algebra.IsAlgebraic.of_finite K S
  exact IsAlgClosed.lift

/-- The image of the actual changed auxiliary field in the original local closure. -/
def rationalPrimeChangedAuxiliaryClosureField
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    IntermediateField (rationalPrimeLocalField p hp) (rationalPrimeLocalClosure p hp) :=
  let K := rationalPrimeLocalField p hp
  let E := rationalPrimeChangedAuxiliaryField p hp n u
  let S := rationalPrimeChangedCyclotomicFiniteAmbient p hp n u
  let f : E →ₐ[K] rationalPrimeLocalClosure p hp :=
    (rationalPrimeChangedCyclotomicFiniteAmbientEmbedding p hp n a u hu ha).comp
      (IntermediateField.inclusion (show E ≤ S from le_sup_left))
  f.fieldRange

/-- The image of the actual original cyclotomic stage in the original local closure. -/
def rationalPrimeOriginalCyclotomicClosureStage
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    FiniteGaloisIntermediateField (rationalPrimeLocalField p hp)
      (rationalPrimeLocalClosure p hp) := by
  let K := rationalPrimeLocalField p hp
  let L := rationalPrimeOriginalCyclotomicStage p hp n
  let S := rationalPrimeChangedCyclotomicFiniteAmbient p hp n u
  let f : L →ₐ[K] rationalPrimeLocalClosure p hp :=
    (rationalPrimeChangedCyclotomicFiniteAmbientEmbedding p hp n a u hu ha).comp
      (IntermediateField.inclusion (show L.toIntermediateField ≤ S from le_sup_right))
  exact finiteGaloisEmbeddingStage f

/-- The original cyclotomic stage identifies with its actual closure image. -/
def rationalPrimeOriginalCyclotomicClosureEquiv
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    rationalPrimeOriginalCyclotomicStage p hp n ≃ₐ[rationalPrimeLocalField p hp]
      rationalPrimeOriginalCyclotomicClosureStage p hp n a u hu ha :=
  let K := rationalPrimeLocalField p hp
  let L := rationalPrimeOriginalCyclotomicStage p hp n
  let S := rationalPrimeChangedCyclotomicFiniteAmbient p hp n u
  let f : L →ₐ[K] rationalPrimeLocalClosure p hp :=
    (rationalPrimeChangedCyclotomicFiniteAmbientEmbedding p hp n a u hu ha).comp
      (IntermediateField.inclusion (show L.toIntermediateField ≤ S from le_sup_right))
  finiteGaloisEmbeddingStageEquiv f

/-- At an odd prime, the Galois group of the actual closure cyclotomic stage is cyclic. -/
theorem rationalPrimeOriginalCyclotomicClosureStage_isCyclic
    (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    IsCyclic Gal(rationalPrimeOriginalCyclotomicClosureStage p hp n a u hu ha /
      rationalPrimeLocalField p hp) := by
  let K := rationalPrimeLocalField p hp
  let L := rationalPrimeOriginalCyclotomicStage p hp n
  let Ω₀ := wittCyclotomicField
    (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n
  letI : NeZero p := ⟨hp.ne_zero⟩
  letI := ZMod.isCyclic_units_of_prime_pow p hp hp2 (n + 1)
  have hμ : IsPrimitiveRoot (rationalPrimeWittCyclotomicFieldPrimitiveRoot p hp n)
      (p ^ (n + 1)) := by
    simpa only [rationalPrimePlace_natGenerator] using
      rationalPrimeWittCyclotomicFieldPrimitiveRoot_isPrimitive p hp n
  letI : NeZero (p ^ (n + 1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  have hcyclo : IsCyclotomicExtension {p ^ (n + 1)} K L := by
    simpa only [L, rationalPrimeOriginalCyclotomicStage,
      rationalPrimePlace_natGenerator] using
        (originalPrimitiveRootStage_isCyclotomic K Ω₀ hμ)
  letI := hcyclo
  have hcyclic : IsCyclic Gal(L/K) := by
    let hζ := IsCyclotomicExtension.zeta_spec (p ^ (n + 1)) K L
    exact isCyclic_of_injective (hζ.autToPow K) (hζ.autToPow_injective K)
  exact (rationalPrimeOriginalCyclotomicClosureEquiv p hp n a u hu ha).autCongr.isCyclic.mp hcyclic

/-- The literal compositum of the changed auxiliary image and cyclotomic image in the closure. -/
def rationalPrimeChangedCyclotomicClosureCompositum
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    FiniteGaloisIntermediateField (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)
      (rationalPrimeLocalClosure p hp) :=
  finiteGaloisCompositumOverIntermediate
    (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)
    (rationalPrimeOriginalCyclotomicClosureStage p hp n a u hu ha)

/-- The changed auxiliary field identifies with its actual image in the local closure. -/
def rationalPrimeChangedAuxiliaryClosureEquiv
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    rationalPrimeChangedAuxiliaryField p hp n u ≃ₐ[rationalPrimeLocalField p hp]
      rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha :=
  let K := rationalPrimeLocalField p hp
  let E := rationalPrimeChangedAuxiliaryField p hp n u
  let S := rationalPrimeChangedCyclotomicFiniteAmbient p hp n u
  let f : E →ₐ[K] rationalPrimeLocalClosure p hp :=
    (rationalPrimeChangedCyclotomicFiniteAmbientEmbedding p hp n a u hu ha).comp
      (IntermediateField.inclusion (show E ≤ S from le_sup_left))
  AlgEquiv.ofInjective f f.injective

/-- The image of the finite Witt compositum is exactly the closure compositum. -/
theorem rationalPrimeChangedCyclotomicFiniteAmbient_map_eq_closureCompositum
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    (⊤ : IntermediateField (rationalPrimeLocalField p hp)
      (rationalPrimeChangedCyclotomicFiniteAmbient p hp n u)).map
        (rationalPrimeChangedCyclotomicFiniteAmbientEmbedding p hp n a u hu ha) =
      (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha).toIntermediateField.restrictScalars
        (rationalPrimeLocalField p hp) := by
  let K := rationalPrimeLocalField p hp
  let Ω₀ := wittCyclotomicField
    (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n
  let E := rationalPrimeChangedAuxiliaryField p hp n u
  let L := rationalPrimeOriginalCyclotomicStage p hp n
  let S := rationalPrimeChangedCyclotomicFiniteAmbient p hp n u
  let ι := rationalPrimeChangedCyclotomicFiniteAmbientEmbedding p hp n a u hu ha
  let fE : E →ₐ[K] S :=
    IntermediateField.inclusion (show E ≤ S from le_sup_left)
  let fL : L →ₐ[K] S :=
    IntermediateField.inclusion (show L.toIntermediateField ≤ S from le_sup_right)
  let ES : IntermediateField K S := fE.fieldRange
  let LS : IntermediateField K S := fL.fieldRange
  have hgen : ES ⊔ LS = ⊤ := by
    apply IntermediateField.toSubfield_injective
    simpa only [ES, LS, AlgHom.fieldRange_toSubfield,
      IntermediateField.sup_toSubfield] using
        (intermediateField_sup_inclusion_ranges E L.toIntermediateField)
  have hmap : ES.map ι ⊔ LS.map ι = (⊤ : IntermediateField K S).map ι := by
    rw [← IntermediateField.map_sup, hgen]
  apply IntermediateField.restrictScalars_injective K
  change (⊤ : IntermediateField K S).map ι =
    (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha ⊔
      (rationalPrimeOriginalCyclotomicClosureStage p hp n a u hu ha).toIntermediateField)
  rw [← hmap]
  congr 1
  · rw [show ES.map ι = (ι.comp fE).fieldRange by
      simp only [ES, AlgHom.fieldRange_eq_map, IntermediateField.map_map]]
    rfl
  · rw [show LS.map ι = (ι.comp fL).fieldRange by
      simp only [LS, AlgHom.fieldRange_eq_map, IntermediateField.map_map]]
    rfl

/-- Restricting the base field of an intermediate field does not change its underlying field. -/
def intermediateFieldRestrictScalarsAlgEquiv
    {K E Ω : Type} [Field K] [Field E] [Field Ω]
    [Algebra K E] [Algebra E Ω] [Algebra K Ω] [IsScalarTower K E Ω]
    (F : IntermediateField E Ω) :
    F.restrictScalars K ≃ₐ[K] F where
  toFun x := ⟨x.1, x.2⟩
  invFun x := ⟨x.1, x.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl

/-- Compatible field equivalences of two local towers induce compatible
maps on their actual valuation integer rings. -/
theorem localFieldIntegerAlgEquiv_algebraMap
    (K E₀ M₀ E M : Type) [Field K] [Field E₀] [Field M₀] [Field E] [Field M]
    [Algebra K E₀] [Algebra K M₀] [Algebra E₀ M₀]
    [Algebra K E] [Algebra K M] [Algebra E M]
    [ValuativeRel K] [ValuativeRel E₀] [ValuativeRel M₀]
    [ValuativeRel E] [ValuativeRel M]
    [TopologicalSpace K] [TopologicalSpace E₀] [TopologicalSpace M₀]
    [TopologicalSpace E] [TopologicalSpace M]
    [IsNonarchimedeanLocalField K] [IsNonarchimedeanLocalField E₀]
    [IsNonarchimedeanLocalField M₀] [IsNonarchimedeanLocalField E]
    [IsNonarchimedeanLocalField M]
    [(ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation E₀)]
    [(ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation M₀)]
    [(ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation E)]
    [(ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation M)]
    [(ValuativeRel.valuation E₀).HasExtension (ValuativeRel.valuation M₀)]
    [(ValuativeRel.valuation E).HasExtension (ValuativeRel.valuation M)]
    (eE : E₀ ≃ₐ[K] E) (eM : M₀ ≃ₐ[K] M)
    (hcomm : ∀ z : E₀, eM (algebraMap E₀ M₀ z) = algebraMap E M (eE z))
    (x : 𝒪[E₀]) :
    localFieldIntegerAlgEquiv K M₀ M eM (algebraMap 𝒪[E₀] 𝒪[M₀] x) =
      algebraMap 𝒪[E] 𝒪[M] (localFieldIntegerAlgEquiv K E₀ E eE x) := by
  apply Subtype.ext
  change algebraMap 𝒪[M] M
      (localFieldIntegerAlgEquiv K M₀ M eM (algebraMap 𝒪[E₀] 𝒪[M₀] x)) =
    algebraMap 𝒪[M] M
      (algebraMap 𝒪[E] 𝒪[M] (localFieldIntegerAlgEquiv K E₀ E eE x))
  rw [localFieldIntegerAlgEquiv_coefficient K M₀ M eM]
  change eM (algebraMap E₀ M₀ (algebraMap 𝒪[E₀] E₀ x)) =
    algebraMap E M (algebraMap 𝒪[E] E (localFieldIntegerAlgEquiv K E₀ E eE x))
  rw [localFieldIntegerAlgEquiv_coefficient K E₀ E eE]
  exact hcomm _

/-- The actual closure cyclotomic stage includes in the actual closure compositum. -/
def rationalPrimeOriginalCyclotomicClosureInclusion
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    rationalPrimeOriginalCyclotomicClosureStage p hp n a u hu ha →ₐ[
      rationalPrimeLocalField p hp] rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha := by
  let K := rationalPrimeLocalField p hp
  let E := rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha
  let L := rationalPrimeOriginalCyclotomicClosureStage p hp n a u hu ha
  let M := rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha
  let j : L →ₐ[K] M.toIntermediateField.restrictScalars K :=
    IntermediateField.inclusion (show L.toIntermediateField ≤
      M.toIntermediateField.restrictScalars K by
        change L.toIntermediateField ≤ E ⊔ L.toIntermediateField
        exact le_sup_right)
  exact (intermediateFieldRestrictScalarsAlgEquiv M.toIntermediateField).toAlgHom.comp j

/-- The finite Witt compositum identifies with the actual compositum in the local closure. -/
def rationalPrimeChangedCyclotomicClosureCompositumEquiv
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    rationalPrimeChangedCyclotomicCompositum p hp n u ≃ₐ[rationalPrimeLocalField p hp]
      rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha := by
  let K := rationalPrimeLocalField p hp
  let M := rationalPrimeChangedCyclotomicCompositum p hp n u
  let S := rationalPrimeChangedCyclotomicFiniteAmbient p hp n u
  let ι := rationalPrimeChangedCyclotomicFiniteAmbientEmbedding p hp n a u hu ha
  have hsource : M.toIntermediateField.restrictScalars K = S := by
    apply SetLike.coe_injective
    exact rationalPrimeChangedCyclotomicCompositum_coe p hp n u
  have hrange : ι.fieldRange =
      (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha).toIntermediateField.restrictScalars K :=
    (AlgHom.fieldRange_eq_map ι).trans
      (rationalPrimeChangedCyclotomicFiniteAmbient_map_eq_closureCompositum
        p hp n a u hu ha)
  exact (IntermediateField.equivOfEq hsource).trans <|
    (AlgEquiv.ofInjective ι ι.injective).trans <|
      (IntermediateField.equivOfEq hrange).trans <|
        intermediateFieldRestrictScalarsAlgEquiv _

/-- The compositum equivalence commutes with the changed auxiliary-field inclusions. -/
theorem rationalPrimeChangedCyclotomicClosureCompositumEquiv_auxiliary
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a)
    (x : rationalPrimeChangedAuxiliaryField p hp n u) :
    rationalPrimeChangedCyclotomicClosureCompositumEquiv p hp n a u hu ha
        (algebraMap (rationalPrimeChangedAuxiliaryField p hp n u)
          (rationalPrimeChangedCyclotomicCompositum p hp n u) x) =
      algebraMap (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)
        (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha)
        (rationalPrimeChangedAuxiliaryClosureEquiv p hp n a u hu ha x) := by
  apply Subtype.ext
  rfl

/-- The original Witt auxiliary and compositum stages carry one compatible
spectral tower over the rational local field. -/
theorem rationalPrimeChangedCyclotomicWitt_exists_tower_local_structure
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    let K := rationalPrimeLocalField p hp
    let E := rationalPrimeChangedAuxiliaryField p hp n u
    let M := rationalPrimeChangedCyclotomicCompositum p hp n u
    ∃ (_ : FiniteDimensional K E) (_ : FiniteDimensional K M)
      (_ : ValuativeRel E) (_ : TopologicalSpace E)
      (_ : IsNonarchimedeanLocalField E)
      (_ : (ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation E))
      (_ : ValuativeRel M) (_ : TopologicalSpace M)
      (_ : IsNonarchimedeanLocalField M)
      (_ : (ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation M))
      (_ : (ValuativeRel.valuation E).HasExtension (ValuativeRel.valuation M)),
      True := by
  let K := rationalPrimeLocalField p hp
  let E := rationalPrimeChangedAuxiliaryField p hp n u
  let M := rationalPrimeChangedCyclotomicCompositum p hp n u
  letI : FiniteDimensional K E :=
    (rationalPrimeChangedAuxiliaryField_finrank_and_finite p hp n a u hu ha).2
  letI : FiniteDimensional K M := FiniteDimensional.trans K E M
  letI := IsTopologicalAddGroup.rightUniformSpace K
  haveI := isUniformAddGroup_of_addCommGroup (G := K)
  let normK := localFieldOriginalNorm K
  letI : NontriviallyNormedField K := normK
  letI : NormedField K := normK.toNormedField
  haveI : CompleteSpace K := localFieldOriginalNorm_complete K
  haveI : IsUltrametricDist K := localFieldOriginalNorm_isUltrametric K
  haveI : (NormedField.valuation (K := K)).Compatible :=
    localFieldOriginalNorm_compatible K
  letI : NontriviallyNormedField E := spectralNorm.nontriviallyNormedField K E
  letI : NormedAlgebra K E := spectralNorm.normedAlgebra K E
  letI : NontriviallyNormedField M := spectralNorm.nontriviallyNormedField K M
  letI : NormedAlgebra K M := spectralNorm.normedAlgebra K M
  letI : NormedAlgebra E M := spectralNorm.normedAlgebra' K E M
  haveI : IsUltrametricDist E := IsUltrametricDist.of_normedAlgebra K
  haveI : IsUltrametricDist M := IsUltrametricDist.of_normedAlgebra K
  letI : ValuativeRel E := ValuativeRel.ofValuation (NormedField.valuation (K := E))
  letI : ValuativeRel M := ValuativeRel.ofValuation (NormedField.valuation (K := M))
  haveI : IsNonarchimedeanLocalField E :=
    spectralFiniteExtension_isNonarchimedeanLocalField K E
  haveI : IsNonarchimedeanLocalField M :=
    spectralFiniteExtension_isNonarchimedeanLocalField K M
  haveI : (ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation E) :=
    spectralValuation_hasExtension K E
  haveI : (ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation M) :=
    spectralValuation_hasExtension K M
  haveI : (ValuativeRel.valuation E).HasExtension (ValuativeRel.valuation M) :=
    normedFieldValuation_hasExtension E M
  exact ⟨inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, trivial⟩

/-- The closure auxiliary and compositum stages carry compatible spectral local structures. -/
theorem rationalPrimeChangedCyclotomicClosure_exists_local_structure
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a) :
    let K := rationalPrimeLocalField p hp
    let E := rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha
    let M := rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha
    ∃ (_ : FiniteDimensional K E) (_ : ValuativeRel E)
      (_ : TopologicalSpace E) (_ : IsNonarchimedeanLocalField E)
      (_ : (ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation E))
      (_ : ValuativeRel M) (_ : TopologicalSpace M)
      (_ : IsNonarchimedeanLocalField M)
      (_ : (ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation M))
      (_ : (ValuativeRel.valuation E).HasExtension (ValuativeRel.valuation M)),
      True := by
  let K := rationalPrimeLocalField p hp
  let E₀ := rationalPrimeChangedAuxiliaryField p hp n u
  let E := rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha
  let M := rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha
  letI : FiniteDimensional K E₀ :=
    (rationalPrimeChangedAuxiliaryField_finrank_and_finite p hp n a u hu ha).2
  letI : FiniteDimensional K E :=
    LinearEquiv.finiteDimensional
      (rationalPrimeChangedAuxiliaryClosureEquiv p hp n a u hu ha).toLinearEquiv
  letI : FiniteDimensional K M := FiniteDimensional.trans K E M
  letI := IsTopologicalAddGroup.rightUniformSpace K
  haveI := isUniformAddGroup_of_addCommGroup (G := K)
  let normK := localFieldOriginalNorm K
  letI : NontriviallyNormedField K := normK
  letI : NormedField K := normK.toNormedField
  haveI : CompleteSpace K := localFieldOriginalNorm_complete K
  haveI : IsUltrametricDist K := localFieldOriginalNorm_isUltrametric K
  haveI : (NormedField.valuation (K := K)).Compatible :=
    localFieldOriginalNorm_compatible K
  letI : NontriviallyNormedField E := spectralNorm.nontriviallyNormedField K E
  letI : NormedAlgebra K E := spectralNorm.normedAlgebra K E
  letI : NontriviallyNormedField M := spectralNorm.nontriviallyNormedField K M
  letI : NormedAlgebra K M := spectralNorm.normedAlgebra K M
  letI : NormedAlgebra E M := spectralNorm.normedAlgebra' K E M
  haveI : IsUltrametricDist E := IsUltrametricDist.of_normedAlgebra K
  haveI : IsUltrametricDist M := IsUltrametricDist.of_normedAlgebra K
  letI : ValuativeRel E := ValuativeRel.ofValuation (NormedField.valuation (K := E))
  letI : ValuativeRel M := ValuativeRel.ofValuation (NormedField.valuation (K := M))
  haveI : IsNonarchimedeanLocalField E :=
    spectralFiniteExtension_isNonarchimedeanLocalField K E
  haveI : IsNonarchimedeanLocalField M :=
    spectralFiniteExtension_isNonarchimedeanLocalField K M
  haveI : (ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation E) :=
    spectralValuation_hasExtension K E
  haveI : (ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation M) :=
    spectralValuation_hasExtension K M
  haveI : (ValuativeRel.valuation E).HasExtension (ValuativeRel.valuation M) :=
    normedFieldValuation_hasExtension E M
  exact ⟨inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, trivial⟩

/-- The exact normed auxiliary uniformizer transports to the closure model and remains irreducible upstairs. -/
theorem rationalPrimeChangedCyclotomicClosure_exists_integer_uniformizer_core
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a)
    [FiniteDimensional (rationalPrimeLocalField p hp)
      (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)]
    [ValuativeRel (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)]
    [TopologicalSpace (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)]
    [IsNonarchimedeanLocalField (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)]
    [(ValuativeRel.valuation (rationalPrimeLocalField p hp)).HasExtension
      (ValuativeRel.valuation (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha))]
    [ValuativeRel (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha)]
    [TopologicalSpace (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha)]
    [IsNonarchimedeanLocalField (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha)]
    [(ValuativeRel.valuation (rationalPrimeLocalField p hp)).HasExtension
      (ValuativeRel.valuation (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha))]
    [(ValuativeRel.valuation (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)).HasExtension
      (ValuativeRel.valuation (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha))] :
    ∃ θE : 𝒪[rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha],
      Irreducible θE ∧
      Algebra.norm (rationalPrimeLocalField p hp)
          (-algebraMap 𝒪[rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha]
            (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha) θE) =
        (a : rationalPrimeLocalField p hp) * p ∧
      Irreducible (algebraMap
        𝒪[rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha]
        𝒪[rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha] θE) := by
  let K := rationalPrimeLocalField p hp
  let E₀ := rationalPrimeChangedAuxiliaryField p hp n u
  let M₀ := rationalPrimeChangedCyclotomicCompositum p hp n u
  let E := rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha
  let M := rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha
  let eE := rationalPrimeChangedAuxiliaryClosureEquiv p hp n a u hu ha
  let eM := rationalPrimeChangedCyclotomicClosureCompositumEquiv p hp n a u hu ha
  obtain ⟨fdE₀, fdM₀, valE₀, topE₀, localE₀, extKE₀,
      valM₀, topM₀, localM₀, extKM₀, extE₀M₀, _⟩ :=
    rationalPrimeChangedCyclotomicWitt_exists_tower_local_structure p hp n a u hu ha
  letI := fdE₀
  letI := fdM₀
  letI := valE₀
  letI := topE₀
  letI := localE₀
  letI := extKE₀
  letI := valM₀
  letI := topM₀
  letI := localM₀
  letI := extKM₀
  letI := extE₀M₀
  obtain ⟨θ₀, hθ₀, _hvalue, hnorm, hθM₀⟩ :=
    rationalPrimeChangedAuxiliary_exists_compositum_integer_uniformizer
      p hp n a u hu ha
  let eOE : 𝒪[E₀] ≃ₐ[𝒪[K]] 𝒪[E] := localFieldIntegerAlgEquiv K E₀ E eE
  let eOM : 𝒪[M₀] ≃ₐ[𝒪[K]] 𝒪[M] := localFieldIntegerAlgEquiv K M₀ M eM
  let θE : 𝒪[E] := eOE θ₀
  have hθE : Irreducible θE :=
    (MulEquiv.irreducible_iff (f := eOE.toMulEquiv)).mpr hθ₀
  have hcoeffE : algebraMap 𝒪[E] E θE = eE (algebraMap 𝒪[E₀] E₀ θ₀) :=
    localFieldIntegerAlgEquiv_coefficient K E₀ E eE θ₀
  have hnormE : Algebra.norm K (-algebraMap 𝒪[E] E θE) = (a : K) * p := by
    calc
      Algebra.norm K (-algebraMap 𝒪[E] E θE) =
          Algebra.norm K (eE (-algebraMap 𝒪[E₀] E₀ θ₀)) := by
        apply congrArg (Algebra.norm K)
        calc
          -algebraMap 𝒪[E] E θE =
              -eE (algebraMap 𝒪[E₀] E₀ θ₀) := congrArg Neg.neg hcoeffE
          _ = eE (-algebraMap 𝒪[E₀] E₀ θ₀) := (map_neg eE _).symm
      _ = Algebra.norm K (-algebraMap 𝒪[E₀] E₀ θ₀) :=
        Algebra.norm_eq_of_algEquiv eE _
      _ = (a : K) * p := hnorm
  have hmap : eOM (algebraMap 𝒪[E₀] 𝒪[M₀] θ₀) =
      algebraMap 𝒪[E] 𝒪[M] θE := by
    exact localFieldIntegerAlgEquiv_algebraMap K E₀ M₀ E M eE eM
      (rationalPrimeChangedCyclotomicClosureCompositumEquiv_auxiliary
        p hp n a u hu ha) θ₀
  have hθM : Irreducible (algebraMap 𝒪[E] 𝒪[M] θE) := by
    rw [← hmap]
    exact (MulEquiv.irreducible_iff (f := eOM.toMulEquiv)).mpr hθM₀
  exact ⟨θE, hθE, hnormE, hθM⟩

/-- The closure auxiliary stage has the transported exact normed uniformizer;
its upstairs irreducibility proves the closure compositum formally unramified. -/
theorem rationalPrimeChangedCyclotomicClosure_exists_integer_uniformizer
    (p : ℕ) (hp : p.Prime) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a)
    [FiniteDimensional (rationalPrimeLocalField p hp)
      (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)]
    [ValuativeRel (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)]
    [TopologicalSpace (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)]
    [IsNonarchimedeanLocalField (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)]
    [(ValuativeRel.valuation (rationalPrimeLocalField p hp)).HasExtension
      (ValuativeRel.valuation (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha))]
    [ValuativeRel (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha)]
    [TopologicalSpace (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha)]
    [IsNonarchimedeanLocalField (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha)]
    [(ValuativeRel.valuation (rationalPrimeLocalField p hp)).HasExtension
      (ValuativeRel.valuation (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha))]
    [(ValuativeRel.valuation (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)).HasExtension
      (ValuativeRel.valuation (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha))] :
    ∃ θE : 𝒪[rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha],
      Irreducible θE ∧
      Algebra.norm (rationalPrimeLocalField p hp)
          (-algebraMap 𝒪[rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha]
            (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha) θE) =
        (a : rationalPrimeLocalField p hp) * p ∧
      Irreducible (algebraMap
        𝒪[rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha]
        𝒪[rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha] θE) ∧
      Algebra.FormallyUnramified
        𝒪[rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha]
        𝒪[rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha] := by
  let E := rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha
  let M := rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha
  obtain ⟨θE, hθE, hnorm, hθM⟩ :=
    rationalPrimeChangedCyclotomicClosure_exists_integer_uniformizer_core
      p hp n a u hu ha
  haveI : Module.Finite 𝒪[E] 𝒪[M] := localField_integer_module_finite
  exact ⟨θE, hθE, hnorm, hθM,
    localField_integer_formallyUnramified_of_irreducible_algebraMap
      E M θE hθE hθM⟩

/-- For the actual odd prime-power closure stages, normalized reciprocity sends the exact changed-uniformizer norm to restricted positive arithmetic Frobenius. -/
theorem rationalPrimeChangedCyclotomicClosure_reciprocity_norm_uniformizer
    (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) (n a : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a) (ha : ¬p ∣ a)
    [FiniteDimensional (rationalPrimeLocalField p hp)
      (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)]
    [ValuativeRel (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)]
    [TopologicalSpace (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)]
    [IsNonarchimedeanLocalField (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)]
    [(ValuativeRel.valuation (rationalPrimeLocalField p hp)).HasExtension
      (ValuativeRel.valuation (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha))]
    [ValuativeRel (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha)]
    [TopologicalSpace (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha)]
    [IsNonarchimedeanLocalField (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha)]
    [(ValuativeRel.valuation (rationalPrimeLocalField p hp)).HasExtension
      (ValuativeRel.valuation (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha))]
    [(ValuativeRel.valuation (rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha)).HasExtension
      (ValuativeRel.valuation (rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha))] :
    let K := rationalPrimeLocalField p hp
    let Ω := rationalPrimeLocalClosure p hp
    let E := rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha
    let L := rationalPrimeOriginalCyclotomicClosureStage p hp n a u hu ha
    let M := rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha
    let j := rationalPrimeOriginalCyclotomicClosureInclusion p hp n a u hu ha
    let algebraLM : Algebra L M := j.toRingHom.toAlgebra
    letI : SMul L M := algebraLM.toSMul
    letI : Algebra L M := algebraLM
    letI : IsScalarTower K L M := IsScalarTower.of_algHom j
    letI : IsScalarTower L M Ω := IsScalarTower.of_algebraMap_eq' rfl
    letI : IsCyclic Gal(L/K) :=
      rationalPrimeOriginalCyclotomicClosureStage_isCyclic p hp hp2 n a u hu ha
    letI : TopologicalSpace (Rep.ofAlgebraAutOnUnits K Ω) := ⊥
    letI : DiscreteTopology (Rep.ofAlgebraAutOnUnits K Ω) := ⟨rfl⟩
    letI : TopologicalSpace (Rep.ofAlgebraAutOnUnits E Ω) := ⊥
    letI : DiscreteTopology (Rep.ofAlgebraAutOnUnits E Ω) := ⟨rfl⟩
    ∃ θE : 𝒪[E], ∃ hθE : Irreducible θE,
      ∃ (_ : Algebra.FormallyUnramified 𝒪[E] 𝒪[M]),
        Algebra.norm K (-algebraMap 𝒪[E] E θE) = (a : K) * p ∧
        (localFieldFiniteCyclicReciprocity K Ω L
          (Additive.ofMul (Units.map (Algebra.norm K (S := E))
            (Units.mk0 (-algebraMap 𝒪[E] E θE)
              (by intro h; exact hθE.ne_zero (Subtype.ext (neg_eq_zero.mp h))))))).toMul =
          galoisBaseChangeRestriction K E L M (localFieldArithmeticFrobenius E M) := by
  let K := rationalPrimeLocalField p hp
  let Ω := rationalPrimeLocalClosure p hp
  let E := rationalPrimeChangedAuxiliaryClosureField p hp n a u hu ha
  let L := rationalPrimeOriginalCyclotomicClosureStage p hp n a u hu ha
  let M := rationalPrimeChangedCyclotomicClosureCompositum p hp n a u hu ha
  let j := rationalPrimeOriginalCyclotomicClosureInclusion p hp n a u hu ha
  let algebraLM : Algebra L M := j.toRingHom.toAlgebra
  letI : SMul L M := algebraLM.toSMul
  letI : Algebra L M := algebraLM
  letI : IsScalarTower K L M := IsScalarTower.of_algHom j
  letI : IsScalarTower L M Ω := IsScalarTower.of_algebraMap_eq' rfl
  letI : IsCyclic Gal(L/K) :=
    rationalPrimeOriginalCyclotomicClosureStage_isCyclic p hp hp2 n a u hu ha
  letI : TopologicalSpace (Rep.ofAlgebraAutOnUnits K Ω) := ⊥
  letI : DiscreteTopology (Rep.ofAlgebraAutOnUnits K Ω) := ⟨rfl⟩
  letI : TopologicalSpace (Rep.ofAlgebraAutOnUnits E Ω) := ⊥
  letI : DiscreteTopology (Rep.ofAlgebraAutOnUnits E Ω) := ⟨rfl⟩
  obtain ⟨θE, hθE, hnorm, _hθM, hunramified⟩ :=
    rationalPrimeChangedCyclotomicClosure_exists_integer_uniformizer p hp n a u hu ha
  letI : Algebra.FormallyUnramified 𝒪[E] 𝒪[M] := hunramified
  have hneg : Irreducible (-θE) := Associated.rfl.neg_left.symm.irreducible hθE
  exact ⟨θE, hθE, hunramified, hnorm,
    localFieldFiniteCyclicReciprocity_norm_uniformizer K Ω E L M (-θE) hneg⟩

