import Dubon2026.OriginalInertiaNormCompletion
import Dubon2026.OriginalLocalCompletionSurjective

/-! Existing completion surjectivity and prime-adic valuation comparison
discharge density and valuation compatibility for an actual local field
generated by the original global field and rational completion. This is
the finite local inertia comparison required to descend Dubon Theorem
2.6's auxiliary deformation quotient to the original support. -/

namespace Dubon2026
noncomputable section
open IsDedekindDomain
open scoped NumberField ValuativeRel

variable (F L : Type) [Field F] [NumberField F] [NormedField L] [Algebra F L]
  (p : ℕ) (hp : p.Prime) [Algebra (rationalPrimeLocalField p hp) L]
  [ValuativeRel L] [IsNonarchimedeanLocalField L]
  [(ValuativeRel.valuation (rationalPrimeLocalField p hp)).HasExtension (ValuativeRel.valuation L)]

/-- The original global field is dense in the actual local field it
generates with the rational completion. -/
theorem originalGeneratedLocalField_dense
    (hgen : (algebraMap (rationalPrimeLocalField p hp) L).fieldRange ⊔
      (algebraMap F L).fieldRange = ⊤) : DenseRange (algebraMap F L) := by
  let w := originalLocalEmbeddingPrime F L p hp
  have hd := (originalLocalCompletionMap_surjective F L p hp hgen).denseRange.comp
    (w.denseRange_algebraMap F) (originalLocalCompletionMap_continuous F L p hp)
  have he : (originalLocalCompletionMap F L p hp) ∘ (algebraMap F (w.adicCompletion F)) =
      algebraMap F L := funext (originalLocalCompletionMap_algebraMap F L p hp)
  rw [he] at hd
  exact hd

/-- Original inertia at the actual induced global prime acts trivially
on the residue field of the same generated local field. Density and the
valuation comparison follow from existing original constructions. -/
theorem originalGeneratedLocalField_inertia_mem_normInertia
    {K : Type} [NontriviallyNormedField K] [NormedAlgebra K L]
    [IsUltrametricDist K] [IsUltrametricDist L] [CompleteSpace K] [IsGalois K L]
    [(NormedField.valuation (K := L)).Compatible]
    (hgen : (algebraMap (rationalPrimeLocalField p hp) L).fieldRange ⊔
      (algebraMap F L).fieldRange = ⊤)
    (σ : Gal(F/ℚ))
    (hσ : σ ∈ (originalLocalEmbeddingPrime F L p hp).asIdeal.inertia Gal(F/ℚ))
    (g : Gal(L/K)) (he : ∀ x, g (algebraMap F L x) = algebraMap F L (σ x)) :
    g ∈ algebraicLocalInertia K L := by
  have hv : ((originalLocalEmbeddingPrime F L p hp).valuation F).IsEquiv
      ((NormedField.valuation (K := L)).comap (algebraMap F L)) := by
    apply (Valuation.isEquiv_iff_valuationSubring _ _).mpr
    ext x
    change (originalLocalEmbeddingPrime F L p hp).valuation F x ≤ 1 ↔
      NormedField.valuation (algebraMap F L x) ≤ 1
    rw [(originalLocalEmbeddingPrime_valuation_isEquiv F L p hp).le_one_iff_le_one]
    change ValuativeRel.valuation L (algebraMap F L x) ≤ 1 ↔
      NormedField.valuation (algebraMap F L x) ≤ 1
    rw [← (ValuativeRel.valuation L).vle_one_iff, ← (NormedField.valuation (K := L)).vle_one_iff]
  exact originalInertia_mem_normInertia_of_dense_embedding
    (originalLocalEmbeddingPrime F L p hp) (algebraMap F L)
    (originalGeneratedLocalField_dense F L p hp hgen) hv σ hσ g he

end
end Dubon2026
