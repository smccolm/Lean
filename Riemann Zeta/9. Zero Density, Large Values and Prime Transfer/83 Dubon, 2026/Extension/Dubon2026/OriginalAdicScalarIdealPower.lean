import Dubon2026.OriginalAdicUniformizerOrder
import Mathlib.RingTheory.Ideal.Norm.AbsNorm

/-! # Original scalar ideals in finite completions

The original adic valuation identifies the ideal generated by an integer
with the matching power of the actual completion maximal ideal. This is
the remaining scalar-quotient input to DUB-17's finite-place power index.
-/

namespace Dubon2026
noncomputable section
open NumberField IsDedekindDomain
open scoped NumberField WithZero

variable (K : Type) [Field K] [NumberField K] (v : HeightOneSpectrum (𝓞 K))

/-- The valuation of the original scalar in the actual completion is the
exact original prime-ideal multiplicity. -/
theorem originalAdic_natCast_valuation (n : ℕ) (hn : n ≠ 0) :
    Valued.v (n : v.adicCompletion K) =
      WithZero.exp (-(multiplicity v.asIdeal (Ideal.span {(n : 𝓞 K)}) : ℤ)) := by
  calc
    Valued.v (n : v.adicCompletion K) = v.valuation K (n : K) := by
      simpa using
        (HeightOneSpectrum.valuedAdicCompletion_eq_valuation (v := v) (n : 𝓞 K))
    _ = v.intValuation (n : 𝓞 K) := by
      simpa only [map_natCast] using v.valuation_of_algebraMap (K := K) (n : 𝓞 K)
    _ = _ := v.intValuation_eq_exp_neg_multiplicity (Nat.cast_ne_zero.mpr hn)

/-- The original integer scalar generates precisely the matching maximal
ideal power in the actual adic completion integer ring. -/
theorem originalAdic_natCast_span_eq_maximalIdeal_pow (n : ℕ) (hn : n ≠ 0) :
    (Ideal.span {(n : v.adicCompletionIntegers K)} : Ideal (v.adicCompletionIntegers K)) =
      (IsLocalRing.maximalIdeal (v.adicCompletionIntegers K) ^
        multiplicity v.asIdeal (Ideal.span {(n : 𝓞 K)}) : Ideal (v.adicCompletionIntegers K)) := by
  let F := v.adicCompletion K
  let O := v.adicCompletionIntegers K
  obtain ⟨a, ha⟩ := v.valuedAdicCompletion_surjective K (WithZero.exp (-1 : ℤ))
  let q : O := ⟨a, by
    change Valued.v a ≤ 1
    rw [ha]
    exact le_of_lt (by decide : (WithZero.exp (-1 : ℤ) : ℤᵐ⁰) < 1)⟩
  have hq : Irreducible q := originalAdicInteger_irreducible_of_uniformizer K v q ha
  let m := multiplicity v.asIdeal (Ideal.span {(n : 𝓞 K)})
  have hval : Valued.v (n : F) = (Valued.v (q : F)) ^ m := by
    rw [originalAdic_natCast_valuation K v n hn, show Valued.v (q : F) = WithZero.exp (-1 : ℤ) from ha,
      ← WithZero.exp_nsmul]
    congr 1
    simp only [nsmul_eq_mul, mul_neg, mul_one, m]
  let hv := Valuation.valuationSubring.integers (Valued.v : Valuation F ℤᵐ⁰)
  apply SetLike.coe_injective
  have hs := hv.coe_span_singleton_eq_setOf_le_v_algebraMap (n : O)
  have hp := hv.maximalIdeal_pow_eq_setOf_le_v_algebraMap_pow hq m
  exact hs.trans ((show
    {y : O | Valued.v (y : F) ≤ Valued.v (n : F)} =
      {y : O | Valued.v (y : F) ≤ Valued.v (q : F) ^ m} by rw [hval]).trans hp.symm)


end
end Dubon2026
