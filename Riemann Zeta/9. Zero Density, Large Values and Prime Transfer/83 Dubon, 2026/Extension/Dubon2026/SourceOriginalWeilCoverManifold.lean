import Dubon2026.SourceOriginalWeilCoverChartTransitions
import Mathlib.Geometry.Manifold.IsManifold.Basic

/-! DUB-17/18 -> auxiliary cover Abel comparison -> native analytic manifold.
Build the topology and analytic atlas from the proved actual cover charts.
This reuses the original ChartedSpaceCore proof, adapted there from
anthropics/fermats-last-theorem, Apache-2.0, commit
6e837e75355538c7f80bab5b956861e86c4eacc2,
S_AlgebraicCurve_Place_exists_chartedSpace_meromorphicOrderAt_evalAt_eq_ord_complex.
Compactness and connectedness are still separate obligations. -/
namespace Dubon2026.SourceFunctionField.OriginalWeilCoverChart
noncomputable section
open SourceCurve Polynomial Set
open scoped Manifold ContDiff Topology
variable (N : ℕ) [NeZero N] (n : ℕ) [NeZero n]
variable (f : modularFunctionFieldOver N ℂ)
local notation "FF" => modularFunctionFieldOver N ℂ
local notation "EE" => Polynomial.SplittingField (X ^ n - C f : FF[X])
variable (D : Divisor ℂ (modularFunctionFieldOver N ℂ)) (hf : f ≠ 0)
variable (hfD : ∀ v : Place ℂ (modularFunctionFieldOver N ℂ), v.ord f = (n : ℤ) * D v)
include D hf hfD

theorem placeChart_self (v : Place ℂ EE) : placeChart N n f D hf hfD v v = 0 := by
  have h := place_eval_uniformizer N n f D hf hfD v (Metric.mem_ball_self (place_spec N n f D hf hfD v).1)
  simp only [(place_spec N n f D hf hfD v).2.1] at h
  exact h

/-- The native chart core made from every actual cover place parameter. -/
def placeCore : ChartedSpaceCore ℂ (Place ℂ EE) where
  atlas := range (placeChart N n f D hf hfD)
  chartAt := placeChart N n f D hf hfD
  mem_chart_source := mem_placeChart_source N n f D hf hfD
  chart_mem_atlas v := ⟨v, rfl⟩
  open_source := by
    rintro _ _ ⟨v, rfl⟩ ⟨w, rfl⟩
    exact isOpen_placeChart_trans_source N n f D hf hfD v w
  continuousOn_toFun := by
    rintro _ _ ⟨v, rfl⟩ ⟨w, rfl⟩
    exact (analyticOnNhd_placeChart_transition N n f D hf hfD v w).continuousOn

/-- The topology generated by the actual cover uniformizer charts. -/
abbrev placeTopology : TopologicalSpace (Place ℂ EE) :=
  (placeCore N n f D hf hfD).toTopologicalSpace

/-- The native charted-space structure on the actual cover places. -/
abbrev placeChartedSpace : @ChartedSpace ℂ _ (Place ℂ EE) (placeTopology N n f D hf hfD) :=
  (placeCore N n f D hf hfD).toChartedSpace

theorem mem_place_atlas_iff
    (e : @OpenPartialHomeomorph (Place ℂ EE) ℂ (placeTopology N n f D hf hfD) _) :
    (letI := placeTopology N n f D hf hfD; letI := placeChartedSpace N n f D hf hfD;
      e ∈ atlas ℂ (Place ℂ EE)) ↔
      ∃ v, e = (placeCore N n f D hf hfD).openPartialHomeomorph (placeChart N n f D hf hfD v) ⟨v, rfl⟩ := by
  letI := placeTopology N n f D hf hfD
  letI := placeChartedSpace N n f D hf hfD
  change e ∈ ⋃ (e : PartialEquiv (Place ℂ EE) ℂ)
    (he : e ∈ (placeCore N n f D hf hfD).atlas), {(placeCore N n f D hf hfD).openPartialHomeomorph e he} ↔ _
  simp only [mem_iUnion, mem_singleton_iff]
  constructor
  · rintro ⟨_, ⟨v, rfl⟩, rfl⟩
    exact ⟨v, rfl⟩
  · rintro ⟨v, rfl⟩
    exact ⟨_, ⟨v, rfl⟩, rfl⟩

theorem place_isManifold :
    letI := placeTopology N n f D hf hfD
    letI := placeChartedSpace N n f D hf hfD
    IsManifold 𝓘(ℂ, ℂ) ω (Place ℂ EE) := by
  letI := placeTopology N n f D hf hfD
  letI := placeChartedSpace N n f D hf hfD
  refine isManifold_of_contDiffOn 𝓘(ℂ, ℂ) ω (Place ℂ EE)
    fun e e' he he' => ?_
  obtain ⟨v, rfl⟩ := (mem_place_atlas_iff N n f D hf hfD e).mp he
  obtain ⟨w, rfl⟩ := (mem_place_atlas_iff N n f D hf hfD e').mp he'
  simp only [modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm, Function.comp_id,
    Function.id_comp, range_id, inter_univ, preimage_id_eq, id]
  exact (analyticOnNhd_placeChart_transition N n f D hf hfD v w).contDiffOn_of_completeSpace

end
end Dubon2026.SourceFunctionField.OriginalWeilCoverChart
