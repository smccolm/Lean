import Dubon2026.ArithmeticUnitH2BaseChange
import Dubon2026.ArithmeticFiniteLocalCyclicity
import Dubon2026.LocalFieldBaseChangedCarryInvariant

/-! # The normalized invariant of the original arithmetic finite carry

The actual arithmetic restriction factors through the local compositum
already generated by the exact arithmetic embedding. Its cyclicity is
derived from the original finite cyclic global stage. This supplies the
literal local character pairing required before DUB-17's principal-product
argument can discharge the arithmetic invariant-sum obligation.
-/
namespace Dubon2026
noncomputable section
open scoped NumberField
attribute [-instance] UniformSpace.Completion.instSMul SubfieldClass.instSMulRat
  DivisionRing.toRatAlgebra AlgebraicClosure.instSMulOfIsScalarTower
attribute [local instance] arithmeticKummerStageAlgebra arithmeticKummerStageGalois
  arithmeticKummerStageTopology arithmeticKummerStageDiscrete arithmeticGlobalUnitContinuousSMul
  arithmeticUnitBaseChangePrimeModule arithmeticUnitBaseChangeAlgebra
  arithmeticUnitBaseChangeSMul arithmeticUnitBaseChangeTower
  arithmeticFiniteLocalStageGalois arithmeticFiniteLocalStageRationalAlgebra

variable (a : 𝓞 ℚ) (F : FiniteGaloisIntermediateField ℚ (rationalUnramifiedExtension a))

/-- Use the original finite intermediate field's native rational algebra. -/
local instance arithmeticFiniteCarryGlobalAlgebra : Algebra ℚ F := F.toIntermediateField.algebra'

variable [IsCyclic Gal(F/ℚ)] (p : ℕ) (hp : p.Prime)

/-- Use the literal finite arithmetic embedding in its original local closure. -/
local instance arithmeticFiniteCarryClosureAlgebra : Algebra F (rationalPrimeLocalClosure p hp) :=
  (rationalArithmeticFiniteLocalEmbedding a F p hp).toAlgebra

/-- Use the same embedding with codomain in its actual finite local compositum. -/
local instance arithmeticFiniteCarryStageAlgebra : Algebra F (rationalArithmeticFiniteLocalStage a F p hp) :=
  (rationalArithmeticFiniteLocalStageInclusion a F p hp).toAlgebra

/-- Retain the scalar action of the original finite inclusion into its union. -/
local instance arithmeticFiniteCarryUnionSMul : SMul F (rationalUnramifiedExtension a) :=
  (inferInstance : Algebra F (rationalUnramifiedExtension a)).toSMul

/-- Retain the scalar action of the exact finite embedding in the local closure. -/
local instance arithmeticFiniteCarryClosureSMul : SMul F (rationalPrimeLocalClosure p hp) :=
  (arithmeticFiniteCarryClosureAlgebra a F p hp).toSMul

/-- Retain the scalar action of the exact finite local embedding. -/
local instance arithmeticFiniteCarryStageSMul : SMul F (rationalArithmeticFiniteLocalStage a F p hp) :=
  (arithmeticFiniteCarryStageAlgebra a F p hp).toSMul

/-- The original rational algebra of the local compositum factors through its actual prime completion. -/
local instance arithmeticFiniteCarryLocalBaseTower :
    IsScalarTower ℚ (rationalPrimeLocalField p hp) (rationalArithmeticFiniteLocalStage a F p hp) := by
  apply IsScalarTower.of_algebraMap_eq
  intro r
  apply Subtype.ext
  exact IsScalarTower.algebraMap_apply ℚ (rationalPrimeLocalField p hp) (rationalPrimeLocalClosure p hp) r

/-- The original finite arithmetic embedding preserves rational scalars. -/
local instance arithmeticFiniteCarryClosureTower : IsScalarTower ℚ F (rationalPrimeLocalClosure p hp) :=
  IsScalarTower.of_algHom (rationalArithmeticFiniteLocalEmbedding a F p hp)

/-- Its actual codomain restriction preserves rational scalars. -/
local instance arithmeticFiniteCarryStageTower :
    IsScalarTower ℚ F (rationalArithmeticFiniteLocalStage a F p hp) :=
  IsScalarTower.of_algHom (rationalArithmeticFiniteLocalStageInclusion a F p hp)

/-- Passing through the original unramified union retains the exact finite arithmetic embedding. -/
local instance arithmeticFiniteCarryUnionTower :
    IsScalarTower F (rationalUnramifiedExtension a) (rationalPrimeLocalClosure p hp) :=
  IsScalarTower.of_algebraMap_eq' rfl

/-- Passing through the actual local compositum retains that same embedding. -/
local instance arithmeticFiniteCarryLocalTower :
    IsScalarTower F (rationalArithmeticFiniteLocalStage a F p hp) (rationalPrimeLocalClosure p hp) :=
  IsScalarTower.of_algebraMap_eq' rfl

/-- Cyclicity of the same local stage follows from the proved injection into the global stage. -/
local instance arithmeticFiniteCarryLocalCyclic [IsCyclic Gal(F/ℚ)] :
    IsCyclic Gal(rationalArithmeticFiniteLocalStage a F p hp / rationalPrimeLocalField p hp) :=
by
  let A₀ : Algebra ℚ F := inferInstance
  have h₀ : letI := A₀; IsCyclic Gal(F/ℚ) := inferInstance
  have hc : ∀ A : Algebra ℚ F, letI := A; IsCyclic Gal(F/ℚ) := by
    intro A
    have hA : A = A₀ := Subsingleton.elim _ _
    cases hA
    exact h₀
  exact @rationalArithmeticFiniteLocalStage_isCyclic a F (hc _) p hp

/-- Use the same discrete finite-stage unit coefficients as finite inflation. -/
local instance arithmeticFiniteCarryTopology : TopologicalSpace (Rep.ofAlgebraAutOnUnits ℚ F) := ⊥

/-- Those original finite-stage unit coefficients are discrete. -/
local instance arithmeticFiniteCarryDiscrete : DiscreteTopology (Rep.ofAlgebraAutOnUnits ℚ F) := ⟨rfl⟩

variable [TopologicalSpace (rationalArithmeticUnitRepresentation a)]
  [DiscreteTopology (rationalArithmeticUnitRepresentation a)]
  [TopologicalSpace (Rep.ofAlgebraAutOnUnits (rationalPrimeLocalField p hp) (rationalPrimeLocalClosure p hp))]
  [DiscreteTopology (Rep.ofAlgebraAutOnUnits (rationalPrimeLocalField p hp) (rationalPrimeLocalClosure p hp))]

omit [IsCyclic Gal(F/ℚ)] in
/-- Original arithmetic restriction of finite inflation is literal base change of the same original class. -/
theorem rationalArithmeticUnitH2Restriction_finiteStage
    (x : GaloisUnitH2FiniteStage ℚ (rationalUnramifiedExtension a) F) :
    rationalArithmeticUnitH2Restriction a p hp (galoisUnitFiniteStageH2Inflation F x) =
      continuousGaloisUnitBaseChangeH2 ℚ (rationalPrimeLocalField p hp) F
        (rationalPrimeLocalClosure p hp) x := by
  have hres := @rationalArithmeticUnitH2Restriction_eq_baseChange a p hp
    (inferInstanceAs (TopologicalSpace (rationalArithmeticUnitRepresentation a)))
    (inferInstanceAs (DiscreteTopology (rationalArithmeticUnitRepresentation a)))
    (inferInstanceAs (TopologicalSpace (Rep.ofAlgebraAutOnUnits (rationalPrimeLocalField p hp) (rationalPrimeLocalClosure p hp))))
    (inferInstanceAs (DiscreteTopology (Rep.ofAlgebraAutOnUnits (rationalPrimeLocalField p hp) (rationalPrimeLocalClosure p hp))))
    (galoisUnitFiniteStageH2Inflation F x)
  apply hres.trans
  have h := continuousGaloisUnitBaseChangeH2_eq_finiteStage ℚ (rationalUnramifiedExtension a) F x
  exact (congrArg (continuousGaloisUnitBaseChangeH2 ℚ (rationalPrimeLocalField p hp)
    (rationalUnramifiedExtension a) (rationalPrimeLocalClosure p hp)) h.symm).trans
      (continuousGaloisUnitBaseChangeH2_comp ℚ ℚ (rationalPrimeLocalField p hp) F
        (rationalUnramifiedExtension a) (rationalPrimeLocalClosure p hp) x)

/-- The actual arithmetic local invariant of an inflated original finite carry class is the character of original normalized local reciprocity in its constructed local compositum. -/
theorem rationalArithmeticFiniteCarryInvariant
    {n : ℕ} [NeZero n] (χ : Gal(F/ℚ) →* Multiplicative (ZMod n)) (u : ℚˣ) :
    localFieldContinuousH2InvariantEquiv (rationalPrimeLocalField p hp) (rationalPrimeLocalClosure p hp)
      (rationalArithmeticUnitH2Restriction a p hp
        (galoisUnitFiniteStageH2Inflation F
          (Submodule.Quotient.mk (galoisUnitCharacterCarryCocycle χ u)))) =
      rationalCyclicInvariant n
        (χ (rationalArithmeticFiniteLocalRestriction a F p hp
          (localFieldFiniteCyclicReciprocity (rationalPrimeLocalField p hp) (rationalPrimeLocalClosure p hp)
            (rationalArithmeticFiniteLocalStage a F p hp)
            (Additive.ofMul (Units.map (algebraMap ℚ (rationalPrimeLocalField p hp)).toMonoidHom u))).toMul)).toAdd := by
  rw [rationalArithmeticUnitH2Restriction_finiteStage]
  have hpair := localFieldBaseChangedCarryInvariant ℚ (rationalPrimeLocalField p hp) F
    (rationalPrimeLocalClosure p hp) (rationalArithmeticFiniteLocalStage a F p hp) χ u
  exact hpair

end
end Dubon2026
