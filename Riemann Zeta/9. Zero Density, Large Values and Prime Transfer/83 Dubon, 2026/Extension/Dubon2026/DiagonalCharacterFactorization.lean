import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs

/-! # Actual diagonal representations are families of unit-valued characters

Frobenius and tame inertia generation reduce the whole auxiliary local
deformation to these actual characters, on the dependency chain to
Dubon Theorem 2.6.
-/

namespace Dubon2026
noncomputable section
open Matrix

variable {A ι G : Type} [CommRing A] [Fintype ι] [DecidableEq ι] [Group G]

/-- An invertible matrix lies in the actual unit-diagonal subgroup exactly
when its underlying matrix equals its own diagonal. -/
theorem generalLinearGroup_mem_diagonal_range (g : GeneralLinearGroup ι A) :
    g ∈ (Units.map (diagonalRingHom ι A).toMonoidHom).range ↔
      g.val = diagonal (fun i => g.val i i) := by
  constructor
  · rintro ⟨u, rfl⟩
    simp
  · intro h
    have hu : IsUnit (fun i => g.val i i) := by
      rw [← isUnit_diagonal, ← h]
      exact g.isUnit
    obtain ⟨u, hu⟩ := hu
    refine ⟨u, ?_⟩
    apply Units.ext
    change diagonal u.val = g.val
    rw [hu, ← h]

/-- A group generated by inertia and Frobenius has diagonal representation
image once the actual inertia image is generated by a diagonal matrix and
the same Frobenius matrix is diagonal. -/
theorem inertia_frobenius_diagonal_image
    (I : Subgroup G) (φ t : G) (hgen : I ⊔ Subgroup.zpowers φ = ⊤)
    (ρ : G →* GeneralLinearGroup ι A)
    (hI : I.map ρ = Subgroup.zpowers (ρ t))
    (hφ : (ρ φ).val = diagonal (fun i => (ρ φ).val i i))
    (ht : (ρ t).val = diagonal (fun i => (ρ t).val i i)) :
    ∀ g, (ρ g).val = diagonal (fun i => (ρ g).val i i) := by
  let D := (Units.map (diagonalRingHom ι A).toMonoidHom).range
  have hIt : I ≤ D.comap ρ := by
    apply Subgroup.map_le_iff_le_comap.mp
    rw [hI]
    exact Subgroup.zpowers_le.mpr ((generalLinearGroup_mem_diagonal_range _).mpr ht)
  have hφt : Subgroup.zpowers φ ≤ D.comap ρ :=
    Subgroup.zpowers_le.mpr ((generalLinearGroup_mem_diagonal_range _).mpr hφ)
  have htop : ⊤ ≤ D.comap ρ := hgen ▸ sup_le hIt hφt
  intro g
  exact (generalLinearGroup_mem_diagonal_range _).mp (htop (Subgroup.mem_top g))

/-- A representation with actual diagonal image factors through the group
of unit-valued coordinate functions, as a genuine homomorphism. -/
theorem diagonal_representation_exists_characters
    (ρ : G →* GeneralLinearGroup ι A)
    (hρ : ∀ g, (ρ g).val = diagonal (fun i => (ρ g).val i i)) :
    ∃ χ : G →* (ι → A)ˣ, ∀ g, diagonal (χ g).val = (ρ g).val := by
  let D := Units.map (diagonalRingHom ι A).toMonoidHom
  have hD : Function.Injective D := by
    intro x y h
    apply Units.ext
    funext i
    have hi := congrArg (fun M : GeneralLinearGroup ι A => M.val i i) h
    simpa [D] using hi
  have hm (g : G) : ρ g ∈ D.range := (generalLinearGroup_mem_diagonal_range _).mpr (hρ g)
  let χ := (MonoidHom.ofInjective hD).symm.toMonoidHom.comp (ρ.codRestrict D.range hm)
  refine ⟨χ, fun g => ?_⟩
  have h := MonoidHom.apply_ofInjective_symm hD (⟨ρ g, hm g⟩ : D.range)
  exact congrArg Units.val h

end
end Dubon2026
