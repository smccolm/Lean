import Dubon2026.SourceRadialWordPeriodMatrix

/-! DUB-17/18 -> original Abel-Jacobi -> jump-to-period generation.
The exact complementary-edge jump generators and their integer period rows
put every jump in the subgroup generated by the same complementary periods.
The actual analytic loop consumer below supplies both hypotheses.
-/
namespace Dubon2026.SourceFunctionField.CellGeometry.RadialDissectionPeriods
noncomputable section
open Set
variable {X : Type*} [TopologicalSpace X] {κ : Type*}

theorem closure_generated_jumps_le_periods (D : RadialCellDissection X) (T Ts : Finset D.ιE)
    (J z : D.ιE → κ → ℂ) (P : D.ιE → D.ιE → ℤ)
    (hgen : AddSubgroup.closure (range J) ≤ AddSubgroup.closure (J '' ((T ∪ Ts)ᶜ : Finset D.ιE)))
    (hrow : ∀ j ∉ Ts, J j = -∑ l ∈ (T ∪ Ts)ᶜ, (P j l : ℂ) • z l) :
    AddSubgroup.closure (range J) ≤ AddSubgroup.closure (z '' ((T ∪ Ts)ᶜ : Finset D.ιE)) := by
  classical
  refine hgen.trans ?_
  rw [AddSubgroup.closure_le]
  rintro _ ⟨j, hj, rfl⟩
  have hj' : j ∉ Ts := by
    have hh : j ∈ (T ∪ Ts)ᶜ := hj
    exact fun h => (Finset.mem_compl.mp hh) (Finset.mem_union_right T h)
  simp only [hrow j hj', Int.cast_smul_eq_zsmul]
  refine AddSubgroup.neg_mem _ (AddSubgroup.sum_mem _ fun l hl => ?_)
  have hm : z l ∈ z '' ((T ∪ Ts)ᶜ : Finset D.ιE) := ⟨l, hl, rfl⟩
  exact AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure hm) _

end
end Dubon2026.SourceFunctionField.CellGeometry.RadialDissectionPeriods
