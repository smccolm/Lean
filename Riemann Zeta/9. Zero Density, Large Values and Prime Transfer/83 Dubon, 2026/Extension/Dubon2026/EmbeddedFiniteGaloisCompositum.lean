import Dubon2026.FiniteGaloisCompositumOverIntermediate

/-! # The actual local compositum of an embedded finite Galois field

The local base is the original completion, with its existing field structure.
The original arithmetic embedding supplies the other generators. A splitting
polynomial constructs finiteness and Galoisness for the DUB-17 support route.
-/

namespace Dubon2026
noncomputable section

variable {R K L Ω : Type} [Field R] [Field K] [Field L] [Field Ω]
  [Algebra R K] [Algebra R L] [Algebra K Ω] [Algebra R Ω] [IsScalarTower R K Ω]
  [FiniteDimensional R L] [IsGalois R L]

/-- A genuine separable splitting polynomial generates the literal field
obtained by adjoining the original embedded finite Galois field to the actual
local base. The base need not be finite over the original global field. -/
theorem embeddedFiniteGaloisCompositum_splitting_polynomial (i : L →ₐ[R] Ω) :
    ∃ q : Polynomial K, q.Separable ∧
      q.IsSplittingField K (IntermediateField.adjoin K (Set.range i)) := by
  obtain ⟨p, hp, hsplit⟩ := IsGalois.is_separable_splitting_field R L
  letI := hsplit
  let q := p.map (algebraMap R K)
  have hroots : q.rootSet Ω = p.rootSet Ω := by
    simp [q, Set.ext_iff, Polynomial.mem_rootSet']
  have hgen : Algebra.adjoin R (p.rootSet Ω) = i.range :=
    Polynomial.IsSplittingField.adjoin_rootSet_eq_range L p i
  have hadjoin : IntermediateField.adjoin K (Set.range i) =
      IntermediateField.adjoin K (q.rootSet Ω) := by
    apply le_antisymm
    · apply IntermediateField.adjoin_le_iff.mpr
      intro x hx
      have hxgen : x ∈ Algebra.adjoin R (p.rootSet Ω) := hgen ▸ hx
      have hsub : Algebra.adjoin R (p.rootSet Ω) ≤
          ((IntermediateField.adjoin K (q.rootSet Ω)).restrictScalars R).toSubalgebra := by
        apply Algebra.adjoin_le
        intro y hy
        exact IntermediateField.subset_adjoin K (q.rootSet Ω) (hroots.symm ▸ hy)
      exact hsub hxgen
    · apply IntermediateField.adjoin_le_iff.mpr
      intro x hx
      have hxrange : x ∈ i.range := hgen ▸ Algebra.subset_adjoin (hroots ▸ hx)
      exact IntermediateField.subset_adjoin K (Set.range i) hxrange
  refine ⟨q, hp.map, ?_⟩
  rw [hadjoin]
  apply IntermediateField.adjoin_rootSet_isSplittingField
  dsimp only [q]
  rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
  exact Polynomial.Splits.of_algHom hsplit.splits' i

/-- The original field generated by the actual embedded arithmetic stage is
an actual finite Galois stage over the same original local base. -/
def embeddedFiniteGaloisCompositum (i : L →ₐ[R] Ω) : FiniteGaloisIntermediateField K Ω where
  toIntermediateField := IntermediateField.adjoin K (Set.range i)
  finiteDimensional := by
    obtain ⟨q, _hq, hsplit⟩ := embeddedFiniteGaloisCompositum_splitting_polynomial (K := K) i
    letI := hsplit
    exact Polynomial.IsSplittingField.finiteDimensional _ q
  isGalois := by
    obtain ⟨q, hq, hsplit⟩ := embeddedFiniteGaloisCompositum_splitting_polynomial (K := K) i
    letI := hsplit
    exact IsGalois.of_separable_splitting_field hq

end
end Dubon2026
