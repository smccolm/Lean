import Dubon2026.OriginalAugmentationConnectingKernel
import Mathlib.LinearAlgebra.Isomorphisms
import Mathlib.Data.ZMod.QuotientRing

/-! # The actual augmentation ideal's first subgroup cohomology order

The genuine connecting map identifies H1 with the integers modulo the
subgroup order. This discharges the finite-order input in DUB-17's
fundamental-class splitting-coefficient argument, retaining the literal
augmentation ideal and every actual subgroup.
-/
namespace Dubon2026
noncomputable section
open CategoryTheory

variable {G : Type} [Group G] [Finite G] (S : Subgroup G) [Fintype S]

/-- The actual connecting kernel is the principal ideal generated by subgroup order. -/
theorem originalAugmentationConnecting_kernel :
    (originalAugmentationConnecting S).ker = Ideal.span {(Fintype.card S : ℤ)} := by
  ext z
  rw [LinearMap.mem_ker, originalAugmentationConnecting_eq_zero_iff,
    Ideal.mem_span_singleton]
  exact ⟨fun ⟨w, hw⟩ => ⟨w, hw.symm⟩, fun ⟨w, hw⟩ => ⟨w, hw.symm⟩⟩

/-- The actual integral augmentation ideal has H1 cardinality equal to the order of the original subgroup. -/
theorem originalAugmentationSubgroup_first_card :
    Nat.card (groupCohomology (Rep.res S.subtype (originalAugmentationIdeal ℤ G)) 1) =
      Fintype.card S := by
  rw [← Nat.card_congr ((originalAugmentationConnecting S).quotKerEquivOfSurjective
    (originalAugmentationConnecting_surjective S)).toEquiv]
  rw [originalAugmentationConnecting_kernel]
  exact (Nat.card_congr (Int.quotientSpanNatEquivZMod (Fintype.card S)).toEquiv).trans
    (Nat.card_zmod (Fintype.card S))

end
end Dubon2026
