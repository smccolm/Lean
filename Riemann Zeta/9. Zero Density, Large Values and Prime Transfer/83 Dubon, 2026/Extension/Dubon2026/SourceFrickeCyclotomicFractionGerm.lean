import Dubon2026.SourceFrickeCyclotomicLaurent
import Dubon2026.SourceCuspLaurentFractionIdentity
import Dubon2026.SourceFrickeLevelAlgebraV3
import Dubon2026.SourceLaurentEuler

/-! DUB-17/18 -> actual Gamma1 cusp realization -> rational Fourier
structure -> descent of actual Fricke fractions. Every element of the
original cyclotomic algebra generated by j and the Fricke functions has
a proved cyclotomic Laurent representation. The same holds for a
holomorphic numerator/denominator identity, with nonzero denominator
proved nonzero in the Laurent field. -/
namespace Dubon2026.SourceFricke
noncomputable section
open UpperHalfPlane ModularForm SlashInvariantFormClass ModularFormClass SourceFunctionField
open scoped Manifold ModularForm MatrixGroups

/-- The original j/Fricke algebra with coefficients in the actual cyclotomic field. -/
def cyclotomicLevelRing (N : ℕ) : Subalgebra (kN N) (ℍ → ℂ) :=
  Algebra.adjoin (kN N) (levelGen N)

theorem periodic_jf_width (N : ℕ) :
    Function.Periodic (JMultiplicity.jf ∘ ofComplex) N := by
  have h4 : Function.Periodic (⇑E₄ ∘ ofComplex) N := by
    simpa using (periodic_comp_ofComplex E₄ one_mem_strictPeriods_SL).nat_mul N
  have hd := periodic_discriminant_width N
  intro z
  have h4z := h4 z
  have hdz := hd z
  simp only [Function.comp_apply, CuspForm.coe_discriminant] at h4z hdz
  simp only [Function.comp_apply, JMultiplicity.jf, h4z, hdz]

theorem cyclotomicLevelRing_holomorphic {N : ℕ} [NeZero N] {f : ℍ → ℂ}
    (hf : f ∈ cyclotomicLevelRing N) : MDiff f := by
  induction hf using Algebra.adjoin_induction with
  | mem f hf => exact levelGen_subset_HolFn N hf
  | algebraMap c => exact mdifferentiable_const
  | add x y _ _ hx hy => exact hx.add hy
  | mul x y _ _ hx hy => exact hx.mul hy

theorem cyclotomicLevelRing_periodic {N : ℕ} [NeZero N] {f : ℍ → ℂ}
    (hf : f ∈ cyclotomicLevelRing N) : Function.Periodic (f ∘ ofComplex) N := by
  induction hf using Algebra.adjoin_induction with
  | mem f hf =>
    rcases hf with rfl | ⟨i, rfl⟩
    · exact periodic_jf_width N
    · exact periodic_frickeF i
  | algebraMap c => intro z; rfl
  | add x y _ _ hx hy => exact hx.add hy
  | mul x y _ _ hx hy => exact hx.mul hy

theorem exists_cyclotomic_cusp_represents {N : ℕ} [NeZero N] {f : ℍ → ℂ}
    (hf : f ∈ cyclotomicLevelRing N) :
    ∃ A : LaurentSeries (kN N),
      CuspTaylor.Represents (coeffMap (algebraMap (kN N) ℂ) A) (cuspFunction N f) := by
  induction hf using Algebra.adjoin_induction with
  | mem f hf =>
    rcases hf with rfl | ⟨i, rfl⟩
    · exact ⟨jqNModC (kN N) N, by rw [coeffMap_jqNModC_kN]; exact represents_jqNModC N⟩
    · exact ⟨frickeLaurentK N i, represents_frickeLaurentK N i⟩
  | algebraMap c =>
    refine ⟨algebraMap (kN N) (LaurentSeries (kN N)) c, ?_⟩
    have hc : coeffMap (algebraMap (kN N) ℂ)
        (algebraMap (kN N) (LaurentSeries (kN N)) c) =
        algebraMap ℂ (LaurentSeries ℂ) (c : ℂ) := by
      rw [SourceDifferential.algebraMap_laurentSeries_apply_alt,
        SourceDifferential.algebraMap_laurentSeries_apply_alt, coeffMap_single]
      rfl
    rw [hc]
    exact CuspTaylor.represents_cusp_const N (c : ℂ)
  | add x y _ _ hx hy =>
    obtain ⟨A, hA⟩ := hx
    obtain ⟨B, hB⟩ := hy
    exact ⟨A + B, by rw [map_add]; exact hA.cusp_add hB⟩
  | mul x y _ _ hx hy =>
    obtain ⟨A, hA⟩ := hx
    obtain ⟨B, hB⟩ := hy
    exact ⟨A * B, by rw [map_mul]; exact hA.cusp_mul hB⟩

theorem exists_cyclotomic_fraction_represents {N : ℕ} [NeZero N]
    {a b f : ℍ → ℂ} (ha : a ∈ cyclotomicLevelRing N) (hb : b ∈ cyclotomicLevelRing N)
    (hb0 : b ≠ 0) (hrel : f * b = a) :
    ∃ X : LaurentSeries (kN N),
      CuspTaylor.Represents (coeffMap (algebraMap (kN N) ℂ) X) (cuspFunction N f) := by
  obtain ⟨A, hA⟩ := exists_cyclotomic_cusp_represents ha
  obtain ⟨B, hB⟩ := exists_cyclotomic_cusp_represents hb
  have hB0 := hB.ne_zero_of_function_ne_zero (by exact_mod_cast NeZero.pos N)
    (cyclotomicLevelRing_holomorphic hb) (cyclotomicLevelRing_periodic hb) hb0
  exact ⟨A / B, by rw [map_div₀]; exact hA.cusp_of_mul_eq hB hB0 hrel⟩

end
end Dubon2026.SourceFricke