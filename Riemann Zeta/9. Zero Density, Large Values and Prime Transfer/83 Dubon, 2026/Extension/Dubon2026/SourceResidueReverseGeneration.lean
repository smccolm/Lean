import Dubon2026.SourceResidueAdjacentPrimeGeneration
import Dubon2026.SourceResidueExpansionFields

/-! DUB-17/18 -> original Frobenius/inertia -> good reduction -> all-level
residue degree -> the reverse expansion tower. The actual level-Np divisor
field is generated by j and the p-expansion of the level-N field. Strong
induction recovers each missing divisor through the proved adjacent-prime
relation intersection. The level being nonzero in the coefficient field
supplies the needed roots of unity; generation is not a hypothesis. -/
namespace Dubon2026.SourceFunctionField
noncomputable section
open IntermediateField

theorem residue_full_prime_eq_adjoin_expanded
    (K : Type*) [Field K] [IsAlgClosed K] (N p : ℕ) [NeZero N] [hp : Fact p.Prime]
    (hNK : ((N * p : ℕ) : K) ≠ 0) :
    modularFunctionFieldCoeff (N * p) K = IntermediateField.adjoin K
      ((expandedCoefficientField K p N : Set (LaurentSeries K)) ∪ {jqModC K}) := by
  let F := IntermediateField.adjoin K
    ((expandedCoefficientField K p N : Set (LaurentSeries K)) ∪ {jqModC K})
  have hgen : ∀ d : ℕ, ∀ [NeZero d], d ∣ N * p → qExpand K d (jqModC K) ∈ F := by
    intro d
    induction d using Nat.strong_induction_on with
    | h d ih =>
      intro hd0 hdN
      by_cases hpd : p ∣ d
      · obtain ⟨m, rfl⟩ := hpd
        haveI : NeZero m := ⟨fun he => hd0.out (by rw [he, mul_zero])⟩
        have hmN : m ∣ N := by
          rw [Nat.mul_comm N p] at hdN
          exact Nat.dvd_of_mul_dvd_mul_left hp.out.pos hdN
        exact subset_adjoin K _ (Or.inl (qExpand_j_mem_expandedCoefficientField K p N hmN))
      · have hdN' : d ∣ N :=
          Nat.Coprime.dvd_of_dvd_mul_right ((hp.out.coprime_iff_not_dvd.mpr hpd).symm) hdN
        by_cases hd1 : d = 1
        · subst d
          rw [qExpand_one_apply]
          exact subset_adjoin K _ (Or.inr rfl)
        · let l := d.minFac
          have hl : l.Prime := Nat.minFac_prime hd1
          haveI : Fact l.Prime := ⟨hl⟩
          have hld : l ∣ d := Nat.minFac_dvd d
          obtain ⟨m, hdm⟩ := hld
          haveI : NeZero m := ⟨fun he => hd0.out (by rw [hdm, he, mul_zero])⟩
          have hmd : m * l = d := by rw [hdm, mul_comm]
          have hmlt : m < d := by
            rw [← hmd]
            exact lt_mul_of_one_lt_right (Nat.pos_of_ne_zero (NeZero.ne m)) hl.one_lt
          have hmF : qExpand K m (jqModC K) ∈ F :=
            ih m hmlt ((Dvd.intro l hmd).trans hdN)
          have hmpF : qExpand K (m * l * p) (jqModC K) ∈ F := by
            rw [qExpand_congr (by rw [hmd, mul_comm] : m * l * p = p * d) (jqModC K)]
            exact subset_adjoin K _
              (Or.inl (qExpand_j_mem_expandedCoefficientField K p N hdN'))
          haveI : NeZero (l : K) :=
            ⟨ne_zero_of_dvd_ne_zero hNK ((show l ∣ d from ⟨m, hdm⟩).trans hdN).natCast⟩
          haveI : NeZero (p : K) :=
            ⟨ne_zero_of_dvd_ne_zero hNK (dvd_mul_left p N).natCast⟩
          obtain ⟨z, hz⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K l
          obtain ⟨w, hw⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K p
          obtain ⟨ζ, hζval⟩ := hz.isUnit hl.ne_zero
          obtain ⟨η, hηval⟩ := hw.isUnit hp.out.ne_zero
          have h := residue_adjacent_prime_generation K m l p ζ η
            (hζval.symm ▸ hz) (hηval.symm ▸ hw) F hmF hmpF
          rwa [qExpand_congr hmd (jqModC K)] at h
  apply le_antisymm
  · rw [modularFunctionFieldCoeff, adjoin_le_iff]
    rintro x ⟨d, hd, hdN, rfl⟩
    exact hgen d hdN
  · rw [adjoin_le_iff]
    rintro x (hx | hx)
    · exact expandedCoefficientField_le K p N hx
    · rw [Set.mem_singleton_iff] at hx
      exact hx ▸ jq_mem_coeff_field (N * p) K

end
end Dubon2026.SourceFunctionField
