import Mathlib.RingTheory.MvPowerSeries.Basic
import Mathlib.RingTheory.Ideal.Maps

/-! Identify the variable ideal of the finite-variable parameter ring.
This is the algebraic step that turns the original coefficient-ring
comparison into a comparison over the common patching algebra. -/

namespace Dubon2026
noncomputable section
open scoped BigOperators

variable {η O : Type*} [Fintype η] [CommRing O]

/-- A finite-variable series with zero constant coefficient belongs
to the ideal generated by the actual variables. -/
theorem finitePowerSeries_mem_variableIdeal
    (f : MvPowerSeries η O) (hf : MvPowerSeries.constantCoeff f = 0) :
    f ∈ Ideal.span (Set.range (MvPowerSeries.X (R := O) (σ := η))) := by
  classical
  let pick : (d : η →₀ ℕ) → d ≠ 0 → η :=
    fun d hd => Classical.choose (Finsupp.support_nonempty_iff.mpr hd)
  have hpick (d : η →₀ ℕ) (hd : d ≠ 0) : d (pick d hd) ≠ 0 :=
    Finsupp.mem_support_iff.mp (Classical.choose_spec (Finsupp.support_nonempty_iff.mpr hd))
  let part (i : η) : MvPowerSeries η O :=
    fun d => if hd : d = 0 then 0 else if pick d hd = i then MvPowerSeries.coeff d f else 0
  have hpart (i : η) : MvPowerSeries.X i ∣ part i := by
    apply MvPowerSeries.X_dvd_iff.mpr
    intro d hdi
    change (if hd : d = 0 then 0 else if pick d hd = i then MvPowerSeries.coeff d f else 0) = 0
    split
    · rfl
    · rename_i hd
      have hne : pick d hd ≠ i := by
        intro hi
        exact hpick d hd (hi.symm ▸ hdi)
      simp only [hne, ↓reduceIte]
  have hsum : ∑ i, part i = f := by
    apply MvPowerSeries.ext
    intro d
    rw [map_sum]
    by_cases hd : d = 0
    · subst d
      change (∑ i, part i 0) = f 0
      have hz (i : η) : part i 0 = 0 := dif_pos rfl
      simp_rw [hz]
      exact (Finset.sum_const_zero).trans hf.symm
    · calc
        ∑ i, MvPowerSeries.coeff d (part i) = MvPowerSeries.coeff d (part (pick d hd)) := by
          apply Finset.sum_eq_single
          · intro i _ hi
            change (if h : d = 0 then 0 else if pick d h = i then MvPowerSeries.coeff d f else 0) = 0
            simp only [hd, ↓reduceDIte, Ne.symm hi, ↓reduceIte]
          · intro hi
            exact (hi (Finset.mem_univ _)).elim
        _ = MvPowerSeries.coeff d f := by
          change (if h : d = 0 then 0 else if pick d h = pick d hd then MvPowerSeries.coeff d f else 0) = _
          simp only [hd, ↓reduceDIte, ↓reduceIte]
  rw [← hsum]
  apply Submodule.sum_mem
  intro i _
  obtain ⟨g, hg⟩ := hpart i
  rw [hg]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_range_self i))

/-- The variable ideal is exactly the kernel of the constant-coefficient map. -/
theorem finitePowerSeries_variableIdeal_eq_ker :
    Ideal.span (Set.range (MvPowerSeries.X (R := O) (σ := η))) =
      RingHom.ker MvPowerSeries.constantCoeff := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact MvPowerSeries.constantCoeff_X i
  · intro f hf
    exact finitePowerSeries_mem_variableIdeal f hf

/-- Modulo the variable ideal, every series equals its original constant. -/
theorem finitePowerSeries_sub_constant_mem_variableIdeal (f : MvPowerSeries η O) :
    f - MvPowerSeries.C (MvPowerSeries.constantCoeff f) ∈
      Ideal.span (Set.range (MvPowerSeries.X (R := O) (σ := η))) := by
  apply finitePowerSeries_mem_variableIdeal
  rw [map_sub, MvPowerSeries.constantCoeff_C, sub_self]

end
end Dubon2026
