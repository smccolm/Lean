import Dubon2026.SourceEllipticOddQuotientEquation
import Dubon2026.SourceEllipticFunctionRange

/-! The actual odd quotient function-field embedding, with the equation and
nonconstancy inputs fully discharged. Its image is exactly the field generated
by the literal Velu coordinates and lies in the actual cyclic translation
fixed field. This advances the odd quotient-map dependency of DUB-17/18. -/

open WeierstrassCurve
open Dubon2026.SourceEllipticVelu
open scoped IntermediateField

namespace Dubon2026.SourceEllipticFunctionField

variable {F : Type*} [Field F] [DecidableEq F] (W : WeierstrassCurve F)
variable [W.IsElliptic] {Q : W.toAffine.Point} {n : ℕ}

/-- The actual odd quotient pullback into the original elliptic function field. -/
noncomputable def oddQuotientPullback (hQ : addOrderOf Q = 2 * n + 1) :
    (veluQuotient W (oddOrderSummingSet W Q n)).toAffine.FunctionField →ₐ[F] W.toAffine.FunctionField :=
  functionFieldLift (W := (veluQuotient W (oddOrderSummingSet W Q n)).toAffine)
    (odd_genericVelu_equation W hQ) (transcendental_genericVeluX W _)

/-- The odd quotient pullback is injective. -/
theorem oddQuotientPullback_injective (hQ : addOrderOf Q = 2 * n + 1) :
    Function.Injective (oddQuotientPullback W hQ) := (oddQuotientPullback W hQ).injective

/-- The quotient generic x-coordinate pulls back to the literal finite x-formula. -/
theorem oddQuotientPullback_genericX (hQ : addOrderOf Q = 2 * n + 1) :
    oddQuotientPullback W hQ (genericX (veluQuotient W (oddOrderSummingSet W Q n)).toAffine) =
      genericVeluX W (oddOrderSummingSet W Q n) := functionFieldLift_genericX _ _

/-- The quotient generic y-coordinate pulls back to the literal finite y-formula. -/
theorem oddQuotientPullback_genericY (hQ : addOrderOf Q = 2 * n + 1) :
    oddQuotientPullback W hQ (genericY (veluQuotient W (oddOrderSummingSet W Q n)).toAffine) =
      genericVeluY W (oddOrderSummingSet W Q n) := functionFieldLift_genericY _ _

/-- The actual pullback image is exactly the field generated by the two literal coordinates. -/
theorem oddQuotientPullback_range (hQ : addOrderOf Q = 2 * n + 1) :
    (oddQuotientPullback W hQ).fieldRange =
      F⟮genericVeluX W (oddOrderSummingSet W Q n), genericVeluY W (oddOrderSummingSet W Q n)⟯ :=
  functionFieldLift_range _ _

/-- The actual quotient image is fixed by the actual cyclic subgroup of translations. -/
theorem oddQuotientPullback_range_le_fixedField (hQ : addOrderOf Q = 2 * n + 1) :
    (oddQuotientPullback W hQ).fieldRange ≤ translationFixedField W.toAffine (AddSubgroup.zmultiples Q) := by
  rw [oddQuotientPullback_range]
  apply IntermediateField.adjoin_le_iff.mpr
  rintro z (rfl | rfl)
  · exact genericVeluX_mem_oddFixedField W hQ
  · exact genericVeluY_mem_oddFixedField W hQ

end Dubon2026.SourceEllipticFunctionField
