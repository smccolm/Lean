import Dubon2026.SourceEllipticOddFieldTower
import Dubon2026.SourceEllipticFunctionRange
import Mathlib.FieldTheory.RatFunc.IntermediateField

/-! The quadratic rational-coordinate degree transported along an actual
elliptic function-field embedding. This is the precise degree-two input needed
to identify the odd quotient image with its cyclic fixed field (DUB-17/18).
The native intermediate-field map theorem avoids new scalar-tower machinery. -/

open Polynomial WeierstrassCurve
open Dubon2026.SourceEllipticVelu
open scoped IntermediateField

namespace Dubon2026.SourceEllipticFunctionField

variable {F : Type*} [Field F] (W : WeierstrassCurve F)

/-- The actual rational-coordinate image is exactly the field generated by generic x. -/
theorem rationalCoordinateHom_range :
    (rationalCoordinateHom W).fieldRange = F⟮genericX W.toAffine⟯ := by
  rw [AlgHom.fieldRange_eq_map, ← RatFunc.adjoin_X, IntermediateField.adjoin_map,
    Set.image_singleton, ← RatFunc.algebraMap_X, rationalCoordinateHom_polynomial, aeval_X]

/-- The actual elliptic function field is quadratic over its generic x-coordinate field. -/
theorem finrank_genericX : Module.finrank F⟮genericX W.toAffine⟯ W.toAffine.FunctionField = 2 := by
  rw [← rationalCoordinateHom_range, finrank_rationalCoordinateRange]

/-- The image of any actual curve-field embedding is quadratic over the image of generic x. -/
theorem relfinrank_coordinate_image {L : Type*} [Field L] [Algebra F L]
    (f : W.toAffine.FunctionField →ₐ[F] L) :
    IntermediateField.relfinrank F⟮f (genericX W.toAffine)⟯ f.fieldRange = 2 := by
  have hm : F⟮f (genericX W.toAffine)⟯ = F⟮genericX W.toAffine⟯.map f := by
    rw [IntermediateField.adjoin_map, Set.image_singleton]
  rw [hm, AlgHom.fieldRange_eq_map, IntermediateField.relfinrank_map_map,
    IntermediateField.relfinrank_top_right, finrank_genericX]

end Dubon2026.SourceEllipticFunctionField
