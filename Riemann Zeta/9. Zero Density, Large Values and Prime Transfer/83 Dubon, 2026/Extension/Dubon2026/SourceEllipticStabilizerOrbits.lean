import Dubon2026.SourceOriginalAnalyticOrbitSeparation
import Dubon2026.SourceManinParabolicDimension

/-! DUB-17/18 -> numerical modular genus -> exceptional finite-fiber counts.
The full stabilizers at i and rho are generated by S and ST. Their actual
level-coset orbits therefore coincide with the cyclic permutation orbits
already counted by the original Manin relation development.
-/
namespace Dubon2026.SourceFunctionField.FiberOrbits
noncomputable section
open UpperHalfPlane ModularGroup
open scoped MatrixGroups

theorem stabilizer_I_eq_zpowers :
    MulAction.stabilizer SL(2, ℤ) UpperHalfPlane.I = Subgroup.zpowers ModularGroup.S := by
  apply le_antisymm
  · intro g hg
    have h := ModularGroup.stabilizer_I.mp hg
    simp only [Finset.mem_insert, Finset.mem_singleton] at h
    rcases h with rfl | rfl | rfl | rfl
    · exact one_mem _
    · simpa only [show ModularGroup.S ^ 2 = (-1 : SL(2, ℤ)) by decide] using
        Subgroup.npow_mem_zpowers ModularGroup.S 2
    · exact Subgroup.mem_zpowers _
    · simpa only [show ModularGroup.S ^ 3 = -ModularGroup.S by decide] using
        Subgroup.npow_mem_zpowers ModularGroup.S 3
  · exact Subgroup.zpowers_le.mpr (ModularGroup.stabilizer_I.mpr (by simp))

theorem stabilizer_rho_eq_zpowers :
    MulAction.stabilizer SL(2, ℤ) ρ = Subgroup.zpowers (ModularGroup.S * ModularGroup.T) := by
  apply le_antisymm
  · intro g hg
    have h := ModularGroup.stabilizer_ρ.mp hg
    simp only [Finset.mem_insert, Finset.mem_singleton] at h
    rcases h with rfl | rfl | rfl | rfl | rfl | rfl
    · exact one_mem _
    · simpa only [show (ModularGroup.S * ModularGroup.T) ^ 3 = (-1 : SL(2, ℤ)) by decide] using
        Subgroup.npow_mem_zpowers (ModularGroup.S * ModularGroup.T) 3
    · exact Subgroup.mem_zpowers _
    · simpa only [show (ModularGroup.S * ModularGroup.T) ^ 4 = -(ModularGroup.S * ModularGroup.T) by decide] using
        Subgroup.npow_mem_zpowers (ModularGroup.S * ModularGroup.T) 4
    · simpa only [show (ModularGroup.S * ModularGroup.T) ^ 2 = ModularGroup.T⁻¹ * ModularGroup.S by decide] using
        Subgroup.npow_mem_zpowers (ModularGroup.S * ModularGroup.T) 2
    · simpa only [show (ModularGroup.S * ModularGroup.T) ^ 5 = -(ModularGroup.T⁻¹ * ModularGroup.S) by decide] using
        Subgroup.npow_mem_zpowers (ModularGroup.S * ModularGroup.T) 5
  · exact Subgroup.zpowers_le.mpr (ModularGroup.stabilizer_ρ.mpr (by simp))

theorem cyclic_orbitRel_toPerm (N : ℕ) (g : SL(2, ℤ)) (a b : X N) :
    MulAction.orbitRel (Subgroup.zpowers g) (X N) a b ↔
      MulAction.orbitRel (Subgroup.zpowers (MulAction.toPermHom SL(2, ℤ) (X N) g)) (X N) a b := by
  change (∃ k : Subgroup.zpowers g, k • b = a) ↔
    ∃ k : Subgroup.zpowers (MulAction.toPermHom SL(2, ℤ) (X N) g), k • b = a
  constructor
  · rintro ⟨⟨k, hk⟩, ha⟩
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hk
    refine ⟨⟨MulAction.toPermHom SL(2, ℤ) (X N) g ^ n, Subgroup.zpow_mem_zpowers _ n⟩, ?_⟩
    change ((MulAction.toPermHom SL(2, ℤ) (X N) g) ^ n) b = a
    rw [← map_zpow]
    exact ha
  · rintro ⟨⟨k, hk⟩, ha⟩
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hk
    refine ⟨⟨g ^ n, Subgroup.zpow_mem_zpowers _ n⟩, ?_⟩
    change (MulAction.toPermHom SL(2, ℤ) (X N) (g ^ n)) b = a
    rw [map_zpow]
    exact ha

/-- Identify actual full-stabilizer orbits at i with the already counted S-permutation orbits. -/
def orbitEquivSigTwo (N : ℕ) : Orb N UpperHalfPlane.I ≃ SourceManin.Orb (SourceManin.sig2 N) :=
  Quotient.congrRight fun a b => by
    rw [stabilizer_I_eq_zpowers]
    exact cyclic_orbitRel_toPerm N ModularGroup.S a b

/-- Identify actual full-stabilizer orbits at rho with the already counted ST-permutation orbits. -/
def orbitEquivSigThree (N : ℕ) : Orb N ρ ≃ SourceManin.Orb (SourceManin.sig3 N) :=
  Quotient.congrRight fun a b => by
    rw [stabilizer_rho_eq_zpowers]
    exact cyclic_orbitRel_toPerm N (ModularGroup.S * ModularGroup.T) a b

end
end Dubon2026.SourceFunctionField.FiberOrbits
