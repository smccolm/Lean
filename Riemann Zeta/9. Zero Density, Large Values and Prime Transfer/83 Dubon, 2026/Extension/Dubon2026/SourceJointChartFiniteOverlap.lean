import Dubon2026.SourceJointChartOverlapDecomposition
import Dubon2026.SourceJointChartUniformInversePower
import Dubon2026.SourceJointChartOverlapTorsion

/-! DUB-17/18 -> Kummer power lifting -> common residue constants. The
actual overlap quotient is generated by a finite Laurent window of the
lifted chart basis. Good coordinate denominators and the proved pole bounds
discharge its finite-generation assumption. The quotient and both chart
relations are the ones used by the common-constants theorem. -/
namespace Dubon2026.SourceCurve.RegularProlongation.JointChartConstants
noncomputable section
open Polynomial IsLocalRing

theorem finite_overlap_of_good_basis
    {L : Type} [Field L] [IsAlgClosed L] [CharZero L] {A : ValuationSubring L}
    {F : Type*} [Field F] [Algebra L F]
    {ι J : Type*} [Fintype J] {Fb : ι → Type*} [∀ i, Field (Fb i)]
    [∀ i, Algebra (ResidueField A) (Fb i)]
    (R : ∀ i, RegularProlongation A F (Fb i)) (f : F)
    (hf : ∀ i, f ∈ (R i).integers) (hfi : ∀ i, f⁻¹ ∈ (R i).integers)
    (htr : Transcendental L f)
    [FiniteDimensional (IntermediateField.adjoin L ({f} : Set F)) F]
    (z : J → F) (hz : ∀ j, z j ∈ Sg R f)
    (hgood : ∀ s ∈ Sg R f, ∃ (t : L[X]) (p : J → L[X]), IsGood A t ∧
      (∀ j k, (p j).coeff k ∈ A) ∧ s * aeval f t = ∑ j, aeval f (p j) * z j) :
    Module.Finite A (overlapQuotient R f hf hfi) := by
  classical
  have hf0 : f ≠ 0 := fun h => htr (h ▸ isAlgebraic_zero)
  obtain ⟨m, hm⟩ := exists_uniform_inverse_chart_power R f hfi htr z hz
  have hPinv : Pg R f⁻¹ hfi ≤ Ppp R f hf :=
    Pinv_le_Ppp R hf hfi hf0 (exists_mul_pow_mem_Sg R f hf htr)
  let N := overlapRelations R f hf hfi
  have hgen_mem (j : J) (k : Fin (m + 1)) : f⁻¹ ^ (k : ℕ) * z j ∈ Ppp R f hf := by
    refine ⟨X ^ (k : ℕ), k, IsGoodAt.X_pow _, ?_⟩
    rw [map_pow, aeval_X, mul_comm (f⁻¹ ^ (k : ℕ)) (z j), mul_assoc,
      ← mul_pow, inv_mul_cancel₀ hf0, one_pow, mul_one]
    exact hz j
  let gen : J × Fin (m + 1) → Ppp R f hf :=
    fun jk => ⟨f⁻¹ ^ (jk.2 : ℕ) * z jk.1, hgen_mem jk.1 jk.2⟩
  change Module.Finite A (Ppp R f hf ⧸ N)
  rw [Module.finite_def, Submodule.fg_def]
  refine ⟨Set.range (N.mkQ ∘ gen), Set.finite_range _, ?_⟩
  rw [eq_top_iff]
  rintro q -
  obtain ⟨x, rfl⟩ := N.mkQ_surjective q
  obtain ⟨y, hy, v, hv, a, hsum⟩ :=
    overlap_decomposition_of_good_basis R f hf hfi htr z hz m hm hgood x x.2
  have hyv : y + v ∈ Ppp R f hf := add_mem (Pg_le_Ppp R hf hy) (hPinv hv)
  have hrel : (⟨y + v, hyv⟩ : Ppp R f hf) ∈ N :=
    add_mem (Submodule.mem_sup_left hy) (Submodule.mem_sup_right hv)
  have hval : ((⟨y + v, hyv⟩ + ∑ j, ∑ k : Fin (m + 1), a j k • gen (j, k) :
      Ppp R f hf) : F) = y + v + ∑ j, ∑ k : Fin (m + 1),
        algebraMap L F (a j k : L) * (f⁻¹ ^ (k : ℕ) * z j) := by
    rw [← Subalgebra.val_apply, map_add, map_sum]
    simp only [map_sum, Subalgebra.val_apply, gen, Algebra.smul_def]
    rfl
  have hx : x = ⟨y + v, hyv⟩ + ∑ j, ∑ k : Fin (m + 1), a j k • gen (j, k) :=
    Subtype.ext (by rw [hval]; exact hsum)
  rw [hx, map_add, Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero N).mpr hrel,
    zero_add, map_sum]
  refine Submodule.sum_mem _ fun j _ => ?_
  rw [map_sum]
  refine Submodule.sum_mem _ fun k _ => ?_
  rw [map_smul]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(j, k), rfl⟩)

end
end Dubon2026.SourceCurve.RegularProlongation.JointChartConstants
