import Dubon2026.SourceOriginalPeriodInjective

/-! The original all-index integral Hecke algebra is generated by its prime operators.
This reuses the existing prime-power recurrence, coprime composition and free-algebra
pairing transfer. It extends the integral prime adjoints to every positive index
without a new double-coset framework. Exact dependency: DUB-17/18 -> modular
Galois association -> finite integral original Hecke algebra.
-/

namespace Dubon2026
noncomputable section
open Matrix.SpecialLinearGroup CongruenceSubgroup MulOpposite
open scoped MatrixGroups

/-- At source weights, the original recurrence coefficient is an actual integer. -/
theorem sourceHeckeDivisorWeight_intCast (Q : ℕ) (k : ℤ) (hk : 2 ≤ k) (p : ℕ) :
    heckeDivisorWeight Q k p =
      ((if Nat.Coprime p Q then (p : ℤ) ^ (k - 1).toNat else 0 : ℤ) : ℂ) := by
  change (if Nat.Coprime p Q then (p : ℂ) ^ (k - 1) else 0) = _
  split_ifs <;> simp only [Int.cast_pow, Int.cast_natCast, Int.cast_zero]
  rw [← zpow_natCast, Int.toNat_of_nonneg (by omega : 0 ≤ k - 1)]

/-- Every original prime-power operator lies in the integral algebra generated by primes. -/
theorem sourceHeckePrimePower_mem_primeAlgebra (Q : ℕ) [NeZero Q] (k : ℤ) (hk : 2 ≤ k)
    {p : ℕ} [NeZero p] (hp : Nat.Prime p) (r : ℕ) :
    cuspHeckePrimePower (Q := Q) k hp r ∈
      Algebra.adjoin ℤ (Set.range fun q : {q : ℕ // Nat.Prime q} => cuspHeckeLinear Q k q.val) := by
  let A := Algebra.adjoin ℤ
    (Set.range fun q : {q : ℕ // Nat.Prime q} => cuspHeckeLinear Q k q.val)
  have hprime : cuspHeckePrimeLinear (Q := Q) k hp ∈ A := by
    rw [← cuspHeckeLinear_prime Q k hp]
    exact Algebra.subset_adjoin ⟨⟨p, hp⟩, rfl⟩
  change cuspHeckePrimePower k hp r ∈ A
  induction r using Nat.twoStepInduction with
  | zero => exact A.one_mem
  | one => exact hprime
  | more r ih0 ih1 =>
    rw [cuspHeckePrimePower]
    refine A.sub_mem (A.mul_mem hprime ih1) ?_
    rw [sourceHeckeDivisorWeight_intCast Q k hk]
    rw [Int.cast_smul_eq_zsmul]
    exact A.smul_mem ih0 _

/-- Every positive-index original Hecke operator is generated integrally by the original primes. -/
theorem sourceHecke_mem_primeAlgebra (Q : ℕ) [NeZero Q] (k : ℤ) (hk : 2 ≤ k)
    (n : ℕ) (hn : n ≠ 0) :
    cuspHeckeLinear Q k n ∈
      Algebra.adjoin ℤ (Set.range fun q : {q : ℕ // Nat.Prime q} => cuspHeckeLinear Q k q.val) := by
  induction n using Nat.recOnPrimeCoprime with
  | zero => exact (hn rfl).elim
  | prime_pow p r hp =>
    haveI : NeZero p := ⟨hp.ne_zero⟩
    rw [cuspHeckeLinear_primePower Q k hp]
    exact sourceHeckePrimePower_mem_primeAlgebra Q k hk hp r
  | coprime a b ha hb hab iha ihb =>
    rw [← cuspHeckeLinear_coprime_mul Q k (by omega) (by omega) hab]
    exact (Algebra.adjoin ℤ _).mul_mem (iha (by omega)) (ihb (by omega))

/-- Integral adjoints at the original prime indices extend to all positive original indices. -/
theorem sourceOriginalHeckeAdjoint_exists_of_prime
    (Q : ℕ) [NeZero Q] (k : ℤ) (hk : 2 ≤ k)
    (u : {p : ℕ // Nat.Prime p} →
      Module.End ℤ (SourceModularSymbols ℤ (Gamma0 Q) (k - 2).toNat))
    (h : ∀ p f x, sourceOriginalPeriodMap Q k hk (cuspHeckeLinear Q k p.val f) x =
      sourceOriginalPeriodMap Q k hk f (u p x))
    (n : ℕ+) :
    ∃ v : Module.End ℤ (SourceModularSymbols ℤ (Gamma0 Q) (k - 2).toNat),
      ∀ f x, sourceOriginalPeriodMap Q k hk (cuspHeckeLinear Q k (n : ℕ) f) x =
        sourceOriginalPeriodMap Q k hk f (v x) := by
  let t := fun p : {p : ℕ // Nat.Prime p} => cuspHeckeLinear Q k p.val
  have hn := sourceHecke_mem_primeAlgebra Q k hk n n.ne_zero
  rw [Algebra.adjoin_range_eq_range_freeAlgebra_lift] at hn
  obtain ⟨a, ha⟩ := hn
  refine ⟨(FreeAlgebra.lift ℤ (fun p => op (u p)) a).unop, ?_⟩
  intro f x
  rw [← ha]
  exact sourcePairing_freeAlgebra_lift ((sourceOriginalPeriodMap Q k hk).restrictScalars ℤ)
    t u h a f x

end
end Dubon2026
