private def runAudit : CoreM Unit := do
  let env ← getEnv
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut names : Array Name := #[]
  for (name, info) in env.constants.toList do
    if let some idx := env.getModuleIdxFor? name then
      if env.allImportedModuleNames[idx.toNat]!.getRoot == `Dubon2026 then
        if info.isTheorem then names := names.push name
        if info.isAxiom then throwError "Project postulate: {name}"
  if names.isEmpty then throwError "No project theorems discovered"
  for name in publicConsumers do
    if !names.contains name then throwError "Missing public theorem: {name}"
  for name in publicConstructions do
    match env.find? name with
    | none => throwError "Missing public construction: {name}"
    | some info =>
      if info.isTheorem || info.isAxiom then
        throwError "Public construction has incorrect declaration kind: {name}"
      let axioms ← Lean.collectAxioms name
      let forbidden := axioms.filter fun a => !allowed.contains a
      if !forbidden.isEmpty then throwError "Forbidden construction dependencies: {name}: {forbidden}"
      logInfo m!"PASS CONSTRUCTION {name}: {axioms}"
  for name in names.qsort Name.quickLt do
    let axioms ← Lean.collectAxioms name
    let forbidden := axioms.filter fun a => !allowed.contains a
    if !forbidden.isEmpty then throwError "Forbidden dependencies: {name}: {forbidden}"
    logInfo m!"PASS {name}: {axioms}"
  logInfo m!"AUDIT PASS: {names.size} project theorems including private/generated declarations; {publicConsumers.size} registered consumers; {publicConstructions.size} registered constructions. Source gate acceptance is separate."

#eval runAudit

end Dubon2026.Audit

