import Dubon2026.SourceRationalShiftPowerSpan
import Dubon2026.SourceOriginalPowerResidues

/-! DUB-17/18 -> regular differential dimension -> global residue identity.
The actual residue functional of dj vanishes on every rational function of
the original j-coordinate. Partial fractions reduce this to shifted powers;
their differentials equal dj and the proved power-residue identity applies.
SourceOriginalGlobalResidues extends this to arbitrary original functions
using the actual finite Galois closure and the proved pullback degree formula.
-/
namespace Dubon2026.SourceFunctionField
noncomputable section
open SourceCurve KaehlerDifferential
variable (N : ℕ) [NeZero N] (L : Type*) [Field L] [Algebra ℚ L]

/-- Actual original global functions as diagonal repartitions. -/
def originalPrincipalAdele : modularFunctionFieldOver N L →ₗ[L]
    adeleSpace L (modularFunctionFieldOver N L) :=
  (diagonalHom L (modularFunctionFieldOver N L)).codRestrict
    (adeleSpace L (modularFunctionFieldOver N L)) (original_diagonal_mem_adeleSpace N L)

/-- The literal rational subfield generated by the original j-coordinate. -/
def originalRationalJEmbedding : RatFunc L →ₐ[L] modularFunctionFieldOver N L :=
  rationalCoordinateEmbedding L (jOver N L) (transcendental_jOver N L)

omit [NeZero N] in
theorem originalRationalJEmbedding_X :
    originalRationalJEmbedding N L RatFunc.X = jOver N L := by
  exact rationalCoordinateEmbedding_X L (jOver N L) (transcendental_jOver N L)

omit [NeZero N] in
theorem originalRationalJEmbedding_shift_power (c : L) (n : ℤ) :
    originalRationalJEmbedding N L ((RatFunc.X - RatFunc.C c) ^ n) =
      (jOver N L - algebraMap L (modularFunctionFieldOver N L) c) ^ n := by
  rw [map_zpow₀, map_sub, originalRationalJEmbedding_X,
    ← RatFunc.algebraMap_eq_C, AlgHom.commutes]

theorem originalResidueFunctional_rationalJ [IsAlgClosed L] (h : RatFunc L) :
    originalResidueFunctional N L (D_jOver_ne_zero N L)
      (originalPrincipalAdele N L (originalRationalJEmbedding N L h)) = 0 := by
  let φ : RatFunc L →ₗ[L] L :=
    (originalResidueFunctional N L (D_jOver_ne_zero N L)).comp
      ((originalPrincipalAdele N L).comp (originalRationalJEmbedding N L).toLinearMap)
  have hφ : φ = 0 := by
    apply linearMap_eq_zero_of_shift_powers L
    intro c n
    change originalResidueFunctional N L (D_jOver_ne_zero N L)
      (originalPrincipalAdele N L
        (originalRationalJEmbedding N L ((RatFunc.X - RatFunc.C c) ^ n))) = 0
    rw [originalRationalJEmbedding_shift_power]
    have hD : D L (modularFunctionFieldOver N L)
        (jOver N L - algebraMap L (modularFunctionFieldOver N L) c) =
          D L (modularFunctionFieldOver N L) (jOver N L) := by
      rw [map_sub, Derivation.map_algebraMap, sub_zero]
    have hDf : D L (modularFunctionFieldOver N L)
        (jOver N L - algebraMap L (modularFunctionFieldOver N L) c) ≠ 0 := by
      rw [hD]
      exact D_jOver_ne_zero N L
    have he := originalResidueFunctional_power_differential N L hDf n
    simpa only [hD] using he
  exact LinearMap.congr_fun hφ h

end
end Dubon2026.SourceFunctionField
