import Dubon2026.SourceModularJTranscendence
import Dubon2026.SourceDifferentialExpansionInjectivity

/-! DUB-17/18 -> parabolic Hecke realization -> period surjectivity ->
matching cusp-form lower dimension bound -> regular differential realization.
This selects the original Laurent-series modular function field and its
literal j series. The analytic modularity and finite extension are assembled in
SourceOriginalDifferentialInjectivity. Regularity, geometric genus and
cusp-form realization remain separate proof obligations.
Adapted from anthropics/fermats-last-theorem, Apache-2.0, commit
6e837e75355538c7f80bab5b956861e86c4eacc2,
Definitions/Def_ModularCurve_X0.lean, AllDivisors section; Definitions/Def_ModularCurve_ArithmeticGalois.lean, modularFunctionFieldBar; and the selected transcendence bridge.
-/
namespace Dubon2026.SourceFunctionField
noncomputable section
open HahnSeries IntermediateField


variable (N : ℕ)

/-- The actual j series at every divisor of the original level. -/
def divisorExpansions : Set (LaurentSeries ℚ) :=
  {x | ∃ (d : ℕ) (_ : NeZero d), d ∣ N ∧ x = qExpand ℚ d jq}

/-- The rational Laurent-series field generated by all original divisor j expansions. -/
def modularFunctionFieldFull : IntermediateField ℚ (LaurentSeries ℚ) :=
  IntermediateField.adjoin ℚ (divisorExpansions N)

theorem jqd_mem_full {d : ℕ} [NeZero d] (hd : d ∣ N) :
    qExpand ℚ d jq ∈ modularFunctionFieldFull N :=
  subset_adjoin ℚ _ ⟨d, ‹_›, hd, rfl⟩

theorem jq_mem_full : jq ∈ modularFunctionFieldFull N := by
  have h := jqd_mem_full N (one_dvd N)
  rwa [qExpand_one_apply] at h

variable (L : Type*) [Field L] [Algebra ℚ L]

/-- The original full modular function field after actual scalar extension. -/
def modularFunctionFieldOver : IntermediateField L (LaurentSeries L) :=
  laurentBaseChange L (modularFunctionFieldFull N)

/-- The literal transcendental j coordinate in the original scalar-extended function field. -/
def jOver : modularFunctionFieldOver N L :=
  ⟨coeffEmb L jq, coeffEmb_mem_laurentBaseChange L (jq_mem_full N)⟩

theorem coeffEmb_jq : coeffEmb L jq = jqModC L := by
  rw [← jqModC_rat]
  exact map_jqModC (algebraMap ℚ L)

theorem transcendental_jOver : Transcendental L (jOver N L) := by
  intro h
  apply transcendental_jqModC L
  rw [← coeffEmb_jq L]
  exact h.algebraMap (A := LaurentSeries L)

theorem qEuler_jOver_ne_zero [CharZero L] :
    SourceDifferential.qEuler L (jOver N L : LaurentSeries L) ≠ 0 :=
  SourceDifferential.qEuler_ne_zero_of_transcendental
    (modularFunctionFieldOver N L) (jOver N L) (transcendental_jOver N L)

/-- Original differential expansion is injective once separability over the
actual j coordinate is supplied. SourceOriginalDifferentialInjectivity
derives that premise for every nonzero original level. -/
theorem diffQExp_original_injective_of_separable [CharZero L]
    [Algebra.IsSeparable
      (IntermediateField.adjoin L ({jOver N L} : Set (modularFunctionFieldOver N L)))
      (modularFunctionFieldOver N L)] :
    Function.Injective (SourceDifferential.diffQExp (modularFunctionFieldOver N L)) :=
  SourceDifferential.diffQExp_injective_of_transcendental
    (modularFunctionFieldOver N L) (jOver N L) (transcendental_jOver N L)

end
end Dubon2026.SourceFunctionField
