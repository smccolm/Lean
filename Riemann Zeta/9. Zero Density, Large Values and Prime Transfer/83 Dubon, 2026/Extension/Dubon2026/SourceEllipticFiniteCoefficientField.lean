import Dubon2026.SourceEllipticOddBaseChange
import Mathlib.SetTheory.Cardinal.Subfield

/-! Restrict an actual curve and finitely many points to their countable
coefficient field. This is used only to descend the actual prime quotient
product from the complex numbers; no general scheme descent is introduced. -/

namespace Dubon2026.SourceEllipticVelu.OddDiscriminant
open WeierstrassCurve
noncomputable section
variable {F : Type*} [Field F]

/-- The finite set of actual Weierstrass coefficients and point coordinates. -/
def curvePointCoefficients {ι : Type*}
    (W : WeierstrassCurve F) (Q : ι → W.toAffine.Point) : Set F :=
  {W.a₁, W.a₂, W.a₃, W.a₄, W.a₆} ∪
    Set.range (fun i => (coordsOrZero (Q i)).1) ∪
    Set.range (fun i => (coordsOrZero (Q i)).2)

/-- The actual coefficients and finitely many coordinates form a finite set. -/
theorem curvePointCoefficients_finite {ι : Type*} [Finite ι]
    (W : WeierstrassCurve F) (Q : ι → W.toAffine.Point) :
    (curvePointCoefficients W Q).Finite := by
  unfold curvePointCoefficients
  exact ((Set.toFinite _).union (Set.finite_range _)).union (Set.finite_range _)

/-- The subfield generated by the required coefficients is countable. -/
theorem countable_curvePointField {ι : Type*} [Finite ι]
    (W : WeierstrassCurve F) (Q : ι → W.toAffine.Point) :
    Countable (Subfield.closure (curvePointCoefficients W Q)) := by
  apply Cardinal.mk_le_aleph0_iff.mp
  exact (Subfield.cardinalMk_closure_le_max _).trans (max_le
    (Cardinal.le_aleph0_iff_set_countable.mpr (curvePointCoefficients_finite W Q).countable)
    le_rfl)

/-- Restrict the literal five coefficients to a subfield containing them. -/
def curveOverSubfield (W : WeierstrassCurve F) (K : Subfield F)
    (h : {W.a₁, W.a₂, W.a₃, W.a₄, W.a₆} ⊆ (K : Set F)) : WeierstrassCurve K where
  a₁ := ⟨W.a₁, h (by simp)⟩
  a₂ := ⟨W.a₂, h (by simp)⟩
  a₃ := ⟨W.a₃, h (by simp)⟩
  a₄ := ⟨W.a₄, h (by simp)⟩
  a₆ := ⟨W.a₆, h (by simp)⟩

/-- Mapping the restricted curve recovers the original coefficients exactly. -/
theorem curveOverSubfield_map (W : WeierstrassCurve F) (K : Subfield F)
    (h : {W.a₁, W.a₂, W.a₃, W.a₄, W.a₆} ⊆ (K : Set F)) :
    (curveOverSubfield W K h).map K.subtype = W := by
  cases W
  rfl

/-- Ellipticity descends to the actual coefficient subfield. -/
instance curveOverSubfield_isElliptic (W : WeierstrassCurve F) [W.IsElliptic]
    (K : Subfield F) (h : {W.a₁, W.a₂, W.a₃, W.a₄, W.a₆} ⊆ (K : Set F)) :
    (curveOverSubfield W K h).IsElliptic := by
  rw [WeierstrassCurve.isElliptic_iff, isUnit_iff_ne_zero]
  intro hz
  have he := congrArg K.subtype hz
  rw [← WeierstrassCurve.map_Δ, curveOverSubfield_map, map_zero] at he
  exact W.isUnit_Δ.ne_zero he

end
end Dubon2026.SourceEllipticVelu.OddDiscriminant
