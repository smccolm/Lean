import Dubon2026.CyclicTrivialIntegerCohomology
import Mathlib.Data.ZMod.QuotientRing

/-! # Actual even cyclic integer cohomology and its order -/

namespace Dubon2026
noncomputable section

open CategoryTheory
attribute [local instance 1100] Rep.hV2

/-- The image of the original integer norm is the ideal generated by the
actual group order. -/
theorem trivialIntegerRep_norm_range (G : Type) [Group G] [Fintype G] :
    (Rep.trivial ℤ G ℤ).norm.hom.toLinearMap.range =
      Ideal.span {(Fintype.card G : ℤ)} := by
  ext x
  simp only [LinearMap.mem_range, Ideal.mem_span_singleton, dvd_def]
  constructor
  · rintro ⟨y, hy⟩
    exact ⟨y, by rw [← hy]; exact trivialIntegerRep_norm_apply G y⟩
  · rintro ⟨y, hy⟩
    exact ⟨y, (trivialIntegerRep_norm_apply G y).trans hy.symm⟩

/-- The genuine periodic resolution identifies every positive even
integer cohomology group with the integers modulo the original group order. -/
def cyclicTrivialIntegerEvenCohomologyIso
    (G : Type) [CommGroup G] [Fintype G] (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) (n : ℕ) [NeZero n] (hn : Even n) :
    groupCohomology (Rep.trivial ℤ G ℤ) n ≅ ModuleCat.of ℤ (ZMod (Fintype.card G)) := by
  let A := Rep.trivial ℤ G ℤ
  let S := Rep.FiniteCyclicGroup.normHomCompSub A g
  have hz : S.g = 0 := by
    ext
    change (1 : ℤ) - 1 = 0
    exact sub_self 1
  exact Rep.FiniteCyclicGroup.groupCohomologyIsoEven A g hg n hn ≪≫
    (ShortComplex.HomologyData.ofHasCokernel S hz).left.homologyIso ≪≫
    ModuleCat.cokernelIsoRangeQuotient S.f ≪≫
    (Submodule.quotEquivOfEq _ _ (trivialIntegerRep_norm_range G)).toModuleIso ≪≫
    (Int.quotientSpanNatEquivZMod (Fintype.card G)).toAddEquiv.toIntLinearEquiv.toModuleIso

/-- Finiteness and the exact order of the actual positive even integer
cohomology group follow from its proved isomorphism with the original residue ring. -/
theorem cyclic_trivial_integer_even_cohomology_order
    (G : Type) [CommGroup G] [Fintype G] (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) (n : ℕ) [NeZero n] (hn : Even n) :
    Finite (groupCohomology (Rep.trivial ℤ G ℤ) n) ∧
      Nat.card (groupCohomology (Rep.trivial ℤ G ℤ) n) = Fintype.card G := by
  let e := (cyclicTrivialIntegerEvenCohomologyIso G g hg n hn).toLinearEquiv.toEquiv
  haveI : NeZero (Fintype.card G) := ⟨Fintype.card_ne_zero⟩
  exact ⟨Finite.of_equiv (ZMod (Fintype.card G)) e.symm,
    (Nat.card_congr e).trans (Nat.card_zmod (Fintype.card G))⟩

end
end Dubon2026
