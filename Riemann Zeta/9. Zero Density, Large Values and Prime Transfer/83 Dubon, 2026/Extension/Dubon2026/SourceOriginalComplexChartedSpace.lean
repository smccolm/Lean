import Dubon2026.SourceOriginalPlaceChartTransitions
import Mathlib.Geometry.Manifold.IsManifold.Basic

/-! DUB-17/18 -> original torsion cardinality -> complex Abel-Jacobi.
The actual all-place uniformizer charts define a native complex analytic
charted space. The topology and atlas are constructed from their proved
open analytic transitions. Hausdorffness, compactness and connectedness
remain separate obligations before the global comparison applies.
Adapted from anthropics/fermats-last-theorem, Apache-2.0, commit
6e837e75355538c7f80bab5b956861e86c4eacc2,
S_AlgebraicCurve_Place_exists_chartedSpace_meromorphicOrderAt_evalAt_eq_ord_complex.
-/
namespace Dubon2026.SourceFunctionField.OriginalChart
noncomputable section
open SourceCurve Set
open scoped Manifold ContDiff Topology
variable (N : ℕ) [NeZero N]

theorem placeChart_self (v : Place ℂ (modularFunctionFieldOver N ℂ)) : placeChart N v v = 0 := by
  have h := place_eval_uniformizer N v (Metric.mem_ball_self (place_spec N v).1)
  rw [(place_spec N v).2.1] at h
  exact h

/-- The native chart core made from every actual original place parameter. -/
def placeCore : ChartedSpaceCore ℂ (Place ℂ (modularFunctionFieldOver N ℂ)) where
  atlas := range (placeChart N)
  chartAt := placeChart N
  mem_chart_source := mem_placeChart_source N
  chart_mem_atlas v := ⟨v, rfl⟩
  open_source := by
    rintro _ _ ⟨v, rfl⟩ ⟨w, rfl⟩
    exact isOpen_placeChart_trans_source v w
  continuousOn_toFun := by
    rintro _ _ ⟨v, rfl⟩ ⟨w, rfl⟩
    exact (analyticOnNhd_placeChart_transition v w).continuousOn

/-- The topology generated by the actual original uniformizer charts. -/
abbrev placeTopology : TopologicalSpace (Place ℂ (modularFunctionFieldOver N ℂ)) :=
  (placeCore N).toTopologicalSpace

/-- The native charted-space structure on the actual original places. -/
abbrev placeChartedSpace : @ChartedSpace ℂ _ (Place ℂ (modularFunctionFieldOver N ℂ)) (placeTopology N) :=
  (placeCore N).toChartedSpace

theorem mem_place_atlas_iff
    (e : @OpenPartialHomeomorph (Place ℂ (modularFunctionFieldOver N ℂ)) ℂ (placeTopology N) _) :
    (letI := placeTopology N; letI := placeChartedSpace N;
      e ∈ atlas ℂ (Place ℂ (modularFunctionFieldOver N ℂ))) ↔
      ∃ v, e = (placeCore N).openPartialHomeomorph (placeChart N v) ⟨v, rfl⟩ := by
  letI := placeTopology N
  letI := placeChartedSpace N
  change e ∈ ⋃ (e : PartialEquiv (Place ℂ (modularFunctionFieldOver N ℂ)) ℂ)
    (he : e ∈ (placeCore N).atlas), {(placeCore N).openPartialHomeomorph e he} ↔ _
  simp only [mem_iUnion, mem_singleton_iff]
  constructor
  · rintro ⟨_, ⟨v, rfl⟩, rfl⟩
    exact ⟨v, rfl⟩
  · rintro ⟨v, rfl⟩
    exact ⟨_, ⟨v, rfl⟩, rfl⟩

theorem place_isManifold :
    letI := placeTopology N
    letI := placeChartedSpace N
    IsManifold 𝓘(ℂ, ℂ) ω (Place ℂ (modularFunctionFieldOver N ℂ)) := by
  letI := placeTopology N
  letI := placeChartedSpace N
  refine isManifold_of_contDiffOn 𝓘(ℂ, ℂ) ω (Place ℂ (modularFunctionFieldOver N ℂ))
    fun e e' he he' => ?_
  obtain ⟨v, rfl⟩ := (mem_place_atlas_iff N e).mp he
  obtain ⟨w, rfl⟩ := (mem_place_atlas_iff N e').mp he'
  simp only [modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm, Function.comp_id,
    Function.id_comp, range_id, inter_univ, preimage_id_eq, id]
  exact (analyticOnNhd_placeChart_transition v w).contDiffOn_of_completeSpace

end
end Dubon2026.SourceFunctionField.OriginalChart
