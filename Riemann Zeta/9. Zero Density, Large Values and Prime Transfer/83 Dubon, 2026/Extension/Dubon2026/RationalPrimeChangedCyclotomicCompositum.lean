import Dubon2026.RationalPrimeChangedAuxiliaryFrobenius
import Dubon2026.FiniteGaloisCompositumOverIntermediate
import Dubon2026.OriginalCyclotomicPrimeStage

/-! # The actual changed auxiliary/cyclotomic compositum

The primitive root already present in the Witt cyclotomic fraction field
defines the original finite Galois cyclotomic stage.  Adjoining that literal
stage to the changed auxiliary field gives the finite Galois extension over
which DUB-17's unramified reciprocity calculation is made.
-/
namespace Dubon2026
noncomputable section
open scoped ValuativeRel

attribute [local instance] rationalPrimeWittPrime wittCyclotomicRootDomain
  wittCyclotomicRootFaithful wittCyclotomicFieldAlgebra wittCyclotomicFieldTower
  rationalPrimeWittOriginalAlgebra rationalPrimeWittCyclotomicAlgebra
  rationalPrimeWittCyclotomicTower rationalPrimeWittCyclotomicModule
  rationalPrimeWittCyclotomicMulAction

/-- The literal primitive root, mapped from the integral root algebra into its
actual Witt cyclotomic fraction field. -/
def rationalPrimeWittCyclotomicFieldPrimitiveRoot
    (p : ℕ) (hp : p.Prime) (n : ℕ) :
    wittCyclotomicField
      (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n :=
  let q := Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)
  algebraMap (wittCyclotomicRootAlgebra q n) (wittCyclotomicField q n)
    (wittCyclotomicPrimitiveRoot q n)

/-- The mapped root retains exact prime-power order in the actual fraction field. -/
theorem rationalPrimeWittCyclotomicFieldPrimitiveRoot_isPrimitive
    (p : ℕ) (hp : p.Prime) (n : ℕ) :
    let q := Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)
    IsPrimitiveRoot (rationalPrimeWittCyclotomicFieldPrimitiveRoot p hp n)
      (q ^ (n + 1)) := by
  dsimp only
  exact (wittCyclotomicPrimitiveRoot_isPrimitive
    (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n).map_of_injective
      (IsFractionRing.injective _ _)

/-- The actual finite Galois subfield generated by the literal primitive root. -/
def rationalPrimeOriginalCyclotomicStage
    (p : ℕ) (hp : p.Prime) (n : ℕ) :
    FiniteGaloisIntermediateField (rationalPrimeLocalField p hp)
      (wittCyclotomicField
        (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n) :=
  originalPrimitiveRootStage _ _
    (rationalPrimeWittCyclotomicFieldPrimitiveRoot_isPrimitive p hp n)

/-- The literal compositum of the changed auxiliary field and the original
cyclotomic stage is finite Galois over the changed auxiliary field. -/
def rationalPrimeChangedCyclotomicCompositum
    (p : ℕ) (hp : p.Prime) (n : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) :
    FiniteGaloisIntermediateField (rationalPrimeChangedAuxiliaryField p hp n u)
      (wittCyclotomicField
        (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n) :=
  finiteGaloisCompositumOverIntermediate
    (rationalPrimeChangedAuxiliaryField p hp n u)
    (rationalPrimeOriginalCyclotomicStage p hp n)

/-- The constructed field has exactly the carrier of the intended compositum. -/
theorem rationalPrimeChangedCyclotomicCompositum_coe
    (p : ℕ) (hp : p.Prime) (n : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) :
    ((rationalPrimeChangedCyclotomicCompositum p hp n u).toIntermediateField :
      Set (wittCyclotomicField
        (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n)) =
      (rationalPrimeChangedAuxiliaryField p hp n u ⊔
        (rationalPrimeOriginalCyclotomicStage p hp n).toIntermediateField :
          IntermediateField (rationalPrimeLocalField p hp)
            (wittCyclotomicField
              (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n)) :=
  finiteGaloisCompositumOverIntermediate_coe _ _

/-- The diagonal Frobenius has the required inverse-unit power action on the
literal primitive root in the ambient cyclotomic field. -/
theorem rationalPrimeDiagonalFrobenius_primitiveRoot
    (p : ℕ) (hp : p.Prime) (n a b : ℕ)
    (ha : a.Coprime
      ((Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)))
    (hb : b.Coprime
      ((Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)))
    (hab : a * b ≡ 1 [MOD
      (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)]) :
    let q := Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)
    wittCyclotomicDiagonalFieldFrobenius q n a b ha hb hab
        (rationalPrimeWittCyclotomicFieldPrimitiveRoot p hp n) =
      (rationalPrimeWittCyclotomicFieldPrimitiveRoot p hp n) ^ b := by
  dsimp only [rationalPrimeWittCyclotomicFieldPrimitiveRoot]
  rw [wittCyclotomicDiagonalFieldFrobenius_integer]
  have hroot :
      wittCyclotomicDiagonalFrobenius
          (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp))
          n a b ha hb hab
          (wittCyclotomicPrimitiveRoot
            (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n) =
        (wittCyclotomicPrimitiveRoot
          (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n) ^ b := by
    unfold wittCyclotomicPrimitiveRoot
    rw [map_add, map_one,
      wittCyclotomicDiagonalFrobenius_root]
    rw [← add_sub_assoc, add_sub_cancel_left]
    rfl
  rw [hroot, map_pow]

/-- The same diagonal Frobenius preserves the actual original cyclotomic
stage, by induction from its literal primitive-root generator. -/
theorem rationalPrimeDiagonalFrobenius_originalCyclotomicStage
    (p : ℕ) (hp : p.Prime) (n a b : ℕ)
    (ha : a.Coprime
      ((Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)))
    (hb : b.Coprime
      ((Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)))
    (hab : a * b ≡ 1 [MOD
      (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)])
    (x : rationalPrimeOriginalCyclotomicStage p hp n) :
    let q := Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)
    wittCyclotomicDiagonalFieldFrobenius q n a b ha hb hab x.val ∈
      (rationalPrimeOriginalCyclotomicStage p hp n).toIntermediateField := by
  dsimp only
  let K := rationalPrimeLocalField p hp
  let Ω := wittCyclotomicField
    (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n
  let ζ := rationalPrimeWittCyclotomicFieldPrimitiveRoot p hp n
  let L := rationalPrimeOriginalCyclotomicStage p hp n
  let σ := wittCyclotomicDiagonalFieldFrobenius
    (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n a b ha hb hab
  have hx : x.val ∈ IntermediateField.adjoin K ({ζ} : Set Ω) := by
    simpa only [L, rationalPrimeOriginalCyclotomicStage,
      originalPrimitiveRootStage] using x.property
  apply IntermediateField.adjoin_induction K (s := ({ζ} : Set Ω))
    (p := fun y _ => σ y ∈ L.toIntermediateField) (h := hx)
  · intro y hy
    obtain rfl := Set.mem_singleton_iff.mp hy
    rw [show σ ζ = ζ ^ b from
      rationalPrimeDiagonalFrobenius_primitiveRoot p hp n a b ha hb hab]
    exact L.toIntermediateField.pow_mem
      (IntermediateField.subset_adjoin K ({ζ} : Set Ω) (Set.mem_singleton ζ)) b
  · intro y
    rw [show σ (algebraMap K Ω y) = algebraMap K Ω y from
      rationalPrimeDiagonalFrobenius_base p hp n a b ha hb hab y]
    exact L.toIntermediateField.algebraMap_mem y
  · intro y z _ _ hy hz
    rw [map_add]
    exact L.toIntermediateField.add_mem hy hz
  · intro y _ hy
    rw [map_inv₀]
    exact L.toIntermediateField.inv_mem hy
  · intro y z _ _ hy hz
    rw [map_mul]
    exact L.toIntermediateField.mul_mem hy hz

/-- The diagonal Frobenius preserves the actual changed/cyclotomic
compositum: it fixes the changed auxiliary base and preserves the original
cyclotomic generating stage. -/
theorem rationalPrimeDiagonalFrobenius_changedCyclotomicCompositum
    (p : ℕ) (hp : p.Prime) (n a b : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a)
    (ha : a.Coprime
      ((Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)))
    (hb : b.Coprime
      ((Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)))
    (hab : a * b ≡ 1 [MOD
      (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)])
    (x : rationalPrimeChangedCyclotomicCompositum p hp n u) :
    let q := Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)
    wittCyclotomicDiagonalFieldFrobenius q n a b ha hb hab x.val ∈
      (rationalPrimeChangedCyclotomicCompositum p hp n u).toIntermediateField := by
  dsimp only
  let K := rationalPrimeLocalField p hp
  let Ω := wittCyclotomicField
    (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n
  let E := rationalPrimeChangedAuxiliaryField p hp n u
  let L := rationalPrimeOriginalCyclotomicStage p hp n
  let M := rationalPrimeChangedCyclotomicCompositum p hp n u
  let σ := wittCyclotomicDiagonalFieldFrobenius
    (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n a b ha hb hab
  have hx : x.val ∈ IntermediateField.adjoin E (L.toIntermediateField : Set Ω) := by
    have hx' := x.property
    change x.val ∈ IntermediateField.extendScalars
      (show E ≤ E ⊔ L.toIntermediateField from le_sup_left) at hx'
    rw [intermediateField_compositum_extendScalars_eq E L] at hx'
    exact hx'
  apply IntermediateField.adjoin_induction E
    (s := (L.toIntermediateField : Set Ω))
    (p := fun y _ => σ y ∈ M.toIntermediateField) (h := hx)
  · intro y hy
    have hσ : σ y ∈ L.toIntermediateField :=
      rationalPrimeDiagonalFrobenius_originalCyclotomicStage p hp n a b ha hb hab ⟨y, hy⟩
    change σ y ∈ E ⊔ L.toIntermediateField
    have hle : L.toIntermediateField ≤ E ⊔ L.toIntermediateField := le_sup_right
    exact hle hσ
  · intro y
    have hfix : σ y.val = y.val :=
      rationalPrimeDiagonalFrobenius_auxiliary p hp n a b u hu ha hb hab y
    rw [show σ (algebraMap E Ω y) = algebraMap E Ω y by simpa only using hfix]
    change y.val ∈ E ⊔ L.toIntermediateField
    have hle : E ≤ E ⊔ L.toIntermediateField := le_sup_left
    exact hle y.property
  · intro y z _ _ hy hz
    rw [map_add]
    exact M.toIntermediateField.add_mem hy hz
  · intro y _ hy
    rw [map_inv₀]
    exact M.toIntermediateField.inv_mem hy
  · intro y z _ _ hy hz
    rw [map_mul]
    exact M.toIntermediateField.mul_mem hy hz

/-- Restriction of the ambient diagonal Frobenius to the actual compositum,
as an endomorphism over the changed auxiliary field. -/
def rationalPrimeChangedCyclotomicDiagonalAlgHom
    (p : ℕ) (hp : p.Prime) (n a b : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a)
    (ha : a.Coprime
      ((Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)))
    (hb : b.Coprime
      ((Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)))
    (hab : a * b ≡ 1 [MOD
      (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)]) :
    rationalPrimeChangedCyclotomicCompositum p hp n u →ₐ[
      rationalPrimeChangedAuxiliaryField p hp n u]
      rationalPrimeChangedCyclotomicCompositum p hp n u where
  toRingHom :=
    ((wittCyclotomicDiagonalFieldFrobenius
      (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp))
      n a b ha hb hab).toRingHom.comp
      (rationalPrimeChangedCyclotomicCompositum p hp n u).toIntermediateField.val.toRingHom).codRestrict
        (rationalPrimeChangedCyclotomicCompositum p hp n u).toIntermediateField
        (rationalPrimeDiagonalFrobenius_changedCyclotomicCompositum
          p hp n a b u hu ha hb hab)
  commutes' x := by
    apply Subtype.ext
    exact rationalPrimeDiagonalFrobenius_auxiliary p hp n a b u hu ha hb hab x

/-- The restricted diagonal endomorphism is an automorphism.  Injectivity is
inherited from the ambient field automorphism; finite dimension of the actual
finite Galois stage supplies surjectivity. -/
def rationalPrimeChangedCyclotomicDiagonalAlgEquiv
    (p : ℕ) (hp : p.Prime) (n a b : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a)
    (ha : a.Coprime
      ((Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)))
    (hb : b.Coprime
      ((Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)))
    (hab : a * b ≡ 1 [MOD
      (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)]) :
    rationalPrimeChangedCyclotomicCompositum p hp n u ≃ₐ[
      rationalPrimeChangedAuxiliaryField p hp n u]
      rationalPrimeChangedCyclotomicCompositum p hp n u := by
  let f := rationalPrimeChangedCyclotomicDiagonalAlgHom
    p hp n a b u hu ha hb hab
  apply AlgEquiv.ofBijective f
  have hinj : Function.Injective f := by
    intro x y hxy
    apply Subtype.ext
    apply (wittCyclotomicDiagonalFieldFrobenius
      (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp))
      n a b ha hb hab).injective
    exact congrArg Subtype.val hxy
  have hsurj : Function.Surjective f.toLinearMap :=
    LinearMap.injective_iff_surjective.mp
      (show Function.Injective f.toLinearMap from hinj)
  exact ⟨hinj, hsurj⟩

/-- The same literal primitive root as an element of the actual compositum. -/
def rationalPrimeChangedCyclotomicCompositumRoot
    (p : ℕ) (hp : p.Prime) (n : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) :
    rationalPrimeChangedCyclotomicCompositum p hp n u := by
  let K := rationalPrimeLocalField p hp
  let Ω := wittCyclotomicField
    (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) n
  let E := rationalPrimeChangedAuxiliaryField p hp n u
  let L := rationalPrimeOriginalCyclotomicStage p hp n
  let ζ := rationalPrimeWittCyclotomicFieldPrimitiveRoot p hp n
  refine ⟨ζ, ?_⟩
  change ζ ∈ E ⊔ L.toIntermediateField
  have hζ : ζ ∈ L.toIntermediateField := by
    change ζ ∈ IntermediateField.adjoin K ({ζ} : Set Ω)
    exact IntermediateField.subset_adjoin K ({ζ} : Set Ω) (Set.mem_singleton ζ)
  have hle : L.toIntermediateField ≤ E ⊔ L.toIntermediateField := le_sup_right
  exact hle hζ

/-- On the actual compositum generator, the restricted automorphism retains
the required inverse-unit power action. -/
theorem rationalPrimeChangedCyclotomicDiagonalAlgEquiv_root
    (p : ℕ) (hp : p.Prime) (n a b : ℕ)
    (u : 𝒪[rationalPrimeLocalField p hp]ˣ) (hu : u.val = a)
    (ha : a.Coprime
      ((Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)))
    (hb : b.Coprime
      ((Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)))
    (hab : a * b ≡ 1 [MOD
      (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp)) ^ (n + 1)]) :
    rationalPrimeChangedCyclotomicDiagonalAlgEquiv p hp n a b u hu ha hb hab
        (rationalPrimeChangedCyclotomicCompositumRoot p hp n u) =
      (rationalPrimeChangedCyclotomicCompositumRoot p hp n u) ^ b := by
  apply Subtype.ext
  change wittCyclotomicDiagonalFieldFrobenius
      (Rat.HeightOneSpectrum.natGenerator (rationalPrimePlace p hp))
      n a b ha hb hab
      (rationalPrimeWittCyclotomicFieldPrimitiveRoot p hp n) =
    (rationalPrimeWittCyclotomicFieldPrimitiveRoot p hp n) ^ b
  exact rationalPrimeDiagonalFrobenius_primitiveRoot p hp n a b ha hb hab

end
end Dubon2026
