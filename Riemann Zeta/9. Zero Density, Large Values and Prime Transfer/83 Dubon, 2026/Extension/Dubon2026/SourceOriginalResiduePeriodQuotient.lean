import Dubon2026.SourceOriginalMeromorphicNormalizedJumps
import Dubon2026.SourceCellQuotientCycleReduction

/-! DUB-17/18 -> original Abel-Jacobi -> meromorphic loop-period generation.
Pass to the exact additive quotient by cell residue periods. Boundary endpoint
values and original edge integrals now take values in the group required by
the polygon calculation. Integer cycle sums commute with this quotient.
-/
namespace Dubon2026.SourceFunctionField.CellGeometry.MeromorphicPeriods
noncomputable section
open SourceCurve Set Complex KaehlerDifferential
open scoped Real
attribute [local instance] OriginalChart.placeTopology OriginalChart.placeChartedSpace
variable {N : ℕ} [NeZero N] {R : Type*}
local notation "F" => modularFunctionFieldOver N ℂ

/-- The additive subgroup generated by actual cell residue periods. -/
def Λres (D : CellDissection N) (S : Finset (Place ℂ F)) (θ : R → Ω[F⁄ℂ]) : AddSubgroup (R → ℂ) :=
  AddSubgroup.closure (Set.range fun C : D.ιC => (2 * π * I) • ρ D S θ C)

/-- Initial logarithmic boundary value modulo residue periods. -/
def Aq {D : CellDissection N} (S : Finset (Place ℂ F)) (θ : R → Ω[F⁄ℂ])
    (Ψ : R → D.ιC → ℂ → ℂ) (p : Σ C : D.ιC, Fin (D.cell C).R.N) :
    (R → ℂ) ⧸ Λres D S θ :=
  QuotientAddGroup.mk' _ (hfun S θ Ψ p.1 ((D.cell p.1).R.φs p.2.castSucc))

/-- Terminal logarithmic boundary value modulo residue periods. -/
def Bq {D : CellDissection N} (S : Finset (Place ℂ F)) (θ : R → Ω[F⁄ℂ])
    (Ψ : R → D.ιC → ℂ → ℂ) (p : Σ C : D.ιC, Fin (D.cell C).R.N) :
    (R → ℂ) ⧸ Λres D S θ :=
  QuotientAddGroup.mk' _ (hfun S θ Ψ p.1 ((D.cell p.1).R.φs p.2.succ))

/-- Actual differential edge integrals modulo residue periods. -/
def Iq {D : CellDissection N} (S : Finset (Place ℂ F)) (θ : R → Ω[F⁄ℂ])
    (e : D.ιE) : (R → ℂ) ⧸ Λres D S θ :=
  QuotientAddGroup.mk' _ fun r => D.edgeInt (θ r) e

/-- Original differential integrals along an exact integer cycle. -/
def zvθ {D : CellDissection N} (θ : R → Ω[F⁄ℂ]) (Z : D.ιE → D.ιE → ℤ)
    (l : D.ιE) : R → ℂ := fun r => ∑ e, (Z l e : ℂ) * D.edgeInt (θ r) e

theorem zvA_Iq {D : CellDissection N} (S : Finset (Place ℂ F)) (θ : R → Ω[F⁄ℂ])
    (Z : D.ιE → D.ιE → ℤ) (l : D.ιE) :
    ArcPeriods.zvA Z (Iq S θ) l = QuotientAddGroup.mk' _ (zvθ θ Z l) := by
  simp only [ArcPeriods.zvA, Iq, ← map_zsmul, ← map_sum]
  congr 1
  funext r
  simp only [zvθ, Finset.sum_apply, zsmul_eq_mul, Pi.mul_apply]
  rfl

end
end Dubon2026.SourceFunctionField.CellGeometry.MeromorphicPeriods
