import Dubon2026.PolarizedRelationNaturality
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! The actual coefficient ideal for polarized representations with fixed
component and similitude. It is generated by the literal source equations,
and its coefficient-map criterion is proved. This supplies the quotient
construction needed to reuse native framed universality for DUB-17. -/

namespace Dubon2026
open Matrix

variable {G R A ι : Type*} [Group G] [CommRing R] [CommRing A]
  [Fintype ι] [DecidableEq ι]

/-- Every entry of every original polarized relation generates the coefficient ideal. -/
@[irreducible] def representationPolarizedIdeal (τ : G →* GeneralLinearGroup (ι ⊕ ι) R)
    (χ : G →* Multiplicative (ZMod 2)) (ν : G →* Rˣ) : Ideal R :=
  Ideal.span (Set.range fun t : G × (ι ⊕ ι) × (ι ⊕ ι) =>
    polarizedRelationMatrix (τ t.1) (χ t.1) (ν t.1) t.2.1 t.2.2)

/-- Killing this actual ideal is equivalent to vanishing of the same specialized relations. -/
theorem representationPolarizedIdeal_le_kernel_iff_relations
    (τ : G →* GeneralLinearGroup (ι ⊕ ι) R)
    (χ : G →* Multiplicative (ZMod 2)) (ν : G →* Rˣ) (f : R →+* A) :
    representationPolarizedIdeal τ χ ν ≤ RingHom.ker f ↔
      ∀ g, polarizedRelationMatrix (GeneralLinearGroup.map f (τ g)) (χ g)
        (Units.map f.toMonoidHom (ν g)) = 0 := by
  unfold representationPolarizedIdeal
  constructor
  · intro hf g
    rw [← polarizedRelationMatrix_map]
    ext i j
    exact hf (Ideal.subset_span (Set.mem_range_self (g, i, j)))
  · intro hf
    apply Ideal.span_le.mpr
    rintro _ ⟨⟨g, i, j⟩, rfl⟩
    have hij := congrArg (fun M : Matrix (ι ⊕ ι) (ι ⊕ ι) A => M i j) (hf g)
    rw [← polarizedRelationMatrix_map] at hij
    exact hij

/-- The literal relation matrices express precisely the original polarized equations. -/
theorem polarizedMatrixEquations_iff_relations
    (τ : G →* GeneralLinearGroup (ι ⊕ ι) R)
    (χ : G →* Multiplicative (ZMod 2)) (ν : G →* Rˣ) :
    PolarizedMatrixEquations τ χ ν ↔
      ∀ g, polarizedRelationMatrix (τ g) (χ g) (ν g) = 0 := by
  apply forall_congr'
  intro g
  exact ((polarizedRelationMatrix_eq_zero_iff (τ g) (χ g) (ν g)).trans
    (polarizedBlockRepresentation_image_iff (τ g) (χ g) (ν g))).symm

/-- Original coefficient maps kill the exact polarized ideal precisely when they
produce the source's equations with the same component and specialized similitude. -/
theorem representationPolarizedIdeal_le_kernel_iff
    (τ : G →* GeneralLinearGroup (ι ⊕ ι) R)
    (χ : G →* Multiplicative (ZMod 2)) (ν : G →* Rˣ) (f : R →+* A) :
    representationPolarizedIdeal τ χ ν ≤ RingHom.ker f ↔
      PolarizedMatrixEquations ((GeneralLinearGroup.map f).comp τ) χ
        ((Units.map f.toMonoidHom).comp ν) := by
  rw [representationPolarizedIdeal_le_kernel_iff_relations, polarizedMatrixEquations_iff_relations]
  rfl

/-- The original coefficient quotient satisfies all required polarized equations. -/
theorem representationPolarizedIdeal_quotient_equations
    (τ : G →* GeneralLinearGroup (ι ⊕ ι) R)
    (χ : G →* Multiplicative (ZMod 2)) (ν : G →* Rˣ) :
    PolarizedMatrixEquations
      ((GeneralLinearGroup.map (Ideal.Quotient.mk (representationPolarizedIdeal τ χ ν))).comp τ) χ
      ((Units.map (Ideal.Quotient.mk (representationPolarizedIdeal τ χ ν)).toMonoidHom).comp ν) := by
  apply (representationPolarizedIdeal_le_kernel_iff τ χ ν _).mp
  intro r hr
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hr

end Dubon2026
