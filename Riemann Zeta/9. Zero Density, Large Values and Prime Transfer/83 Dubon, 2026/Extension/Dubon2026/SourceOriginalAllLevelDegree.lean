import Dubon2026.SourceOriginalAllLevelInduction

/-! DUB-17/18 -> numerical modular genus -> actual modular coordinate
degree. The original divisor field is generated by j and j_N at every
nonzero level, and its internal j-coordinate degree is dedekindPsi(N)
over every characteristic-zero coefficient field. The exact expanded
minimal polynomial has the primitive triangular conjugate product.
The joint induction discharges all generation, degree and nonmembership
inputs; existing coefficient transport supplies the actual internal field.
Modular ramification, fiber counts and numerical genus remain required.
-/
namespace Dubon2026.SourceFunctionField
noncomputable section
open Polynomial IntermediateField ConjugateSlots
open scoped IntermediateField

theorem original_full_eq_pair (N : ℕ) [NeZero N] :
    modularFunctionFieldFull N = IntermediateField.adjoin ℚ
      ({jq, qExpand ℚ N jq} : Set (LaurentSeries ℚ)) :=
  (original_full_generation_and_degree N).1

theorem original_full_rational_relfinrank_eq_psi (N : ℕ) [NeZero N] :
    relfinrank ℚ⟮jq⟯ (modularFunctionFieldFull N) = SourceLevelProjective.dedekindPsi N :=
  (original_full_generation_and_degree N).2

theorem finrank_original_over_j_eq_psi (N : ℕ) [NeZero N]
    (L : Type*) [Field L] [Algebra ℚ L] :
    Module.finrank (IntermediateField.adjoin L
      ({jOver N L} : Set (modularFunctionFieldOver N L)))
      (modularFunctionFieldOver N L) = SourceLevelProjective.dedekindPsi N := by
  rw [finrank_original_over_j_baseChange, original_full_rational_relfinrank_eq_psi]

theorem expandedJMinpoly_eq_slotProduct (N : ℕ) [NeZero N]
    {K : Type*} [Field K] [Algebra ℚ K] [IsAlgClosed K]
    (ζ : Kˣ) (hζ : IsPrimitiveRoot (ζ : K) N) :
    expandedJMinpoly K N N = slotProduct N ζ :=
  expandedJMinpoly_eq_slotProduct_of_divisor_induction N ζ hζ
    (fun d _ _ => original_full_generation_and_degree d)

end
end Dubon2026.SourceFunctionField
