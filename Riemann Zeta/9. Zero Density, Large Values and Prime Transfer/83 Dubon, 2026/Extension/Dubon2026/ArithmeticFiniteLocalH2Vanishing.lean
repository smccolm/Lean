import Dubon2026.ArithmeticFiniteLocalStage
import Dubon2026.ArithmeticFiniteLocalStageUnramified
import Dubon2026.SpectralUnramifiedAbsoluteH2Vanishing
import Dubon2026.UnramifiedUnionFiniteRamification
import Dubon2026.LocalFieldOriginalNorm

/-! # Actual arithmetic finite local stages have zero absolute H2 inflation away from S

The same arithmetic embedding constructs the local stage. Global unramifiedness,
the original localized integer map and proved integral-closure base change
supply its actual local unramifiedness. This connects the two field-level ends
of the DUB-17 local-support route; the cohomological arithmetic restriction
comparison is still a separate obligation.
-/

namespace Dubon2026
noncomputable section
open scoped NumberField ValuativeRel

attribute [local instance] arithmeticFiniteLocalStageAlgebra
  arithmeticFiniteLocalStageGalois arithmeticFiniteLocalStageRationalAlgebra

variable (a : 𝓞 ℚ) (F : FiniteGaloisIntermediateField ℚ (rationalUnramifiedExtension a))
  (p : ℕ) (hp : p.Prime) (q : ℕ) [Fact q.Prime]
  (A : Rep (ZMod q) Gal(rationalArithmeticFiniteLocalStage a F p hp / rationalPrimeLocalField p hp))
  [Finite A] [TopologicalSpace A] [IsTopologicalAddGroup A] [ContinuousSMul (ZMod q) A]
  (hA : Continuous (fun z : Gal(rationalArithmeticFiniteLocalStage a F p hp / rationalPrimeLocalField p hp) × A =>
    A.ρ z.1 z.2))

/-- For the actual local stage generated by the original arithmetic embedding,
absolute inflation of finite-coefficient H2 vanishes away from the exceptional
integer. Local unramifiedness and every necessary field structure are proved. -/
theorem arithmeticFiniteLocalStageH2_absolute_inflation_eq_zero
    (ha : a ≠ 0) (hpa : ¬(p : 𝓞 ℚ) ∣ a) (x : ContinuousRepresentationH2 A hA) :
    continuousRepresentationH2Restriction A hA
      (AlgEquiv.restrictNormalHom (rationalArithmeticFiniteLocalStage a F p hp) :
        Gal(rationalPrimeLocalClosure p hp / rationalPrimeLocalField p hp) →*
          Gal(rationalArithmeticFiniteLocalStage a F p hp / rationalPrimeLocalField p hp))
      (InfiniteGalois.restrictNormalHom_continuous
        (rationalArithmeticFiniteLocalStage a F p hp).toIntermediateField) x = 0 := by
  let K := rationalPrimeLocalField p hp
  let M := rationalArithmeticFiniteLocalStage a F p hp
  letI := IsTopologicalAddGroup.rightUniformSpace K
  haveI := isUniformAddGroup_of_addCommGroup (G := K)
  let normK := localFieldOriginalNorm K
  letI : NontriviallyNormedField K := normK
  letI : NormedField K := normK.toNormedField
  haveI : CompleteSpace K := localFieldOriginalNorm_complete K
  haveI : IsUltrametricDist K := localFieldOriginalNorm_isUltrametric K
  haveI : (NormedField.valuation (K := K)).Compatible := localFieldOriginalNorm_compatible K
  letI : NontriviallyNormedField M := spectralNorm.nontriviallyNormedField K M
  letI : NormedAlgebra K M := spectralNorm.normedAlgebra K M
  haveI : IsUltrametricDist M := IsUltrametricDist.of_normedAlgebra K
  letI : ValuativeRel M := ValuativeRel.ofValuation (NormedField.valuation (K := M))
  haveI : IsNonarchimedeanLocalField M := spectralFiniteExtension_isNonarchimedeanLocalField K M
  haveI : (ValuativeRel.valuation K).HasExtension (ValuativeRel.valuation M) :=
    spectralValuation_hasExtension K M
  have hunram : Algebra.FormallyUnramified 𝒪[K] 𝒪[M] :=
    arithmeticFiniteLocalStage_integer_unramified a F p hp ha hpa
  exact spectralUnramifiedH2_absolute_inflation_eq_zero M hunram q A hA x

end
end Dubon2026
