import Dubon2026.SourceEllipticCharTwoNegation
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.GroupTheory.Index

/-! The actual characteristic-two exceptional stabilizer modulo elliptic
negation has order twelve. Its kernel is the central subgroup of order two,
needed by the DUB-17/18 modular fixing-field and wild census arguments. -/
namespace Dubon2026.SourceEllipticCharTwo
open WeierstrassCurve SourceEllipticStabilizer
noncomputable section
variable {K : Type*} [Field K] [CharP K 2]

/-- The subgroup generated by actual elliptic negation. -/
def charTwoSignSubgroup : Subgroup (MulAction.stabilizer (VariableChange K) (ofJ0 K)) :=
  Subgroup.zpowers charTwoNegation

omit [CharP K 2] in
theorem charTwoSignSubgroup_card : Nat.card (charTwoSignSubgroup (K := K)) = 2 := by
  rw [charTwoSignSubgroup, Nat.card_zpowers, charTwoNegation_order]

omit [CharP K 2] in
theorem mem_charTwoSignSubgroup_iff (g : MulAction.stabilizer (VariableChange K) (ofJ0 K)) :
    g ∈ charTwoSignSubgroup ↔ g = 1 ∨ g = charTwoNegation := by
  classical
  have hf : IsOfFinOrder (charTwoNegation (K := K)) := by
    rw [← orderOf_pos_iff, charTwoNegation_order]
    norm_num
  rw [charTwoSignSubgroup, hf.mem_zpowers_iff_mem_range_orderOf, charTwoNegation_order]
  rw [show Finset.range 2 = {0, 1} by decide]
  simp

theorem charTwoSignSubgroup_normal : (charTwoSignSubgroup (K := K)).Normal := by
  have hc : charTwoSignSubgroup (K := K) ≤
      Subgroup.center (MulAction.stabilizer (VariableChange K) (ofJ0 K)) :=
    Subgroup.zpowers_le.mpr charTwoNegation_central
  constructor
  intro a ha b
  have he := Subgroup.mem_center_iff.mp (hc ha) b
  simpa only [he, mul_assoc, mul_inv_cancel, mul_one] using ha

theorem charTwoSignSubgroup_index [IsAlgClosed K] :
    (charTwoSignSubgroup (K := K)).index = 12 := by
  have h := (charTwoSignSubgroup (K := K)).index_mul_card
  rw [charTwoSignSubgroup_card, char_two_stabilizer_card] at h
  omega

theorem charTwoSignQuotient_card [IsAlgClosed K] :
    Nat.card ((MulAction.stabilizer (VariableChange K) (ofJ0 K)) ⧸ charTwoSignSubgroup) = 12 := by
  exact charTwoSignSubgroup_index

end
end Dubon2026.SourceEllipticCharTwo
