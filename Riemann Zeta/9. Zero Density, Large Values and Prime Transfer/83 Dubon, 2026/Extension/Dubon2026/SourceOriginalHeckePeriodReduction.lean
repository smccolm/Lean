import Dubon2026.SourceHeckePairingFinite
import Dubon2026.SourceIntegralModularSymbols
import Dubon2026.HeckeAllIndices
import Mathlib.RingTheory.IntegralClosure.Algebra.Basic

/-! The period route applied to the original classical Hecke operators.
DUB-17 Theorem 2.6 and DUB-18 Corollary 8.2 require the actual primitive-form
Galois association along the higher symmetric-power continuation route.
This fixes the original Gamma0 cusp space, the actual integral modular symbols,
and the already proved classical Hecke operators. Manin generation supplies
finite integral cycles. An injective period map and its actual adjoint operators
are explicit inputs of this reduction. They are discharged in SourceOriginalIntegralHecke.
-/

namespace Dubon2026
noncomputable section
open Matrix.SpecialLinearGroup CongruenceSubgroup MvPolynomial
open scoped MatrixGroups

/-- The original integral algebra generated by every positive-index classical Hecke operator. -/
def sourceOriginalIntegralHeckeAlgebra (Q : ℕ) [NeZero Q] (k : ℤ) :
    Subalgebra ℤ (Module.End ℂ (CuspForm ((Gamma0 Q).map (mapGL ℝ)) k)) :=
  Algebra.adjoin ℤ (Set.range fun n : ℕ+ => cuspHeckeLinear Q k (n : ℕ))

/-- The original Gamma0 integral modular-symbol module is finite, with the actual source weight. -/
theorem sourceOriginalIntegralModularSymbols_finite (Q : ℕ) [NeZero Q] (k : ℤ) :
    Module.Finite ℤ (SourceModularSymbols ℤ (Gamma0 Q) (k - 2).toNat) :=
  sourceIntegralModularSymbols_finite (Gamma0 Q) (k - 2).toNat

/-- Actual period injectivity and Hecke adjointness imply finite integral Hecke algebra; finite cycles are derived, and no commutativity or lattice premise is required. -/
theorem sourceOriginalIntegralHeckeAlgebra_finite_of_period
    (Q : ℕ) [NeZero Q] (k : ℤ)
    (P : CuspForm ((Gamma0 Q).map (mapGL ℝ)) k →ₗ[ℂ]
      (SourceModularSymbols ℤ (Gamma0 Q) (k - 2).toNat →ₗ[ℤ] ℂ))
    (hP : Function.Injective P)
    (u : ℕ+ → Module.End ℤ (SourceModularSymbols ℤ (Gamma0 Q) (k - 2).toNat))
    (h : ∀ (n : ℕ+) f x, P (cuspHeckeLinear Q k (n : ℕ) f) x = P f (u n x)) :
    Module.Finite ℤ (sourceOriginalIntegralHeckeAlgebra Q k) := by
  letI := sourceOriginalIntegralModularSymbols_finite Q k
  exact sourceOperatorAlgebra_finite_of_pairing (P.restrictScalars ℤ) hP
    (fun n : ℕ+ => cuspHeckeLinear Q k (n : ℕ)) u h

/-- With the actual period inputs, every original positive-index Hecke operator is integral over the integers. -/
theorem sourceOriginalHecke_isIntegral_of_period
    (Q : ℕ) [NeZero Q] (k : ℤ)
    (P : CuspForm ((Gamma0 Q).map (mapGL ℝ)) k →ₗ[ℂ]
      (SourceModularSymbols ℤ (Gamma0 Q) (k - 2).toNat →ₗ[ℤ] ℂ))
    (hP : Function.Injective P)
    (u : ℕ+ → Module.End ℤ (SourceModularSymbols ℤ (Gamma0 Q) (k - 2).toNat))
    (h : ∀ (n : ℕ+) f x, P (cuspHeckeLinear Q k (n : ℕ) f) x = P f (u n x))
    (n : ℕ+) :
    IsIntegral ℤ (cuspHeckeLinear Q k (n : ℕ)) := by
  letI := sourceOriginalIntegralHeckeAlgebra_finite_of_period Q k P hP u h
  have hn : cuspHeckeLinear Q k (n : ℕ) ∈ sourceOriginalIntegralHeckeAlgebra Q k :=
    Algebra.subset_adjoin ⟨n, rfl⟩
  exact (IsIntegral.of_finite ℤ
    (⟨cuspHeckeLinear Q k (n : ℕ), hn⟩ : sourceOriginalIntegralHeckeAlgebra Q k)).map
      (sourceOriginalIntegralHeckeAlgebra Q k).val

end
end Dubon2026
