import Dubon2026.FiniteBaseRealConjugation
import Dubon2026.OriginalRealComplexPeriodSign

/-! The original real absolute Galois restriction lands in the actual
finite totally real base group. This identifies the actual infinite-place
cohomology input on DUB-17's polarized arithmetic deformation route. -/

namespace Dubon2026
open NumberField
open scoped NumberField
noncomputable section

/-- Retain the original arithmetic union algebra for real restriction. -/
local instance finiteBaseRealRestrictionUnionAlgebra (a : 𝓞 ℚ) :
    Algebra ℚ (rationalUnramifiedExtension a) := (rationalUnramifiedExtension a).algebra'

variable (a : 𝓞 ℚ) (F : IntermediateField ℚ (rationalUnramifiedExtension a))
  [FiniteDimensional ℚ F] [IsTotallyReal F]

/-- Every original real automorphism fixes the original totally real finite base. -/
theorem finiteBaseRealRestriction_mem (g : Gal(ℂ/ℝ)) :
    rationalRealArithmeticRestriction a g ∈ F.fixingSubgroup := by
  obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp (originalRealComplexConjugation_generates g)
  rw [map_zpow]
  exact F.fixingSubgroup.zpow_mem (finiteBaseRealConjugation a F).property m

/-- The actual real absolute Galois group restricts continuously to the original finite-base arithmetic group. -/
def finiteBaseRealArithmeticRestriction : Gal(ℂ/ℝ) →ₜ* finiteBaseArithmeticGaloisGroup a F :=
  ⟨(rationalRealArithmeticRestriction a).toMonoidHom.codRestrict F.fixingSubgroup
    (finiteBaseRealRestriction_mem a F),
    (rationalRealArithmeticRestriction a).continuous.subtype_mk _⟩

/-- The same original complex conjugation is retained by the actual real restriction. -/
theorem finiteBaseRealArithmeticRestriction_conjugation :
    finiteBaseRealArithmeticRestriction a F Complex.conjAe = finiteBaseRealConjugation a F := rfl

/-- The actual real restriction is generated by the same original arithmetic conjugation. -/
theorem finiteBaseRealArithmeticRestriction_generated (g : Gal(ℂ/ℝ)) :
    finiteBaseRealArithmeticRestriction a F g ∈ Subgroup.zpowers (finiteBaseRealConjugation a F) := by
  obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp (originalRealComplexConjugation_generates g)
  rw [map_zpow, finiteBaseRealArithmeticRestriction_conjugation]
  exact (Subgroup.zpowers _).zpow_mem (Subgroup.mem_zpowers _) m

end
end Dubon2026
