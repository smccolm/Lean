import Dubon2026.SourceRadialMeromorphicNormalizedJumps
import Dubon2026.SourceRadialQuotientCycleReduction

/-! DUB-17/18 -> cover Abel converse -> meromorphic loop generation.
Use the additive quotient by the actual cell residue periods. Integer cycle
sums commute with the quotient; no complex vector-space structure is assumed
on that quotient. Actual coefficients and residues are supplied downstream. -/
namespace Dubon2026.SourceFunctionField.CellGeometry.RadialMeromorphicPeriods
noncomputable section
open Set Complex
open scoped Real
variable {X R : Type*} [TopologicalSpace X]

/-- The subgroup generated by the residue period of each radial cell. -/
def Λres (D : RadialCellDissection X) (S : Finset X) (residue : X → R → ℂ) : AddSubgroup (R → ℂ) :=
  AddSubgroup.closure (Set.range fun C : D.ιC => (2 * π * I) • ρ D S residue C)

/-- Initial logarithmic boundary value in the residue quotient. -/
def Aq {D : RadialCellDissection X} (S : Finset X) (residue : X → R → ℂ)
    (Ψ : R → D.ιC → ℂ → ℂ) (p : Σ C : D.ιC, Fin (D.cell C).R.N) :
    (R → ℂ) ⧸ Λres D S residue :=
  QuotientAddGroup.mk' _ (hfun S residue Ψ p.1 ((D.cell p.1).R.φs p.2.castSucc))

/-- Terminal logarithmic boundary value in the residue quotient. -/
def Bq {D : RadialCellDissection X} (S : Finset X) (residue : X → R → ℂ)
    (Ψ : R → D.ιC → ℂ → ℂ) (p : Σ C : D.ιC, Fin (D.cell C).R.N) :
    (R → ℂ) ⧸ Λres D S residue :=
  QuotientAddGroup.mk' _ (hfun S residue Ψ p.1 ((D.cell p.1).R.φs p.2.succ))

/-- Edge-integral vectors in the residue quotient. -/
def Iq {D : RadialCellDissection X} (S : Finset X) (residue : X → R → ℂ)
    (I : D.ιE → R → ℂ) (e : D.ιE) : (R → ℂ) ⧸ Λres D S residue :=
  QuotientAddGroup.mk' _ (I e)

theorem zvA_Iq {D : RadialCellDissection X} (S : Finset X) (residue : X → R → ℂ)
    (I : D.ιE → R → ℂ) (Z : D.ιE → D.ιE → ℤ) (l : D.ιE) :
    RadialArcPeriods.zvA Z (Iq S residue I) l =
      QuotientAddGroup.mk' _ (RadialDissectionPeriods.zv Z I l) := by
  simp only [RadialArcPeriods.zvA, Iq, ← map_zsmul, ← map_sum]
  congr 1
  funext r
  simp only [RadialDissectionPeriods.zv, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, zsmul_eq_mul]
  rfl

end
end Dubon2026.SourceFunctionField.CellGeometry.RadialMeromorphicPeriods
