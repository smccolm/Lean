import Dubon2026.SymmetricRegularTraceFixedDimension
import Dubon2026.AdjointRepresentationRestriction

/-! The local finite image already returned at an auxiliary prime controls
the actual trace-zero invariant dimension. Specified Frobenius generation
and the original symmetric regular conjugacy suffice for DUB-17. -/

namespace Dubon2026
noncomputable section
open Matrix
open scoped MatrixGroups

/-- If the original image is generated by a specified element, invariants
of its actual pullback action are exactly that element's fixed vectors. -/
theorem representation_comp_invariants_eq_generator_ker
    {R G H V : Type} [CommRing R] [Group G] [Group H] [AddCommGroup V] [Module R V]
    (T : Representation R H V) (f : G →* H) (γ : G)
    (hgen : ∀ g, f g ∈ Subgroup.zpowers (f γ)) :
    Representation.invariants (T.comp f) = LinearMap.ker (T (f γ) - 1) := by
  apply le_antisymm
  · intro x hx
    exact sub_eq_zero.mpr (hx γ)
  · intro x hx g
    have hxγ : T (f γ) x = x := sub_eq_zero.mp hx
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hgen g)
    change T (f g) x = x
    rw [← hn]
    clear hn hgen g
    induction n with
    | zero => simp
    | succ n ih => simp_all [zpow_add_one]
    | pred n ih =>
      simpa [neg_sub_comm _ (1 : ℤ), zpow_sub] using congr(T (f γ)⁻¹ $(ih.trans hxγ.symm))

/-- A cyclic original local matrix image with the specified regular
symmetric Frobenius has invariant trace-zero dimension equal to the
symmetric degree. Conjugacy may be in the whole original general linear group. -/
theorem matrixTrace_invariants_finrank_of_symmetric_generator
    {K G : Type} [Field K] [Group G] (n : ℕ)
    (ρ : G →* GeneralLinearGroup (Fin (n + 1)) K) (γ : G)
    (hgen : ∀ g, ρ g ∈ Subgroup.zpowers (ρ γ))
    (u : Kˣ) (hu : 2 * n < orderOf u)
    (hconj : IsConj (ρ γ) (homogeneousSymmetricGL n
      (SpecialLinearGroup.toGL (ringSL2UnitDiagonal u)))) :
    Module.finrank K (matrixTraceZeroAdjointRep ρ).ρ.invariants = n := by
  let B := homogeneousSymmetricGL n (SpecialLinearGroup.toGL (ringSL2UnitDiagonal u))
  let T := matrixTraceZeroAdjointRepresentation
    (MonoidHom.id (GeneralLinearGroup (Fin (n + 1)) K))
  have he : (matrixTraceZeroAdjointRep ρ).ρ = T.comp ρ := by
    exact (matrixTraceZeroAdjointRepresentation_comp (MonoidHom.id _) ρ).symm
  rw [he, representation_comp_invariants_eq_generator_ker T ρ γ hgen]
  obtain ⟨C, hC⟩ := isConj_iff.mp hconj
  have hc := representationConjugateFixed_finrank T (ρ γ) C
  rw [hC] at hc
  rw [← hc]
  have hd := matrixDistinctDiagonalTraceFixed_finrank (MonoidHom.id _) B
    (fun i : Fin (n + 1) => (u : K) ^ i.val * (↑u⁻¹ : K) ^ (n - i.val))
    (symmetric_unit_weights_injective u n hu) (homogeneousSymmetricGL_unitDiagonal u n)
  rw [Fintype.card_fin] at hd
  exact Nat.add_right_cancel hd

end
end Dubon2026
