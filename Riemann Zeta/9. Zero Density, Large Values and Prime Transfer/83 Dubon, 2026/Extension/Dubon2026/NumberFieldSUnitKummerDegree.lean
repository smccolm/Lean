import Dubon2026.NumberFieldSUnitKummerFinite
import Dubon2026.OriginalKummerDegree

/-! # Exact degree of the original full S-unit Kummer extension

The original S-unit rank, original power quotient and nondegenerate
original radical pairing now calculate the degree of the constructed
field. This discharges the finite Kummer degree input to the global
class-field norm-index route for DUB-17, without assuming that formula.
-/

namespace Dubon2026
noncomputable section
open IsDedekindDomain
open scoped NumberField
variable (K Ω : Type) [Field K] [NumberField K] [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [IsGalois K Ω]

/-- The actual field generated by all original S-unit radicals has its exact required degree. -/
theorem numberField_sUnit_kummerField_finrank
    (S : Set (HeightOneSpectrum (𝓞 K))) (hS : S.Finite)
    (n : ℕ) (hn : 0 < n) (ζ : K) (hζ : IsPrimitiveRoot ζ n) :
    Module.finrank K (originalKummerRadicalField (Ω := Ω) n
      (S.unit K ⊔ (powMonoidHom (α := Kˣ) n).range)) =
      n ^ (Fintype.card (NumberField.InfinitePlace K) + S.ncard) := by
  letI := numberField_sUnit_kummerClasses_finite K S hS n hn.ne'
  rw [originalKummerRadicalField_finrank n hn
    ⟨ζ, (mem_primitiveRoots hn).mpr hζ⟩]
  exact numberField_sUnit_kummerClasses_card K S hS n hn.ne' ζ hζ

/-- The actual Galois group of the original full S-unit radical field has the same exact cardinality. -/
theorem numberField_sUnit_kummerField_galois_card
    (S : Set (HeightOneSpectrum (𝓞 K))) (hS : S.Finite)
    (n : ℕ) (hn : 0 < n) (ζ : K) (hζ : IsPrimitiveRoot ζ n) :
    Nat.card Gal(originalKummerRadicalField (Ω := Ω) n
      (S.unit K ⊔ (powMonoidHom (α := Kˣ) n).range)/K) =
      n ^ (Fintype.card (NumberField.InfinitePlace K) + S.ncard) := by
  letI := numberField_sUnit_kummerClasses_finite K S hS n hn.ne'
  rw [originalKummerRadicalField_galois_card n hn
    ⟨ζ, (mem_primitiveRoots hn).mpr hζ⟩]
  exact numberField_sUnit_kummerClasses_card K S hS n hn.ne' ζ hζ

end
end Dubon2026
