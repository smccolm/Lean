import Mathlib.Analysis.Calculus.IteratedDeriv.Lemmas
import Mathlib.Analysis.Analytic.OfScalars
import Mathlib.Analysis.Analytic.Uniqueness
import Mathlib.RingTheory.PowerSeries.Basic
import Mathlib.Tactic

/-! DUB-17/18 -> original torsion cardinality -> cusp parameters.
The original cusp embeddings are generated by explicit convergent j
series. Taylor expansions of analytic germs respect sums and products;
their quotients will therefore realize this actual cusp field directly.
Native Taylor convergence and uniqueness replace a general algebraic
power-series convergence theorem. Only the scalar complex germ at zero
needed by this cusp construction is treated here.
-/
namespace Dubon2026.SourceFunctionField.CuspTaylor
noncomputable section
open Filter
open scoped Topology

/-- The actual Taylor coefficients of a complex function at zero. -/
def series (f : ℂ → ℂ) : PowerSeries ℂ :=
  PowerSeries.mk fun n => iteratedDeriv n f 0 / n.factorial

theorem coeff_series (f : ℂ → ℂ) (n : ℕ) :
    (series f).coeff n = iteratedDeriv n f 0 / n.factorial := PowerSeries.coeff_mk _ _

theorem hasFPowerSeriesAt_series {f : ℂ → ℂ} (hf : AnalyticAt ℂ f 0) :
    HasFPowerSeriesAt f (FormalMultilinearSeries.ofScalars ℂ (fun n => (series f).coeff n)) 0 := by
  simpa only [coeff_series] using hf.hasFPowerSeriesAt

theorem series_const (c : ℂ) : series (fun _ : ℂ => c) = PowerSeries.C c := by
  ext n
  by_cases hn : n = 0
  · subst n
    simp [coeff_series]
  · simp [coeff_series, iteratedDeriv_const, hn, PowerSeries.coeff_C]

theorem series_add {f g : ℂ → ℂ} (hf : AnalyticAt ℂ f 0) (hg : AnalyticAt ℂ g 0) :
    series (f + g) = series f + series g := by
  ext n
  simp only [coeff_series, map_add, iteratedDeriv_add hf.contDiffAt hg.contDiffAt, add_div]

theorem series_mul {f g : ℂ → ℂ} (hf : AnalyticAt ℂ f 0) (hg : AnalyticAt ℂ g 0) :
    series (f * g) = series f * series g := by
  ext n
  simp only [coeff_series, iteratedDeriv_mul hf.contDiffAt hg.contDiffAt,
    Finset.sum_div, PowerSeries.coeff_mul,
    Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk, Nat.succ_eq_add_one]
  refine Finset.sum_congr rfl fun i hi => ?_
  rw [Nat.cast_choose _ (by simpa only [Finset.mem_range, Nat.lt_succ_iff] using hi)]
  field_simp [Nat.factorial_ne_zero]

theorem series_eq_of_eventuallyEq {f g : ℂ → ℂ}
    (hf : AnalyticAt ℂ f 0) (hg : AnalyticAt ℂ g 0) (he : f =ᶠ[𝓝 (0 : ℂ)] g) :
    series f = series g := by
  have h := (hasFPowerSeriesAt_series hf).eq_formalMultilinearSeries_of_eventually
    (hasFPowerSeriesAt_series hg) he
  have hc := FormalMultilinearSeries.ofScalars_series_injective ℂ ℂ h
  ext n
  exact congrFun hc n

theorem series_eq_zero_iff {f : ℂ → ℂ} (hf : AnalyticAt ℂ f 0) :
    series f = 0 ↔ f =ᶠ[𝓝 (0 : ℂ)] 0 := by
  constructor
  · intro h
    have hs := hasFPowerSeriesAt_series hf
    rw [h] at hs
    have hs0 : HasFPowerSeriesAt f (0 : FormalMultilinearSeries ℂ ℂ ℂ) 0 := by
      simp only [map_zero] at hs
      change HasFPowerSeriesAt f (FormalMultilinearSeries.ofScalars ℂ (0 : ℕ → ℂ)) 0 at hs
      rwa [FormalMultilinearSeries.ofScalars_series_eq_zero_of_scalar_zero ℂ ℂ] at hs
    exact hs0.eventually_eq_zero
  · intro h
    have hz := series_eq_of_eventuallyEq hf (analyticAt_const : AnalyticAt ℂ (0 : ℂ → ℂ) 0) h
    change series f = series (fun _ : ℂ => (0 : ℂ)) at hz
    rw [series_const] at hz
    exact hz.trans (map_zero PowerSeries.C)

end
end Dubon2026.SourceFunctionField.CuspTaylor
