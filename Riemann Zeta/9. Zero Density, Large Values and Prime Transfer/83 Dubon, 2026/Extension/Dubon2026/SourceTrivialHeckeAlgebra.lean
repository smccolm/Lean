import Dubon2026.SourceTrivialIntegralHecke
import Mathlib.Algebra.FreeAlgebra

/-! DUB-17/18 -> residual Galois association -> characteristic-zero
weight-two lifting -> the genuine finite integral Hecke algebra.
Its generators are the existing full native trivial-H1 operators.
Finiteness and commutativity are derived from the already proved native
cohomology finiteness and actual prime-correspondence commutativity.
-/

namespace Dubon2026
noncomputable section
open CongruenceSubgroup groupCohomology

/-- The actual integral operator algebra generated by all original good-prime
Hecke correspondences on full trivial-coefficient H1. -/
def sourceTrivialHeckeAlgebra (Q : ℕ) :
    Subalgebra ℤ (Module.End ℤ (H1 (Rep.trivial ℤ (Gamma0 Q) ℤ))) :=
  Algebra.adjoin ℤ (Set.range (sourceTrivialRingHeckeOperators ℤ Q))

/-- The original full integral weight-two Hecke algebra is finite over Z. -/
theorem sourceTrivialHeckeAlgebra_finite (Q : ℕ) [NeZero Q] :
    Module.Finite ℤ (sourceTrivialHeckeAlgebra Q) := by
  letI := sourceTrivialH1_finite ℤ Q
  letI : IsNoetherian ℤ (H1 (Rep.trivial ℤ (Gamma0 Q) ℤ)) :=
    isNoetherian_of_isNoetherianRing_of_finite ℤ _
  letI : IsNoetherian ℤ (Module.End ℤ (H1 (Rep.trivial ℤ (Gamma0 Q) ℤ))) := by
    convert isNoetherian_linearMap ℤ (H1 (Rep.trivial ℤ (Gamma0 Q) ℤ))
      (H1 (Rep.trivial ℤ (Gamma0 Q) ℤ)) using 1
    exact Subsingleton.elim _ _
  exact Module.Finite.of_injective (sourceTrivialHeckeAlgebra Q).val.toLinearMap
    Subtype.val_injective

/-- The actual integral weight-two Hecke algebra is commutative, by the
proved full original prime-correspondence calculation. -/
theorem sourceTrivialHeckeAlgebra_commutative (Q : ℕ) :
    IsMulCommutative (sourceTrivialHeckeAlgebra Q) :=
  Algebra.isMulCommutative_adjoin ℤ (by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
    exact (sourceTrivialRingHeckeOperators_commute ℤ Q i j).eq)

/-- An integral Hecke word as an element of the original operator algebra. -/
def sourceTrivialIntegralHeckeWord (Q : ℕ) :
    FreeAlgebra ℤ (sourceBinaryHeckePrime Q) →ₐ[ℤ] sourceTrivialHeckeAlgebra Q :=
  (Subalgebra.equivOfEq _ _
    (Algebra.adjoin_range_eq_range_freeAlgebra_lift ℤ
      (X := sourceBinaryHeckePrime Q) (sourceTrivialRingHeckeOperators ℤ Q))).symm.toAlgHom.comp
      (FreeAlgebra.lift ℤ (sourceTrivialRingHeckeOperators ℤ Q)).rangeRestrict

/-- The original integral word has exactly its full native operator value. -/
theorem sourceTrivialIntegralHeckeWord_coe (Q : ℕ)
    (a : FreeAlgebra ℤ (sourceBinaryHeckePrime Q)) :
    (sourceTrivialIntegralHeckeWord Q a : Module.End ℤ (H1 (Rep.trivial ℤ (Gamma0 Q) ℤ))) =
      FreeAlgebra.lift ℤ (sourceTrivialRingHeckeOperators ℤ Q) a := rfl

/-- Every element of the actual integral Hecke algebra is represented by
an integral word in its genuine good-prime generators. -/
theorem sourceTrivialIntegralHeckeWord_surjective (Q : ℕ) :
    Function.Surjective (sourceTrivialIntegralHeckeWord Q) :=
  (Subalgebra.equivOfEq _ _
    (Algebra.adjoin_range_eq_range_freeAlgebra_lift ℤ
      (X := sourceBinaryHeckePrime Q) (sourceTrivialRingHeckeOperators ℤ Q))).symm.surjective.comp
        (AlgHom.rangeRestrict_surjective _)

end
end Dubon2026
