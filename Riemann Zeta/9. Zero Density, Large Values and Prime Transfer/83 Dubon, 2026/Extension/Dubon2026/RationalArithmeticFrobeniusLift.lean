/-! Lift the actual finite Frobenius class to the original prime-local
arithmetic restriction. This removes the local representative assumption
from the DUB-17 auxiliary-prime detection chain. -/

namespace Dubon2026
noncomputable section
open scoped NumberField
attribute [-instance] SubfieldClass.instSMulRat AlgebraicClosure.instSMulOfIsScalarTower
  UniformSpace.Completion.instSMul
attribute [local instance] arithmeticOrbitLocalUnionAlgebra arithmeticOrbitFieldRationalAlgebra
  arithmeticOrbitCompletionNumberField arithmeticOrbitCompletionBaseAlgebra
  arithmeticOrbitCompletionValuation arithmeticOrbitCompletionTopology arithmeticOrbitCompletionLocalField
  arithmeticOrbitCompletionValuationExtension arithmeticOrbitCompletionUniformity arithmeticOrbitCompletionUniformAdd
  arithmeticOrbitCompletionTargetAlgebra arithmeticOrbitCompletionClosureAlgebra
  arithmeticOrbitCompletionGlobalAlgebra
  rationalOriginalCompletionTargetAlgebra rationalOriginalCompletionClosureAlgebra
  rationalOriginalCompletionClosureTower rationalArithmeticOriginalPrimeLiesOver
  originalAdicRelationCompletionAlgebra originalAdicLocalRelationGalois originalAdicLocalRelationCupFinite
  rationalArithmeticOriginalCompletion_closureTower rationalOriginalCompletionGalois
  rationalArithmeticOriginalFiniteGalois

/-- The original place is the literal principal ideal generated by the
same rational prime integer. -/
theorem rationalOriginalPrimePlace_eq_span (p : ℕ) (hp : p.Prime) :
    (rationalOriginalPrimePlace p hp).asIdeal = Ideal.span {(p : 𝓞 ℚ)} := by
  ext x
  rw [rationalOriginalPrimePlace_mem_iff, Ideal.mem_span_singleton]

/-- Every unramified finite Frobenius class has a representative in the
image of the original prime-local arithmetic Galois group. The actual
finite field, local closure and chosen embedding are preserved. -/
theorem rationalArithmetic_exists_local_frobenius
    (a : 𝓞 ℚ) (p : ℕ) (hp : p.Prime)
    (F : FiniteGaloisIntermediateField ℚ (rationalUnramifiedExtension a))
    (hunr : Chebotarev.UnramifiedIn ℚ F (Ideal.span {(p : 𝓞 ℚ)})) :
    ∃ g : Gal(rationalPrimeLocalClosure p hp / rationalPrimeLocalField p hp),
      Chebotarev.frobeniusClass ℚ F (Ideal.span {(p : 𝓞 ℚ)}) =
        ConjClasses.mk (AlgEquiv.restrictNormalHom F
          (rationalPrimeArithmeticRestriction a p hp g)) := by
  have hunr' : Chebotarev.UnramifiedIn ℚ F (rationalOriginalPrimePlace p hp).asIdeal := by
    rwa [rationalOriginalPrimePlace_eq_span]
  obtain ⟨σ, hσ⟩ := originalCompletion_exists_frobenius ℚ F
    (rationalOriginalPrimePlace p hp) (rationalArithmeticOriginalPrime a p hp F) hunr'
  let V := (rationalOriginalPrimePlace p hp).adicCompletion ℚ
  let W := (rationalArithmeticOriginalPrime a p hp F).adicCompletion F
  let Ω := rationalPrimeLocalClosure p hp
  obtain ⟨τ, hτ⟩ := AlgEquiv.restrictNormalHom_surjective (F := V) (K₁ := W) Ω σ
  let g := (rationalOriginalCompletionGaloisEquiv p hp).symm τ
  have hrestrict : galoisBaseChangeRestriction V (rationalPrimeLocalField p hp) W Ω g = σ := by
    change AlgEquiv.restrictNormalHom W
      ((rationalOriginalCompletionGaloisEquiv p hp) g) = σ
    rw [(rationalOriginalCompletionGaloisEquiv p hp).apply_symm_apply]
    exact hτ
  refine ⟨g, ?_⟩
  rw [← rationalArithmeticOriginalCompletion_galois_restriction a p hp F g, hrestrict]
  simpa only [rationalOriginalPrimePlace_eq_span] using hσ

end
end Dubon2026
