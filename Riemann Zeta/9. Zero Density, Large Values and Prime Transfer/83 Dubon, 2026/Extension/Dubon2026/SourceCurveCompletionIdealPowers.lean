import Dubon2026.SourceCurveCompletionNorm
import Dubon2026.SourceCurveUniformizerResidue

/-! The original uniformizer generates the actual completed maximal
ideal, and its powers detect the literal completed valuation. This
identifies completed ramification with original ramification, needed to
prove the dimension of the product of completions in the DUB-17/18
field-trace sum over places. Native valuation-ring divisibility supplies
the ideal membership criterion. -/

noncomputable section

namespace Dubon2026.SourceCurve.Place

open IsDedekindDomain WithZero

variable {K F : Type*} [Field K] [Field F] [Algebra K F] (v : Place K F)

/-- The original uniformizer, embedded in the actual completed integral ring. -/
def completionUniformizer : v.adicCompletionIntegers :=
  algebraMap v.toValuationSubring v.adicCompletionIntegers v.uniformizerSubring

/-- The embedded original uniformizer has the same normalized valuation. -/
theorem valued_completionUniformizer :
    Valued.v (v.completionUniformizer : v.adicCompletion) = exp (-1 : ℤ) := by
  change Valued.v (algebraMap F v.adicCompletion v.uniformizer) = _
  rw [v.valued_completion_algebraMap]
  exact v.adicValuation_coe_irreducible v.irreducible_uniformizerSubring

/-- The actual completed maximal ideal is generated by the original uniformizer. -/
theorem completion_maximalIdeal_eq_span :
    IsLocalRing.maximalIdeal v.adicCompletionIntegers = Ideal.span {v.completionUniformizer} := by
  letI := v.completionValuation_nontrivial
  have hu : (Valued.v : Valuation v.adicCompletion ℤᵐ⁰).IsUniformizer
      (v.completionUniformizer : v.adicCompletion) := by
    rw [Valuation.IsUniformizer.iff,
      Valuation.IsRankOneDiscrete.generator_eq_exp_neg_one_of_surjective
        (v.heightOneSpectrum.valuedAdicCompletion_surjective F)]
    exact v.valued_completionUniformizer
  exact hu.is_generator

/-- Powers of the actual completed maximal ideal are exactly the corresponding valuation balls. -/
theorem mem_completion_maximalIdeal_pow (x : v.adicCompletionIntegers) (n : ℕ) :
    x ∈ IsLocalRing.maximalIdeal v.adicCompletionIntegers ^ n ↔
      Valued.v (x : v.adicCompletion) ≤ exp (-(n : ℤ)) := by
  rw [v.completion_maximalIdeal_eq_span, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  rw [(HeightOneSpectrum.adicCompletionIntegers.integers (K := F)
    (v := v.heightOneSpectrum)).dvd_iff_le]
  change Valued.v (x : v.adicCompletion) ≤ Valued.v ((v.completionUniformizer : v.adicCompletion) ^ n) ↔ _
  rw [map_pow, v.valued_completionUniformizer, ← exp_nsmul]
  simp only [nsmul_eq_mul, mul_neg_one]

end Dubon2026.SourceCurve.Place
