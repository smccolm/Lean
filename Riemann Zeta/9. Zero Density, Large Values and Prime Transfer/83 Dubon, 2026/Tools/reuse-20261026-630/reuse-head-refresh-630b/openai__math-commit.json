      "blob_url": "https://github.com/openai/math/blob/1581d4cbdd69a0faf34b2089614fe2a814316a6a/.github%2Fworkflows%2Flock-prs.yml",
      "raw_url": "https://github.com/openai/math/raw/1581d4cbdd69a0faf34b2089614fe2a814316a6a/.github%2Fworkflows%2Flock-prs.yml",
      "contents_url": "https://api.github.com/repos/openai/math/contents/.github%2Fworkflows%2Flock-prs.yml?ref=1581d4cbdd69a0faf34b2089614fe2a814316a6a",
      "patch": "@@ -0,0 +1,20 @@\n+name: Lock pull requests\n+\n+on:\n+  pull_request_target:\n+    types: [opened]\n+\n+permissions:\n+  pull-requests: write\n+\n+jobs:\n+  lock:\n+    if: github.repository == 'openai/math'\n+    runs-on: ubuntu-24.04\n+    timeout-minutes: 2\n+    steps:\n+      - name: Lock the pull request conversation\n+        run: gh api --method PUT \"repos/$GITHUB_REPOSITORY/issues/$PR_NUMBER/lock\"\n+        env:\n+          GH_TOKEN: ${{ github.token }}\n+          PR_NUMBER: ${{ github.event.pull_request.number }}"
    }
  ]
