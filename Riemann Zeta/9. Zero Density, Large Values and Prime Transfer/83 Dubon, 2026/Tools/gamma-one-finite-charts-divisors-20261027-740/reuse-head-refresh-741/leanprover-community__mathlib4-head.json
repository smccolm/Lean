[{"sha":"116662aa4c1e9106ab5c609b3214b02f6e11a65a","node_id":"C_kwDOFcwZ1doAKDExNjY2MmFhNGMxZTkxMDZhYjVjNjA5YjMyMTRiMDJmNmUxMWE2NWE","commit":{"author":{"name":"JX-Mo","email":"296066944+JX-Mo@users.noreply.github.com","date":"2026-10-27T05:50:01Z"},"committer":{"name":"JX-Mo","email":"296066944+JX-Mo@users.noreply.github.com","date":"2026-10-27T05:50:01Z"},"message":"chore(TensorProduct): golf `mul_assoc` of tensor algebras (#45234)\n\nWe add an auxiliary lemma for proving the associativity law of bilinear maps, turning an equality in terms of bilinear maps into an equality of linear maps so that we can use `ext`. We then use it to golf the proof of `mul_assoc` of tensor algebras.","tree":{"sha":"08e7027bf4e8d77bf0e16d3fdf7e7fdbe2be47e6","url":"https://api.github.com/repos/leanprover-community/mathlib4/git/trees/08e7027bf4e8d77bf0e16d3fdf7e7fdbe2be47e6"},"url":"https://api.github.com/repos/leanprover-community/mathlib4/git/commits/116662aa4c1e9106ab5c609b3214b02f6e11a65a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/leanprover-community/mathlib4/commits/116662aa4c1e9106ab5c609b3214b02f6e11a65a","html_url":"https://github.com/leanprover-community/mathlib4/commit/116662aa4c1e9106ab5c609b3214b02f6e11a65a","comments_url":"https://api.github.com/repos/leanprover-community/mathlib4/commits/116662aa4c1e9106ab5c609b3214b02f6e11a65a/comments","author":{"login":"JX-Mo","id":296066944,"node_id":"U_kgDOEaWfgA","avatar_url":"https://avatars.githubusercontent.com/u/296066944?v=4","gravatar_id":"","url":"https://api.github.com/users/JX-Mo","html_url":"https://github.com/JX-Mo","followers_url":"https://api.github.com/users/JX-Mo/followers","following_url":"https://api.github.com/users/JX-Mo/following{/other_user}","gists_url":"https://api.github.com/users/JX-Mo/gists{/gist_id}","starred_url":"https://api.github.com/users/JX-Mo/starred{/owner}{/repo}","subscriptions_ur