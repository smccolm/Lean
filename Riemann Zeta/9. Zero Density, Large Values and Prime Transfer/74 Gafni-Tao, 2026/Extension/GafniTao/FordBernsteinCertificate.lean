def fordAffineGap (j : ℕ) : Polynomial ℚ :=
  fordNumericalGap.comp (fordGapSubintervalMap j)

def fordBernsteinCoefficient (j k : ℕ) : ℚ :=
  ∑ i ∈ Finset.range (k + 1),
    (fordAffineGap j).coeff i *
      (Nat.choose k i : ℚ) / (Nat.choose 88 i : ℚ)

def fordBernsteinExpansion (j : ℕ) : Polynomial ℚ :=
  ∑ k ∈ Finset.range 89,
    Polynomial.C (fordBernsteinCoefficient j k) *
      bernsteinPolynomial ℚ 88 k

end

end GafniTao
