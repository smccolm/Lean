def fordGapBernsteinExpansion5 : Polynomial ℚ :=
  ∑ k ∈ Finset.range 89,
    Polynomial.C (fordGapBernsteinCoeff5 k) *
      bernsteinPolynomial ℚ 88 k

theorem fordGapBernsteinCoeff5_nonneg
    {k : ℕ} (hk : k < 89) : 0 ≤ fordGapBernsteinCoeff5 k := by
  interval_cases k <;>
    norm_num [fordGapBernsteinCoeff5]

